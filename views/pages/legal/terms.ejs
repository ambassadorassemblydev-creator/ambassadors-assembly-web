    <style>
        .legal-page {
            padding-top: 100px;
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .legal-header {
            padding: 80px 0 40px;
            text-align: center;
        }

        .last-updated {
            font-size: 0.9rem;
            color: #71b280;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-top: 10px;
        }

        .legal-content {
            background: #ffffff;
            border: 1.5px solid rgba(26, 26, 26, 0.1);
            border-radius: 40px;
            padding: 60px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.05);
            color: #1a1a1a;
            margin-bottom: 100px;
        }
        .legal-header h1 { font-size: 3.5rem; font-weight: 950; letter-spacing: -0.04em; margin-bottom: 20px; color: #1a1a1a; }
        .legal-header p { color: rgba(26, 26, 26, 0.5); font-size: 1.1rem; }
        
        .content-sections h2 { font-size: 1.5rem; font-weight: 800; color: #1a1a1a; margin-top: 40px; margin-bottom: 15px; }
        .content-sections p { line-height: 1.8; color: rgba(26, 26, 26, 0.6); margin-bottom: 20px; }
        .content-sections ul { padding-left: 20px; color: rgba(26, 26, 26, 0.6); margin-bottom: 25px; }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
