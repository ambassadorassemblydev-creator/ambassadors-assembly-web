<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <main class="ministries-page">
          <!-- AMBIENT BG -->
          <div class="give-bg">
            <div class="bg-overlay"></div>
            <img src="/images/emerald-hero-bg.png" alt="Ministries Background" class="bg-img">
          </div>

          <!-- HERO SECTION -->
          <section class="min-hero">
            <div class="hero-content">
              <span class="gsap-min">Our Community Structure</span>
              <h1 class="gsap-min">Ministries & Impact</h1>
              <p class="gsap-min">Discover where you belong and how we touch lives beyond our walls.</p>
            </div>
          </section>

          <!-- FELLOWSHIP MINISTRIES -->
          <section class="min-section">
            <div class="section-header">
              <div class="section-badge">Fellowship Groups</div>
              <h2>Where You Belong</h2>
              <p>Connect with a family of believers that shares your journey.</p>
            </div>
            <div class="min-grid">
              <% const fellowshipMin = ministries.filter(m => m.category === 'fellowship'); %>
              <% fellowshipMin.forEach((m, i) => { %>
                <a href="/ministries/<%= m.slug %>" class="min-card gsap-min-card glass-fx">
                  <div class="min-card__img">
                    <img src="<%= m.cover_image_url || 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=1000' %>" alt="<%= m.name %>">
                    <div class="img-overlay"></div>
                  </div>
                  <div class="min-card__body">
                    <h3><%= m.name %></h3>
                    <p><%= m.description %></p>
                    <span class="join-link">Join Group ↗</span>
                  </div>
                </a>
              <% }) %>
            </div>
          </section>

          <!-- SERVICE MINISTRIES -->
          <section class="min-section alt-bg">
            <div class="section-header">
              <div class="section-badge">Service Units</div>
              <h2>Where You Serve</h2>
              <p>Use your gifts and talents to build the house of God.</p>
            </div>
            <div class="min-grid">
              <% const serviceMin = ministries.filter(m => m.category === 'service'); %>
              <% serviceMin.forEach((m, i) => { %>
                <a href="/ministries/<%= m.slug %>" class="min-card gsap-min-card glass-fx">
                  <div class="min-card__img">
                    <img src="<%= m.cover_image_url || 'https://images.unsplash.com/photo-1523240715632-d984bb4b9106?q=80&w=1000' %>" alt="<%= m.name %>">
                    <div class="img-overlay"></div>
                  </div>
                  <div class="min-card__body">
                    <h3><%= m.name %></h3>
                    <p><%= m.description %></p>
                    <span class="join-link">Volunteer Now ↗</span>
                  </div>
                </a>
              <% }) %>
            </div>
          </section>

          <!-- COMMUNITY IMPACT (OUTREACH) -->
          <section class="min-section impact-section">
            <div class="section-header">
              <div class="section-badge highlight">Community Impact</div>
              <h2>Reaching Beyond The Walls</h2>
              <p>We are committed to touching lives through strategic outreach programs.</p>
            </div>
            
            <div class="impact-grid">
              <!-- Static Impact Areas (Client Request) -->
              <div class="impact-areas">
                <div class="impact-area glass-fx">
                  <i class="fas fa-bullhorn"></i>
                  <h4>Evangelism Campaigns</h4>
                </div>
                <div class="impact-area glass-fx">
                  <i class="fas fa-hand-holding-heart"></i>
                  <h4>Community Support</h4>
                </div>
                <div class="impact-area glass-fx">
                  <i class="fas fa-first-aid"></i>
                  <h4>Medical Outreaches</h4>
                </div>
                <div class="impact-area glass-fx">
                  <i class="fas fa-briefcase"></i>
                  <h4>Leadership Seminars</h4>
                </div>
              </div>

              <!-- Dynamic Upcoming Outreaches -->
              <div class="upcoming-outreach">
                <h3 class="upcoming-title">Upcoming Outreaches</h3>
                <% if (outreachEvents && outreachEvents.length > 0) { %>
                  <div class="outreach-stack">
                    <% outreachEvents.forEach(evt => { %>
                      <a href="/events/<%= evt.slug %>" class="outreach-item glass-fx">
                        <div class="outreach-date">
                          <span class="day"><%= new Date(evt.start_date).getDate() %></span>
                          <span class="month"><%= new Date(evt.start_date).toLocaleString('default', { month: 'short' }).toUpperCase() %></span>
                        </div>
                        <div class="outreach-info">
                          <h4><%= evt.title %></h4>
                          <p><%= evt.location_name %></p>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                      </a>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="no-outreach glass-fx">
                    <p>No outreach events scheduled currently. Check back soon!</p>
                  </div>
                <% } %>
              </div>
            </div>
          </section>

        </main>

  <%- include('../partials/footer') %>

  <style>
    .ministries-page { position: relative; overflow-x: hidden; }
    
    .min-hero { height: 50vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 6%; position: relative; margin-top: 60px; }
    .min-hero span { display: block; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 4px; color: var(--aa-green); margin-bottom: 20px; }
    .min-hero h1 { font-family: 'Outfit', sans-serif; font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 900; line-height: 1; letter-spacing: -0.04em; margin-bottom: 25px; color: #1a1a1a; }
    .min-hero p { font-size: 1.15rem; color: rgba(26,26,26,0.6); max-width: 600px; margin: 0 auto; }

    .min-section { padding: 80px 6%; position: relative; }
    .alt-bg { background: rgba(23, 106, 96, 0.03); border-top: 1px solid rgba(23, 106, 96, 0.08); border-bottom: 1px solid rgba(23, 106, 96, 0.08); }
    
    .section-header { text-align: center; margin-bottom: 60px; }
    .section-badge { display: inline-block; padding: 6px 16px; background: rgba(26,26,26,0.05); border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 20px; color: rgba(26,26,26,0.6); }
    .section-badge.highlight { background: var(--aa-green); color: white; }
    .section-header h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; margin-bottom: 15px; color: #1a1a1a; }
    .section-header p { color: rgba(26,26,26,0.6); font-size: 1.1rem; }

    .min-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; max-width: 1400px; margin: 0 auto; }
    .min-card { border-radius: 28px; overflow: hidden; position: relative; transition: 0.6s cubic-bezier(0.16, 1, 0.3, 1); text-decoration: none; color: inherit; height: 100%; display: flex; flex-direction: column; }
    .min-card:hover { transform: translateY(-12px); box-shadow: 0 30px 60px rgba(0,0,0,0.1) !important; }
    .min-card__img { height: 280px; position: relative; overflow: hidden; }
    .min-card__img img { width: 100%; height: 100%; object-fit: cover; transition: 1.2s; }
    .min-card:hover .min-card__img img { transform: scale(1.1); }
    .img-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%); }

    .min-card__body { padding: 30px; flex: 1; display: flex; flex-direction: column; }
    .min-card__body h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 12px; color: #1a1a1a; }
    .min-card__body p { font-size: 0.95rem; color: rgba(26,26,26,0.6); line-height: 1.6; margin-bottom: 25px; flex: 1; }
    .join-link { font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--aa-green); margin-top: auto; }

    /* Impact Grid */
    .impact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 1400px; margin: 0 auto; }
    .impact-areas { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .impact-area { padding: 35px; border-radius: 24px; text-align: center; transition: 0.3s; }
    .impact-area:hover { background: white; transform: scale(1.05); border-color: var(--aa-green); }
    .impact-area i { font-size: 2rem; color: var(--aa-green); margin-bottom: 15px; display: block; }
    .impact-area h4 { font-size: 1.1rem; font-weight: 800; color: #1a1a1a; margin: 0; }

    .upcoming-title { font-size: 1.3rem; font-weight: 900; margin-bottom: 25px; color: #1a1a1a; padding-left: 10px; }
    .outreach-stack { display: flex; flex-direction: column; gap: 15px; }
    .outreach-item { display: flex; align-items: center; gap: 20px; padding: 20px; border-radius: 20px; text-decoration: none; color: inherit; transition: 0.3s; }
    .outreach-item:hover { background: white; border-color: var(--aa-green); padding-left: 30px; }
    .outreach-date { width: 55px; height: 55px; background: var(--aa-green); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white; flex-shrink: 0; }
    .outreach-date .day { font-size: 1.2rem; font-weight: 900; line-height: 1; }
    .outreach-date .month { font-size: 0.6rem; font-weight: 800; }
    .outreach-info { flex: 1; }
    .outreach-info h4 { font-size: 1.1rem; font-weight: 800; color: #1a1a1a; margin: 0 0 4px; }
    .outreach-info p { font-size: 0.85rem; color: rgba(26,26,26,0.6); margin: 0; }
    .no-outreach { padding: 40px; text-align: center; border-radius: 24px; color: rgba(26,26,26,0.5); font-weight: 600; }

    .glass-fx { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border: 1.5px solid rgba(26,26,26,0.08); box-shadow: 0 8px 32px rgba(0,0,0,0.02); }

    /* Ambient BG */
    .give-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
    .bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.15; filter: grayscale(1); }
    .bg-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, #f7faf8 0%, #ffffff 100%); }

    @media (max-width: 1100px) { .min-grid { grid-template-columns: repeat(2, 1fr); } .impact-grid { grid-template-columns: 1fr; } }
    @media (max-width: 768px) { .min-grid { grid-template-columns: 1fr; } .min-hero { height: 40vh; } .impact-areas { grid-template-columns: 1fr; } }
  </style>

  <script>
    window.addEventListener('load', () => {
      gsap.from('.gsap-min', { y: 40, opacity: 0, duration: 1, stagger: 0.15, ease: 'power3.out' });
      gsap.from('.gsap-min-card', { 
        scrollTrigger: { trigger: '.min-grid', start: 'top 80%' },
        y: 60, opacity: 0, duration: 1, stagger: 0.1, ease: 'power3.out' 
      });
    });
  </script>
                </div></div></div></div></div></div></div></div></body></html>