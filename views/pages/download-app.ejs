<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="download-app-page" class="dm-download-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200" id="dm-outer-wrapper">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

                  <%- include('../partials/navbar') %>

                  <style>
                    .download-hero {
                        padding: 180px 6% 80px;
                        /* High IQ: Soft ivory-green grained gradient */
                        background: linear-gradient(135deg, #ffffff 0%, #f4fcf6 100%);
                        position: relative;
                        overflow: hidden;
                        min-height: 100vh;
                    }
                    .bg-glow {
                        position: absolute;
                        top: 15%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        width: 1000px;
                        height: 1000px;
                        background: radial-gradient(circle, rgba(23, 106, 96, 0.05) 0%, transparent 70%);
                        pointer-events: none;
                        z-index: 1;
                    }
                    .hero-content {
                        position: relative;
                        z-index: 2;
                        max-width: 1400px;
                        margin: 0 auto;
                        text-align: center;
                    }
                    .hero-label {
                        font-family: 'Manrope', sans-serif;
                        font-size: 0.85rem;
                        font-weight: 800;
                        letter-spacing: 0.4em;
                        text-transform: uppercase;
                        color: #176a60; /* Emerald Text */
                        margin-bottom: 25px;
                        display: block;
                    }
                    .hero-title {
                        font-family: 'Manrope', sans-serif;
                        font-size: clamp(3rem, 8vw, 6rem);
                        font-weight: 900;
                        line-height: 0.95;
                        letter-spacing: -0.05em;
                        color: #1a1a1a; /* Obsidian Black */
                        margin-bottom: 40px;
                        text-transform: uppercase;
                    }
                    .text-emerald { color: #176a60; }

                    .download-grid {
                        display: grid;
                        grid-template-columns: 1.2fr 0.8fr;
                        gap: 50px;
                        margin-top: 60px;
                        text-align: left;
                    }

                    .apk-card {
                        background: rgba(255, 255, 255, 0.9);
                        border: 1.5px solid rgba(23, 106, 96, 0.15);
                        border-radius: 40px;
                        padding: 50px;
                        box-shadow: 0 30px 60px rgba(23, 106, 96, 0.05);
                        backdrop-filter: blur(10px);
                    }
                    .apk-card h2 { font-size: 2.8rem; margin-bottom: 15px; font-weight: 900; color: #176a60; letter-spacing: -0.02em; }
                    .apk-card p { margin-bottom: 35px; color: #334155; font-size: 1.2rem; line-height: 1.6; }

                    .btn-download {
                        background: #176a60;
                        color: white;
                        padding: 24px 48px;
                        border-radius: 24px;
                        text-decoration: none !important;
                        font-weight: 800;
                        font-size: 1.25rem;
                        display: inline-flex;
                        align-items: center;
                        gap: 15px;
                        width: fit-content;
                        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
                        box-shadow: 0 15px 30px rgba(23, 106, 96, 0.25);
                    }
                    .btn-download:hover { transform: translateY(-8px) scale(1.02); box-shadow: 0 25px 50px rgba(23, 106, 96, 0.35); background: #134e5e; }

                    .pwa-info {
                        display: flex;
                        flex-direction: column;
                        gap: 25px;
                    }
                    .pwa-step {
                        background: #ffffff;
                        border: 1.5px solid rgba(23, 106, 96, 0.08);
                        padding: 30px;
                        border-radius: 35px;
                        transition: all 0.4s ease;
                        box-shadow: 0 10px 20px rgba(0,0,0,0.02);
                    }
                    .pwa-step:hover { border-color: #176a60; transform: translateX(15px); box-shadow: 0 15px 40px rgba(23, 106, 96, 0.1); }
                    .step-num { color: #176a60; font-weight: 900; font-size: 1.3rem; margin-bottom: 12px; display: block; opacity: 0.8; }
                    .pwa-step h3 { font-size: 1.2rem; margin-bottom: 8px; color: #1a1a1a; font-weight: 800; }
                    .pwa-step p { font-size: 0.95rem; color: #64748b; line-height: 1.5; }

                    @media (max-width: 900px) {
                        .download-grid { grid-template-columns: 1fr; gap: 30px; }
                        .hero-title { font-size: 3.5rem; }
                        .apk-card { padding: 35px 25px; }
                    }
                  </style>

                  <main>
                    <section class="download-hero">
                        <div class="bg-glow"></div>
                        <div class="hero-content">
                            <span class="hero-label gsap-reveal">Ambassadors Assembly Mobile</span>
                            <h1 class="hero-title gsap-reveal">Divine <span class="text-emerald">Connection</span><br>On Every Device</h1>
                            
                            <div class="download-grid">
                                <div class="apk-card gsap-reveal">
                                    <h2>Android APK</h2>
                                    <p>Download the official Android installation package directly to your device. Full performance, zero limits.</p>
                                    <a href="#" id="apk-link" class="btn-download">
                                        <i class="fas fa-download"></i>
                                        Download APK
                                    </a>
                                    <div style="margin-top: 30px; font-size: 0.8rem; color: #888; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;">
                                        Current Version: v1.0.0 (Production)<br>
                                        Last Updated: <%= new Date().toLocaleDateString() %>
                                    </div>
                                </div>

                                <div class="pwa-info gsap-reveal">
                                    <div class="pwa-step">
                                        <span class="step-num">01</span>
                                        <h3>Instant Install</h3>
                                        <p>No app store needed. Tap the 'Share' or 'Menu' icon in your browser.</p>
                                    </div>
                                    <div class="pwa-step">
                                        <span class="step-num">02</span>
                                        <h3>Add to Home</h3>
                                        <p>Select "Add to Home Screen" to install the Ambassadors app instantly.</p>
                                    </div>
                                    <div class="pwa-step">
                                        <span class="step-num">03</span>
                                        <h3>Launch Anywhere</h3>
                                        <p>Access sermons, giving, and AI directly from your home screen.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                  </main>

                  <%- include('../partials/footer') %>

                  <script>
                    window.addEventListener('load', () => {
                      gsap.from('.gsap-reveal', {
                        y: 60,
                        opacity: 0,
                        duration: 1.2,
                        stagger: 0.2,
                        ease: 'power4.out'
                      });
                    });

                    document.getElementById('apk-link').addEventListener('click', (e) => {
                        const link = e.currentTarget.getAttribute('href');
                        if (link === '#') {
                            e.preventDefault();
                            alert("The High IQ APK link is coming soon! For now, please use the 'Add to Home Screen' method.");
                        }
                    });
                  </script>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
