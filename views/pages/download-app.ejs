<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="download-app-page" class="dm-download-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200" id="dm-outer-wrapper">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

                  <%- include('../partials/navbar') %>

                  <style>
                    .download-hero {
                        padding: 180px 6% 80px;
                        background: linear-gradient(135deg, #ffffff 0%, #f4fcf6 100%);
                        position: relative;
                        overflow: hidden;
                        min-height: 100vh;
                    }
                    .bg-glow {
                        position: absolute;
                        top: 15%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        width: 1000px;
                        height: 1000px;
                        background: radial-gradient(circle, rgba(23, 106, 96, 0.05) 0%, transparent 70%);
                        pointer-events: none;
                        z-index: 1;
                    }
                    .hero-content {
                        position: relative;
                        z-index: 2;
                        max-width: 1400px;
                        margin: 0 auto;
                        text-align: center;
                    }
                    .hero-label {
                        font-family: 'Manrope', sans-serif;
                        font-size: 0.85rem;
                        font-weight: 800;
                        letter-spacing: 0.4em;
                        text-transform: uppercase;
                        color: #176a60;
                        margin-bottom: 25px;
                        display: block;
                    }
                    .hero-title {
                        font-family: 'Manrope', sans-serif;
                        font-size: clamp(3rem, 8vw, 6rem);
                        font-weight: 900;
                        line-height: 0.95;
                        letter-spacing: -0.05em;
                        color: #1a1a1a;
                        margin-bottom: 40px;
                        text-transform: uppercase;
                    }
                    .text-emerald { color: #176a60; }

                    .download-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
                        gap: 30px;
                        margin-top: 60px;
                        text-align: left;
                    }

                    .download-card {
                        background: rgba(255, 255, 255, 0.9);
                        border: 1.5px solid rgba(23, 106, 96, 0.15);
                        border-radius: 40px;
                        padding: 40px;
                        box-shadow: 0 30px 60px rgba(23, 106, 96, 0.05);
                        backdrop-filter: blur(10px);
                        display: flex;
                        flex-direction: column;
                        transition: all 0.5s ease;
                    }
                    .download-card:hover { transform: translateY(-10px); border-color: #176a60; }
                    .download-card h2 { font-size: 2.2rem; margin-bottom: 15px; font-weight: 900; color: #176a60; letter-spacing: -0.02em; }
                    .download-card p { margin-bottom: 35px; color: #334155; font-size: 1.1rem; line-height: 1.6; flex-grow: 1; }

                    .btn-download {
                        background: #176a60;
                        color: white !important;
                        padding: 20px 32px;
                        border-radius: 24px;
                        text-decoration: none !important;
                        font-weight: 800;
                        font-size: 1.1rem;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        gap: 12px;
                        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
                        box-shadow: 0 15px 30px rgba(23, 106, 96, 0.25);
                        cursor: pointer;
                        border: none;
                    }
                    .btn-download:hover { transform: scale(1.03); box-shadow: 0 20px 40px rgba(23, 106, 96, 0.35); background: #134e5e; }
                    .btn-download.outline { background: transparent; border: 2px solid #176a60; color: #176a60 !important; box-shadow: none; }

                    .notification-optin {
                        margin-top: 80px;
                        background: #176a60;
                        border-radius: 40px;
                        padding: 60px;
                        color: white;
                        text-align: center;
                        position: relative;
                        overflow: hidden;
                    }
                    .notification-optin h2 { font-size: 2.5rem; font-weight: 900; margin-bottom: 15px; }
                    .notification-optin p { font-size: 1.2rem; opacity: 0.9; margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto; }
                    .btn-notify { background: white; color: #176a60 !important; padding: 20px 40px; border-radius: 20px; font-weight: 800; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 10px; border: none; cursor: pointer; transition: all 0.3s ease; }
                    .btn-notify:hover { transform: scale(1.05); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }

                    @media (max-width: 600px) {
                        .notification-optin { padding: 40px 20px; border-radius: 30px; }
                        .notification-optin h2 { font-size: 1.8rem; }
                    }
                  </style>

                  <main>
                    <section class="download-hero">
                        <!-- <div class="bg-glow"></div> -->
                        <div class="hero-content">
                            <span class="hero-label">Ambassadors Assembly Mobile</span>
                            <h1 class="hero-title">Divine <span class="text-emerald">Connection</span><br>On Every Device</h1>
                            
                            <div class="download-grid">
                                <!-- Android Card -->
                                <div class="download-card">
                                    <h2>Android App</h2>
                                    <p>Get the full Android experience. Direct APK download for maximum performance and instant updates.</p>
                                    <a href="https://bxlmmvunfyvsbqakgxed.supabase.co/storage/v1/object/public/resources/apps/ambassadors-v1.apk" class="btn-download">
                                        <i class="fab fa-android"></i>
                                        Download APK
                                    </a>
                                </div>

                                 <!-- iOS Card -->
                                 <div class="download-card">
                                     <h2>iOS (Apple)</h2>
                                     <p>Optimized for iPhone and iPad. Install via our premium PWA experience with full Push Notification support.</p>
                                     <div style="display: flex; flex-direction: column; gap: 12px;">
                                         <button onclick="showIOSGuide()" class="btn-download">
                                             <i class="fab fa-apple"></i>
                                             Install on iOS
                                         </button>
                                         <a href="https://bxlmmvunfyvsbqakgxed.supabase.co/storage/v1/object/public/resources/apps/ambassadors-v1.ipa" class="btn-download outline" style="padding: 12px 20px; font-size: 0.9rem; border-radius: 18px;">
                                             <i class="fas fa-file-download"></i>
                                             Download .IPA
                                         </a>
                                     </div>
                                 </div>

                                <!-- PWA Card -->
                                <div class="download-card">
                                    <h2>Web Desktop</h2>
                                    <p>Experience the Ambassadors Assembly on your PC or Mac. Install as a standalone application.</p>
                                    <button id="pwa-install-btn" class="btn-download outline">
                                        <i class="fas fa-desktop"></i>
                                        Install as Web App
                                    </button>
                                </div>
                            </div>

                            <!-- Push Notification Opt-in -->
                            <div class="notification-optin">
                                <h2>Never Miss a Word</h2>
                                <p>Enable push notifications to receive daily devotionals, event alerts, and live stream updates directly on your device.</p>
                                <button onclick="subscribePush()" id="push-btn" class="btn-notify">
                                    <i class="fas fa-bell"></i>
                                    Enable Notifications
                                </button>
                                <div id="push-status" style="margin-top: 15px; font-size: 0.9rem; font-weight: 700; display: none;"></div>
                            </div>
                        </div>
                    </section>
                  </main>

                  <%- include('../partials/footer') %>

                  <script>
                    window.addEventListener('load', () => {
                      gsap.from('.gsap-reveal', {
                        y: 60,
                        opacity: 0,
                        duration: 1.2,
                        stagger: 0.2,
                        ease: 'power4.out'
                      });

                      // Check notification status
                      if (Notification.permission === 'granted') {
                          document.getElementById('push-btn').style.display = 'none';
                          const status = document.getElementById('push-status');
                          status.innerText = '✅ Notifications are enabled';
                          status.style.display = 'block';
                      }
                    });

                    async function subscribePush() {
                        const btn = document.getElementById('push-btn');
                        const status = document.getElementById('push-status');
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enabling...';

                        try {
                            const success = await window.PWA.requestPermission();
                            if (success) {
                                btn.style.display = 'none';
                                status.innerText = '✅ Notifications enabled successfully!';
                                status.style.color = '#ffffff';
                                status.style.display = 'block';
                                showToast('Welcome to the loop! Notifications enabled.', 'success');
                            } else {
                                throw new Error('Permission denied');
                            }
                        } catch (err) {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fas fa-bell"></i> Try Again';
                            alert('Notification permission was denied. Please enable them in your browser settings to receive updates.');
                        }
                    }

                    function showIOSGuide() {
                        window.AA.alert(
                            "To install on iPhone:\n\n1. Tap the Share icon (box with arrow) at the bottom of Safari.\n2. Scroll down and tap 'Add to Home Screen'.\n3. Tap 'Add' to finish.",
                            "iOS Installation Guide"
                        );
                    }
                  </script>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
