<%- include('../partials/head') %>

<body class="bg-dark text-white d-flex align-items-center justify-content-center" style="min-height: 100vh; overflow: hidden; background: #0a0a0a;">
  
  <div class="text-center gsap-reveal">
    <!-- CINEMATIC LOADER -->
    <div class="loader-wrapper mb-4">
      <div class="loader-circle"></div>
      <div class="loader-inner"></div>
      <div class="loader-logo">
         <img src="https://res.cloudinary.com/dxwhpacz7/image/upload/v1775200226/IMG-20260304-WA0059_telyum.jpg" alt="Logo" style="width: 40px; height: 40px; border-radius: 50%;">
      </div>
    </div>
    
    <h2 class="auth-text" style="font-family: 'Outfit', sans-serif; font-weight: 700; letter-spacing: -0.5px; opacity: 0.8;">Securing Session</h2>
    <p class="text-muted small" style="letter-spacing: 1px; text-transform: uppercase; opacity: 0.5;">Please wait while we connect your Ambassador identity</p>
  </div>

  <input type="hidden" id="csrfToken" value="<%= locals.csrfToken %>">

  <style>
    .loader-wrapper {
      position: relative;
      width: 100px;
      height: 100px;
      margin: 0 auto;
    }
    .loader-circle {
      position: absolute;
      inset: 0;
      border: 2px solid rgba(23, 106, 96, 0.1);
      border-top-color: #176a60;
      border-radius: 50%;
      animation: spin 1.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
    }
    .loader-inner {
      position: absolute;
      inset: 10px;
      border: 2px solid rgba(37, 211, 102, 0.05);
      border-bottom-color: #25D366;
      border-radius: 50%;
      animation: spin-reverse 1s linear infinite;
    }
    .loader-logo {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes spin-reverse { to { transform: rotate(-360deg); } }
    
    .auth-text {
      background: linear-gradient(to bottom, #ffffff, #888);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      // Reveal animation
      gsap.from('.gsap-reveal', { y: 20, opacity: 0, duration: 1, ease: 'power4.out' });

      // Handle the hash
      const handleAuthHash = async () => {
        const hash = window.location.hash;
        if (!hash) {
          console.log("No hash found, redirecting to sign-in");
          window.location.href = "/account/login?error=no_session";
          return;
        }

        // Parse hash into a session object (Supabase style)
        const params = new URLSearchParams(hash.substring(1));
        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');
        const expiresIn = params.get('expires_in');

        if (!accessToken) {
          window.location.href = "/account/login?error=invalid_session";
          return;
        }

        const session = {
          access_token: accessToken,
          refresh_token: refreshToken,
          expires_in: parseInt(expiresIn)
        };

        try {
          const response = await fetch('/api/auth/session', {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'x-csrf-token': document.getElementById("csrfToken")?.value
            },
            body: JSON.stringify({ session })
          });

          if (response.ok) {
            window.location.hash = ""; // Clear hash
            window.location.href = "/my-account";
          } else {
            const data = await response.json();
            window.location.href = "/account/login?error=" + encodeURIComponent(data.message || "session_failed");
          }
        } catch (err) {
          console.error("Auth bridge failure:", err);
          window.location.href = "/account/login?error=bridge_error";
        }
      };

      // Small delay to ensure hash is stable in some browsers
      setTimeout(handleAuthHash, 500);
    });
  </script>
</body>
</html>
