<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main class="buildings-main">
      <!-- HERO -->
      <section class="buildings-hero">
        <div class="hero-bg">
          <div class="hero-overlay"></div>
          <img src="/images/emerald-hero-bg.png" alt="Building Vision" class="hero-img">
        </div>
        <div class="hero-content">
          <span class="sub-label">The Kingdom Expansion</span>
          <h1>Building the <br><span class="text-green">Future</span></h1>
          <p>Join us in creating sacred spaces that will serve as portals for kingdom advancement and specialized training for generations to come.</p>
        </div>
      </section>

      <!-- PROJECT GRID -->
      <section class="project-portfolio">
        <div class="container">
          <div class="section-header">
            <span class="section-num">01 / PROJECTS</span>
            <h2>Active <span class="text-green">Endeavors</span></h2>
          </div>

          <div class="project-grid">
            <% projects.forEach((project, i) => { %>
              <div class="project-card gsap-project" onclick="location.href='/fund-the-buildings/<%= project.slug %>'">
                <div class="project-card__img-wrap">
                  <img src="<%= (project.media_urls && project.media_urls[0]) || 'https://images.unsplash.com/photo-1541888946425-d81bb19480c5?q=80&w=2070' %>" alt="<%= project.name %>">
                </div>
                <div class="project-card__content">
                  <div class="project-card__status">
                    <span class="status-tag">ACTIVE SEEDING</span>
                  </div>
                  <h3><%= project.name %></h3>
                  <p><%= project.description %></p>
                  
                  <% if (project.show_progress) { %>
                    <div class="progress-wrap">
                      <div class="progress-info">
                        <span><%= Math.round((project.current_amount / project.goal_amount) * 100) %>% RAISED</span>
                        <span>Goal: ₦<%= (project.goal_amount / 1000000).toFixed(1) %>M</span>
                      </div>
                      <div class="progress-bar">
                        <div class="progress-fill" style="width: <%= Math.min(100, (project.current_amount / project.goal_amount) * 100) %>%"></div>
                      </div>
                    </div>
                  <% } %>
                  
                  <div class="project-card__footer">
                    <span class="btn-text">View Project Details &rarr;</span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/footer') %>
 

  <style>
    :root {
      --aa-green: rgba(113, 178, 128, 1);
    }
    .text-green { color: var(--aa-green); }

    .buildings-main { background: var(--color_1); min-height: 100vh; }

    /* HERO with Gradient Mask */
    .buildings-hero { position: relative; height: 75vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .hero-bg { position: absolute; top:0; left:0; width:100%; height:100%; z-index: 1; }
    .hero-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; transform: scale(1.1); }
    .hero-overlay { 
      position: absolute; top:0; left:0; width:100%; height:100%; 
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 0%, rgba(255,255,255,0.4) 50%, var(--color_1) 100%); 
      z-index: 2; 
    }
    
    .hero-content { position: relative; z-index: 3; text-align: center; max-width: 800px; padding: 0 6%; }
    .sub-label { display: block; font-size: 0.8rem; font-weight: 800; letter-spacing: 5px; color: var(--aa-green); margin-bottom: 20px; text-transform: uppercase; }
    .hero-content h1 { font-size: clamp(3.5rem, 10vw, 7rem); line-height: 0.85; font-weight: 900; letter-spacing: -0.05em; margin-bottom: 30px; }
    .hero-content p { font-size: 1.25rem; color: rgba(26,26,26,0.6); line-height: 1.6; }

    /* PORTFOLIO GRID */
    .project-portfolio { padding: 100px 0 150px; position: relative; z-index: 10; }
    .container { max-width: 1400px; margin: 0 auto; padding: 0 6%; }
    
    .section-header { margin-bottom: 60px; }
    .section-num { font-size: 0.75rem; font-weight: 900; opacity: 0.3; letter-spacing: 5px; margin-bottom: 20px; display: block; }
    .section-header h2 { font-size: 3.5rem; letter-spacing: -0.03em; font-weight: 900; }

    .project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 40px; position: relative; z-index: 10; }
    
    .project-card { 
      position: relative; border-radius: 40px; overflow: hidden; background: #ffffff; 
      border: 1.5px solid rgba(26,26,26,0.1); cursor: pointer; transition: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 11;
    }
    .project-card:hover { transform: translateY(-15px); border-color: var(--aa-green); box-shadow: 0 40px 80px rgba(0,0,0,0.05); }
    
    .project-card__img-wrap { aspect-ratio: 16/10; overflow: hidden; }
    .project-card__img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: 1.2s cubic-bezier(0.16, 1, 0.3, 1); filter: grayscale(0); }
    .project-card:hover .project-card__img-wrap img { transform: scale(1.1); }

    .project-card__content { padding: 40px; }
    .project-card__status { margin-bottom: 15px; }
    .status-tag { font-size: 0.65rem; font-weight: 900; letter-spacing: 2px; color: var(--aa-green); border: 1px solid var(--aa-green); padding: 5px 12px; border-radius: 100px; }
    
    .project-card h3 { font-size: 2rem; font-weight: 800; margin-bottom: 15px; letter-spacing: -0.02em; color: #1a1a1a; }
    .project-card p { font-size: 1.05rem; color: rgba(26,26,26,0.5); line-height: 1.6; margin-bottom: 30px; }

    /* PROGRESS */
    .progress-wrap { margin-bottom: 30px; }
    .progress-info { display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 900; color: rgba(26,26,26,0.4); margin-bottom: 10px; }
    .progress-bar { width: 100%; height: 6px; background: rgba(26,26,26,0.05); border-radius: 100px; overflow: hidden; }
    .progress-fill { height: 100%; background: var(--aa-green); border-radius: 100px; transition: 1s cubic-bezier(0.16, 1, 0.3, 1); }

    .project-card__footer { font-size: 0.85rem; font-weight: 800; color: var(--aa-green); text-transform: uppercase; letter-spacing: 1px; }

    @media (max-width: 1000px) {
      .project-grid { grid-template-columns: 1fr; gap: 20px; }
      .project-card__content { padding: 25px; }
      .project-card h3 { font-size: 1.5rem; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script>
    const initBuildingGsap = () => {
      gsap.fromTo(".hero-content > *", 
        { y: 40, opacity: 0 }, 
        { y: 0, opacity: 1, duration: 1, stagger: 0.2, ease: "power3.out" }
      );
      gsap.fromTo(".gsap-project", 
        { y: 60, opacity: 0 }, 
        { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power2.out", delay: 0.5 }
      );
    };

    if (document.readyState === 'complete') {
      initBuildingGsap();
    } else {
      window.addEventListener('load', initBuildingGsap);
    }
  </script>
</body>
</html>
