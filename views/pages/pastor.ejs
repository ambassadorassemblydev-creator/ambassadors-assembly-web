<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: #fdfbf7;">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
                  
                  <%- include('../partials/navbar') %>

                  <main class="pastor-page">
                    <!-- PRESIDENT SECTION -->
                    <section class="pastor-hero" style="background: #ffffff; border-bottom: 1.5px solid rgba(23,106,96,0.05); padding-top: 150px;">
                      <div class="hero-container">
                        <div class="hero-image-side gsap-hero">
                          <div class="pastor-frame">
                            <img src="https://res.cloudinary.com/dxwhpacz7/image/upload/q_auto/f_auto/v1777044609/IMG-20260424-WA0012.jpg" alt="President of Ambassadors Assembly" class="pastor-img">
                            <div class="frame-decoration"></div>
                          </div>
                        </div>
                        <div class="hero-text-side">
                          <span class="sub-label gsap-hero">Visionary Leadership</span>
                          <h1 class="gsap-hero">Our <br><span class="text-green">President</span></h1>
                          <div class="pastor-bio glass-fx gsap-hero">
                            <p>Ambassadors Assembly is led by a visionary leadership dedicated to the global mandate of raising ambassadors for Christ. Through strategic foresight and a deep commitment to the Great Commission, our leadership ensures that the ministry's impact transcends borders, bringing the light of the Gospel to nations and empowering believers to walk in their divine purpose. We are committed to excellence in ministry and the total transformation of lives through the power of the Holy Spirit.</p>
                          </div>
                        </div>
                      </div>
                    </section>

                    <!-- HERO (PASTOR) -->
                    <section class="pastor-hero">
                      <div class="hero-container">
                        <div class="hero-text-side">
                          <span class="sub-label gsap-hero">Spiritual Leadership</span>
                          <h1 class="gsap-hero">Meet Our <br><span class="text-green">Pastor</span></h1>
                          <div class="pastor-bio glass-fx gsap-hero">
                            <p>Pastor Olusegun M. Samuel is a seasoned minister of the Gospel, teacher of God's Word, conference speaker, and visionary leader. He holds advanced theological and professional qualifications and has dedicated his life to helping people move from limitation into dominion through the power of God. Under his leadership, many lives continue to experience transformation, healing, growth, and purpose.</p>
                          </div>
                        </div>
                        <div class="hero-image-side gsap-hero">
                          <div class="pastor-frame">
                            <img src="https://res.cloudinary.com/dxwhpacz7/image/upload/q_auto/f_auto/v1777044608/IMG-20260424-WA0013.jpg" alt="Pastor Olusegun M. Samuel" class="pastor-img">
                            <div class="frame-decoration"></div>
                          </div>
                        </div>
                      </div>
                    </section>

                    <!-- WELCOME MESSAGE -->
                    <section class="welcome-section">
                      <div class="welcome-container glass-fx gsap-up">
                        <div class="welcome-content">
                          <span class="quote-icon">"</span>
                          <h2>Welcome From The Pastor</h2>
                          <p>Welcome to The Ambassadors' Assembly. We are delighted to receive you. This is a place where faith is built, destinies are restored, families are strengthened, and lives are transformed by God's Word. We look forward to worshipping with you and helping you grow in Christ. God bless you.</p>
                          <div class="pastor-sig">
                            <strong>Pastor Olusegun M. Samuel</strong>
                            <span>Lead Pastor, Ambassadors Assembly</span>
                          </div>
                        </div>
                      </div>
                    </section>

                    <!-- VALUES & FIRST TIME -->
                    <section class="values-grid-section">
                      <div class="values-container">
                        <div class="values-card glass-fx gsap-up">
                          <h3>Our Values</h3>
                          <div class="values-list">
                            <div class="value-item">
                              <div class="v-dot"></div>
                              <span>Worship</span>
                            </div>
                            <div class="value-item">
                              <div class="v-dot"></div>
                              <span>Prayer</span>
                            </div>
                            <div class="value-item">
                              <div class="v-dot"></div>
                              <span>Deliverance</span>
                            </div>
                            <div class="value-item">
                              <div class="v-dot"></div>
                              <span>The Word of God</span>
                            </div>
                          </div>
                        </div>

                        <div class="welcome-card glass-fx gsap-up">
                          <h3>First Time Here?</h3>
                          <p>We would love to welcome you personally. Here is what you can expect when you join us:</p>
                          <ul class="expectations">
                            <li><span>Friendly people</span></li>
                            <li><span>Inspiring worship</span></li>
                            <li><span>Powerful teaching</span></li>
                            <li><span>A place to belong</span></li>
                          </ul>
                          <a href="/plan-a-visit" class="visit-btn">Plan Your Visit</a>
                        </div>
                      </div>
                    </section>
                  </main>

                  <%- include('../partials/footer') %>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    :root {
      --emerald: #176a60;
      --emerald-light: rgba(23, 106, 96, 0.1);
      --text: #1a1a1a;
      --bg: #fdfbf7;
    }

    .pastor-page { padding-bottom: 150px; overflow: hidden; }
    .text-green { color: var(--emerald); }

    /* Hero */
    .pastor-hero { padding: 120px 6% 80px; }
    .hero-container { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: center; }
    
    .sub-label { display: block; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 5px; color: var(--emerald); margin-bottom: 20px; }
    .pastor-hero h1 { font-family: 'Manrope', sans-serif; font-size: clamp(3.5rem, 8vw, 6rem); font-weight: 950; line-height: 0.9; letter-spacing: -0.05em; margin-bottom: 40px; }
    
    .pastor-bio { padding: 40px; border-radius: 30px; background: white; border: 1.5px solid rgba(23,106,96,0.1); }
    .pastor-bio p { font-size: 1.15rem; line-height: 1.8; color: rgba(26,26,26,0.7); }

    .pastor-frame { position: relative; width: 100%; aspect-ratio: 0.85; border-radius: 40px; overflow: hidden; }
    .pastor-img { width: 100%; height: 100%; object-fit: cover; }
    .frame-decoration { position: absolute; top: 20px; right: 20px; bottom: 20px; left: 20px; border: 1.5px solid rgba(255,255,255,0.3); border-radius: 30px; pointer-events: none; }

    /* Welcome Section */
    .welcome-section { padding: 80px 6%; }
    .welcome-container { max-width: 1000px; margin: 0 auto; padding: 80px; border-radius: 50px; text-align: center; position: relative; background: white; border: 1.5px solid rgba(23,106,96,0.05); }
    .quote-icon { position: absolute; top: 20px; left: 50%; transform: translateX(-50%); font-size: 10rem; font-family: serif; color: var(--emerald-light); opacity: 0.5; line-height: 1; }
    .welcome-content h2 { font-size: 2.5rem; font-weight: 900; margin-bottom: 30px; position: relative; z-index: 2; }
    .welcome-content p { font-size: 1.3rem; line-height: 1.7; color: rgba(26,26,26,0.7); margin-bottom: 40px; position: relative; z-index: 2; }
    .pastor-sig { display: flex; flex-direction: column; gap: 5px; }
    .pastor-sig strong { font-size: 1.2rem; color: var(--emerald); }
    .pastor-sig span { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; opacity: 0.4; }

    /* Values Grid */
    .values-grid-section { padding: 80px 6%; }
    .values-container { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
    
    .glass-fx { background: white; border: 1.5px solid rgba(23,106,96,0.1); border-radius: 40px; padding: 60px; box-shadow: 0 20px 50px rgba(0,0,0,0.02); }
    
    .values-card h3, .welcome-card h3 { font-size: 2rem; font-weight: 900; margin-bottom: 30px; color: var(--emerald); }
    
    .values-list { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .value-item { display: flex; align-items: center; gap: 15px; padding: 20px; background: var(--emerald-light); border-radius: 20px; transition: 0.3s; }
    .value-item:hover { transform: translateY(-5px); background: var(--emerald); color: white; }
    .v-dot { width: 8px; height: 8px; background: currentColor; border-radius: 50%; }
    .value-item span { font-weight: 800; font-size: 1.1rem; }

    .welcome-card p { font-size: 1.1rem; color: rgba(26,26,26,0.6); margin-bottom: 30px; }
    .expectations { list-style: none; padding: 0; margin: 0 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .expectations li { font-weight: 700; color: #1a1a1a; display: flex; align-items: center; gap: 10px; }
    .expectations li::before { content: '✓'; color: var(--emerald); font-weight: 900; }

    .visit-btn { display: inline-block; padding: 18px 40px; background: #1a1a1a; color: white; border-radius: 100px; text-decoration: none; font-weight: 800; transition: 0.4s; }
    .visit-btn:hover { background: var(--emerald); transform: translateY(-3px); box-shadow: 0 15px 30px rgba(23,106,96,0.2); }

    @media (max-width: 1000px) {
      .hero-container { grid-template-columns: 1fr; gap: 40px; }
      .hero-image-side { order: -1; }
      .values-container { grid-template-columns: 1fr; }
      .welcome-container { padding: 40px 20px; }
      .pastor-hero h1 { font-size: 3.5rem; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script>
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener('load', () => {
      // Hero Animations
      gsap.from('.gsap-hero', {
        y: 60, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power4.out'
      });

      // Scroll Reveal Animations
      document.querySelectorAll('.gsap-up').forEach(el => {
        gsap.from(el, {
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
          },
          y: 60,
          opacity: 0,
          duration: 1,
          ease: 'power3.out'
        });
      });
    });
  </script>
</body>
</html>
