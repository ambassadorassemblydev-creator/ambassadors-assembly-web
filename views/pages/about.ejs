<%- include('../partials/head') %>
<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main>
      <!-- CINEMATIC ABOUT HERO (HIGH-IQ OVERHAUL) -->
      <section class="about-hero" id="about-hero">
        <div class="about-hero__bg">
          <div class="about-hero__overlay"></div>
          <img src="https://images.unsplash.com/photo-1471306224500-6d0d218be372?q=80&w=2671&auto=format&fit=crop" alt="Ambassadors Sanctuary" class="about-hero__img">
        </div>
        
        <div class="about-hero__content">
          <div class="about-hero__text-wrap">
            <span class="hero-tag gsap-hero-reveal">BEYOND RELIGION, A KINGDOM ASSIGNMENT</span>
            <h1 class="hero-title gsap-hero-reveal" id="about-hero-title">OUR IDENTITY</h1>
          </div>
        </div>
      </section>

      <!-- EDITORIAL LAYOUT WITH SIDE-NAV -->
      <div class="editorial-container">
        
        <!-- STICKY SIDE-NAV -->
        <aside class="side-nav" id="side-nav">
          <div class="side-nav__inner">
            <div class="side-nav__line">
              <div class="side-nav__progress" id="nav-progress"></div>
            </div>
            <ul class="side-nav__list">
              <li class="side-nav__item active" data-section="history">
                <span class="side-nav__num">01</span>
                <span class="side-nav__label">OUR HISTORY</span>
              </li>
              <li class="side-nav__item" data-section="vision">
                <span class="side-nav__num">02</span>
                <span class="side-nav__label">VISION & MISSION</span>
              </li>
              <li class="side-nav__item" data-section="values">
                <span class="side-nav__num">03</span>
                <span class="side-nav__label">CORE VALUES & CULTURE</span>
              </li>
              <li class="side-nav__item" data-section="beliefs">
                <span class="side-nav__num">04</span>
                <span class="side-nav__label">WHAT WE BELIEVE</span>
              </li>
              <li class="side-nav__item" data-section="leadership">
                <span class="side-nav__num">05</span>
                <span class="side-nav__label">LEADERSHIP</span>
              </li>
            </ul>
          </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="editorial-content">
          
          <!-- SECTION 1: HISTORY -->
          <section id="history" class="ed-section ed-section--story">
            <div class="section-label">01 / OUR ORIGINS</div>
            <h2 class="ed-title">Church <span class="text-green">History</span></h2>
            <div class="ed-text" style="font-size: 1.1rem;">
              <p><strong>LIVING FAITH FOUNDATION:</strong> The origin of the Living Faith Foundation dates back to 1981/82, when a young Civil Engineer, by the name of Prince Joseph Adeolu Olaiya was posted to the old Sokoto State for the mandatory one-year National Youth Service Corp (NYSC). Driven by a passion for lost souls, he believed that the only mission of the church was to WIN souls, demonstrated through crusades organized under the Christian Corpers Fellowship.</p>
              <p>God wanted him to stay back by the reason of a broader vision which gave birth to Weekly teachings and Prayer sessions that metamorphosed into the Living Faith Foundation today. As President and Founder, Rev. PJA Olaiya has been called to RAISE men who in turn, go out to do the supernatural for the enlargement and establishment of God’s Kingdom.</p>
              <p>With over 40 years of experience in the deliverance ministry, Rev. PJA Olaiya developed a special program called <em>Sorting Out</em>, aimed at helping people out of their difficulties by identifying trends and cycles about their lives and bringing total deliverance. He is happily married to Pastor Mrs. Florence Joy Adeolu Olaiya. The Living Faith Foundation now has over 100 branches in Nigeria and overseas.</p>
              
              <h3 style="font-size: 1.5rem; margin-top: 40px; margin-bottom: 20px; color: #1a1a1a;">The Ambassadors’ Assembly</h3>
              <p>The Ambassadors’ Assembly Lagos, is a District Headquarter church of the Living Faith Foundation. It is the ZOA International Bible School first Lagos cohort class (2008/2009) project. It was a mandate and prerequisite for graduation to plant a new church in fulfillment of Mark 16:15.</p>
              <p>The name came from 2 Corinthians 5:20 <em>“Therefore, we are Ambassadors for Christ.”</em> The church moved from LCCI to Prestige Events Centre in Alausa, then to Martinos Event Centre, and now stands at its permanent site as God continues to expand the ministry.</p>
            </div>
          </section>

          <!-- SECTION 2: VISION & MISSION -->
          <section id="vision" class="ed-section">
            <div class="section-label">02 / OUR PURPOSE</div>
            <h2 class="ed-title">Vision & <span class="text-green">Mission</span></h2>
            <div class="ed-text">
              <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--aa-green);">Vision Statement</h3>
              <p style="margin-bottom: 40px;">A church committed to raising men for the ever-increasing Kingdom work, transforming lives and reforming homes with sound biblical teaching and problem solving. To raise kingdom Ambassadors who live victoriously, influence their world, and manifest the life and power of Christ in every sphere.</p>
              
              <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--aa-green);">Mission Statement</h3>
              <p>As a church, the mission is in line with the Mission of the Living Faith Foundation, which is summarized as the <strong>3R’s: REACH, RAISE AND RULE</strong>.</p>
              <ul style="list-style: none; padding: 0; margin-top: 20px;">
                <li style="margin-bottom: 15px;"><strong>Reach:</strong> Reach the world in the power of the Holy Spirit.</li>
                <li style="margin-bottom: 15px;"><strong>Raise:</strong> Raise the men that are won to reach the world.</li>
                <li><strong>Rule:</strong> Rule the world by empowering those that are won.</li>
              </ul>
            </div>
          </section>

          <!-- SECTION 3: CORE VALUES & CULTURE -->
          <section id="values" class="ed-section">
            <div class="section-label">03 / OUR DNA</div>
            <h2 class="ed-title">Core Values & <span class="text-green">Culture</span></h2>
            
            <div class="dna-list">
              <div class="dna-item gsap-dna">
                <span class="dna-label">WORD-BASED LIVING</span>
                <p>The Bible is our firm foundation and ultimate guide.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">FAITH & DOMINION</span>
                <p>We live above limitations and walk in spiritual authority.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">LOVE & UNITY</span>
                <p>We build strong relationships and authentic community.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">EXCELLENCE</span>
                <p>We serve God with our absolute best in all we do.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">SERVICE</span>
                <p>We are deeply committed to impacting lives and society.</p>
              </div>
            </div>

            <div class="ed-text" style="margin-top: 50px;">
              <h3 style="font-size: 1.5rem; margin-bottom: 15px; color: var(--aa-green);">Church Culture and Community Focus</h3>
              <p>We are a warm, welcoming, and purpose-driven community where people grow spiritually, discover purpose, and build meaningful relationships. We emphasize practical Christianity, living out God’s Word daily.</p>
            </div>
          </section>

          <!-- SECTION 4: BELIEFS -->
          <section id="beliefs" class="ed-section">
            <div class="section-label">04 / STATEMENT OF FAITH</div>
            <h2 class="ed-title">What We <span class="text-green">Believe</span></h2>
            <div class="ed-text">
              <ul style="list-style: disc; padding-left: 20px; line-height: 2;">
                <li>The Bible is the inspired Word of God.</li>
                <li>There is one God expressed in the Father, Son, and Holy Spirit.</li>
                <li>Salvation is through Jesus Christ alone.</li>
                <li>The Holy Spirit empowers believers for victorious living.</li>
                <li>The Church is called to disciple nations and transform lives.</li>
                <li>Jesus Christ is coming again.</li>
              </ul>
            </div>
          </section>

          <!-- SECTION 5: LEADERSHIP -->
          <section id="leadership" class="ed-section ed-section--leadership">
            <div class="section-label">05 / STEWARDSHIP</div>
            <h2 class="ed-title">Led by <span class="text-green">Divine Intent</span></h2>
            <div class="ed-text">
              <p>Our leadership is defined by servitude and a relentless pursuit of spiritual depth. Led by our Presiding Pastors and a college of consecrated ministers.</p>
            </div>
            
            <div class="leadership-grid">
              <% (staff || []).filter(s => (s.department === 'Pastoral' || s.department === 'Leadership' || s.role?.includes('Pastor'))).forEach(member => { %>
                <div class="leader-card glass-fx">
                  <div class="leader-img">
                    <% 
                      let avatarUrl = member.avatar_url;
                      if (avatarUrl && avatarUrl.includes('cloudinary.com')) {
                        avatarUrl = avatarUrl.replace('/upload/', '/upload/f_auto,q_auto,w_500,c_fill,g_face/');
                      }
                      const fullName = (member.first_name || '') + ' ' + (member.last_name || '');
                      const fallback = `https://ui-avatars.com/api/?name=${member.first_name || 'AA'}+${member.last_name || ''}&background=134E5E&color=fff`;
                    %>
                    <img src="<%= avatarUrl %>" alt="<%= fullName %>" loading="lazy" onerror="this.src='<%= fallback %>'">
                  </div>
                  <div class="leader-info">
                    <h3><%= (member.first_name || '') + ' ' + (member.last_name || '') %></h3>
                    <p><%= member.role %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </section>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>

  <style>
    :root {
      --aa-green: rgba(113, 178, 128, 1);
      --aa-green-glow: rgba(113, 178, 128, 0.2);
    }

    body.dmRoot { background: var(--color_1); color: #1a1a1a; }

    .text-green { color: var(--aa-green); }

    /* OVERHAULED HERO STYLE */
    .about-hero {
      position: relative;
      height: 100vh;
      width: 100%;
      display: flex;
      align-items: flex-end; /* Text moved lower */
      justify-content: flex-start;
      padding-bottom: 12vh;
      padding-left: 8%;
      overflow: hidden;
    }

    .about-hero__bg {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      z-index: 1;
    }
    .about-hero__img {
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.6;
      transform: scale(1.1);
    }
    .about-hero__overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(to top, var(--color_1) 0%, rgba(245, 240, 232, 0.4) 40%, transparent 100%);
      z-index: 2;
    }

    .about-hero__content {
      position: relative;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end; /* High IQ: Anchoring text low for cinematic feel */
      padding: 0 8% 12vh 8%;
      color: #1a1a1a;
      z-index: 10;
      width: 100%;
    }

    /* EDITORIAL SPACING */
    .editorial-container {
      position: relative;
      display: flex;
      background: var(--color_1);
      padding: 0 8%;
      z-index: 20;
      margin-top: 15vh; /* Large breathe room */
      padding-top: 150px;
    }

    .side-nav {
      position: sticky; top: 20vh; width: 220px; height: fit-content;
      padding-right: 30px;
    }
    .side-nav__inner { position: relative; padding-left: 20px; }
    .side-nav__line {
      position: absolute; left: 0; top: 0; width: 1px; height: 100%;
      background: rgba(26,26,26,0.1);
    }
    .side-nav__progress {
      position: absolute; left: -1px; top: 0; width: 3px; height: 0%;
      background: var(--aa-green);
      box-shadow: 0 0 15px var(--aa-green-glow);
    }
    .side-nav__item {
      margin-bottom: 50px; cursor: pointer; opacity: 0.4;
      transition: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .side-nav__item.active { opacity: 1; color: #1a1a1a; }
    .side-nav__num { font-size: 0.7rem; font-weight: 900; color: var(--aa-green); margin-bottom: 8px; display: block; }
    .side-nav__label { font-size: 0.85rem; font-weight: 800; letter-spacing: 2px; }

    .editorial-content { flex: 1; max-width: 800px; margin-left: 60px; }
    .ed-section { padding-bottom: 200px; }
    .section-label { font-size: 0.7rem; font-weight: 900; opacity: 0.2; letter-spacing: 5px; margin-bottom: 30px; }
    .ed-title { font-size: clamp(2.5rem, 6vw, 5rem); line-height: 0.95; margin-bottom: 50px; letter-spacing: -0.04em; color: #1a1a1a; }
    .ed-text { font-size: 1.3rem; color: rgba(26,26,26,0.7); line-height: 1.7; }
    .ed-image-wrap { margin-top: 80px; border-radius: 40px; overflow: hidden; }

    /* LEADERSHIP GRID (PREMIUM) */
    .leadership-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); /* Forced 2-column as requested */
      gap: 40px; margin-top: 80px;
    }
    .leader-card {
      padding: 0; border-radius: 35px; overflow: hidden;
      background: #ffffff;
      border: 1.5px solid rgba(26,26,26,0.1);
      transition: 0.5s transform cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .leader-card:hover { transform: translateY(-10px); background: #ffffff; box-shadow: 0 20px 40px rgba(0,0,0,0.08); }
    .leader-img { width: 100%; aspect-ratio: 0.85; overflow: hidden; }
    .leader-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); transition: 1s cubic-bezier(0.16, 1, 0.3, 1); }
    .leader-card:hover .leader-img img { filter: grayscale(0%); scale: 1.05; }
    .leader-info { padding: 30px; text-align: left; }
    .leader-info h3 { font-size: 1.4rem; font-weight: 700; margin-bottom: 8px; color: #1a1a1a; }
    .leader-info p { font-size: 0.7rem; font-weight: 900; letter-spacing: 2px; color: var(--aa-green); text-transform: uppercase; }

    .dna-list { border-top: 1.5px solid rgba(26,26,26,0.1); }
    .dna-item { padding: 60px 0; border-bottom: 1.5px solid rgba(26,26,26,0.1); }
    .dna-label { font-size: 0.7rem; font-weight: 900; color: var(--aa-green); letter-spacing: 3px; margin-bottom: 15px; display: block; }
    .dna-item p { font-size: 1.8rem; font-weight: 600; line-height: 1.2; color: #1a1a1a; }

    @media (max-width: 1100px) {
      .editorial-container { flex-direction: column; padding: 0 6%; }
      .editorial-content { margin-left: 0; margin-top: 80px; }
      .side-nav { position: relative; top: 0; width: 100%; padding: 0; margin-bottom: 60px; }
      .side-nav__list { display: flex; gap: 30px; overflow-x: auto; padding-bottom: 20px; }
      .side-nav__num { margin-bottom: 4px; }
      .side-nav__line {
        position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
        background: rgba(26,26,26,0.1);
        display: block; top: auto;
      }
      .side-nav__progress {
        position: absolute; left: 0; bottom: 0; width: 0%; height: 2px;
        background: var(--aa-green);
        display: block; top: auto;
      }
      .about-hero { padding-left: 6%; }
    }

    /* MOVED WHO WE ARE STYLES */
    .about-section-moved {
      position: relative;
      padding: 60px 0;
      overflow: hidden;
    }
    .about-section__inner-moved {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .about-card-moved {
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background: #2a2a2a;
    }
    .about-card__img-moved {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: 0.85;
    }
    .about-card__overlay-moved {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 40px 30px;
      background: linear-gradient(to top, rgba(20, 20, 20, 0.95) 0%, transparent 100%);
    }
    .about-card__badge-moved {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(26, 26, 26, 0.12);
      border: 1px solid rgba(26, 26, 26, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }
    .about-card__badge-moved svg {
      width: 24px;
      height: 24px;
      color: #fff;
    }
    .about-card__name-moved {
      font-family: 'Outfit', sans-serif;
      font-size: 1.6rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
    }
    .about-content-moved {
      padding: 20px 0;
    }
    .about-content__title-moved {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(2rem, 3.5vw, 2.8rem);
      font-weight: 900;
      color: #1a1a1a;
      line-height: 1.1;
      margin-bottom: 24px;
    }
    .about-content__subtitle-moved {
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      font-weight: 500;
      color: rgba(26, 26, 26, 0.65);
      margin-bottom: 20px;
      line-height: 1.6;
    }
    .about-content__desc-moved {
      font-family: 'Inter', sans-serif;
      font-size: 0.92rem;
      font-weight: 400;
      color: rgba(26, 26, 26, 0.5);
      line-height: 1.75;
      margin-bottom: 36px;
    }

    @media (max-width: 768px) {
      .about-section__inner-moved { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script>
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener('load', () => {
      // 1. HERO ANIMATION
      const heroTl = gsap.timeline();
      heroTl.from(".about-hero__img", { scale: 1.3, duration: 2, ease: "power2.out" })
            .from(".gsap-hero-reveal", { y: 60, opacity: 0, stagger: 0.15, duration: 1.2, ease: "power4.out" }, "-=1.5");

      // PARALLAX HERO
      gsap.to(".about-hero__img", {
        scrollTrigger: {
          trigger: ".about-hero",
          start: "top top",
          end: "bottom top",
          scrub: true
        },
        y: 100,
        opacity: 0.3
      });

      // 2. SIDE NAV PROGRESS
      gsap.to("#nav-progress", {
        scrollTrigger: {
          trigger: ".editorial-container",
          start: "top 20%",
          end: "bottom 80%",
          scrub: true
        },
        height: window.innerWidth > 1100 ? "100%" : "2px",
        width: window.innerWidth > 1100 ? "3px" : "100%"
      });

      // 3. SECTION SPY
      const sections = ['history', 'vision', 'values', 'beliefs', 'leadership'];
      sections.forEach(id => {
        ScrollTrigger.create({
          trigger: `#${id}`,
          start: "top 40%",
          onEnter: () => updateActiveNav(id),
          onEnterBack: () => updateActiveNav(id)
        });
      });

      function updateActiveNav(id) {
        document.querySelectorAll('.side-nav__item').forEach(el => {
          el.classList.remove('active');
          if (el.dataset.section === id) el.classList.add('active');
        });
      }

      // 4. BATCH LOAD LEADERS
      ScrollTrigger.batch(".leader-card", {
        onEnter: batch => gsap.from(batch, { y: 50, opacity: 0, stagger: 0.15, duration: 0.8, ease: "power3.out" }),
        once: true
      });

      // 5. DNA ANIMATIONS
      gsap.from(".gsap-dna", {
        scrollTrigger: {
          trigger: "#dna",
          start: "top 60%"
        },
        y: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power2.out"
      });
    });
  </script>
</body>
</html>
