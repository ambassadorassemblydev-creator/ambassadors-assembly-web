<%- include('../partials/head') %>
<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main>
      <!-- REVELATION HERO (CINEMATIC) -->
      <section class="rev-hero" id="rev-hero">
        <div class="rev-hero__bg">
          <div class="rev-hero__overlay"></div>
          <img src="https://images.unsplash.com/photo-1438032005730-c779502df39b?q=80&w=2671&auto=format&fit=crop" alt="Sanctuary" class="rev-hero__img">
        </div>
        <div class="rev-hero__content">
          <h1 class="rev-hero__title" id="rev-text">ABOUT US</h1>
          <div class="rev-hero__bottom">
            <span class="rev-hero__scroll-indicator">Scroll to Explore</span>
          </div>
        </div>
      </section>

      <!-- EDITORIAL LAYOUT WITH SIDE-NAV -->
      <div class="editorial-container">
        
        <!-- STICKY SIDE-NAV -->
        <aside class="side-nav" id="side-nav">
          <div class="side-nav__inner">
            <div class="side-nav__line">
              <div class="side-nav__progress" id="nav-progress"></div>
            </div>
            <ul class="side-nav__list">
              <li class="side-nav__item active" data-section="story">
                <span class="side-nav__num">01</span>
                <span class="side-nav__label">OUR STORY</span>
              </li>
              <li class="side-nav__item" data-section="leadership">
                <span class="side-nav__num">02</span>
                <span class="side-nav__label">LEADERSHIP</span>
              </li>
              <li class="side-nav__item" data-section="dna">
                <span class="side-nav__num">03</span>
                <span class="side-nav__label">OUR DNA</span>
              </li>
            </ul>
          </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="editorial-content">
          
          <!-- SECTION 1: STORY -->
          <section id="story" class="ed-section ed-section--story">
            <div class="section-label">01 / REVELATION</div>
            <h2 class="ed-title">A Vision Born in <span class="text-green">Excellence</span></h2>
            <div class="ed-text">
              <p>In the heart of a generation seeking truth, Ambassadors Assembly emerged as a lighthouse of consecration. What began as a gathering of few has evolved into a global movement of kingdom ambassadors, committed to manifesting the glory of God in every sphere of human endeavor.</p>
              <p>We are not just a church; we are a specialized training ground for kings and priests, commissioned to restore the authentic image of Christ to a world in transition.</p>
            </div>
            <div class="ed-image-wrap">
              <img src="https://images.unsplash.com/photo-1544427928-c49cdfebf4ad?q=80&w=2000" alt="Church Gathering">
            </div>
          </section>

          <!-- SECTION 2: LEADERSHIP -->
          <section id="leadership" class="ed-section ed-section--leadership">
            <div class="section-label">02 / STEWARDSHIP</div>
            <h2 class="ed-title">Led by <span class="text-green">Divine Intent</span></h2>
            <div class="ed-text">
              <p>Our leadership is defined by servitude and a relentless pursuit of spiritual depth. Led by the Presiding Pastor and a college of consecrated ministers, we ensure that every soul is nurtured, every gift is activated, and every ambassador is deployed for purpose.</p>
            </div>
            
            <div class="leadership-grid">
              <% staff.filter(s => s.department === 'Pastoral' || s.department === 'Leadership').forEach(member => { %>
                <div class="leader-card glass-fx">
                  <div class="leader-img">
                    <img src="<%= member.avatar_url %>" alt="<%= member.first_name %>">
                  </div>
                  <div class="leader-info">
                    <h3><%= member.first_name %> <%= member.last_name %></h3>
                    <p><%= member.role %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </section>
<style>
  /* STRIP DUDA'S WHITE BACKGROUNDS & PADDING */
                    body.dmRoot, #dm, .dm_wrapper, .dmOuter, .dmInner, #site_content, .dmBody, #allWrapper, #dm_content, #dmFlexHeaderContainer, #flex-header {
                      background-color: transparent !important;
                      background-image: none !important;
                    }
                    #dmFlexHeaderContainer {
                      position: absolute !important;
                      top: 0; left: 0; width: 100%; z-index: 1000 !important;
                    }
                    #dmFirstContainer, #allWrapper, #dm_content {
                      margin: 0 !important; padding: 0 !important;
                    }
</style>
          <!-- SECTION 3: DNA -->
          <section id="dna" class="ed-section ed-section--dna">
            <div class="section-label">03 / ESSENCE</div>
            <h2 class="ed-title">Our <span class="text-green">Holy DNA</span></h2>
            
            <div class="dna-list">
              <div class="dna-item gsap-dna">
                <span class="dna-label">01 / CONSECRATION</span>
                <p>We live life as a sacred offering, separated unto God for His specific use.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">02 / EXCELLENCE</span>
                <p>We believe if it is for the King, it must be world-class. No mediocrity.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">03 / AMBASSADORSHIP</span>
                <p>We represent the interest of a foreign government—Heaven—here on earth.</p>
              </div>
              <div class="dna-item gsap-dna">
                <span class="dna-label">04 / REVELATION</span>
                <p>We do not operate by human wisdom, but by the proceeding word of God.</p>
              </div>
            </div>
          </section>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>

  <style>
    /* BRAND COLORS */
    :root {
      --aa-green: #15803d;
      --aa-green-glow: rgba(34, 197, 94, 0.4);
      --aa-bg: #050505;
    }

    .text-green { color: var(--aa-green); }

    /* REVELATION HERO */
    .rev-hero {
      position: relative;
      height: 100vh;
      width: 100%;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--aa-bg);
      z-index: 10;
    }

    .rev-hero__bg {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      transform: scale(1.1);
    }
    .rev-hero__img { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; filter: blur(10px); }
    .rev-hero__overlay {
      position: absolute; top:0; left:0; width:100%; height:100%;
      background: linear-gradient(to bottom, transparent 60%, var(--aa-bg) 100%);
      z-index: 1;
    }

    .rev-hero__content { position: relative; z-index: 2; text-align: center; }
    .rev-hero__title {
      font-size: clamp(4rem, 15vw, 15rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 0.8;
      color: white;
      margin: 0;
      pointer-events: none;
    }

    .rev-hero__bottom {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      opacity: 0.5;
    }
    .rev-hero__scroll-indicator { font-size: 0.7rem; letter-spacing: 4px; text-transform: uppercase; font-weight: 800; }

    /* EDITORIAL LAYOUT */
    .editorial-container {
      position: relative;
      display: flex;
      background: var(--aa-bg);
      padding: 0 6%;
      z-index: 20; /* Slides over hero */
      margin-top: -20vh; /* Start reveal early */
      padding-top: 100px;
    }

    /* SIDE NAV */
    .side-nav {
      position: sticky;
      top: 15vh;
      width: 250px;
      height: fit-content;
      padding-right: 40px;
    }
    .side-nav__inner { position: relative; padding-left: 20px; }
    .side-nav__line {
      position: absolute; left: 0; top: 0; width: 1px; height: 100%;
      background: rgba(255,255,255,0.1);
    }
    .side-nav__progress {
      position: absolute; left: -1px; top: 0; width: 3px; height: 0%;
      background: var(--aa-green);
      box-shadow: 0 0 10px var(--aa-green-glow);
    }
    .side-nav__list { list-style: none; padding: 0; margin: 0; }
    .side-nav__item {
      margin-bottom: 40px;
      cursor: pointer;
      opacity: 0.3;
      transition: 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex; flex-direction: column;
    }
    .side-nav__item.active { opacity: 1; }
    .side-nav__num { font-size: 0.7rem; font-weight: 900; color: var(--aa-green); margin-bottom: 5px; }
    .side-nav__label { font-size: 0.85rem; font-weight: 800; letter-spacing: 2px; }

    /* MAIN CONTENT */
    .editorial-content { flex: 1; max-width: 900px; }
    .ed-section { padding-bottom: 150px; }
    .section-label { font-size: 0.75rem; font-weight: 800; opacity: 0.3; letter-spacing: 4px; margin-bottom: 20px; }
    .ed-title { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1; margin-bottom: 40px; letter-spacing: -0.04em; }
    .ed-text { font-size: 1.25rem; color: rgba(255,255,255,0.6); line-height: 1.6; max-width: 700px; }
    .ed-text p { margin-bottom: 30px; }

    .ed-image-wrap { margin-top: 60px; border-radius: 40px; overflow: hidden; height: 500px; }
    .ed-image-wrap img { width: 100%; height: 100%; object-fit: cover; }

    /* LEADERSHIP */
    .leadership-grid { margin-top: 60px; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 30px; }
    .leader-card { padding: 30px; border-radius: 30px; }
    .leader-img { width: 100%; aspect-ratio: 1; border-radius: 20px; overflow: hidden; margin-bottom: 20px; }
    .leader-img img { width: 100%; height: 100%; object-fit: cover; transition: 1s; }
    .leader-card:hover .leader-img img { transform: scale(1.05); }
    .leader-info h3 { font-size: 1.2rem; margin-bottom: 5px; }
    .leader-info p { font-size: 0.75rem; font-weight: 800; color: var(--aa-green); text-transform: uppercase; letter-spacing: 1px; }

    /* DNA */
    .dna-list { margin-top: 60px; }
    .dna-item { padding: 40px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .dna-label { display: block; font-size: 0.7rem; font-weight: 900; color: var(--aa-green); margin-bottom: 10px; }
    .dna-item p { font-size: 1.5rem; font-weight: 500; }

    .glass-fx { background: rgba(255,255,255,0.02); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.05); }

    @media (max-width: 1000px) {
      .editorial-container { flex-direction: column; }
      .side-nav { position: relative; top: 0; width: 100%; margin-bottom: 60px; padding: 0; }
      .side-nav__list { display: flex; gap: 20px; overflow-x: auto; padding-bottom: 20px; }
      .side-nav__item { margin-bottom: 0; min-width: 150px; }
      .side-nav__line { display: none; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script>
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener('load', () => {
      // 1. REVELATION SCROLL EFFECT
      gsap.to("#rev-text", {
        scrollTrigger: {
          trigger: "#rev-hero",
          start: "top top",
          end: "bottom top",
          scrub: true,
          pin: true
        },
        y: 200,
        opacity: 0,
        scale: 0.8,
        filter: "blur(20px)"
      });

      // 2. SIDE NAV PROGRESS
      gsap.to("#nav-progress", {
        scrollTrigger: {
          trigger: ".editorial-content",
          start: "top 20%",
          end: "bottom 80%",
          scrub: true
        },
        height: "100%"
      });

      // 3. SECTION SPY
      const sections = ['story', 'leadership', 'dna'];
      sections.forEach(id => {
        ScrollTrigger.create({
          trigger: `#${id}`,
          start: "top 40%",
          onEnter: () => updateActiveNav(id),
          onEnterBack: () => updateActiveNav(id)
        });
      });

      function updateActiveNav(id) {
        document.querySelectorAll('.side-nav__item').forEach(el => {
          el.classList.remove('active');
          if (el.dataset.section === id) el.classList.add('active');
        });
      }

      // 4. DNA ANIMATIONS (ACCELERATED)
      gsap.from(".gsap-dna", {
        scrollTrigger: {
          trigger: "#dna",
          start: "top 60%"
        },
        y: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power2.out"
      });
    });
  </script>
</body>
</html>