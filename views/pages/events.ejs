<%- include('../partials/head') %>
<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main class="aa-ev-main">
      <!-- CINEMATIC HERO -->
      <section class="aa-ev-hero">
        <div class="aa-ev-hero__bg">
          <div class="aa-ev-hero__overlay"></div>
          <img src="https://images.unsplash.com/photo-1511795409834-432f7b1728d2?q=80&w=2671&auto=format&fit=crop" alt="Gathering" class="aa-ev-hero__img" style="opacity: 0.6;">
        </div>
        <div class="aa-ev-hero__content">
          <span class="aa-ev-hero__sub">THE GATHERING ARCHIVE</span>
          <h1 class="aa-ev-hero__title">Sacred <br><span style="color: #22c55e;">Encounters</span></h1>
          <p class="aa-ev-hero__text">Join us for high-impact gatherings designed to shift atmospheres and transform lives.</p>
        </div>
      </section>

      <!-- DYNAMIC ARCHIVE GRID -->
      <section class="aa-ev-archive">
        <div class="aa-ev-container">
          
          <!-- FILTER HUD -->
          <div class="aa-ev-hud glass-fx">
            <div class="aa-ev-hud__label">FILTER BY CATEGORY</div>
            <div class="aa-ev-filters">
              <button class="aa-filter-btn active" data-filter="all">All Gatherings</button>
              <button class="aa-filter-btn" data-filter="Special">Special Events</button>
              <button class="aa-filter-btn" data-filter="Weekly">Weekly Service</button>
              <button class="aa-filter-btn" data-filter="Outreach">Community Outreach</button>
            </div>
          </div>

          <!-- GRID -->
          <div class="aa-ev-grid" id="events-grid">
            <% events.forEach((event, i) => { %>
              <div class="aa-ev-card gsap-ev-card" data-category="<%= event.category %>">
                <a href="/events/<%= event.slug %>" class="aa-ev-card__link">
                  <div class="aa-ev-card__img-wrap">
                    <img src="<%= event.cover_image_url && event.cover_image_url.trim() !== '' ? event.cover_image_url : 'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?q=80&w=1200&auto=format&fit=crop' %>" 
                         onerror="this.src='https://images.unsplash.com/photo-1438232992991-995b7058bbb3?q=80&w=1200&auto=format&fit=crop'"
                         alt="<%= event.title %>" class="aa-ev-card__img">
                    <div class="aa-ev-card__date-badge">
                      <span class="aa-ev-date-day"><%= new Date(event.start_date).getDate() %></span>
                      <span class="aa-ev-date-mon"><%= new Date(event.start_date).toLocaleString('default', { month: 'short' }).toUpperCase() %></span>
                    </div>
                  </div>
                  <div class="aa-ev-card__info">
                    <span class="aa-ev-card__tag text-green"><%= event.category %></span>
                    <h3 class="aa-ev-card__title"><%= event.title %></h3>
                    <div class="aa-ev-card__meta">
                      <span class="aa-ev-meta-item">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                        <%= event.location %>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>

        </div>
      </section>
    </main>

    <%- include('../partials/footer') %>
  

  <style>
    :root {
      --aa-green: rgba(113, 178, 128, 1);
      --aa-bg: var(--color_1);
    }
    .text-green { color: var(--aa-green); }

    .aa-ev-main { background: var(--color_1); min-height: 100vh; color: #1a1a1a; }

    /* HERO */
    .aa-ev-hero { position: relative; height: 70vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .aa-ev-hero__bg { position: absolute; top:0; left:0; width:100%; height:100%; z-index: 1; }
    .aa-ev-hero__img { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; }
    .aa-ev-hero__overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, transparent, var(--color_1)); z-index: 2; }
    
    .aa-ev-hero__content { position: relative; z-index: 3; text-align: center; max-width: 800px; padding: 0 6%; }
    .aa-ev-hero__sub { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: 5px; opacity: 0.5; margin-bottom: 20px; }
    .aa-ev-hero__title { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.9; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 30px; color: #1a1a1a; }
    .aa-ev-hero__text { font-size: 1.25rem; color: rgba(26,26,26,0.6); }

    /* ARCHIVE */
    .aa-ev-archive { padding: 60px 0 150px; }
    .aa-ev-container { max-width: 1400px; margin: 0 auto; padding: 0 6%; }

    /* HUD */
    .aa-ev-hud { 
      padding: 30px; border-radius: 30px; margin-bottom: 60px; 
      display: flex; justify-content: space-between; align-items: center;
    }
    .aa-ev-hud__label { font-size: 0.7rem; font-weight: 900; letter-spacing: 2px; opacity: 0.4; }
    .aa-ev-filters { display: flex; gap: 10px; }
    .aa-filter-btn { 
      padding: 10px 20px; border-radius: 100px; border: none; background: transparent; 
      color: rgba(26,26,26,0.45); font-weight: 800; font-size: 0.8rem; cursor: pointer; transition: 0.3s;
    }
    .aa-filter-btn:hover { color: #1a1a1a; }
    .aa-filter-btn.active { background: var(--aa-green); color: white; }

    /* GRID */
    .aa-ev-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 40px; }
    
    .aa-ev-card { position: relative; border-radius: 40px; overflow: hidden; background: #ffffff; border: 1.5px solid rgba(26,26,26,0.08); transition: 0.5s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
    .aa-ev-card:hover { transform: translateY(-10px); background: #ffffff; box-shadow: 0 20px 40px rgba(0,0,0,0.08); }
    
    .aa-ev-card__link { display: block; text-decoration: none; color: inherit; }

    .aa-ev-card__img-wrap { position: relative; aspect-ratio: 16/10; overflow: hidden; }
    .aa-ev-card__img { width: 100%; height: 100%; object-fit: cover; transition: 1s; }
    .aa-ev-card:hover .aa-ev-card__img { transform: scale(1.05); }
    
    .aa-ev-card__date-badge { 
      position: absolute; top: 20px; left: 20px; width: 60px; height: 60px; 
      background: white; border-radius: 12px; display: flex; flex-direction: column; 
      align-items: center; justify-content: center; border: 1px solid rgba(0,0,0,0.1);
    }
    .aa-ev-date-day { font-size: 1.4rem; font-weight: 900; color: #1a1a1a; line-height: 1; }
    .aa-ev-date-mon { font-size: 0.6rem; font-weight: 900; color: var(--aa-green); }

    .aa-ev-card__info { padding: 30px; color: #1a1a1a; }
    .aa-ev-card__tag { font-size: 0.7rem; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; display: block; }
    .aa-ev-card__title { font-size: 1.6rem; line-height: 1.2; font-weight: 800; margin-bottom: 15px; color: #1a1a1a; }
    .aa-ev-card__meta { display: flex; gap: 20px; font-size: 0.85rem; color: rgba(26,26,26,0.4); font-weight: 500; }
    .aa-ev-meta-item { display: flex; align-items: center; gap: 6px; }

    .glass-fx { background: #ffffff; border: 1.5px solid rgba(26,26,26,0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.03); }

    @media (max-width: 1000px) {
      .aa-ev-hud { flex-direction: column; gap: 20px; align-items: flex-start; }
      .aa-ev-filters { width: 100%; overflow-x: auto; padding-bottom: 10px; }
      .aa-ev-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
      .aa-ev-card__info { padding: 15px; }
      .aa-ev-card__title { font-size: 1.1rem; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script>
    const initEventsGsap = () => {
      // Entrance
      gsap.fromTo(".aa-ev-hero__content > *", 
        { y: 50, opacity: 0 }, 
        { y: 0, opacity: 1, duration: 1, stagger: 0.2, ease: "power3.out" }
      );
      gsap.fromTo(".gsap-ev-card", 
        { scale: 0.9, opacity: 0 }, 
        { scale: 1, opacity: 1, duration: 0.6, stagger: 0.05, delay: 0.5 }
      );
      
      // Filter Logic
      const buttons = document.querySelectorAll('.aa-filter-btn');
      const cards = document.querySelectorAll('.aa-ev-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const filter = btn.dataset.filter;

          gsap.to(cards, { scale: 0.9, opacity: 0, duration: 0.3, onComplete: () => {
            cards.forEach(card => {
              if (filter === 'all' || card.dataset.category === filter) {
                card.style.display = 'block';
              } else {
                card.style.display = 'none';
              }
            });
            gsap.to(cards, { scale: 1, opacity: 1, duration: 0.5, stagger: 0.05 });
          }});
        });
      });
    };

    if (document.readyState === 'complete') {
      initEventsGsap();
    } else {
      window.addEventListener('load', initEventsGsap);
    }
  </script>
</body>
</html>