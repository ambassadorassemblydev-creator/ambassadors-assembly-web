<%- include('../partials/head') %>

<link rel="stylesheet" href="/css/events-page.css">

<body id="dmRoot" data-page-alias="events" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite events-page hasStickyHeader"
  style="background: #080808; margin: 0; padding: 0;">
  <%- include('../partials/preloader') %>

  <!-- Duda wrappers needed for sticky header + social icon CSS -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper">
      <div class="dmOuter">
        <div class="dmInner">
          <div id="dm-outer-wrapper" class="runtime-module-container dm-bfs dm-layout-home hasStickyHeader inMiniHeaderMode dmDHeader" data-soch="true">
            <div id="site_content">

  <%- include('../partials/navbar') %>

  <!-- MAIN WRAPPER -->
  <main class="events-main-content">
    
    <!-- HERO SECTION -->
    <header class="events-hero">
      <div class="events-hero__inner">
        <span class="events-hero__label">Upcoming Moments</span>
        <h1 class="events-hero__title">Events</h1>
        
        <!-- Filters -->
        <div class="events-filters">
          <button class="filter-pill active" data-filter="all">All Events</button>
          <% 
            const types = [...new Set(events.map(e => e.event_type))];
            types.forEach(type => { 
          %>
            <button class="filter-pill" data-filter="<%= type %>"><%= type.charAt(0).toUpperCase() + type.slice(1) %></button>
          <% }) %>
        </div>
      </div>
    </header>

    <!-- FEATURED "NEXT UP" SECTION -->
    <% if (events.length > 0) { 
        const nextUp = events[0];
    %>
    <section class="featured-event">
      <div class="featured-event__card animate-on-scroll">
        <div class="featured-event__bg">
          <img src="<%= nextUp.cover_image_url %>" alt="<%= nextUp.title %>">
        </div>
        <div class="featured-event__content">
          <span class="featured-event__badge">Next Up</span>
          <h2 class="featured-event__title"><%= nextUp.title %></h2>
          
          <div class="featured-event__info">
            <div class="info-item">
              <span class="info-item__label">Date</span>
              <span class="info-item__value">
                <%= new Date(nextUp.start_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              </span>
            </div>
            <div class="info-item">
              <span class="info-item__label">Location</span>
              <span class="info-item__value"><%= nextUp.location_name || 'Ambassadors Assembly' %></span>
            </div>
          </div>

          <a href="/events/<%= nextUp.slug %>" class="glass-button">Register Now</a>
        </div>
      </div>
    </section>
    <% } %>

    <!-- GRID SECTION -->
    <section class="events-grid-section">
      <div class="events-grid">
        <% events.forEach((evt, i) => { %>
          <div class="event-card-standard animate-on-scroll" data-type="<%= evt.event_type %>">
            <div class="event-card-standard__img">
              <img src="<%= evt.cover_image_url %>" alt="<%= evt.title %>" loading="lazy">
            </div>
            <div class="event-card-standard__content">
              <span class="event-card-standard__tag"><%= evt.event_type %></span>
              <h3 class="event-card-standard__title"><%= evt.title %></h3>
              
              <div class="event-card-standard__meta">
                <span class="meta-date">
                  <%= new Date(evt.start_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %>
                </span>
                <a href="/events/<%= evt.slug %>" class="meta-link">View Event →</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- PARABOLIC SCATTERED CARDS SECTION -->
    <section class="parabolic-section">
      <div class="parabolic-header animate-on-scroll">
        <span class="events-hero__label">Be Part of the Community</span>
        <h2 class="section-title" style="text-align: center;">Experience Assembly</h2>
      </div>

      <div class="parabolic-cards-wrap">
        <% 
          // Use a mix of upcoming events for the fan
          const fanEvents = events.slice(0, 7);
          fanEvents.forEach((evt, i) => { 
            const offsets = [
              { x: "-240%", y: "40%", r: -15, s: -40 },
              { x: "-160%", y: "20%", r: -10, s: -25 },
              { x: "-80%", y: "5%", r: -5, s: -12 },
              { x: "0", y: "0", r: 0, s: 0 },
              { x: "80%", y: "5%", r: 5, s: 12 },
              { x: "160%", y: "20%", r: 10, s: 25 },
              { x: "240%", y: "40%", r: 15, s: 40 }
            ];
            const pos = offsets[i] || offsets[3];
        %>
          <div class="parabolic-card" 
               data-x="<%= pos.x %>" 
               data-y="<%= pos.y %>" 
               data-rotate="<%= pos.r %>" 
               data-start="<%= pos.s %>">
            <img src="<%= evt.cover_image_url %>" alt="<%= evt.title %>">
            <div class="parabolic-card__info">
              <h4 style="margin: 0; font-size: 0.9rem;"><%= evt.title %></h4>
              <p style="margin: 5px 0 0; font-size: 0.7rem; color: #b89f7a;"><%= new Date(evt.start_date).toDateString() %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>

            </div><!-- /#site_content -->
          </div><!-- /#dm-outer-wrapper -->
        </div><!-- /.dmInner -->
      </div><!-- /.dmOuter -->
    </div><!-- /.dm_wrapper -->
  </div><!-- /#dm -->

  <!-- Load GreenSock and specific JS for this page -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script src="/js/events-page.js"></script>
</body>
