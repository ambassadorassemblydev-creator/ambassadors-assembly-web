<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="events-grid-page" class="dm-events-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200" id="dm-outer-wrapper">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

                  <%- include('../partials/navbar') %>

                  <style>
                    :root {
                      --accent: #f5f0e8;
                      --accent-muted: rgba(245, 240, 232, 0.4);
                      --glass: rgba(255, 255, 255, 0.03);
                      --glass-border: rgba(255, 255, 255, 0.08);
                    }

                    .events-hero {
                      padding: 220px 6% 160px;
                      background: #050505;
                      position: relative;
                      overflow: hidden;
                    }

                    .give-bg { position: absolute; top:0; left:0; width:100%; height:100%; z-index: 1; pointer-events: none; }
                    .bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.3; filter: brightness(0.6) contrast(1.2); }
                    .bg-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, rgba(5,5,5,0.4) 0%, #050505 100%); }

                    .hero-content {
                      position: relative;
                      z-index: 2;
                      max-width: 1400px;
                      margin: 0 auto;
                    }

                    .hero-label {
                      font-family: 'Manrope', sans-serif;
                      font-size: 0.8rem;
                      font-weight: 700;
                      letter-spacing: 0.3em;
                      text-transform: uppercase;
                      color: var(--accent-muted);
                      margin-bottom: 20px;
                      display: block;
                    }

                    .hero-title {
                      font-family: 'Manrope', sans-serif;
                      font-size: clamp(3rem, 7vw, 6rem);
                      font-weight: 900;
                      line-height: 0.95;
                      letter-spacing: -0.04em;
                      color: var(--accent);
                    }

                    /* Timeline Grid */
                    .events-grid-section {
                      padding: 100px 6%;
                      background: #0e0e0e;
                      position: relative;
                    }

                    .events-grid-section::before {
                      content: '';
                      position: absolute;
                      top: 0; left: 50%; width: 1px; height: 100%;
                      background: linear-gradient(to bottom, var(--glass-border), transparent);
                      display: none; /* Only show on desktop if we want timeline feel */
                    }

                    .grid-container {
                      max-width: 1400px;
                      margin: 0 auto;
                      display: grid;
                      grid-template-columns: repeat(2, 1fr);
                      gap: 120px 80px; /* Increased gap to prevent overlap from staggering */
                    }

                    .event-item {
                      text-decoration: none;
                      display: block;
                      position: relative;
                    }

                    /* Parabolic Offset - Refined to prevent collisions */
                    .event-item:nth-child(even) { transform: translateY(120px); }

                    .event-card {
                      background: var(--glass);
                      backdrop-filter: blur(20px);
                      -webkit-backdrop-filter: blur(20px);
                      border: 1px solid var(--glass-border);
                      border-radius: 40px;
                      overflow: hidden;
                      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                    }

                    .event-item:hover .event-card {
                      transform: scale(1.02);
                      border-color: rgba(255,255,255,0.2);
                    }

                    .card-media {
                      position: relative;
                      width: 100%;
                      aspect-ratio: 4/3;
                      overflow: hidden;
                    }

                    .card-media img {
                      width: 100%;
                      height: 100%;
                      object-fit: cover;
                      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
                    }

                    .event-item:hover .card-media img {
                      transform: scale(1.1);
                    }

                    .card-content {
                      padding: 40px;
                    }

                    .event-date {
                      display: flex;
                      align-items: center;
                      gap: 12px;
                      margin-bottom: 20px;
                    }

                    .date-pill {
                      padding: 4px 12px;
                      background: var(--accent);
                      color: #0e0e0e;
                      border-radius: 6px;
                      font-size: 0.7rem;
                      font-weight: 800;
                      text-transform: uppercase;
                      letter-spacing: 0.5px;
                    }

                    .date-text {
                      font-family: 'Manrope', sans-serif;
                      font-size: 0.85rem;
                      font-weight: 600;
                      color: var(--accent-muted);
                    }

                    .event-title {
                      font-family: 'Manrope', sans-serif;
                      font-size: 1.8rem;
                      font-weight: 800;
                      color: var(--accent);
                      line-height: 1.2;
                      margin-bottom: 12px;
                    }

                    .event-loc {
                      font-size: 0.9rem;
                      color: rgba(245, 240, 232, 0.4);
                      display: flex;
                      align-items: center;
                      gap: 6px;
                    }

                    .event-loc svg { width: 14px; opacity: 0.6; }

                    @media (max-width: 1100px) {
                      .grid-container { gap: 60px 40px; }
                      .event-title { font-size: 1.5rem; }
                      .filters-container { flex-direction: column; align-items: stretch; gap: 20px; }
                      .search-box { max-width: none; }
                    }

                    /* FILTERS */
                    .filters-section { padding: 40px 6%; background: #0e0e0e; border-bottom: 1px solid var(--glass-border); position: sticky; top: 0; z-index: 90; backdrop-filter: blur(20px); }
                    .filters-container { max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
                    
                    .search-box { flex-grow: 1; max-width: 500px; position: relative; }
                    .search-input { width: 100%; background: var(--glass); border: 1px solid var(--glass-border); border-radius: 100px; padding: 15px 30px 15px 60px; color: white; font-family: inherit; font-size: 0.95rem; transition: 0.3s; }
                    .search-input:focus { border-color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.06); outline: none; }
                    .search-icon { position: absolute; left: 25px; top: 50%; transform: translateY(-50%); opacity: 0.4; }
                    
                    .category-pills { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; scrollbar-width: none; }
                    .category-pills::-webkit-scrollbar { display: none; }
                    .pill { padding: 12px 24px; border-radius: 50px; border: 1px solid var(--glass-border); background: var(--glass); color: rgba(255,255,255,0.6); font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: 0.3s; white-space: nowrap; }
                    .pill:hover { background: rgba(255,255,255,0.06); color: white; }
                    .pill.active { background: white; color: black; border-color: white; }

                    @media (max-width: 768px) {
                      .grid-container { grid-template-columns: 1fr; gap: 40px; }
                      .event-item:nth-child(even) { transform: none; }
                      .events-hero { padding-top: 140px; }
                      .hero-title { font-size: 3.5rem; }
                      .card-content { padding: 30px; }
                    }
                  </style>

                  <main>
                    <!-- AMBIENT BG -->
                    <div class="give-bg">
                      <div class="bg-overlay"></div>
                      <img src="https://images.unsplash.com/photo-1540331547168-8b63109225b7?q=80&w=2000&auto=format&fit=crop" alt="Events Background" class="bg-img">
                    </div>
                    
                    <section class="events-hero" style="background: transparent;">
                      <div class="hero-content">
                        <span class="hero-label gsap-reveal">Calendar</span>
                        <h1 class="hero-title gsap-reveal">Gatherings &<br>Conferences</h1>
                      </div>
                    </section>

                    <section class="filters-section">
                      <div class="filters-container">
                        <div class="search-box">
                          <div class="search-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></div>
                          <input type="text" id="eventSearch" class="search-input" placeholder="Search events by title or location...">
                        </div>
                        <div class="category-pills">
                          <button class="pill active" data-cat="all">All Events</button>
                          <button class="pill" data-cat="worship">Worship</button>
                          <button class="pill" data-cat="conference">Conference</button>
                          <button class="pill" data-cat="outreach">Outreach</button>
                          <button class="pill" data-cat="youth">Youth</button>
                        </div>
                      </div>
                    </section>

                    <section class="events-grid-section">
                      <div class="grid-container">
                        <% if (events && events.length > 0) { %>
                          <% events.forEach((evt, i) => { 
                             const startDate = new Date(evt.start_date);
                             const dateStr = startDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                             const category = (evt.event_type || 'other').toLowerCase();
                          %>
                            <a href="/events/<%= evt.slug %>" class="event-item gsap-event" data-index="<%= i %>" data-title="<%= evt.title.toLowerCase() %>" data-loc="<%= (evt.location_name || '').toLowerCase() %>" data-cat="<%= category %>">
                              <div class="event-card">
                                <div class="card-media">
                                  <img src="<%= evt.cover_image_url || 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=2069&auto=format&fit=crop' %>" 
                                       alt="<%= evt.title %>" loading="lazy">
                                </div>
                                <div class="card-content">
                                  <div class="event-date">
                                    <span class="date-pill"><%= startDate.toLocaleDateString('en-US', { month: 'short' }) %> <%= startDate.getDate() %></span>
                                    <span class="date-text"><%= dateStr %></span>
                                  </div>
                                  <h2 class="event-title"><%= evt.title %></h2>
                                  <p class="event-loc">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    <%= evt.location_name || 'Ambassadors Assembly HQ' %>
                                  </p>
                                </div>
                              </div>
                            </a>
                          <% }) %>
                        <% } else { %>
                          <div class="no-results" style="grid-column: 1 / -1; text-align: center; color: var(--accent-muted); padding: 100px 0;">
                            <p>No upcoming events currently scheduled. Check back soon!</p>
                          </div>
                        <% } %>
                      </div>
                    </section>
                  </main>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    window.addEventListener('load', () => {
      // Hero reveal
      gsap.from('.gsap-reveal', {
        y: 60, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power4.out'
      });

      // Staggered Event Reveal
      gsap.from('.gsap-event', {
        scrollTrigger: {
          trigger: '.grid-container',
          start: 'top 80%'
        },
        y: 100,
        opacity: 0,
        duration: 1.2,
        stagger: 0.15,
        ease: 'power3.out'
      });

      // FILTERING LOGIC
      const searchInput = document.getElementById('eventSearch');
      const pills = document.querySelectorAll('.pill');
      const eventItems = document.querySelectorAll('.event-item');
      let currentCat = 'all';

      function filterEvents() {
        const query = searchInput.value.toLowerCase();
        
        eventItems.forEach(item => {
          const title = item.dataset.title;
          const loc = item.dataset.loc;
          const cat = item.dataset.cat;
          
          const matchesQuery = title.includes(query) || loc.includes(query);
          const matchesCat = currentCat === 'all' || cat === currentCat;
          
          if (matchesQuery && matchesCat) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });

        // Refresh AOS/Animations if needed (optional)
      }

      searchInput.addEventListener('input', filterEvents);
      
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          currentCat = pill.dataset.cat;
          filterEvents();
        });
      });
    });
  </script>
</body>
</html>