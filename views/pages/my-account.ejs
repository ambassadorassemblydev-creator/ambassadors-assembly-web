    <!-- ───────── TAB: ATTENDANCE ───────── -->
    <div class="aas-tab <%= activeTab === 'attendance' ? 'on' : '' %>" id="aas-attendance">
      <div class="aas-ph">
        <div class="aas-eyebrow">Service & Fellowship Tracking</div>
        <h1>Attendance Record</h1>
        <p>Your faithfulness in fellowship is recorded here. Keep up the good work!</p>
      </div>

      <div class="aas-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
          <div>
            <h3 style="font-size:16px; font-weight:800; color:var(--dk); margin:0;">Fellowship Activity</h3>
            <p style="font-size:12px; color:var(--mu); margin:4px 0 0;">Last 12 months of service attendance</p>
          </div>
          <div style="display:flex; gap:12px;">
            <div style="text-align:right;">
              <div style="font-size:18px; font-weight:800; color:var(--g);"><%= attendance ? attendance.length : 0 %></div>
              <div style="font-size:10px; font-weight:700; color:var(--mu); text-transform:uppercase;">Total Services</div>
            </div>
          </div>
        </div>

        <!-- GitHub Style Calendar -->
        <div class="attendance-calendar-container">
          <div class="calendar-grid" id="attendanceGrid">
            <!-- Grid will be populated by JS for premium responsiveness -->
          </div>
          <div class="calendar-footer">
            <div class="calendar-legend">
              <span>Less</span>
              <div class="legend-box level-0"></div>
              <div class="legend-box level-1"></div>
              <div class="legend-box level-2"></div>
              <div class="legend-box level-3"></div>
              <div class="legend-box level-4"></div>
              <span>More</span>
            </div>
          </div>
        </div>

        <style>
          .attendance-calendar-container {
            padding: 20px;
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--bdr);
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
            scrollbar-color: rgba(23, 106, 96, 0.2) transparent;
          }
          .attendance-calendar-container::-webkit-scrollbar {
            height: 6px;
          }
          .attendance-calendar-container::-webkit-scrollbar-thumb {
            background: rgba(23, 106, 96, 0.2);
            border-radius: 10px;
          }
          .calendar-grid {
            display: grid;
            grid-template-rows: repeat(7, 12px);
            grid-auto-flow: column;
            gap: 4px;
            padding-bottom: 10px;
          }
          .calendar-day {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            background: #ebedf0;
            cursor: pointer;
            position: relative;
            transition: transform 0.2s;
          }
          .calendar-day:hover {
            transform: scale(1.2);
            z-index: 2;
          }
          .calendar-day:hover::after {
            content: attr(data-date);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            padding: 4px 8px;
            background: #333;
            color: #fff;
            font-size: 10px;
            border-radius: 4px;
            white-space: nowrap;
            z-index: 10;
          }
          .calendar-day.present { background: #9be9a8; }
          .calendar-day.regular { background: #40c463; }
          .calendar-day.faithful { background: #30a14e; }
          .calendar-day.leader { background: #216e39; }
          
          .calendar-legend {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            color: var(--mu);
            margin-top: 12px;
            justify-content: flex-end;
          }
          .legend-box { width: 10px; height: 10px; border-radius: 2px; }
          .level-0 { background: #ebedf0; }
          .level-1 { background: #9be9a8; }
          .level-2 { background: #40c463; }
          .level-3 { background: #30a14e; }
          .level-4 { background: #216e39; }
        </style>

        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('attendanceGrid');
            if (!grid) return;

            const attendanceData = JSON.parse(`<%- JSON.stringify(attendance || []) %>`);
            const attendanceMap = {};
            attendanceData.forEach(record => {
              attendanceMap[record.service_date] = record;
            });

            const today = new Date();
            const oneYearAgo = new Date();
            oneYearAgo.setFullYear(today.getFullYear() - 1);
            
            // Adjust to start of week
            const start = new Date(oneYearAgo);
            start.setDate(start.getDate() - start.getDay());

            for (let i = 0; i < 53 * 7; i++) {
              const current = new Date(start);
              current.setDate(start.getDate() + i);
              
              const dateStr = current.toISOString().split('T')[0];
              const day = document.createElement('div');
              day.className = 'calendar-day';
              day.setAttribute('data-date', dateStr);
              
              if (attendanceMap[dateStr]) {
                day.classList.add('present');
                // Could add more logic for levels if multiple services per day
              }
              
              if (current > today) {
                day.style.opacity = '0.3';
                day.style.pointerEvents = 'none';
              }

              grid.appendChild(day);
            }
          });
        </script>
      </div>

      <!-- Recent Attendance List -->
      <div class="aas-card" style="margin-top:20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
          <h3 class="aas-card-title">Recent Check-ins</h3>
          <span style="font-size:11px; font-weight:700; color:var(--mu);"><%= attendance ? attendance.length : 0 %> records found</span>
        </div>
        <% if (attendance && attendance.length > 0) { %>
          <div class="aas-attendance-list">
            <% [...attendance].reverse().slice(0, 15).forEach(record => { %>
              <div class="aas-attendance-row" style="display:flex; align-items:center; justify-content:space-between; padding:15px 0; border-bottom:1.5px solid var(--bdr);">
                <div style="display:flex; align-items:center; gap:14px; flex:1;">
                  <div style="width:40px; height:40px; border-radius:12px; background:var(--g-pl); color:var(--g); display:flex; align-items:center; justify-content:center; font-size:16px;">
                    <i class="fas <%= record.service_name.toLowerCase().includes('service') ? 'fa-church' : 'fa-calendar-star' %>"></i>
                  </div>
                  <div>
                    <div style="font-weight:800; color:var(--dk); font-size:14.5px;"><%= record.service_name %></div>
                    <div style="font-size:11px; color:var(--mu); font-weight:600;"><%= new Date(record.service_date).toLocaleDateString('en-GB', {day:'2-digit', month:'long', year:'numeric'}) %></div>
                  </div>
                </div>
                <div style="text-align:right;">
                  <span style="font-size:9.5px; font-weight:800; background:var(--g-pl); color:var(--g); padding:5px 12px; border-radius:100px; text-transform:uppercase; letter-spacing:.5px;">
                    <i class="fas fa-check-circle" style="margin-right:4px;"></i> Present
                  </span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="aas-empty" style="padding:40px 0;">
            <i class="fas fa-history" style="font-size:32px; opacity:.15; margin-bottom:12px;"></i>
            <p style="font-size:13.5px; color:var(--mu);">No attendance history available yet.</p>
          </div>
        <% } %>
      </div>

      <div style="margin-top:24px; text-align:center;">
        <p style="font-size:13px; color:var(--mu);">Have a QR code for today's service?</p>
        <button class="btn-g" style="margin-top:12px; padding:12px 30px;" onclick="window.location.href='/my-account/attendance/mark'">
          <i class="fas fa-qrcode"></i> Scan Entrance QR
        </button>
      </div>
    </div><!-- /attendance -->

<% if (locals.selectSessions && selectSessions.length > 0) { %>
