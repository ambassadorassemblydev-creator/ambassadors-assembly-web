                  <i class="fas fa-clock"></i> Interest Pending
                </span>
              <% } else { %>
                <% if (hasWorker) { %>
                  <button class="dept-apply" onclick="showToast(`You are already part of the <%= w.church_departments ? w.church_departments.name : 'Outreach Team' %>. Please contact your HOD to change units.`, 'info')" style="cursor: help;">
