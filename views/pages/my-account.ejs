<%- include('../partials/head') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <link rel="stylesheet" href="/css/account.css">

        <div class="dashboard-wrapper">
          <%- include('../partials/account-sidebar', { activePage: 'dashboard', activeTab: activeTab }) %>

          <main class="dash-content">
            <!-- PREMIUM HEADER -->
            <div class="content-header">
              <div class="header-badge">MEMBER ECOSYSTEM</div>
              <h1>Welcome, <%= user.first_name || 'Ambassador' %></h1>
              <p>Manage your ministry involvement, giving, and profile state from your personalized command center.</p>
            </div>

            <!-- OVERVIEW TAB -->
            <div id="tab-overview" class="tab-pane <%= activeTab === 'overview' ? 'active' : '' %>">
              <div class="grid-stats">
                <div class="stat-card" style="animation-delay: 0.1s;">
                  <div class="stat-icon"><i class="fas fa-hand-holding-heart"></i></div>
                  <div class="stat-info">
                    <span class="stat-label">Total Giving</span>
                    <p class="stat-value">₦<%= stats.totalGiving %></p>
                  </div>
                </div>
                <div class="stat-card" style="animation-delay: 0.2s;">
                  <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                  <div class="stat-info">
                    <span class="stat-label">Events</span>
                    <p class="stat-value"><%= stats.eventCount %></p>
                  </div>
                </div>
                <div class="stat-card" style="animation-delay: 0.3s;">
                  <div class="stat-icon"><i class="fas fa-pray"></i></div>
                  <div class="stat-info">
                    <span class="stat-label">Prayers</span>
                    <p class="stat-value"><%= stats.prayerCount %></p>
                  </div>
                </div>
              </div>

              <div class="dashboard-main-grid">
                <div class="glass-card chart-section" style="margin-bottom: 30px; animation-delay: 0.4s;">
                  <div class="card-header">
                    <h3>Partnership Growth</h3>
                    <div class="card-actions">
                      <span class="period-tag">Last 6 Months</span>
                    </div>
                  </div>
                  <div class="chart-container" style="height: 300px; position: relative;">
                    <canvas id="givingChart"></canvas>
                  </div>
                </div>

                <div class="glass-card activity-section" style="animation-delay: 0.5s;">
                  <div class="card-header">
                    <h3>Recent Partnership</h3>
                    <a href="javascript:void(0)" onclick="switchTab('giving')" class="btn-text">Review All</a>
                  </div>
                  <div class="table-responsive">
                    <table class="activity-list">
                      <thead>
                        <tr>
                          <th>Category</th>
                          <th>Amount</th>
                          <th>Status</th>
                          <th>Date</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (donations && donations.length > 0) { %>
                          <% donations.slice(0, 5).forEach((d, idx) => { %>
                            <tr style="animation: dashFadeIn 0.5s <%= 0.6 + (idx * 0.1) %>s ease both;">
                              <td><strong><%= d.donation_categories ? d.donation_categories.name : 'General' %></strong></td>
                              <td>₦<%= Number(d.amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                              <td><span class="status-badge status-paid"><%= d.status %></span></td>
                              <td><%= new Date(d.created_at).toLocaleDateString() %></td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr><td colspan="4" class="empty-msg" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.2);">No giving history found yet.</td></tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- EVENTS TAB -->
            <div id="tab-events" class="tab-pane <%= activeTab === 'events' ? 'active' : '' %>">
              <div class="glass-card">
                <div class="card-header">
                  <h3>Event Registrations</h3>
                  <a href="/events" class="btn-primary-mini">Find Events</a>
                </div>
                <div class="table-responsive">
                  <table class="activity-list">
                    <thead>
                      <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (events && events.length > 0) { %>
                        <% events.forEach(reg => { %>
                          <tr>
                            <td><strong><%= reg.events.title %></strong></td>
                            <td><%= new Date(reg.events.start_date).toLocaleDateString() %></td>
                            <td><span class="status-badge status-active">Confirmed</span></td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr><td colspan="3" class="empty-msg" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.2);">You have no upcoming events.</td></tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- GIVING TAB (Full History) -->
            <div id="tab-giving" class="tab-pane <%= activeTab === 'giving' ? 'active' : '' %>">
              <div class="glass-card">
                <div class="card-header">
                  <h3>Personnel Verified</h3>
                  <a href="/my-account/profile" class="btn-text">Edit Settings &rarr;</a>
                </div>
                
                <div class="profile-summary">
                  <div class="sum-item">
                    <label>Full Name</label>
                    <p><%= user.first_name %> <%= user.last_name %></p>
                  </div>
                  <div class="sum-item">
                    <label>Email Address</label>
                    <p><%= user.email %></p>
                  </div>
                  <div class="sum-item">
                    <label>Service Department</label>
                    <p class="text-green"><%= user.department_name || 'General Member' %></p>
                  </div>
                </div>
              </div>
               <div class="glass-card">
                <div class="card-header">
                  <h3>Detailed History</h3>
                  <a href="/give" class="btn-primary-mini">New Partnership</a>
                </div>
                <div class="table-responsive">
                  <table class="activity-list">
                    <thead>
                      <tr>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (donations && donations.length > 0) { %>
                        <% donations.forEach(d => { %>
                          <tr>
                            <td><strong><%= d.donation_categories ? d.donation_categories.name : 'General' %></strong></td>
                            <td>₦<%= Number(d.amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                            <td><span class="status-badge status-paid"><%= d.status %></span></td>
                            <td><%= new Date(d.created_at).toLocaleDateString() %></td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr><td colspan="4" class="empty-msg" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.2);">No history found.</td></tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- PRAYERS TAB -->
            <div id="tab-prayers" class="tab-pane <%= activeTab === 'prayers' ? 'active' : '' %>">
              <div class="glass-card">
                <div class="card-header">
                  <h3>My Prayer Petitions</h3>
                  <a href="/prayer-requests" class="btn-primary-mini">Send Petition</a>
                </div>
                <div class="empty-state">
                  <i class="fas fa-pray"></i>
                  <p>Your spiritual petitions will appear here.</p>
                </div>
              </div>
            </div>

            <!-- NOTES TAB -->
            <div id="tab-notes" class="tab-pane <%= activeTab === 'notes' ? 'active' : '' %>">
               <div class="glass-card">
                <div class="card-header">
                  <h3>Sermon Highlights</h3>
                </div>
                <div class="empty-state">
                  <i class="fas fa-sticky-note"></i>
                  <p>Your notes from live services will be saved here.</p>
                </div>
              </div>
            </div>

            <style>
              .tab-pane { display: none; animation: dashFadeIn 0.6s ease; }
              .tab-pane.active { display: block; }
              @keyframes dashFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
              
              .btn-primary-mini {
                background: var(--accent-sage);
                color: #0c0c0c;
                padding: 10px 20px;
                border-radius: 12px;
                font-size: 11px;
                font-weight: 800;
                text-decoration: none;
                transition: 0.3s;
                text-transform: uppercase;
                letter-spacing: 0.5px;
              }
              .btn-primary-mini:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(113, 178, 128, 0.4); }
              
              .empty-state { text-align: center; padding: 80px 20px; color: rgba(255,255,255,0.2); }
              .empty-state i { font-size: 48px; margin-bottom: 24px; color: var(--accent-sage); opacity: 0.4; }
              .empty-state p { font-size: 15px; font-family: 'Inter', sans-serif; }
              
              .dmFooterContainer { display: none !important; }
            </style>

            <script>
              function switchTab(tab) {
                document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
                const target = document.getElementById('tab-' + tab);
                if (target) {
                  target.classList.add('active');
                  const url = new URL(window.location);
                  url.searchParams.set('tab', tab);
                  window.history.pushState({}, '', url);
                  
                  document.querySelectorAll('.nav-link').forEach(link => {
                    link.classList.remove('active');
                    const href = link.getAttribute('href');
                    if (tab === 'overview' && href === '/my-account') link.classList.add('active');
                    else if (href.includes('tab=' + tab)) link.classList.add('active');
                  });
                }
              }

              (function() {
                const ctx = document.getElementById('givingChart');
                if (ctx) {
                  const history = <%- JSON.stringify(donations || []) %>;
                  if (history.length === 0) return;

                  const months = {};
                  history.sort((a,b) => new Date(a.created_at) - new Date(b.created_at)).forEach(d => {
                    const date = new Date(d.created_at);
                    const key = date.toLocaleString('default', { month: 'short' }) + ' ' + date.getFullYear();
                    months[key] = (months[key] || 0) + Number(d.amount);
                  });

                  new Chart(ctx, {
                    type: 'line',
                    data: {
                      labels: Object.keys(months),
                      datasets: [{
                        label: 'Partnership (£)',
                        data: Object.values(months),
                        borderColor: '#71b280',
                        backgroundColor: 'rgba(113, 178, 128, 0.1)',
                        borderWidth: 4,
                        tension: 0.45,
                        fill: true,
                        pointBackgroundColor: '#71b280',
                        pointBorderColor: '#fff',
                        pointHoverRadius: 8,
                        pointRadius: 4
                      }]
                    },
                    options: {
                      responsive: true,
                      maintainAspectRatio: false,
                      plugins: { legend: { display: false } },
                      scales: {
                        y: { 
                          beginAtZero: true, 
                          grid: { color: 'rgba(255,255,255,0.03)' },
                          ticks: { color: 'rgba(255,255,255,0.3)', font: { size: 11, family: 'Inter' } }
                        },
                        x: { 
                          grid: { display: false },
                          ticks: { color: 'rgba(255,255,255,0.3)', font: { size: 11, family: 'Inter' } }
                        }
                      }
                    }
                  });
                }
              })();
            </script>
          </main>
        </div>

        <%- include('../partials/footer') %>
      </div>
    </div>
  </div>
</body>
</html>