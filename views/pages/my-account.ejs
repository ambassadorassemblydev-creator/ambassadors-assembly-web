<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/dashboard-new.css">

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding:0;margin:0;background:var(--color_1);">
<%- include('../partials/preloader') %>
<div id="dm" class="dmwr">
  <div class="dm_wrapper -var5 null">
    <div dmwrapped="true" id="1901957768" class="dm-home-page">
      <div class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 dmPageBody dmDHeader" id="dm-outer-wrapper">
        <div class="dmOuter"><div class="dmInner"><div class="dmLayoutWrapper dmStandardDesktop">
          <div id="site_content">
            <%- include('../partials/navbar') %>

<%
  // ── Helper vars ──
  const hasWorker = user && user.church_workers && user.church_workers.length > 0;
  const w = hasWorker ? user.church_workers[0] : null;

  let displayRole = 'Member';
  if (hasWorker) {
    displayRole = (w.church_positions && w.church_positions.title) ? w.church_positions.title : 'Church Worker';
  }

  const activeTab = locals.tab || 'overview';

  function getDeptIcon(name) {
    if (!name) return 'fa-users-cog';
    const n = name.toLowerCase();
    if (n.includes('media') || n.includes('communication')) return 'fa-video';
    if (n.includes('music') || n.includes('choir') || n.includes('praise') || n.includes('worship')) return 'fa-music';
    if (n.includes('usher') || n.includes('protocol') || n.includes('hospitality')) return 'fa-door-open';
    if (n.includes('children') || n.includes('kids')) return 'fa-child';
    if (n.includes('youth') || n.includes('teen') || n.includes('young')) return 'fa-graduation-cap';
    if (n.includes('prayer') || n.includes('intercession')) return 'fa-praying-hands';
    if (n.includes('technical') || n.includes('sound') || n.includes('audio') || n.includes('tech')) return 'fa-tools';
    if (n.includes('security') || n.includes('safety')) return 'fa-shield-alt';
    if (n.includes('finance') || n.includes('treasury') || n.includes('account')) return 'fa-coins';
    if (n.includes('sanit') || n.includes('clean')) return 'fa-broom';
    if (n.includes('decor') || n.includes('art') || n.includes('creative')) return 'fa-paint-brush';
    if (n.includes('evangel') || n.includes('outreach') || n.includes('mission')) return 'fa-bullhorn';
    if (n.includes('welfare') || n.includes('care')) return 'fa-hands-helping';
    if (n.includes('health') || n.includes('medical') || n.includes('first aid')) return 'fa-first-aid';
    if (n.includes('transport') || n.includes('driver') || n.includes('logistics')) return 'fa-bus';
    if (n.includes('admin') || n.includes('secretary')) return 'fa-briefcase';
    return 'fa-users-cog';
  }
%>

<!-- Mobile overlay -->
<div class="aas-overlay" id="aasOverlay"></div>

<div class="aa-dash">

  <!-- ═══════════════════════════════════════════ -->
  <!--                  SIDEBAR                   -->
  <!-- ═══════════════════════════════════════════ -->
  <%- include('../partials/aa-sidebar', { activeTab: activeTab }) %>

  <!-- ═══════════════════════════════════════════ -->
  <!--                MAIN CONTENT                -->
  <!-- ═══════════════════════════════════════════ -->
  <main class="aas-main">
    <!-- Top Progress Bar -->
    <div id="aasProgress" style="position:fixed;top:0;left:0;height:4px;background:linear-gradient(90deg,var(--g) 0%,var(--g-lt) 100%);width:0%;z-index:100000;transition:width .4s ease,opacity .3s ease;opacity:0;"></div>


    <!-- Mobile top bar -->
    <div class="aas-mob-bar">
      <button class="aas-ham" id="aasHam"><i class="fas fa-bars"></i></button>
      <span class="aas-mob-hello"><%= user.title ? user.title + ' ' : '' %><%= user.first_name %></span>
    </div>

    <!-- ───────── TAB: OVERVIEW ───────── -->
    <div class="aas-tab <%= activeTab === 'overview' ? 'on' : '' %>" id="aas-overview">

      <!-- Hero -->
      <div class="aas-hero">
        <div class="aas-hero-inner">
          <div class="aas-hero-eye"><i class="fas fa-church"></i> The Ambassadors Assembly</div>
          <h1 class="aas-hero-title">
            Welcome back,<br>
            <%= user.title ? user.title + ' ' : '' %><%= user.first_name %> <%= user.last_name %>
          </h1>
          <p class="aas-hero-sub">
            <% if (hasWorker) { %>
              Thank you for your faithful service. Your dedication to the <%= w.church_departments ? w.church_departments.name : 'team' %> inspires the entire assembly.
            <% } else { %>
              We're glad you're here. Everything you need — your giving, prayers, notes, and church life — all in one place.
            <% } %>
          </p>
          <div class="aas-hero-tags">
            <span class="aas-hero-tag">
              <i class="fas fa-id-card"></i>
              <%= user.member_id || 'AA-' + user.id.substring(0,6).toUpperCase() %>
            </span>
            <% if (user.created_at) { %>
            <span class="aas-hero-tag">
              <i class="fas fa-calendar-check"></i>
              Member since <%= new Date(user.created_at).getFullYear() %>
            </span>
            <% } %>
            <% if (hasWorker && w.church_departments) { %>
            <span class="aas-hero-tag">
              <i class="fas fa-briefcase"></i>
              <%= w.church_departments.name %>
            </span>
            <% } %>
            <span class="aas-hero-tag">
              <i class="fas fa-shield-alt"></i>
              <%= displayRole %>
            </span>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="aas-stats">
        <div class="aas-stat">
          <div class="aas-stat-ic"><i class="fas fa-hand-holding-heart"></i></div>
          <div class="aas-stat-lbl">Total Giving</div>
          <div class="aas-stat-val">₦<%= parseFloat(stats.totalGiving || 0).toLocaleString() %></div>
        </div>
        <div class="aas-stat">
          <div class="aas-stat-ic"><i class="fas fa-calendar-check"></i></div>
          <div class="aas-stat-lbl">Events Registered</div>
          <div class="aas-stat-val"><%= stats.eventCount %></div>
        </div>
        <div class="aas-stat">
          <div class="aas-stat-ic"><i class="fas fa-praying-hands"></i></div>
          <div class="aas-stat-lbl">Prayer Requests</div>
          <div class="aas-stat-val"><%= stats.prayerCount %></div>
        </div>
        <div class="aas-stat">
          <div class="aas-stat-ic"><i class="fas fa-sticky-note"></i></div>
          <div class="aas-stat-lbl">Sermon Notes</div>
          <div class="aas-stat-val"><%= stats.noteCount %></div>
        </div>
      </div>

      <!-- Quick actions -->
      <div class="aas-qa">
        <a href="/give" class="aas-qa-btn">
          <div class="aas-qa-ic"><i class="fas fa-hand-holding-usd"></i></div>
          <span class="aas-qa-lbl">Give Online</span>
        </a>
        <button class="aas-qa-btn" onclick="aasTabById('events')">
          <div class="aas-qa-ic"><i class="fas fa-calendar-alt"></i></div>
          <span class="aas-qa-lbl">View Events</span>
        </button>
        <a href="/events?type=community_impact" class="aas-qa-btn">
          <div class="aas-qa-ic"><i class="fas fa-globe-africa"></i></div>
          <span class="aas-qa-lbl">Community Impact</span>
        </a>
        <button class="aas-qa-btn" onclick="aasTabById('outreach')">
          <div class="aas-qa-ic"><i class="fas fa-heartbeat"></i></div>
          <span class="aas-qa-lbl">Outreach Team</span>
        </button>
        <button class="aas-qa-btn" onclick="triggerShareCardPopup()">
          <div class="aas-qa-ic" style="background:var(--g); color:#fff;"><i class="fas fa-share-alt"></i></div>
          <span class="aas-qa-lbl">Share My Card</span>
        </button>

      </div>

      <!-- Two-col: upcoming events + recent giving -->
      <div class="aas-2col">
        <!-- Upcoming events -->
        <div class="aas-card">
          <div class="aas-card-row">
            <h3 class="aas-card-title">Upcoming Events</h3>
            <button class="btn-o" onclick="aasTabById('events')">View All</button>
          </div>
          <%
            const upcoming = (events || [])
              .filter(e => e.events && new Date(e.events.start_date) >= new Date())
              .slice(0, 4);
          %>
          <% if (upcoming.length > 0) { %>
            <% upcoming.forEach(reg => { const ev = reg.events; %>
              <div class="aas-ev-item">
                <div class="aas-ev-date">
                  <span class="ev-d"><%= new Date(ev.start_date).getDate() %></span>
                  <span class="ev-m"><%= new Date(ev.start_date).toLocaleDateString('en-US',{month:'short'}) %></span>
                </div>
                <div class="aas-ev-info">
                  <h4><%= ev.title %></h4>
                  <p><i class="fas fa-map-marker-alt" style="font-size:10px;margin-right:4px;"></i><%= ev.location_name || 'Ambassadors Assembly' %></p>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="aas-empty" style="padding:24px 0;">
              <i class="fas fa-calendar"></i>
              <p>No upcoming events. <a href="/events">Browse events</a></p>
            </div>
          <% } %>
        </div>

        <!-- Recent giving -->
        <div class="aas-card">
          <div class="aas-card-row">
            <h3 class="aas-card-title">Recent Partnership</h3>
            <button class="btn-o" onclick="aasTabById('giving')">Full History</button>
          </div>
          <% const recentGiving = [...(donations || [])].reverse().slice(0, 5); %>
          <% if (recentGiving.length > 0) { %>
            <% recentGiving.forEach(d => { %>
              <div class="aas-give-row">
                <div>
                  <span class="give-cat"><%= d.donation_categories ? d.donation_categories.name : 'General Offering' %></span>
                  <div class="give-dt"><%= new Date(d.created_at).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %></div>
                </div>
                <span class="give-amt">₦<%= Number(d.amount).toLocaleString() %></span>
              </div>
            <% }) %>
          <% } else { %>
            <div class="aas-empty" style="padding:24px 0;">
              <i class="fas fa-heart"></i>
              <p>No records. <a href="/give">Partner with us</a></p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Worker service detail (if church worker) -->
      <% if (hasWorker) { %>
      <div class="aas-card">
        <div class="aas-card-row">
          <div>
            <div class="aas-eyebrow">Service Placement</div>
            <h3 class="aas-card-title">My Ministry Role</h3>
          </div>
        </div>
        <% user.church_workers.forEach(cw => { %>
        <div class="aas-worker-card">
          <div class="aas-worker-ic"><i class="fas fa-briefcase"></i></div>
          <div>
            <div style="font-weight:800;color:var(--dk);font-size:15px;">
              <%= cw.church_positions ? cw.church_positions.title : 'Worker' %>
            </div>
            <div style="font-size:13px;color:var(--mu);margin-top:2px;">
              <%= cw.church_departments ? cw.church_departments.name : 'Outreach & Impact' %>
            </div>
            <div style="margin-top:9px;">
              <span style="font-size:9.5px;font-weight:700;padding:3px 10px;border-radius:100px;text-transform:uppercase;background:<%= cw.status === 'active' ? 'var(--g-pl)' : '#fef3c7' %>;color:<%= cw.status === 'active' ? 'var(--g)' : '#92400e' %>;">
                <%= cw.status || 'pending' %>
              </span>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>

    </div><!-- /overview -->


    <!-- ───────── TAB: EVENTS ───────── -->
    <div class="aas-tab <%= activeTab === 'events' ? 'on' : '' %>" id="aas-events">
      <div class="aas-ph">
        <div class="aas-eyebrow">My Calendar</div>
        <h1>Registered Events</h1>
        <p>All events you have registered for at Ambassadors Assembly.</p>
      </div>

      <% if (events && events.length > 0) { %>
        <% events.forEach(reg => { const ev = reg.events; if (!ev) return; const isPast = new Date(ev.start_date) < new Date(); %>
          <div class="aas-card" style="display:flex;align-items:center;gap:20px;padding:20px 26px;margin-bottom:13px;">
            <div class="aas-ev-date" style="width:58px;height:58px;border-radius:16px;">
              <span class="ev-d" style="font-size:21px;"><%= new Date(ev.start_date).getDate() %></span>
              <span class="ev-m"><%= new Date(ev.start_date).toLocaleDateString('en-US',{month:'short',year:'numeric'}) %></span>
            </div>
            <div style="flex:1;">
              <div style="font-size:15px;font-weight:800;color:var(--dk);margin-bottom:4px;"><%= ev.title %></div>
              <div style="font-size:11.5px;color:var(--mu);display:flex;gap:14px;flex-wrap:wrap;">
                <span><i class="fas fa-map-marker-alt" style="margin-right:4px;"></i><%= ev.location_name || 'The Ambassadors Assembly' %></span>
                <span><i class="fas fa-clock" style="margin-right:4px;"></i><%= new Date(ev.start_date).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}) %></span>
              </div>
            </div>
            <span style="font-size:9.5px;font-weight:700;padding:5px 13px;border-radius:100px;text-transform:uppercase;flex-shrink:0;background:<%= isPast ? '#f3f4f6' : 'var(--g-pl)' %>;color:<%= isPast ? '#6b7280' : 'var(--g)' %>;">
              <%= isPast ? '✓ Attended' : 'Upcoming' %>
            </span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="aas-card"><div class="aas-empty">
          <i class="fas fa-calendar-times"></i>
          <p>No events registered yet.</p>
          <a href="/events" class="btn-g" style="margin-top:14px;display:inline-flex;">Browse Events <i class="fas fa-arrow-right" style="margin-left:6px;"></i></a>
        </div></div>
      <% } %>

      <div style="text-align:center;margin-top:20px;">
        <a href="/events" class="btn-o" style="font-size:13.5px;padding:11px 26px;">
          <i class="fas fa-calendar-alt"></i> Explore All Events
        </a>
      </div>
    </div><!-- /events -->


    <!-- ───────── TAB: GIVING ───────── -->
    <div class="aas-tab <%= activeTab === 'giving' ? 'on' : '' %>" id="aas-giving">
      <div class="aas-ph">
        <div class="aas-eyebrow">Generosity & Faithfulness</div>
        <h1>Partnership History</h1>
        <p>Your complete record of giving and financial partnership with the church.</p>
      </div>

      <!-- Big total card -->
      <div class="aas-card" style="background:linear-gradient(135deg,var(--g) 0%,var(--g-lt) 100%);color:#fff;margin-bottom:22px;">
        <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;opacity:.8;margin-bottom:7px;">Total Partnership (All Time)</div>
        <div style="font-size:40px;font-weight:900;font-family:'Outfit',sans-serif;margin-bottom:4px;">₦<%= parseFloat(stats.totalGiving || 0).toLocaleString() %></div>
        <div style="opacity:.75;font-size:12.5px;"><%= (donations||[]).length %> contributions recorded</div>
      </div>

      <% if (donations && donations.length > 0) { %>
        <div class="aas-card">
          <div class="aas-card-row">
            <h3 class="aas-card-title">All Contributions</h3>
          </div>
          <% [...donations].reverse().forEach(d => { %>
            <div class="aas-give-row">
              <div>
                <div style="font-size:13.5px;font-weight:600;color:var(--dk);">
                  <%= d.donation_categories ? d.donation_categories.name : 'General Offering' %>
                </div>
                <div class="give-dt"><%= new Date(d.created_at).toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'}) %></div>
              </div>
              <span class="give-amt">₦<%= Number(d.amount).toLocaleString() %></span>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="aas-card"><div class="aas-empty">
          <i class="fas fa-hand-holding-heart"></i>
          <p>No giving records found. Start your journey of generosity today.</p>
          <a href="/give" class="btn-g" style="margin-top:14px;display:inline-flex;">Give Now <i class="fas fa-arrow-right" style="margin-left:6px;"></i></a>
        </div></div>
      <% } %>

      <div style="text-align:center;margin-top:20px;">
        <a href="/give" class="btn-g" style="font-size:13.5px;padding:11px 26px;">
          <i class="fas fa-heart"></i> Partner With Us
        </a>
      </div>
    </div><!-- /giving -->


    <!-- ───────── TAB: PRAYERS ───────── -->
    <div class="aas-tab <%= activeTab === 'prayers' ? 'on' : '' %>" id="aas-prayers">
      <div class="aas-ph">
        <div class="aas-eyebrow">Intercession & Faith</div>
        <h1>My Prayer Requests</h1>
        <p>Your prayer requests submitted to the Ambassadors Assembly prayer team.</p>
      </div>

      <% if (prayers && prayers.length > 0) { %>
        <% prayers.forEach(p => { %>
          <div class="aas-pray-item">
            <h4><%= p.title %></h4>
            <p><%= p.description ? p.description.substring(0,200) + (p.description.length > 200 ? '…' : '') : 'No description provided.' %></p>
            <div class="pray-meta">
              <span class="pray-badge <%= p.is_approved ? 'pb-ok' : 'pb-pend' %>">
                <%= p.is_approved ? '✓ Approved' : '⏳ Pending Review' %>
              </span>
              <span class="pray-badge" style="background:#f3f4f6;color:#6b7280;">
                <%= new Date(p.created_at).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %>
              </span>
              <% if (p.prayer_count > 0) { %>
              <span class="pray-badge" style="background:#ede9fe;color:#6d28d9;">
                <i class="fas fa-hands"></i> <%= p.prayer_count %> Interceding
              </span>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="aas-card"><div class="aas-empty">
          <i class="fas fa-praying-hands"></i>
          <p>No prayer requests submitted yet. The prayer team is ready to stand with you.</p>
          <a href="/prayer-wall" class="btn-g" style="margin-top:14px;display:inline-flex;">Submit Prayer <i class="fas fa-arrow-right" style="margin-left:6px;"></i></a>
        </div></div>
      <% } %>

      <div style="text-align:center;margin-top:20px;">
        <a href="/prayer-wall" class="btn-o" style="font-size:13.5px;padding:11px 26px;">
          <i class="fas fa-hands"></i> Visit Prayer Wall
        </a>
      </div>
    </div><!-- /prayers -->


    <!-- ───────── TAB: NOTES ───────── -->
    <div class="aas-tab <%= activeTab === 'notes' ? 'on' : '' %>" id="aas-notes">
      <div class="aas-ph">
        <div class="aas-eyebrow">Sermon Notes & Journal</div>
        <h1>My Notes</h1>
        <p>Personal sermon notes and spiritual journal entries captured through the app.</p>
      </div>

      <% if (notes && notes.length > 0) { %>
        <% notes.forEach(n => { %>
          <div class="aas-note">
            <h4><%= n.title || 'Sermon Note' %></h4>
            <p><%= n.content ? n.content.substring(0,220) + (n.content.length > 220 ? '…' : '') : '' %></p>
            <div class="note-dt"><%= new Date(n.created_at).toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'}) %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="aas-card"><div class="aas-empty">
          <i class="fas fa-sticky-note"></i>
          <p>No notes yet. Start capturing insights from sermons and spiritual moments.</p>
        </div></div>
      <% } %>
    </div><!-- /notes -->


    <!-- ───────── TAB: MINISTRY (FELLOWSHIP) ───────── -->
    <div class="aas-tab <%= activeTab === 'ministry' ? 'on' : '' %>" id="aas-ministry">
      <div class="aas-ph">
        <div class="aas-eyebrow">Spiritual Community</div>
        <h1>Fellowship Groups</h1>
        <p>
          Fellowship groups are our core spiritual communities — prayer teams, youth groups, and age-based fellowships.
          <br><small style="color:rgba(45,55,72,.4);">Note: These focus on spiritual growth and community support.</small>
        </p>
      </div>

      <% if (user.ministry_members && user.ministry_members.length > 0) { %>
        <% user.ministry_members.forEach(mm => { const m = mm.ministries; if (!m) return; %>
          <div class="aas-min-card">
            <div class="aas-min-ic"><i class="fas fa-users"></i></div>
            <div class="aas-min-info">
              <h3><%= m.name %></h3>
              <p><%= m.description || 'A ministry of Ambassadors Assembly.' %></p>
              <span class="min-role-tag"><%= mm.role === 'pending' ? 'Pending Approval' : (mm.role || 'Member') %></span>
            </div>
            <a href="/ministries/<%= m.slug %>" class="btn-o" style="align-self:flex-start;">View</a>
          </div>
        <% }) %>
      <% } else { %>
        <div class="aas-card"><div class="aas-empty">
          <i class="fas fa-users"></i>
          <p>You haven't joined any ministry groups yet.</p>
          <a href="/ministries" class="btn-g" style="margin-top:14px;display:inline-flex;">Explore Ministries <i class="fas fa-arrow-right" style="margin-left:6px;"></i></a>
        </div></div>
      <% } %>

      <div style="text-align:center;margin-top:20px;">
        <a href="/ministries" class="btn-o" style="font-size:13.5px;padding:11px 26px;">
          <i class="fas fa-compass"></i> Explore All Ministries
        </a>
      </div>
    </div><!-- /ministry -->


    <!-- ───────── TAB: OUTREACH & COMMUNITY IMPACT ───────── -->
    <div class="aas-tab <%= activeTab === 'outreach' ? 'on' : '' %>" id="aas-outreach">
      <div class="aas-ph">
        <div class="aas-eyebrow">Service & Outreach</div>
        <h1>Outreach & Community Impact</h1>
        <p>
          Outreach and Community Impact initiatives are the operational units where we serve the church and the community. Find your place of service and volunteer to join an impact team.
          <br><small style="color:rgba(45,55,72,.4);">Focus: External impact, church operations, and community service.</small>
        </p>
      </div>

      <% if (departments && departments.length > 0) { %>
        <div class="aas-dept-grid">
          <% departments.forEach((dept, idx) => { %>
            <div class="aas-dept-card" style="animation-delay:<%= idx * 0.06 %>s;">
              <div class="dept-ic">
                <i class="fas <%= getDeptIcon(dept.name) %>"></i>
              </div>
              <h2 class="dept-nm"><%= dept.name %></h2>
              <p class="dept-ds"><%= dept.description || 'Serving the house of God with excellence and dedication.' %></p>
              <% if (hasWorker && w.church_departments && w.church_departments.id === dept.id) { %>
                <span style="background:var(--g-pl);color:var(--g);padding:9px 18px;border-radius:100px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;display:inline-flex;align-items:center;gap:7px;">
                  <i class="fas fa-check-circle"></i> My Outreach Team
                </span>
