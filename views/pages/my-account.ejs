<%- include('../partials/head') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: #0c0c0c;">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <link rel="stylesheet" href="/css/account.css">

        <div class="dashboard-wrapper">
          <%- include('../partials/account-sidebar') %>

          <!-- CONTENT -->
          <main class="dash-content">
            
            <% if (activeTab === 'overview') { %>
              <div class="content-header">
                <h1>The Hub</h1>
                <p>Hello, <%= user.first_name %>. Here is what's happening in your journey.</p>
              </div>

              <div class="grid-stats">
                <div class="stat-card">
                  <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
                  <div>
                    <span class="stat-val">Up Next</span>
                    <span class="stat-label">Youth Conference 2026</span>
                  </div>
                </div>
                <div class="stat-card">
                  <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
                  <div>
                    <span class="stat-val"><%= user.department_interest || 'None' %></span>
                    <span class="stat-label">Interest Area</span>
                  </div>
                </div>
              </div>

              <!-- GIVING GRAPH -->
              <div class="glass-card" style="margin-bottom: 30px;">
                <h3 style="margin-top:0; margin-bottom:20px; font-family:'Articulat CF Demi Bold';">Giving Trends</h3>
                <div style="height: 300px; width: 100%;">
                  <canvas id="givingChart"></canvas>
                </div>
              </div>

              <div class="glass-card">
                <h3 style="margin-top:0; margin-bottom:30px; font-family:'Articulat CF Demi Bold';">Recent Giving History</h3>
                <table class="activity-list">
                  <thead>
                    <tr>
                      <th>Category</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (donations && donations.length > 0) { %>
                      <% donations.forEach(d => { %>
                        <tr>
                          <td><strong><%= d.donation_categories.name %></strong></td>
                          <td>£<%= d.amount %></td>
                          <td><span class="status-badge status-paid"><%= d.status %></span></td>
                          <td><%= new Date(d.created_at).toLocaleDateString() %></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="4" style="text-align:center; opacity:0.4; padding: 40px;">No giving records yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <% if (activeTab === 'events') { %>
              <div class="content-header">
                <h1>My Events</h1>
                <p>Events you've registered for or marked interest in.</p>
              </div>
              <div class="glass-card">
                <table class="activity-list">
                  <thead>
                    <tr>
                      <th>Event</th>
                      <th>Date</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (events && events.length > 0) { %>
                      <% events.forEach(reg => { %>
                        <tr>
                          <td><strong><%= reg.events.title %></strong></td>
                          <td><%= new Date(reg.events.start_date).toLocaleDateString() %></td>
                          <td><span class="status-badge status-active">Registered</span></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="3" style="text-align:center; opacity:0.4; padding: 40px;">No event registrations yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <% if (activeTab === 'notes') { %>
              <div class="content-header">
                <h1>My Notes</h1>
                <p>Private reflections and notes from previous sermons.</p>
              </div>
              
              <div class="notes-grid">
                <% if (notes && notes.length > 0) { %>
                  <% notes.forEach(n => { %>
                    <div class="glass-card note-card">
                      <div class="note-header">
                        <span class="note-date"><%= new Date(n.created_at).toLocaleDateString() %></span>
                        <span class="note-tag"><%= n.category || 'General' %></span>
                      </div>
                      <div class="note-body">
                        <%= n.note %>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="glass-card" style="text-align:center; padding: 60px; opacity: 0.5;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-bottom: 20px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <p>No notes saved yet. Start taking notes during our live broadcasts!</p>
                  </div>
                <% } %>
              </div>
            <% } %>

            <script>
              // CHART LOGIC
              <% if (activeTab === 'overview' && fullHistory) { %>
                const ctx = document.getElementById('givingChart');
                if (ctx) {
                  const history = <%- JSON.stringify(fullHistory) %>;
                  
                  // Group by month
                  const months = {};
                  history.forEach(d => {
                    const date = new Date(d.created_at);
                    const key = date.toLocaleString('default', { month: 'short' }) + ' ' + date.getFullYear();
                    months[key] = (months[key] || 0) + Number(d.amount);
                  });

                  new Chart(ctx, {
                    type: 'line',
                    data: {
                      labels: Object.keys(months),
                      datasets: [{
                        label: 'Partnership Growth (£)',
                        data: Object.values(months),
                        borderColor: 'rgba(113, 178, 128, 1)',
                        backgroundColor: 'rgba(113, 178, 128, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: 'rgba(113, 178, 128, 1)',
                        pointBorderColor: '#fff',
                        pointHoverRadius: 6
                      }]
                    },
                    options: {
                      responsive: true,
                      maintainAspectRatio: false,
                      plugins: {
                        legend: { display: false }
                      },
                      scales: {
                        y: { 
                          beginAtZero: true, 
                          grid: { color: 'rgba(255,255,255,0.05)' },
                          ticks: { color: 'rgba(255,255,255,0.4)', font: { size: 10 } }
                        },
                        x: { 
                          grid: { display: false },
                          ticks: { color: 'rgba(255,255,255,0.4)', font: { size: 10 } }
                        }
                      }
                    }
                  });
                }
              <% } %>
            </script>

          </main>
        </div>

        <%- include('../partials/footer') %>
                <!-- </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div> -->
</body>
</html>