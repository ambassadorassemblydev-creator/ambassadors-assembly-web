<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: #0c0c0c;">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <style>
          :root {
            --sidebar-width: 280px;
            --accent-blue: #3B6FB5;
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.06);
          }

          .dashboard-wrapper {
            display: flex;
            min-height: 100vh;
            padding-top: 80px; /* Offset for navbar */
            background: radial-gradient(circle at 0% 0%, rgba(59, 111, 181, 0.05) 0%, transparent 50%);
          }

          /* SIDEBAR */
          .dash-sidebar {
            width: var(--sidebar-width);
            height: calc(100vh - 80px);
            position: fixed;
            left: 0;
            top: 80px;
            padding: 40px 20px;
            border-right: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            background: rgba(12, 12, 12, 0.6);
            backdrop-filter: blur(20px);
            z-index: 100;
          }

          .sidebar-profile {
            padding-bottom: 30px;
            border-bottom: 1px solid var(--glass-border);
            margin-bottom: 30px;
          }
          .sidebar-profile .avatar {
            width: 60px;
            height: 60px;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--accent-blue), #1e293b);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 15px;
            color: white;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
          }
          .sidebar-profile h3 { font-size: 18px; margin: 0; font-family: 'Articulat CF Demi Bold'; }
          .sidebar-profile p { font-size: 12px; color: rgba(255,255,255,0.4); margin: 5px 0 0; }

          .nav-links { list-style: none; padding: 0; margin: 0; flex-grow: 1; }
          .nav-item { margin-bottom: 8px; }
          .nav-link {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 20px;
            border-radius: 12px;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
          }
          .nav-link:hover { background: rgba(255,255,255,0.05); color: white; }
          .nav-link.active {
            background: rgba(59, 111, 181, 0.1);
            color: var(--accent-blue);
            border-right: 3px solid var(--accent-blue);
          }
          .nav-link svg { width: 20px; height: 20px; }

          .sidebar-footer { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--glass-border); }
          .logout-btn {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 20px;
            color: #ef4444;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: 0.3s;
          }

          /* MAIN CONTENT AREA */
          .dash-content {
            margin-left: var(--sidebar-width);
            flex-grow: 1;
            padding: 60px 5%;
            width: calc(100% - var(--sidebar-width));
          }

          .content-header { margin-bottom: 50px; }
          .content-header h1 { font-family: 'Articulat CF Demi Bold'; font-size: 42px; margin: 0 0 10px; }
          .content-header p { color: rgba(255,255,255,0.4); font-size: 18px; }

          .glass-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 40px;
            backdrop-filter: blur(20px);
            animation: dashFadeUp 0.8s ease backwards;
          }

          /* TABS STYLING */
          .tab-content { display: none; }
          .tab-content.active { display: block; }

          .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; margin-bottom: 40px; }
          .stat-card { padding: 30px; border-radius: 20px; background: rgba(255,255,255,0.02); display: flex; align-items: flex-start; gap: 20px; border: 1px solid var(--glass-border); }
          .stat-icon { width: 50px; height: 50px; border-radius: 12px; background: rgba(59, 111, 181, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-blue); }
          .stat-val { font-size: 24px; font-weight: 800; display: block; }
          .stat-label { font-size: 12px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 1px; }

          /* ACTIVITY TABLES */
          .activity-list { width: 100%; border-collapse: collapse; }
          .activity-list th { text-align: left; padding: 15px 20px; font-size: 12px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid var(--glass-border); }
          .activity-list td { padding: 20px; border-bottom: 1px solid var(--glass-border); font-size: 14px; }
          .activity-list tr:last-child td { border-bottom: none; }
          
          .status-badge { padding: 4px 10px; border-radius: 50px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
          .status-paid, .status-active { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
          .status-pending { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }

          @keyframes dashFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

          /* RESPONSIVE */
          @media (max-width: 1024px) {
            .dash-sidebar { width: 80px; padding: 40px 10px; }
            .sidebar-profile, .nav-link span, .sidebar-footer span { display: none; }
            .dash-content { margin-left: 80px; width: calc(100% - 80px); }
            .nav-link { justify-content: center; padding: 14px 0; }
          }

          @media (max-width: 768px) {
            .dashboard-wrapper { flex-direction: column; }
            .dash-sidebar {
              position: fixed; bottom: 0; left: 0; top: auto; width: 100%; height: 70px;
              flex-direction: row; padding: 0; border-right: none; border-top: 1px solid var(--glass-border);
              justify-content: space-around; align-items: center;
            }
            .nav-links { display: flex; width: 100%; justify-content: space-around; }
            .nav-item { margin: 0; }
            .sidebar-footer { display: none; }
            .dash-content { margin: 0; width: 100%; padding: 40px 20px 100px; }
          }
        </style>

        <div class="dashboard-wrapper">
          <!-- SIDEBAR -->
          <aside class="dash-sidebar">
            <div class="sidebar-profile">
              <div class="avatar"><%= user.first_name[0] %></div>
              <h3><%= user.first_name %> <%= user.last_name %></h3>
              <p><%= user.member_id || 'Member' %></p>
            </div>

            <ul class="nav-links">
              <li class="nav-item">
                <a href="/my-account?tab=overview" class="nav-link <%= activeTab === 'overview' ? 'active' : '' %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span>Overview</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/my-account/profile" class="nav-link">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  <span>Edit Profile</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/my-account?tab=events" class="nav-link <%= activeTab === 'events' ? 'active' : '' %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  <span>My Events</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/my-account?tab=giving" class="nav-link <%= activeTab === 'giving' ? 'active' : '' %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                  <span>My Giving</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/my-account?tab=prayers" class="nav-link <%= activeTab === 'prayers' ? 'active' : '' %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  <span>My Prayers</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/departments" class="nav-link">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  <span>Departments</span>
                </a>
              </li>
            </ul>

            <div class="sidebar-footer">
              <a href="/logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                <span>Log Out</span>
              </a>
            </div>
          </aside>

          <!-- CONTENT -->
          <main class="dash-content">
            
            <% if (activeTab === 'overview') { %>
              <div class="content-header">
                <h1>The Hub</h1>
                <p>Hello, <%= user.first_name %>. Here is what's happening in your journey.</p>
              </div>

              <div class="grid-stats">
                <div class="stat-card">
                  <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
                  <div>
                    <span class="stat-val">Up Next</span>
                    <span class="stat-label">Youth Conference 2026</span>
                  </div>
                </div>
                <div class="stat-card">
                  <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
                  <div>
                    <span class="stat-val"><%= user.department_interest || 'None' %></span>
                    <span class="stat-label">Interest Area</span>
                  </div>
                </div>
              </div>

              <div class="glass-card">
                <h3 style="margin-top:0; margin-bottom:30px; font-family:'Articulat CF Demi Bold';">Recent Giving</h3>
                <table class="activity-list">
                  <thead>
                    <tr>
                      <th>Category</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (donations && donations.length > 0) { %>
                      <% donations.forEach(d => { %>
                        <tr>
                          <td><strong><%= d.donation_categories.name %></strong></td>
                          <td>£<%= d.amount %></td>
                          <td><span class="status-badge status-paid"><%= d.status %></span></td>
                          <td><%= new Date(d.created_at).toLocaleDateString() %></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="4" style="text-align:center; opacity:0.4; padding: 40px;">No giving records yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <% if (activeTab === 'events') { %>
              <div class="content-header">
                <h1>My Events</h1>
                <p>Events you've registered for or marked interest in.</p>
              </div>
              <div class="glass-card">
                <table class="activity-list">
                  <thead>
                    <tr>
                      <th>Event</th>
                      <th>Date</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (events && events.length > 0) { %>
                      <% events.forEach(reg => { %>
                        <tr>
                          <td><strong><%= reg.events.title %></strong></td>
                          <td><%= new Date(reg.events.start_date).toLocaleDateString() %></td>
                          <td><span class="status-badge status-active">Registered</span></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="3" style="text-align:center; opacity:0.4; padding: 40px;">No event registrations yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <% if (activeTab === 'prayers') { %>
              <div class="content-header">
                <h1>My Prayers</h1>
                <p>Keep track of your prayer requests and testimonies.</p>
              </div>
              <div class="glass-card">
                 <table class="activity-list">
                  <thead>
                    <tr>
                      <th>Request</th>
                      <th>Status</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (prayers && prayers.length > 0) { %>
                      <% prayers.forEach(p => { %>
                        <tr>
                          <td><strong><%= p.title %></strong></td>
                          <td><span class="status-badge status-pending"><%= p.status %></span></td>
                          <td><%= new Date(p.created_at).toLocaleDateString() %></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="3" style="text-align:center; opacity:0.4; padding: 40px;">No prayer requests yet.</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>

          </main>
        </div>

        <%- include('../partials/footer') %>
                </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>