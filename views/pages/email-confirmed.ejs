  </div> <!-- Closing dmwr -->

  <!-- AUTHENTICATION BRIDGE -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const handleAuthHash = async () => {
        const hash = window.location.hash;
        if (!hash || !hash.includes('access_token')) {
          // If no hash, maybe they are already logged in or just visiting.
          // But usually this page is reached via email link which HAS a hash.
          return;
        }

        // Show centered bridge UI
        const bridgeOverlay = document.getElementById('auth-bridge-overlay');
        if (bridgeOverlay) bridgeOverlay.style.display = 'flex';

        console.log("Auth hash detected, establishing session...");
        const params = new URLSearchParams(hash.substring(1));
        const session = {
          access_token: params.get('access_token'),
          refresh_token: params.get('refresh_token'),
          expires_in: params.get('expires_in'),
          token_type: params.get('token_type')
        };

        try {
          const response = await fetch('/api/auth/session', {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'x-csrf-token': document.getElementById("csrfToken")?.value
            },
            body: JSON.stringify({ session })
          });

          if (response.ok) {
            console.log("Session established successfully.");
            // We stay on this page to show the success message, 
            // but now the "Go to Dashboard" button will work because the cookie is set.
          }
        } catch (err) {
          console.error("Auth bridge failure:", err);
        }
      };

      handleAuthHash();
    });
  </script>
  <!-- AUTH BRIDGE OVERLAY (High IQ Cinematic Loader) -->
  <div id="auth-bridge-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(255,255,255,0.95); z-index:999999999; align-items:center; justify-content:center; flex-direction:column; backdrop-filter:blur(15px); transition:all 0.5s ease;">
    <div class="auth-bridge-spinner"></div>
    <h2 style="font-family:'var(--heading-font)', sans-serif; margin-top:25px; color:#1a1a1a; font-size: 28px;">Securing Your Session</h2>
    <p style="color:rgba(26,26,26,0.5); font-size:16px; margin-top: 12px;">Connecting to the Kingdom network...</p>
  </div>
</body>
</html>
