                  <!-- ======================================================== -->
                  <!-- PAGE SPECIFIC CSS (Cinematic Glassmorphism)              -->
                  <!-- ======================================================== -->
                  <style>
                    /* STRIP DUDA'S WHITE BACKGROUNDS & PADDING */
                    body.dmRoot, #dm, .dm_wrapper, .dmOuter, .dmInner, #site_content, .dmBody, #allWrapper, #dm_content, #dmFlexHeaderContainer, #flex-header {
                      background-color: transparent !important;
                      background-image: none !important;
                    }
                    #dmFlexHeaderContainer {
                      position: absolute !important;
                      top: 0; left: 0; width: 100%; z-index: 1000 !important;
                    }
                    #dmFirstContainer, #allWrapper, #dm_content {
                      margin: 0 !important; padding: 0 !important;
                    }

                    /* BACKGROUND & LAYOUT */
                    .auth-section {
                      position: relative;
                      width: 100%;
                      min-height: 100vh;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      padding: 160px 4% 60px; /* Accounts for absolute navbar */
                      background-image: url('https://res.cloudinary.com/dxwhpacz7/image/upload/q_auto/f_auto/v1775987631/45-dream-dark-blue-gradient.jpg');
                      background-size: cover;
                      background-position: center;
                      font-family: 'var(--body-font)', sans-serif;
                      color: #1a1a1a;
                    }

                    .confirmed-container {
                      background: #ffffff;
                      padding: 60px;
                      border-radius: 20px;
                      border: 1.5px solid rgba(26, 26, 26, 0.1);
                      text-align: center;
                      max-width: 500px;
                      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.05);
                    }

                    .success-icon-box {
                      background: rgba(113, 178, 128, 0.1);
                      padding: 15px;
                      border-radius: 50%;
                      width: 80px;
                      height: 80px;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      margin: 0 auto 30px;
                      border: 1.5px solid rgba(113, 178, 128, 0.2);
                    }

                    .confirmed-container h1 {
                      font-family: 'var(--heading-font)', sans-serif;
                      font-size: 32px;
                      margin: 0 0 15px 0;
                      color: #1a1a1a;
                    }

                    .confirmed-container p {
                      color: rgba(26, 26, 26, 0.5);
                      line-height: 1.6;
                      margin-bottom: 40px;
                      font-size: 16px;
                    }

                    .auth-submit-btn {
                      display: inline-block;
                      width: 100%;
                      padding: 16px;
                      border-radius: 12px;
                      background: #176a60;
                      border: 1.5px solid rgba(113, 178, 128, 0.3);
                      color: #ffffff;
                      font-family: 'var(--heading-font)', sans-serif;
                      font-size: 16px;
                      text-decoration: none;
                      transition: all 0.3s ease;
                      font-weight: 700;
                    }

                    .auth-submit-btn:hover {
                      background: #1a1a1a;
                      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
                    }
                  </style>

                  <!-- ======================================================== -->
                  <!-- EMAIL CONFIRMED HTML -->
                  <!-- ======================================================== -->
                  <section class="auth-section">
                    <div class="confirmed-container">
                      
                      <div class="success-icon-box">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#176a60" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </div>

                      <h1>Email Confirmed!</h1>
                      <p>Your account has been successfully verified. Welcome to the Ambassadors Assembly! Tap below to head to your dashboard and complete your onboarding.</p>

                      <style>
                        .auth-bridge-spinner { width:50px; height:50px; border:3px solid rgba(23, 106, 96, 0.1); border-top:3px solid #176a60; border-radius:50%; animation:spin-bridge 1s linear infinite; }
                        @keyframes spin-bridge { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
                      </style>

                      <input type="hidden" id="csrfToken" value="<%= locals.csrfToken %>">
                      <a href="/onboarding" class="auth-submit-btn">Go to Dashboard</a>
                      
                    </div>
                  </section>
                  <!-- ======================================================== -->
                  <!-- END EMAIL CONFIRMED HTML -->
                  <!-- ======================================================== -->
