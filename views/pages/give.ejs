<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <main class="give-page">
          
          <!-- AMBIENT BG -->
          <div class="give-bg">
            <div class="bg-overlay"></div>
            <img src="https://images.unsplash.com/photo-1510531704581-5b2870972060?q=80&w=2073&auto=format&fit=crop" alt="Worship Background" class="bg-img">
          </div>

          <div class="give-content">
            
            <header class="give-header gsap-up">
              <span class="give-subtitle">Generosity in Action</span>
              <h1 class="give-title">Believe in<br>The Harvest</h1>
              <p class="give-intro">Your partnership enables us to share the gospel of Jesus Christ across nations and transform lives through the power of God.</p>
            </header>

            <div class="give-grid">
              
              <!-- LEFT: THE WHY -->
              <section class="give-manifesto gsap-up">
                <div class="manifesto-card glass-fx">
                  <div class="verse">
                    <p>"Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver."</p>
                    <span class="ref">— 2 Corinthians 9:7</span>
                  </div>
                  
                  <div class="impact-stats">
                    <div class="stat">
                      <span class="stat-num">100%</span>
                      <span class="stat-label">Towards Ministry</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num">Global</span>
                      <span class="stat-label">Impact Reach</span>
                    </div>
                  </div>
                </div>
              </section>

              <!-- RIGHT: THE SEED (FORM) -->
              <aside class="give-form-aside gsap-up">
                <div class="give-card glass-fx">
                  <h3>Select Seed Amount</h3>
                  
                  <div class="amount-presets">
                    <button class="preset-btn" data-amt="5000">₦5,000</button>
                    <button class="preset-btn active" data-amt="10000">₦10,000</button>
                    <button class="preset-btn" data-amt="25000">₦25,000</button>
                    <button class="preset-btn" data-amt="50000">₦50,000</button>
                  </div>

                  <div class="custom-amount">
                    <span class="currency-label">₦</span>
                    <input type="number" id="custom-amt" placeholder="Other Amount" min="1">
                  </div>

                  <div class="fund-select">
                    <div class="aa-select" id="fundSelectWrapper">
                      <div class="aa-select__trigger" id="fundTrigger">
                        <span id="fundSelectedName"><%= categories[0].name %></span>
                        <i class="fas fa-chevron-down"></i>
                      </div>
                      <div class="aa-select__options" id="fundOptions">
                        <% categories.forEach((cat, idx) => { %>
                          <div class="aa-select__option <%= idx === 0 ? 'selected' : '' %>" data-value="<%= cat.id %>" data-name="<%= cat.name %>">
                            <%= cat.name %>
                          </div>
                        <% }) %>
                      </div>
                      <input type="hidden" id="fund-type" value="<%= categories[0].id %>">
                    </div>
                  </div>

                  <div class="custom-amount" style="margin-top: -10px;">
                    <input type="text" id="give-reason" placeholder="Reason for giving (Optional)" style="width: 100%; background: #fafafa; border: 1.5px solid rgba(26, 26, 26, 0.1); border-radius: 12px; padding: 16px; color: #1a1a1a; font-size: 0.9rem; font-weight: 600; outline: none; transition: 0.3s; margin-bottom: 30px;">
                  </div>

                  <button class="give-submit-btn" onclick="initiateGiving()">Partner Now</button>

                  <div class="security-badges">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span>Secure encrypted partnership</span>
                  </div>
                </div>
              </aside>

            </div>

          </div>
        </main>

      <!-- </div>
    </div>
  </div> -->

  <%- include('../partials/footer') %>

  <style>
    :root {
      --accent: var(--aa-green);
      --accent-dark: #1a1a1a;
      --glass: #ffffff;
      --glass-border: rgba(26, 26, 26, 0.1);
    }

    .give-page { position: relative; min-height: 100vh; overflow-x: hidden; }

    /* Background Immersive */
    .give-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
    .bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.1; filter: contrast(1.1) grayscale(1); }
    .bg-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: var(--color_1); }

    /* Content Layout */
    .give-content { max-width: 1400px; margin: 0 auto; padding: 180px 6% 120px; }
    
    .give-header { margin-bottom: 80px; max-width: 800px; }
    .give-subtitle { display: block; font-family: 'Manrope', sans-serif; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4em; color: var(--aa-green); margin-bottom: 20px; }
    .give-title { font-family: 'Manrope', sans-serif; font-size: clamp(3rem, 7vw, 6.5rem); font-weight: 950; line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 30px; color: #1a1a1a; }
    .give-intro { font-size: 1.15rem; line-height: 1.6; color: rgba(26, 26, 26, 0.6); max-width: 600px; }

    .give-grid { display: grid; grid-template-columns: 1fr 440px; gap: 60px; align-items: start; }

    .glass-fx { background: #ffffff; border: 1.5px solid rgba(26, 26, 26, 0.1); border-radius: 32px; padding: 50px; box-shadow: 0 20px 50px rgba(0,0,0,0.05); }

    /* Manifesto */
    .verse { font-style: italic; font-size: 1.4rem; line-height: 1.6; margin-bottom: 40px; color: #1a1a1a; position: relative; }
    .verse::before { content: '"'; position: absolute; left: -25px; top: -10px; font-size: 4rem; opacity: 0.1; font-family: serif; color: var(--aa-green); }
    .ref { display: block; font-size: 0.85rem; font-weight: 700; font-style: normal; margin-top: 15px; opacity: 0.4; text-transform: uppercase; letter-spacing: 1px; color: #1a1a1a; }

    .impact-stats { display: flex; gap: 40px; margin-top: 60px; padding-top: 40px; border-top: 1.5px solid rgba(26, 26, 26, 0.1); }
    .stat-num { display: block; font-size: 2.5rem; font-weight: 900; color: #1a1a1a; margin-bottom: 5px; }
    .stat-label { font-size: 0.75rem; text-transform: uppercase; opacity: 0.4; letter-spacing: 1px; font-weight: 700; color: #1a1a1a; }

    /* Give Card / Form */
    .give-card { box-shadow: 0 40px 100px rgba(0,0,0,0.05); }
    .give-card h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: 30px; text-align: center; color: #1a1a1a; }

    .amount-presets { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px; }
    .preset-btn { 
      padding: 16px; border-radius: 12px; border: 1.5px solid rgba(26, 26, 26, 0.1); background: #fafafa;
      color: #1a1a1a; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: 0.3s;
    }
    .preset-btn:hover { background: #f0f0f0; }
    .preset-btn.active { background: #1a1a1a; color: white; border-color: #1a1a1a; }

    .custom-amount { position: relative; margin-bottom: 20px; }
    .currency-label { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); font-weight: 700; opacity: 0.4; }
    #custom-amt { 
      width: 100%; background: #fafafa; border: 1.5px solid rgba(26, 26, 26, 0.1); border-radius: 12px;
      padding: 16px 16px 16px 40px; color: #1a1a1a; font-size: 1.1rem; outline: none; font-weight: 700;
      transition: 0.3s;
    }
    #custom-amt:focus { border-color: var(--aa-green); }

    .fund-select { margin-bottom: 30px; }
    .aa-select { position: relative; width: 100%; user-select: none; }
    .aa-select__trigger {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px; background: #fafafa; border: 1.5px solid rgba(26, 26, 26, 0.1);
      border-radius: 12px; cursor: pointer; font-size: 0.95rem; font-weight: 700;
      color: #1a1a1a; transition: 0.3s;
    }
    .aa-select__trigger:hover { border-color: var(--aa-green); background: #fff; }
    .aa-select__trigger i { font-size: 0.8rem; opacity: 0.4; transition: transform 0.3s; }
    .aa-select.open .aa-select__trigger i { transform: rotate(180deg); }
    
    .aa-select__options {
      position: absolute; top: calc(100% + 10px); left: 0; width: 100%;
      background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px);
      border: 1.5px solid rgba(26, 26, 26, 0.1); border-radius: 16px;
      padding: 8px; z-index: 100; box-shadow: 0 20px 40px rgba(0,0,0,0.1);
      opacity: 0; visibility: hidden; transform: translateY(10px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .aa-select.open .aa-select__options { opacity: 1; visibility: visible; transform: translateY(0); }
    
    .aa-select__option {
      padding: 12px 16px; border-radius: 8px; cursor: pointer;
      font-size: 0.9rem; font-weight: 600; color: #1a1a1a; transition: 0.2s;
    }
    .aa-select__option:hover { background: var(--g-up); color: var(--aa-green); }
    .aa-select__option.selected { background: var(--aa-green); color: #fff; }

    .give-submit-btn {
      width: 100%; padding: 20px; border-radius: 100px; background: #1a1a1a; color: white;
      font-weight: 900; font-size: 1.1rem; border: none; cursor: pointer; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .give-submit-btn:hover { background: var(--aa-green); transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
    .give-submit-btn:active { transform: translateY(0); background: #115048; color: white !important; }
    .give-submit-btn:active { transform: translateY(0); background: #115048; color: white !important; }

    .security-badges { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 25px; opacity: 0.3; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }

    @media (max-width: 1000px) {
      .give-grid { grid-template-columns: 1fr; }
      .give-content { padding-top: 140px; }
      .give-title { font-size: 3.5rem; }
      .give-card { order: -1; }
    }
  </style>

  <script>
    window.addEventListener('load', () => {
      gsap.from('.gsap-up', {
        y: 40, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power3.out'
      });
    });

    // Preset logic
    const presets = document.querySelectorAll('.preset-btn');
    const customInp = document.getElementById('custom-amt');

    presets.forEach(btn => {
      btn.addEventListener('click', () => {
        presets.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        customInp.value = '';
      });
    });

    customInp.addEventListener('input', () => {
      if(customInp.value) {
        presets.forEach(b => b.classList.remove('active'));
      }
    });

    // Custom Dropdown Logic
    const trigger = document.getElementById('fundTrigger');
    const wrapper = document.getElementById('fundSelectWrapper');
    const options = document.querySelectorAll('.aa-select__option');
    const hiddenInp = document.getElementById('fund-type');
    const selectedName = document.getElementById('fundSelectedName');

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      wrapper.classList.toggle('open');
    });

    options.forEach(opt => {
      opt.addEventListener('click', () => {
        const val = opt.dataset.value;
        const name = opt.dataset.name;
        
        hiddenInp.value = val;
        selectedName.textContent = name;
        
        options.forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        
        wrapper.classList.remove('open');
      });
    });

    document.addEventListener('click', () => {
      wrapper.classList.remove('open');
    });

    /**
     * ============================================================
     * initiateGiving() — Server-Side Initialization Flow
     * ============================================================
     * 1. Collects amount, category, and email from the form
     * 2. Calls POST /api/payments/initialize on the server
     *    → Server generates a unique reference + idempotency key
     *    → Server creates a pending donation in the database
     *    → Server calls Paystack API to initialize the transaction
     *    → Server returns the access_code for PaystackPop
     * 3. Opens PaystackPop with the server-provided access_code
     * 4. On success, calls POST /api/payments/verify to finalize
     * 
     * DOUBLE-PAYMENT PROTECTION:
     * - Server generates the reference (can't be spoofed)
     * - Idempotency key blocks duplicate intents within 5 minutes
     * - DB UNIQUE constraint on reference prevents double inserts
     * - Status check (pending→completed) prevents double completions
     * ============================================================
     */
    async function initiateGiving() {
      const payBtn = document.querySelector('.give-submit-btn');
      const activePreset = document.querySelector('.preset-btn.active');
      let amount = customInp.value || (activePreset ? activePreset.dataset.amt : null);
      let fund = document.getElementById('fund-type').value;
      let fundName = document.getElementById('fundSelectedName').textContent;
      let reason = document.getElementById('give-reason').value;
      
      // Resolve Email from session
      const email = "<%= locals.user ? locals.user.email : '' %>";
      
      // ── Validation ──────────────────────────────────────────
      if (!amount || isNaN(amount) || amount < 100) {
        showToast('Please enter a valid seed amount (minimum ₦100)', 'error');
        return;
      }

      if (!email) {
        showToast('Please sign in to partner with us, or use the Building Fund for guest giving.', 'info');
        setTimeout(() => window.location.href = '/account/login?redirect=/give', 2000);
        return;
      }

      // ── 🛡️ DOUBLE-PAYMENT PROTECTION: Disable button immediately ──
      payBtn.disabled = true;
      payBtn.textContent = "Initializing Secure Payment...";

      try {
        // ── Step 1: Get reCAPTCHA token (if available) ────────
        let recaptchaToken = null;
        if (typeof grecaptcha !== 'undefined') {
          recaptchaToken = await new Promise((resolve) => {
            grecaptcha.ready(() => {
              grecaptcha.execute('<%= locals.recaptchaSiteKey %>', { action: 'donation_init' }).then(resolve);
            });
          });
        }

        // ── Step 2: Initialize payment on the server ──────────
        // The server generates a unique reference, creates a pending
        // donation, and calls Paystack API to get the access_code.
        const initRes = await fetch('/api/payments/initialize', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= locals.csrfToken %>'
          },
          body: JSON.stringify({
            email: email,
            amount: parseFloat(amount),
            categoryId: fund,
            donationType: fundName || 'General',
            notes: reason,
            'g-recaptcha-response': recaptchaToken
          })
        });

        const initResult = await initRes.json();

        if (!initResult.success) {
          showToast(initResult.message || 'Could not initialize payment. Please try again.', 'error');
          payBtn.disabled = false;
          payBtn.textContent = "Partner Now";
          return;
        }

        // ── Step 3: Open Paystack checkout with server access code ──
        payBtn.textContent = "Opening Secure Checkout...";

        const handler = PaystackPop.setup({
          key: "<%= paystackPublicKey %>",
          email: email,
          amount: parseFloat(amount) * 100, // Kobo
          currency: "NGN",
          ref: initResult.reference, // Server-generated reference (not client-generated)
          access_code: initResult.access_code, // Server-provided access code
          callback: async function(response) {
            try {
              payBtn.textContent = "Verifying Seed...";

              // ── Step 4: Verify payment on the server ────────
              // Server re-verifies with Paystack API and updates
              // the donation status to 'completed'.
              const verifyRes = await fetch('/api/payments/verify', {
                method: 'POST',
                headers: { 
                  'Content-Type': 'application/json',
                  'X-CSRF-Token': '<%= locals.csrfToken %>'
                },
                body: JSON.stringify({
                  reference: response.reference,
                  'g-recaptcha-response': recaptchaToken
                })
              });

              const result = await verifyRes.json();
              
              if (result.success) {
                showToast('Seed received with Honor! Thank you for your partnership.', 'success');
                // Redirect to the confirmation page with the receipt reference
                setTimeout(() => window.location.href = `/confirmation?type=donation&reference=${result.donation?.receipt_number || response.reference}&amount=${amount}&category=${encodeURIComponent(fundName || 'General Giving')}&email=${encodeURIComponent(email)}`, 2000);
              } else {
                showToast('Verification issue: ' + (result.message || 'Please contact support with reference: ' + response.reference), 'error');
                payBtn.disabled = false;
                payBtn.textContent = "Partner Now";
              }
            } catch (err) {
              console.error('[Giving] Verify Error:', err);
              showToast('Network error during verification. Your payment is safe. Reference: ' + response.reference, 'error');
              payBtn.disabled = false;
              payBtn.textContent = "Partner Now";
            }
          },
          onClose: function() {
            payBtn.disabled = false;
            payBtn.textContent = "Partner Now";
            showToast('Transaction cancelled.', 'info');
          }
        });
        handler.openIframe();

      } catch (err) {
        console.error('[Giving] Init Error:', err);
        showToast('Could not connect to payment server. Please try again.', 'error');
        payBtn.disabled = false;
        payBtn.textContent = "Partner Now";
      }
    }
  </script>
  <script src="https://js.paystack.co/v1/inline.js"></script>
</body>
</html>

