<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main class="proj-detail">
      <!-- HERO (EMPHASIS ON IMAGE) -->
      <section class="proj-hero">
        <div class="proj-hero__bg">
          <div class="proj-hero__overlay"></div>
          <img src="<%= (project.media_urls && project.media_urls[0]) || 'https://images.unsplash.com/photo-1541888946425-d81bb19480c5?q=80&w=2670' %>" alt="<%= project.name %>" class="proj-hero__img">
        </div>
        <div class="proj-hero__content">
           <a href="/fund-the-buildings" class="back-link">&larr; Back to Projects</a>
           <span class="sub-label">Building Project</span>
           <h1><%= project.name %></h1>
        </div>
      </section>

      <!-- CONTENT SPLIT LAYOUT -->
      <div class="proj-container">
        
        <div class="proj-main-content">
          <!-- VISION QUOTE -->
          <% if (project.quote) { %>
            <div class="vision-quote glass-fx">
              <p>"<%= project.quote %>"</p>
              <cite>— <%= project.quote_author || 'Presiding Pastor' %></cite>
            </div>
          <% } %>

          <div class="proj-story">
            <h2>The <span class="text-green">Vision</span></h2>
            <div class="story-text">
              <p><%= project.long_description || project.description %></p>
            </div>
          </div>

          <!-- GALLERY -->
          <% if (project.media_urls && project.media_urls.length > 1) { %>
            <div class="proj-gallery">
              <h2>Visual <span class="text-green">Manifesto</span></h2>
              <div class="gallery-grid">
                <% project.media_urls.slice(1).forEach((url, i) => { %>
                  <div class="gallery-item glass-fx">
                    <img src="<%= url %>" alt="Perspective <%= i+1 %>">
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- GIVING SIDEBAR -->
        <aside class="proj-sidebar">
          <div class="sidebar-card glass-fx sticky-sidebar">
            <div class="sidebar-header">
              <h3>Participate in the <span class="text-green">Legacy</span></h3>
              <p>Your seed today secures the sanctuary of tomorrow.</p>
            </div>

            <% if (project.show_progress) { %>
              <div class="sidebar-progress">
                <div class="prog-meta">
                  <span><%= Math.round((project.current_amount / project.goal_amount) * 100) %>% RAISED</span>
                  <span>₦<%= (project.goal_amount / 1000000).toFixed(1) %>M GOAL</span>
                </div>
                <div class="prog-bar"><div class="prog-fill" style="width: <%= Math.min(100, (project.current_amount / project.goal_amount) * 100) %>%"></div></div>
              </div>
            <% } %>

            <div class="giving-form">
              <label>Select Amount (NGN)</label>
              <div class="amount-grid">
                <button class="amount-btn" onclick="setAmount(5000)">₦5k</button>
                <button class="amount-btn" onclick="setAmount(20000)">₦20k</button>
                <button class="amount-btn" onclick="setAmount(50000)">₦50k</button>
                <button class="amount-btn" onclick="setAmount(100000)">₦100k</button>
              </div>
              <input type="number" id="custom-amount" placeholder="Or Enter Custom Amount" class="amount-input">
              
              <!-- HIGH IQ: Guest Email Resolution -->
              <% if (!locals.user) { %>
                <div class="guest-identity" style="margin-bottom: 20px;">
                  <label style="opacity: 0.5; font-size: 11px;">Receipt Email</label>
                  <input type="email" id="donor-email" placeholder="email@example.com" class="amount-input" style="margin-bottom: 0;">
                </div>
              <% } %>

              <button class="pay-btn" id="project-pay-btn" onclick="payWithPaystack()">Plant Your Seed &rarr;</button>
              <p class="secure-label">Secure Transaction via Paystack</p>
            </div>
          </div>
        </aside>

      </div>
    </main>

    <%- include('../partials/footer') %>
 

  <style>
    /* ... existing styles ... */
    .pay-btn:disabled { opacity: 0.5; cursor: not-allowed; filter: grayscale(1); }
  </style>

  <script src="https://js.paystack.co/v1/inline.js"></script>
  <script>
    function setAmount(amt) {
      document.getElementById('custom-amount').value = amt;
    }

    function payWithPaystack() {
      const amountInp = document.getElementById('custom-amount');
      const payBtn = document.getElementById('project-pay-btn');
      const amount = amountInp.value;
      
      // Resolve Email
      const userEmail = "<%= locals.user ? locals.user.email : '' %>";
      const guestEmail = document.getElementById('donor-email')?.value;
      const email = userEmail || guestEmail;

      if (!amount || amount < 100) {
        showToast('Please enter a valid seed amount (minimum ₦100)', 'error');
        return;
      }

      if (!email || !email.includes('@')) {
        showToast('Please provide a valid email for your receipt.', 'error');
        document.getElementById('donor-email')?.focus();
        return;
      }

      // 🛡️ DOUBLE-PAYMENT PROTECTION
      payBtn.disabled = true;
      payBtn.textContent = "Opening Secure Checkout...";

      const handler = PaystackPop.setup({
        key: '<%= locals.PAYSTACK_PUBLIC_KEY %>',
        email: email,
        amount: amount * 100, // Kobo
        currency: "NGN",
        ref: 'AA-PROJ-' + Math.floor((Math.random() * 1e9) + 1),
        metadata: {
          custom_fields: [
            { display_name: "Project", variable_name: "project", value: "<%= project.name %>" },
            { display_name: "Type", variable_name: "type", value: "building_fund" }
          ]
        },
        callback: async function(response) {
          try {
            payBtn.textContent = "Verifying Seed...";
            
            const verifyRes = await fetch('/api/payments/verify', {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= locals.csrfToken %>'
               },
              body: JSON.stringify({
                reference: response.reference,
                amount: amount,
                categoryId: '<%= project.id %>',
                type: 'building_fund',
                email: email
              })
            });

            const result = await verifyRes.json();
            
            if (result.success) {
              showToast('Thank you for your seed! Your kingdom investment has been logged.', 'success');
              setTimeout(() => location.reload(), 2000);
            } else {
              showToast('Payment verify issue: ' + (result.message || 'Check reference'), 'error');
              payBtn.disabled = false;
              payBtn.textContent = "Plant Your Seed →";
            }
          } catch (err) {
            console.error('[Payment] Verify Error:', err);
            showToast('Network error during verification. Reference: ' + response.reference, 'error');
          }
        },
        onClose: function() {
          payBtn.disabled = false;
          payBtn.textContent = "Plant Your Seed →";
          showToast('Transaction cancelled.', 'info');
        }
      });
      handler.openIframe();
    }
  </script>
</body>
</html>
