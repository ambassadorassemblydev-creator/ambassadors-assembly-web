<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main class="proj-detail">
      <!-- HERO (EMPHASIS ON IMAGE) -->
      <section class="proj-hero">
        <div class="proj-hero__bg">
          <div class="proj-hero__overlay"></div>
          <img src="<%= (project.media_urls && project.media_urls[0]) || 'https://images.unsplash.com/photo-1541888946425-d81bb19480c5?q=80&w=2670' %>" alt="<%= project.name %>" class="proj-hero__img">
        </div>
        <div class="proj-hero__content">
           <a href="/fund-the-buildings" class="back-link">&larr; Back to Projects</a>
           <span class="sub-label">Building Project</span>
           <h1><%= project.name %></h1>
        </div>
      </section>

      <!-- CONTENT SPLIT LAYOUT -->
      <div class="proj-container">
        
        <div class="proj-main-content">
          <!-- VISION QUOTE -->
          <% if (project.quote) { %>
            <div class="vision-quote glass-fx">
              <p>"<%= project.quote %>"</p>
              <cite>— <%= project.quote_author || 'Presiding Pastor' %></cite>
            </div>
          <% } %>

          <div class="proj-story">
            <h2>The <span class="text-green">Vision</span></h2>
            <div class="story-text">
              <p><%= project.long_description || project.description %></p>
            </div>
          </div>

          <!-- GALLERY -->
          <% if (project.media_urls && project.media_urls.length > 1) { %>
            <div class="proj-gallery">
              <h2>Visual <span class="text-green">Manifesto</span></h2>
              <div class="gallery-grid">
                <% project.media_urls.slice(1).forEach((url, i) => { %>
                  <div class="gallery-item glass-fx">
                    <img src="<%= url %>" alt="Perspective <%= i+1 %>">
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- GIVING SIDEBAR -->
        <aside class="proj-sidebar">
          <div class="sidebar-card glass-fx sticky-sidebar">
            <div class="sidebar-header">
              <h3>Participate in the <span class="text-green">Legacy</span></h3>
              <p>Your seed today secures the sanctuary of tomorrow.</p>
            </div>

            <% if (project.show_progress) { %>
              <div class="sidebar-progress">
                <div class="prog-meta">
                  <span><%= Math.round((project.current_amount / project.goal_amount) * 100) %>% RAISED</span>
                  <span>₦<%= (project.goal_amount / 1000000).toFixed(1) %>M GOAL</span>
                </div>
                <div class="prog-bar"><div class="prog-fill" style="width: <%= Math.min(100, (project.current_amount / project.goal_amount) * 100) %>%"></div></div>
              </div>
            <% } %>

            <div class="giving-form">
              <label>Select Amount (NGN)</label>
              <div class="amount-grid">
                <button class="amount-btn" onclick="setAmount(5000)">₦5k</button>
                <button class="amount-btn" onclick="setAmount(20000)">₦20k</button>
                <button class="amount-btn" onclick="setAmount(50000)">₦50k</button>
                <button class="amount-btn" onclick="setAmount(100000)">₦100k</button>
              </div>
              <input type="number" id="custom-amount" placeholder="Or Enter Custom Amount" class="amount-input">
              
              <button class="pay-btn" onclick="payWithPaystack()">Plant Your Seed &rarr;</button>
              <p class="secure-label">Secure Transaction via Paystack 🛡️</p>
            </div>
          </div>
        </aside>

      </div>
    </main>

    <%- include('../partials/footer') %>
 

  <style>
    :root { --aa-green: #22c55e; --aa-bg: #050505; }
    .text-green { color: var(--aa-green); }

    .proj-detail { background: var(--aa-bg); min-height: 100vh; }
    
    .proj-hero { position: relative; height: 60vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .proj-hero__bg { position: absolute; top:0; left:0; width:100%; height:100%; z-index:1; }
    .proj-hero__img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; }
    .proj-hero__overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, transparent, var(--aa-bg)); z-index:2; }
    .proj-hero__content { position: relative; z-index: 3; text-align: center; }
    .proj-hero h1 { font-size: clamp(3rem, 8vw, 6rem); font-weight: 900; letter-spacing: -0.04em; margin-bottom: 20px; }
    .sub-label { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: 5px; color: var(--aa-green); text-transform: uppercase; margin-bottom: 20px; }
    .back-link { position: absolute; top: -60px; left: 50%; transform: translateX(-50%); font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); text-decoration: none; font-weight: 800; }

    .proj-container { max-width: 1400px; margin: 0 auto; padding: 60px 6% 150px; display: grid; grid-template-columns: 1fr 400px; gap: 60px; }
    
    .vision-quote { padding: 40px; border-radius: 30px; margin-bottom: 60px; border-left: 4px solid var(--aa-green); }
    .vision-quote p { font-size: 1.5rem; font-style: italic; line-height: 1.6; color: rgba(255,255,255,0.8); margin-bottom: 20px; }
    .vision-quote cite { font-size: 0.8rem; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; color: var(--aa-green); opacity: 0.7; }

    .proj-story h2, .proj-gallery h2 { font-size: 2.5rem; margin-bottom: 30px; letter-spacing: -0.02em; font-weight: 800; }
    .story-text { font-size: 1.25rem; line-height: 1.8; color: rgba(255,255,255,0.6); }

    .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
    .gallery-item { border-radius: 20px; overflow: hidden; aspect-ratio: 4/3; }
    .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: 1s; }
    .gallery-item:hover img { transform: scale(1.05); }

    /* SIDEBAR */
    .proj-sidebar { position: relative; }
    .sticky-sidebar { position: sticky; top: 100px; padding: 40px; border-radius: 40px; }
    .sidebar-header h3 { font-size: 1.5rem; margin-bottom: 15px; }
    .sidebar-header p { font-size: 0.9rem; color: rgba(255,255,255,0.5); line-height: 1.5; margin-bottom: 30px; }

    .sidebar-progress { margin-bottom: 40px; }
    .prog-meta { display: flex; justify-content: space-between; font-size: 0.65rem; font-weight: 900; color: rgba(255,255,255,0.4); margin-bottom: 10px; }
    .prog-bar { height: 6px; background: rgba(255,255,255,0.05); border-radius: 100px; overflow: hidden; }
    .prog-fill { height: 100%; background: var(--aa-green); border-radius: 100px; }

    .giving-form label { display: block; font-size: 0.7rem; font-weight: 900; letter-spacing: 1px; margin-bottom: 15px; opacity: 0.5; }
    .amount-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
    .amount-btn { padding: 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: transparent; color: white; cursor: pointer; font-weight: 800; transition: 0.3s; }
    .amount-btn:hover { background: rgba(34, 197, 94, 0.1); border-color: var(--aa-green); }
    .amount-input { width: 100%; padding: 15px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; margin-bottom: 25px; }

    .pay-btn { width: 100%; padding: 18px; border-radius: 100px; background: var(--aa-green); border: none; color: white; font-weight: 900; font-size: 0.9rem; cursor: pointer; transition: 0.3s; box-shadow: 0 10px 20px rgba(34, 197, 94, 0.2); }
    .pay-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(34, 197, 94, 0.4); }
    .secure-label { text-align: center; font-size: 0.65rem; margin-top: 15px; opacity: 0.3; }

    .glass-fx { background: rgba(255,255,255,0.03); backdrop-filter: blur(40px); border: 1px solid rgba(255,255,255,0.08); }

    @media (max-width: 1100px) {
      .proj-container { grid-template-columns: 1fr; }
      .proj-sidebar { margin-top: 40px; }
      .sticky-sidebar { position: relative; top: 0; }
    }
  </style>

  <script src="https://js.paystack.co/v1/inline.js"></script>
  <script>
    function setAmount(amt) {
      document.getElementById('custom-amount').value = amt;
    }

    function payWithPaystack() {
      const amount = document.getElementById('custom-amount').value;
      if (!amount || amount < 100) {
        window.AA.alert('Please enter a valid seed amount (minimum ₦100)');
        return;
      }

      // HIGH IQ: Reusing the standard Paystack logic from give.ejs
      const handler = PaystackPop.setup({
        key: '<%= locals.PAYSTACK_PUBLIC_KEY %>',
        email: 'donor@ambassadors-assembly.cc', // Dynamic email placeholder
        amount: amount * 100, // Kobo
        currency: "NGN",
        metadata: {
          custom_fields: [{ display_name: "Project", variable_name: "project", value: "<%= project.name %>" }]
        },
        callback: function(response) {
          window.AA.alert('Thank you for your seed! Your kingdom investment has been logged.', 'Success');
          location.reload();
        },
        onClose: function() {
          window.AA.alert('Transaction cancelled.');
        }
      });
      handler.openIframe();
    }
  </script>
</body>
</html>
