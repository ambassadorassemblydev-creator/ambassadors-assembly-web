<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main class="proj-detail">
      <!-- HERO (EMPHASIS ON IMAGE) -->
      <section class="proj-hero">
        <div class="proj-hero__bg">
          <div class="proj-hero__overlay"></div>
          <img src="<%= (project.media_urls && project.media_urls[0]) || 'https://images.unsplash.com/photo-1541888946425-d81bb19480c5?q=80&w=2670' %>" alt="<%= project.name %>" class="proj-hero__img">
        </div>
        <div class="proj-hero__content">
           <a href="/fund-the-buildings" class="back-link">&larr; Back to Projects</a>
           <span class="sub-label">Building Project</span>
           <h1><%= project.name %></h1>
        </div>
      </section>

      <!-- CONTENT SPLIT LAYOUT -->
      <div class="proj-container">
        
        <div class="proj-main-content">
          <!-- VISION QUOTE -->
          <% if (project.quote) { %>
            <div class="vision-quote glass-fx">
              <p>"<%= project.quote %>"</p>
              <cite>— <%= project.quote_author || 'Presiding Pastor' %></cite>
            </div>
          <% } %>

          <div class="proj-story">
            <h2>The <span class="text-green">Vision</span></h2>
            <div class="story-text">
              <p><%= project.long_description || project.description %></p>
            </div>
          </div>

          <!-- GALLERY -->
          <% if (project.media_urls && project.media_urls.length > 1) { %>
            <div class="proj-gallery">
              <h2>Visual <span class="text-green">Manifesto</span></h2>
              <div class="gallery-grid">
                <% project.media_urls.slice(1).forEach((url, i) => { %>
                  <div class="gallery-item glass-fx">
                    <img src="<%= url %>" alt="Perspective <%= i+1 %>">
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- GIVING SIDEBAR -->
        <aside class="proj-sidebar">
          <div class="sidebar-card glass-fx sticky-sidebar">
            <div class="sidebar-header">
              <h3>Participate in the <span class="text-green">Legacy</span></h3>
              <p>Your seed today secures the sanctuary of tomorrow.</p>
            </div>

            <% if (project.show_progress) { %>
              <div class="sidebar-progress">
                <div class="prog-meta">
                  <span><%= Math.round((project.current_amount / project.goal_amount) * 100) %>% RAISED</span>
                  <span>₦<%= (project.goal_amount / 1000000).toFixed(1) %>M GOAL</span>
                </div>
                <div class="prog-bar"><div class="prog-fill" style="width: <%= Math.min(100, (project.current_amount / project.goal_amount) * 100) %>%"></div></div>
              </div>
            <% } %>

            <div class="giving-form">
              <label>Select Amount (NGN)</label>
              <div class="amount-grid">
                <button class="amount-btn" onclick="setAmount(5000)">₦5k</button>
                <button class="amount-btn" onclick="setAmount(20000)">₦20k</button>
                <button class="amount-btn" onclick="setAmount(50000)">₦50k</button>
                <button class="amount-btn" onclick="setAmount(100000)">₦100k</button>
              </div>
              <input type="number" id="custom-amount" placeholder="Or Enter Custom Amount" class="amount-input">
              
              <!-- HIGH IQ: Guest Email Resolution -->
              <% if (!locals.user) { %>
                <div class="guest-identity" style="margin-bottom: 20px;">
                  <label style="opacity: 0.5; font-size: 11px;">Receipt Email</label>
                  <input type="email" id="donor-email" placeholder="email@example.com" class="amount-input" style="margin-bottom: 0;">
                </div>
              <% } %>

              <button class="pay-btn" id="project-pay-btn" onclick="payWithPaystack()">Plant Your Seed &rarr;</button>
              <p class="secure-label">Secure Transaction via Paystack</p>
            </div>
          </div>
        </aside>

      </div>
    </main>

    <%- include('../partials/footer') %>
 

  <style>
    :root {
      --aa-green: #176a60;
    }
    
    .project-detail-main { background: var(--color_1, #ffffff); min-height: 100vh; color: #1a1a1a; }
    .text-green { color: var(--aa-green); }

    .proj-detail { padding-bottom: 150px; background: var(--color_1, #ffffff); }

    /* Hero */
    .proj-hero {
      position: relative; height: 75vh; min-height: 500px; width: 100%;
      display: flex; align-items: flex-end; padding: 180px 6% 100px 6%;
      overflow: hidden;
    }
    .proj-hero__bg { position: absolute; top:0; left:0; width:100%; height:100%; z-index: 1; }
    .proj-hero__img { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }
    .proj-hero__overlay { 
      position: absolute; top:0; left:0; width:100%; height:100%; 
      background: linear-gradient(to top, rgba(255,255,255,1) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0.2) 100%);
    }
    .proj-hero__content { position: relative; z-index: 2; max-width: 1000px; color: #1a1a1a; }
    .back-link { display: inline-block; color: #1a1a1a; text-decoration: none; font-weight: 800; font-size: 0.9rem; margin-bottom: 20px; opacity: 0.8; transition: 0.3s; padding: 8px 16px; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 100px; }
    .back-link:hover { opacity: 1; transform: translateX(-5px); background: #fafafa; }
    .sub-label { display: block; font-size: 0.8rem; font-weight: 900; letter-spacing: 5px; color: var(--aa-green); text-transform: uppercase; margin-bottom: 15px; }
    .proj-hero h1 { font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 950; margin: 0; line-height: 1; letter-spacing: -0.04em; color: #1a1a1a; }

    /* Layout */
    .proj-container {
      max-width: 1400px; margin: -50px auto 0; padding: 0 6%;
      display: grid; grid-template-columns: 1.6fr 1fr; gap: 60px;
      position: relative; z-index: 10;
    }

    /* Content */
    .vision-quote { padding: 40px; margin-bottom: 60px; position: relative; overflow: hidden; background: #ffffff; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
    .vision-quote::before { content: '“'; position: absolute; top: -20px; left: 20px; font-size: 15rem; color: var(--aa-green); opacity: 0.1; font-family: serif; }
    .vision-quote p { font-size: 1.5rem; line-height: 1.6; font-weight: 300; font-style: italic; margin-bottom: 20px; color: #1a1a1a; position: relative; z-index: 2; }
    .vision-quote cite { font-style: normal; font-weight: 800; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px; color: var(--aa-green); position: relative; z-index: 2; }

    .proj-story h2 { font-size: 3rem; font-weight: 900; margin-bottom: 30px; letter-spacing: -0.03em; color: #1a1a1a; }
    .story-text { font-size: 1.15rem; line-height: 1.8; color: rgba(26, 26, 26, 0.7); margin-bottom: 40px; }

    /* Gallery */
    .proj-gallery { margin-top: 80px; }
    .proj-gallery h2 { font-size: 2rem; font-weight: 900; margin-bottom: 40px; color: #1a1a1a; }
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px; }
    .gallery-item { aspect-ratio: 16/10; overflow: hidden; padding: 0; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: 1s cubic-bezier(0.16, 1, 0.3, 1); }
    .gallery-item:hover img { transform: scale(1.05); }

    /* Sidebar */
    .sidebar-sticky { position: sticky; top: 120px; }
    .sidebar-card { 
      background: #ffffff !important; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 30px; padding: 40px; 
      box-shadow: 0 20px 50px rgba(0,0,0,0.05); color: #1a1a1a !important;
    }
    .sidebar-card h3 { font-size: 1.8rem; font-weight: 800; margin-bottom: 15px; color: #1a1a1a; }
    .sidebar-card p { font-size: 0.95rem; color: rgba(26, 26, 26, 0.6); margin-bottom: 30px; }

    .prog-meta { display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 900; margin-bottom: 12px; color: var(--aa-green); }
    .prog-bar { width: 100%; height: 8px; background: #f0f0f0; border-radius: 100px; margin-bottom: 40px; overflow: hidden; }
    .prog-fill { height: 100%; background: linear-gradient(135deg, var(--aa-green) 0%, #115048 100%); border-radius: 100px; }

    .giving-form label { display: block; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; color: rgba(26,26,26,0.6); }
    .amount-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-bottom: 20px; }
    .amount-btn { 
      background: #fafafa; border: 1.5px solid rgba(26,26,26,0.1); color: #1a1a1a;
      padding: 15px; border-radius: 15px; font-weight: 800; cursor: pointer; transition: 0.3s;
    }
    .amount-btn:hover { background: #ffffff; border-color: var(--aa-green); color: var(--aa-green); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }

    .amount-input { 
      width: 100%; background: #fafafa; border: 1.5px solid rgba(26,26,26,0.1); 
      color: #1a1a1a; padding: 18px 22px; border-radius: 18px; font-size: 1rem; margin-bottom: 30px; display: block; outline: none; transition: 0.3s;
    }
    .amount-input:focus { border-color: var(--aa-green); background: #ffffff; box-shadow: 0 0 0 4px rgba(23, 106, 96, 0.1); }
    
    .pay-btn { 
      width: 100%; padding: 20px; border-radius: 100px; background: linear-gradient(135deg, var(--aa-green) 0%, #115048 100%); color: white;
      border: none; font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.3s;
      margin-bottom: 20px; box-shadow: 0 10px 25px rgba(23, 106, 96, 0.3);
    }
    .pay-btn:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(23, 106, 96, 0.4); }
    .pay-btn:active { transform: translateY(0); background: #0d3d37; color: white !important; }
    .pay-btn:disabled { opacity: 0.5; filter: grayscale(1); cursor: not-allowed; transform: none; box-shadow: none; }
    .secure-label { display: block; text-align: center; font-size: 0.65rem; color: rgba(26,26,26,0.5); font-weight: 700; margin-top: 20px; text-transform: uppercase; letter-spacing: 1px; }

    @media (max-width: 1100px) {
      .proj-container { grid-template-columns: 1fr; margin-top: -30px; }
      .proj-hero { height: 60vh; min-height: 400px; padding-top: 120px; }
    }
  </style>

  <script>
    function setAmount(amt) {
      document.getElementById('custom-amount').value = amt;
    }

    async function payWithPaystack() {
      const amountInp = document.getElementById('custom-amount');
      const payBtn = document.getElementById('project-pay-btn');
      const amount = amountInp.value;
      
      // Resolve Email
      const userEmail = "<%= locals.user ? locals.user.email : '' %>";
      const guestEmail = document.getElementById('donor-email')?.value;
      const email = userEmail || guestEmail;

      if (!amount || amount < 100) {
        showToast('Please enter a valid seed amount (minimum ₦100)', 'error');
        return;
      }

      if (!email || !email.includes('@')) {
        showToast('Please provide a valid email for your receipt.', 'error');
        document.getElementById('donor-email')?.focus();
        return;
      }

      // ── 🛡️ DOUBLE-PAYMENT PROTECTION ──
      payBtn.disabled = true;
      payBtn.textContent = "Initializing Secure Payment...";

      try {
        // ── Step 1: Get reCAPTCHA token (if available) ────────
        let recaptchaToken = null;
        if (typeof grecaptcha !== 'undefined') {
          recaptchaToken = await new Promise((resolve) => {
            grecaptcha.ready(() => {
              grecaptcha.execute('<%= locals.recaptchaSiteKey %>', { action: 'donation_init' }).then(resolve);
            });
          });
        }

        // ── Step 2: Initialize payment on the server ──────────
        const initRes = await fetch('/api/payments/initialize', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= locals.csrfToken %>'
          },
          body: JSON.stringify({
            email: email,
            amount: parseFloat(amount),
            categoryId: '<%= project.id %>',
            donationType: 'building_fund',
            notes: 'Building Project: <%= project.name %>',
            'g-recaptcha-response': recaptchaToken
          })
        });

        const initResult = await initRes.json();

        if (!initResult.success) {
          showToast(initResult.message || 'Could not initialize payment. Please try again.', 'error');
          payBtn.disabled = false;
          payBtn.textContent = "Plant Your Seed →";
          return;
        }

        // ── Step 3: Open Paystack checkout ──────────
        payBtn.textContent = "Opening Secure Checkout...";

        const handler = PaystackPop.setup({
          key: '<%= locals.PAYSTACK_PUBLIC_KEY %>',
          email: email,
          amount: parseFloat(amount) * 100, // Kobo
          currency: "NGN",
          ref: initResult.reference,
          access_code: initResult.access_code,
          callback: async function(response) {
            try {
              payBtn.textContent = "Verifying Seed...";
              
              // ── Step 4: Verify payment on the server ────────
              const verifyRes = await fetch('/api/payments/verify', {
                method: 'POST',
                headers: { 
                  'Content-Type': 'application/json',
                  'X-CSRF-Token': '<%= locals.csrfToken %>'
                 },
                body: JSON.stringify({
                  reference: response.reference,
                  'g-recaptcha-response': recaptchaToken
                })
              });

              const result = await verifyRes.json();
              
              if (result.success) {
                showToast('Thank you for your seed! Your kingdom investment has been logged.', 'success');
                // High IQ: Include reference, amount, category and email for the receipt page
                setTimeout(() => window.location.href = `/confirmation?type=donation&reference=${result.donation?.receipt_number || response.reference}&amount=${amount}&category=Building%20Fund&email=${encodeURIComponent(email)}`, 2000);
              } else {
                showToast('Payment verify issue: ' + (result.message || 'Check reference'), 'error');
                payBtn.disabled = false;
                payBtn.textContent = "Plant Your Seed →";
              }
            } catch (err) {
              console.error('[Payment] Verify Error:', err);
              showToast('Network error during verification. Reference: ' + response.reference, 'error');
              payBtn.disabled = false;
              payBtn.textContent = "Plant Your Seed →";
            }
          },
          onClose: function() {
            payBtn.disabled = false;
            payBtn.textContent = "Plant Your Seed →";
            showToast('Transaction cancelled.', 'info');
          }
        });
        handler.openIframe();

      } catch (err) {
        console.error('[Payment] Init Error:', err);
        showToast('Could not connect to payment server. Please try again.', 'error');
        payBtn.disabled = false;
        payBtn.textContent = "Plant Your Seed →";
      }
    }
  </script>
</body>
</html>
