<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
                  
                  <%- include('../partials/navbar') %>

                  <main class="membership-page">
                    <!-- HERO -->
                    <section class="membership-hero">
                      <div class="hero-bg">
                        <div class="hero-overlay" style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, transparent, var(--color_1)); z-index: 2;"></div>
                        <img src="https://res.cloudinary.com/dxwhpacz7/image/upload/f_auto,q_auto/v1777418384/emerald-hero-bg.jpg" alt="Membership Background" class="bg-img" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit: cover; opacity: 0.15; filter: grayscale(1); z-index: 1;">
                      </div>
                      <div class="hero-content">
                        <span class="sub-label gsap-memb">SPIRITUAL JOURNEY</span>
                        <h1 class="hero-title gsap-memb">Membership <span class="text-green">Criteria</span></h1>
                        <p class="hero-subtitle gsap-memb">Explore the steps and requirements to become a committed worker and serve in our departments.</p>
                      </div>
                    </section>

                    <!-- CONTENT -->
                    <section class="membership-content">
                      <div class="membership-container">
                        
                        <div class="intro-block glass-fx gsap-memb-up">
                          <h3>Ready to Serve?</h3>
                          <p>Church attendance is open to whosoever wills. However, to become a recognized worker in church or serve in any department, we follow a sacred process to ensure alignment of vision, spiritual maturity, and commitment.</p>
                        </div>

                        <!-- 12 STEPS LIST -->
                        <div class="steps-grid">
                          <!-- STEP 1 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">01</span>
                            <h4>Must be Born Again</h4>
                            <p>You must have a personal, saving relationship with Jesus Christ, having confessed Him as your Lord and Savior.</p>
                          </div>
                          <!-- STEP 2 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">02</span>
                            <h4>Must be Spirit-Filled</h4>
                            <p>Evidence of being filled with the Holy Spirit, with the biblical evidence of speaking in tongues.</p>
                          </div>
                          <!-- STEP 3 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">03</span>
                            <h4>Must be a Soul Winner</h4>
                            <p>A personal commitment to personal evangelism, following Jesus' command to reach the lost.</p>
                          </div>
                          <!-- STEP 4 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">04</span>
                            <h4>Teachable Spirit</h4>
                            <p>Must possess a humble, teachable heart that is ready to learn and take correction from leadership.</p>
                          </div>
                          <!-- STEP 5 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">05</span>
                            <h4>Personal Information Form</h4>
                            <p>Complete the official personal information form to register your details with the church administration.</p>
                          </div>
                          <!-- STEP 6 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">06</span>
                            <h4>Leadership Interview</h4>
                            <p>Successfully go through a chat/interview with the leadership of the specific department you wish to join.</p>
                          </div>
                          <!-- STEP 7 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">07</span>
                            <h4>Passport Photographs</h4>
                            <p>Submit two recent physical passport photographs for administrative profiling and ID card creation.</p>
                          </div>
                          <!-- STEP 8 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">08</span>
                            <h4>LFF Foundation/Family Class</h4>
                            <p>Complete and obtain certification for the Living Faith Foundation Family Class.</p>
                          </div>
                          <!-- STEP 9 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">09</span>
                            <h4>LFF Responsibility Class</h4>
                            <p>Complete and obtain certification for the Living Faith Foundation Responsibility Class.</p>
                          </div>
                          <!-- STEP 10 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">10</span>
                            <h4>LFF Maturity Class</h4>
                            <p>Complete and obtain certification for the Living Faith Foundation Maturity Class (concessions may be available in special cases).</p>
                          </div>
                          <!-- STEP 11 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">11</span>
                            <h4>Probationary Period</h4>
                            <p>Complete a one-month active probationary period in your chosen department before final confirmation.</p>
                          </div>
                          <!-- STEP 12 -->
                          <div class="step-card glass-fx gsap-memb-card">
                            <span class="step-num">12</span>
                            <h4>Letter of Confirmation</h4>
                            <p>If you are transferring from another Living Faith Foundation branch, you must obtain a formal letter of transfer/confirmation.</p>
                          </div>
                        </div>

                      </div>
                    </section>
                  </main>

                  <%- include('../partials/footer') %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    :root { 
        --aa-green: #25D366; 
        --aa-bg: var(--color_1);
    }
    .text-green { color: var(--aa-green); }

    .membership-page {
        background: var(--aa-bg);
        color: #1a1a1a;
        min-height: 100vh;
    }
    
    .membership-hero { position: relative; height: 50vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; margin-top: 100px; }
    .hero-bg { position: absolute; top:0; left:0; width:100%; height:100%; background: transparent; }
    .hero-content { position: relative; z-index: 3; padding: 0 6%; }
    .sub-label { display: block; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 5px; color: var(--aa-green); margin-bottom: 20px; }
    .hero-title { font-size: clamp(3rem, 8vw, 5rem); font-weight: 950; line-height: 0.9; letter-spacing: -0.05em; color: #1a1a1a; margin-bottom: 20px; }
    .hero-subtitle { font-size: 1.2rem; color: rgba(26,26,26,0.6); max-width: 700px; margin: 0 auto; line-height: 1.6; }

    .membership-content { padding: 40px 6% 150px; }
    .membership-container { max-width: 1200px; margin: 0 auto; }
    
    .intro-block { padding: 50px; margin-bottom: 60px; text-align: center; border-radius: 32px; }
    .intro-block h3 { font-size: 2rem; font-weight: 850; color: #1a1a1a; margin-bottom: 20px; }
    .intro-block p { font-size: 1.15rem; color: rgba(26,26,26,0.6); line-height: 1.7; max-width: 900px; margin: 0 auto; }

    .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
    .step-card { padding: 40px; border-radius: 28px; background: #ffffff; display: flex; flex-direction: column; transition: all 0.4s ease; border: 1.5px solid rgba(26, 26, 26, 0.08); box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02); }
    .step-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.06); border-color: var(--aa-green); }
    
    .step-num { font-size: 2.5rem; font-weight: 950; color: rgba(37, 211, 102, 0.15); font-family: 'Outfit', sans-serif; line-height: 1; margin-bottom: 25px; }
    .step-card h4 { font-size: 1.3rem; font-weight: 850; color: #1a1a1a; margin-bottom: 15px; }
    .step-card p { font-size: 0.98rem; color: rgba(26,26,26,0.55); line-height: 1.6; margin: 0; }

    .glass-fx { background: #ffffff; border: 1.5px solid rgba(26, 26, 26, 0.1); box-shadow: 0 10px 40px rgba(0,0,0,0.03); }

    @media (max-width: 1000px) {
        .steps-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 700px) {
        .steps-grid { grid-template-columns: 1fr; }
        .intro-block { padding: 30px; }
        .step-card { padding: 30px; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
        gsap.registerPlugin(ScrollTrigger);

        // Hero Entrance
        gsap.from('.gsap-memb', { y: 40, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power3.out' });
        
        // Intro Block Entrance
        gsap.from('.gsap-memb-up', {
            scrollTrigger: { trigger: '.intro-block', start: 'top 85%' },
            y: 50, opacity: 0, duration: 1, ease: 'power3.out'
        });

        // Cards Entrance
        gsap.from('.gsap-memb-card', {
            scrollTrigger: { trigger: '.steps-grid', start: 'top 85%' },
            y: 60, opacity: 0, duration: 1, stagger: 0.08, ease: 'power3.out'
        });
    });
  </script>
</body>
</html>
