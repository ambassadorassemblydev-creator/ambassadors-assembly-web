<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper">
      <div dmwrapped="true" id="faq-page" class="dm-home-page">
        <div id="dmStyle_outerContainer" class="dmOuter">
          <div id="dmStyle_innerContainer" class="dmInner">
            <div class="dmLayoutWrapper standard-var dmStandardDesktop">
              <div id="site_content">
                <%- include('../partials/navbar') %>

                <main class="faq-page">
                  <section class="faq-hero">
                    <div class="hero-bg">
                      <div class="hero-overlay"></div>
                    </div>
                    <div class="hero-content">
                      <span class="sub-label">Got Questions?</span>
                      <h1 class="hero-title">Frequently Asked <span class="text-green">Questions</span></h1>
                    </div>
                  </section>

                  <section class="faq-content">
                    <div class="faq-container">
                      
                      <!-- Q1 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">Where is the church located? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>We are located at <strong>No. 7, Fashe Street, Omole Phase 2 Extension, Isheri Olowoora, Lagos</strong>. Free parking is available, and our welcome team is ready to guide you. You can get directions using the button below:</p>
                          <div class="map-link" style="margin-top: 15px;">
                            <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(locals.churchSettings?.church_address || '7, Fashe street, Omole Phase 2 Extension, Isheri Olowoora, Lagos') %>" target="_blank" class="map-btn" style="display: inline-block; padding: 12px 24px; background: #1a1a1a; color: white; border-radius: 100px; text-decoration: none; font-weight: 800; font-size: 0.9rem; transition: 0.3s;">Get Directions ↗</a>
                          </div>
                        </div>
                      </div>

                      <!-- Q2 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">What time are your services? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>Our official service timetable is as follows:</p>
                          <ul style="list-style: none; padding: 0; line-height: 1.8; margin-bottom: 15px; color: rgba(26,26,26,0.7);">
                            <li><strong>Sundays:</strong>
                              <br>&bull; Green Pastures (Discipleship): 7:30 AM — 8:10 AM
                              <br>&bull; Celebration Service: 8:15 AM — 10:00 AM
                            </li>
                            <li style="margin-top: 10px;"><strong>Wednesdays:</strong>
                              <br>&bull; Midweek Service / Bible Study: 6:00 PM — 7:30 PM
                            </li>
                            <li style="margin-top: 10px;"><strong>Mondays:</strong>
                              <br>&bull; Virtual Prayer Meeting: 8:00 PM — 9:00 PM (Online)
                            </li>
                          </ul>
                        </div>
                      </div>

                      <!-- Q3 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">Do I need to be a member to attend? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>No, absolutely not. Everyone is welcome to attend our services and programs. Whether you are visiting for the first time, exploring faith, or looking for a home cell, you are part of the family.</p>
                        </div>
                      </div>

                      <!-- Q4 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">Is there a place for children? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>Yes, we have a dedicated Children's Church (Junior Church) that nurtures kids from infancy up to 12 years old. They will learn the Bible in a safe, dynamic, and engaging environment while you enjoy the main service.</p>
                        </div>
                      </div>

                      <!-- Q5 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">How can I join a department? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>To serve in a department or become a worker, you can sign up after service at the information desk or directly online. Register for an account on our website, complete your onboarding, and complete the department request in your dashboard.</p>
                        </div>
                      </div>

                      <!-- Q6 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">Do you offer counseling or prayer support? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>Yes! Pastoral support, counseling, and prayer are fully available. You can submit prayer requests on our virtual Prayer Wall, or request private pastoral sessions by speaking to us directly after services.</p>
                        </div>
                      </div>

                      <!-- Q7 -->
                      <div class="faq-item glass-fx">
                        <button class="faq-question">Are services streamed online? <span class="icon">+</span></button>
                        <div class="faq-answer">
                          <p>Yes, our services are streamed live online! You can watch live via the Streams section on this website, or connect through our official YouTube and Facebook channels.</p>
                        </div>
                      </div>

                    </div>
                  </section>
                </main>

                <%- include('../partials/footer') %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    :root { 
        --aa-green: #25D366; 
        --aa-bg: var(--color_1);
    }
    .text-green { color: var(--aa-green); }

    .faq-page {
        background: var(--aa-bg);
        color: #1a1a1a;
        min-height: 100vh;
    }
    
    .faq-hero { position: relative; height: 40vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; margin-top: 100px; }
    
    .hero-content { position: relative; z-index: 3; padding: 0 6%; }
    .sub-label { display: block; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 5px; color: var(--aa-green); margin-bottom: 20px; }
    .hero-title {
        font-size: clamp(3rem, 8vw, 5rem);
        font-weight: 950;
        line-height: 0.9;
        letter-spacing: -0.05em;
        color: #1a1a1a;
    }

    .faq-content { padding: 40px 6% 150px; }
    .faq-container { max-width: 800px; margin: 0 auto; }
    
    .faq-item {
        background: #ffffff;
        border: 1.5px solid rgba(26, 26, 26, 0.1);
        border-radius: 20px;
        margin-bottom: 20px;
        overflow: hidden;
        transition: 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
    }
    
    .faq-question {
        width: 100%;
        text-align: left;
        padding: 25px 30px;
        background: none;
        border: none;
        font-size: 1.2rem;
        font-weight: 800;
        color: #1a1a1a;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .faq-question:focus { outline: none; }
    
    .faq-question .icon {
        font-size: 1.5rem;
        color: var(--aa-green);
        transition: transform 0.3s ease;
    }
    
    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
        padding: 0 30px;
    }
    
    .faq-answer p {
        padding-bottom: 25px;
        color: rgba(26, 26, 26, 0.7);
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .faq-item.active { border-color: var(--aa-green); }
    .faq-item.active .icon { transform: rotate(45deg); }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');
            const answer = item.querySelector('.faq-answer');
            
            question.addEventListener('click', () => {
                const isActive = item.classList.contains('active');
                
                // Close all other items
                faqItems.forEach(otherItem => {
                    otherItem.classList.remove('active');
                    otherItem.querySelector('.faq-answer').style.maxHeight = null;
                });
                
                if (!isActive) {
                    item.classList.add('active');
                    answer.style.maxHeight = answer.scrollHeight + "px";
                }
            });
        });
    });
  </script>
</body>
</html>
