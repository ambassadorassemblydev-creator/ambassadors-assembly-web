<style>
  .modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px);
    z-index: 2000; display: none; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .modal-content {
    background: #ffffff; border: 1.5px solid rgba(26, 26, 26, 0.1);
    border-radius: 20px; padding: 40px; width: 90%; max-width: 450px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.1); transform: translateY(20px);
    transition: transform 0.3s ease; position: relative; color: #1a1a1a; font-family: 'Articulat_CF_Normal', sans-serif;
  }
  .modal-close {
    position: absolute; top: 20px; right: 20px; cursor: pointer; color: rgba(26,26,26,0.3);
  }
  .modal-close:hover { color: #1a1a1a; }
  .modal-overlay.active { display: flex; opacity: 1; }
  .modal-overlay.active .modal-content { transform: translateY(0); }
</style>

<div class="modal-overlay" id="forgot-pwd-modal">
  <div class="modal-content">
    <div class="modal-close" id="close-modal">✕</div>
    <h2 style="font-family: 'Articulat CF Demi Bold'; margin-top:0; color: #1a1a1a;">Reset Password</h2>
    <p style="color: rgba(26,26,26,0.5); font-size: 14px; margin-bottom: 25px;">Enter your email and we'll send you a secure reset link.</p>
    
    <div class="error-alert" id="reset-error"></div>
    <div class="error-alert" id="reset-success" style="background: rgba(50,215,75,0.1); color: #32d74b; border-color: #32d74b;"></div>

    <div class="input-group">
      <input type="email" id="reset-email" placeholder=" " required>
      <label for="reset-email">Email Address</label>
    </div>
    <button class="auth-submit-btn" id="send-reset-btn">Send Reset Link</button>
  </div>
</div>

<script>
  // Add this inside your existing DOMContentLoaded in sign-in.ejs
  document.querySelector('a[href="/forgot-password"]').addEventListener('click', (e) => {
    e.preventDefault();
    document.getElementById('forgot-pwd-modal').classList.add('active');
  });
  document.getElementById('close-modal').addEventListener('click', () => {
    document.getElementById('forgot-pwd-modal').classList.remove('active');
  });
</script>
