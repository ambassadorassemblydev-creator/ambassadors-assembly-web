<%- include('../partials/head') %>


 <!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
   
  <!-- BG AMBIENCE -->
  <div class="watch-bg">
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>
  </div>
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <main class="page-container">
          <div class="sermon-layout">
            
              <!-- LEFT: PLAYER & INFO -->
              <div class="player-wrapper glass-fx">
                <% 
                  function getEmbedUrl(url) {
                    if (!url) return 'https://www.youtube.com/embed/dQw4w9WgXcQ';
                    
                    // YouTube
                    if (url.includes('youtube.com/watch')) {
                      const videoId = new URL(url).searchParams.get('v');
                      return `https://www.youtube.com/embed/${videoId}?enablejsapi=1`;
                    }
                    if (url.includes('youtu.be/')) {
                      const videoId = url.split('/').pop().split('?')[0];
                      return `https://www.youtube.com/embed/${videoId}?enablejsapi=1`;
                    }
                    
                    // Vimeo
                    if (url.includes('vimeo.com/')) {
                      const videoId = url.split('/').pop().split('?')[0];
                      return `https://player.vimeo.com/video/${videoId}`;
                    }
                    
                    return url; // Return as is if already embed or other
                  }
                  
                  const activeUrl = getEmbedUrl(sermon.video_url);
                  const isIframe = activeUrl.includes('youtube.com') || activeUrl.includes('vimeo.com') || activeUrl.includes('embed');
                %>
                <% if (isIframe) { %>
                  <iframe id="yt-player-frame" src="<%= activeUrl %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  
                  <!-- Fallback overlay shown when embed is blocked (Error 150/153) -->
                  <div id="embed-error-overlay" class="offline-placeholder" style="display:none; position:absolute; top:0; left:0; width:100%; height:100%; z-index:5; background: #000;">
                    <div class="offline-card" style="color: white; padding: 30px; text-align: center;">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#e94560" stroke-width="1.5" style="margin-bottom: 20px;"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                      <h2 style="color: white; font-size: 20px; margin-bottom: 10px;">This video cannot be embedded</h2>
                      <p style="color: rgba(255,255,255,0.7); font-size: 14px; margin-bottom: 20px;">The owner has restricted playback on external sites. Watch it directly on YouTube.</p>
                      <a id="yt-direct-link" href="" target="_blank" class="action-btn" style="background: #176a60; color: white; border: none; padding: 12px 30px; border-radius: 50px; text-decoration: none; font-weight: 700;">
                        Watch on YouTube
                      </a>
                    </div>
                  </div>
                <% } else { %>
                  <video src="<%= activeUrl %>" controls playsinline style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"></video>
                <% } %>
              </div>

              <div class="sermon-info">
                <div class="meta-row">
                  <% if (sermon.series) { %>
                    <span class="series-pill"><%= sermon.series.title %></span>
                  <% } %>
                  <span class="date-label"><%= new Date(sermon.sermon_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                </div>
                
                <h1 class="sermon-title"><%= sermon.title %></h1>
                
                <div class="speaker-row">
                  <div class="speaker-avatar">
                    <img src="<%= (sermon.speaker && sermon.speaker.image_url) || 'https://res.cloudinary.com/dxwhpacz7/image/upload/v1775200226/IMG-20260304-WA0059_telyum.jpg' %>" alt="<%= (sermon.speaker && sermon.speaker.name) || 'Speaker' %>">
                  </div>
                  <div class="speaker-details">
                    <span class="speaker-name"><%= (sermon.speaker && sermon.speaker.name) || 'Ambassadors Assembly' %></span>
                    <span class="speaker-role"><%= (sermon.speaker && sermon.speaker.bio) ? sermon.speaker.bio.substring(0, 50) + '...' : 'Ministry Speaker' %></span>
                  </div>
                </div>

                <div class="sermon-description">
                  <p><%= sermon.description || 'No description available for this message.' %></p>
                </div>

                <!-- SHARE & ACTIONS -->
                <div class="action-grid">
                  <button class="action-btn share" onclick="copyStreamLink()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>
                    Share Message
                  </button>
                  <% if (sermon.notes_pdf_url) { %>
                    <a href="<%= sermon.notes_pdf_url %>" target="_blank" class="action-btn notes">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      Study Guide
                    </a>
                  <% } %>
                </div>
              </div>

              <!-- RELATED IN SERIES -->
              <% if (relatedSermons && relatedSermons.length > 0) { %>
                <section class="related-section">
                  <h3 class="section-heading">More from this Series</h3>
                  <div class="related-grid">
                    <% relatedSermons.forEach(rel => { %>
                      <a href="/sermons/<%= rel.slug %>" class="related-card glass-fx">
                        <div class="rel-img">
                          <img src="<%= rel.thumbnail_url %>" alt="<%= rel.title %>">
                        </div>
                        <div class="rel-info">
                          <h4><%= rel.title %></h4>
                          <span><%= new Date(rel.sermon_date).toLocaleDateString() %></span>
                        </div>
                      </a>
                    <% }) %>
                  </div>
                </section>
              <% } %>
           

            <!-- RIGHT: INTERACTION HUB (CORRELATION) -->
            <aside class="study-hub glass-fx">
              <div class="hub-tabs">
                <div class="hub-tab active" data-target="notes">NOTES</div>
                <div class="hub-tab" data-target="bible">BIBLE</div>
              </div>

              <div class="hub-content">
                <!-- NOTES PANEL -->
                <div id="tab-notes" class="tab-panel active">
                  <div class="notes-header">
                    <h3>Your Study Notes</h3>
                    <p>Notes taken during the live stream or while watching arrive here automatically.</p>
                  </div>
                  <textarea id="personal-notes" placeholder="What is God saying to you through this message?"></textarea>
                  <div class="notes-footer">
                    <button class="export-btn" onclick="downloadNotes()">Export to Text</button>
                  </div>
                </div>

                <!-- BIBLE PANEL -->
                <div id="tab-bible" class="tab-panel">
                  <div class="bible-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,0.2)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20M4 19.5V4a2 2 0 0 1 2-2h10l4 4v10a2 2 0 0 1-2 2H6.5a2.5 2.5 0 0 0-2.5 2.5z"/></svg>
                    <p style="color: #6b7280;">Search Scripture references here.</p>
                    <input type="text" placeholder="John 3:16..." class="bible-search">
                  </div>
                </div>
              </div>
            </aside>

          </div>
        </main>

    

  <style>
    :root {
      --accent: #176a60;
      --glass: rgba(255, 255, 255, 0.6);
      --glass-border: rgba(0, 0, 0, 0.08);
    }

    body { font-family: 'Outfit', sans-serif; color: #1a1a1a; background: var(--color_1); }

    .page-container { padding-top: 100px; min-height: 100vh; }
    
    /* Layout */
    .sermon-layout { 
      display: grid; 
      grid-template-columns: 1fr 420px; 
      max-width: 1600px; 
      margin: 0 auto; 
      padding: 40px; 
      gap: 40px; 
    }

    .player-wrapper { 
      position: relative; 
      padding-top: 56.25%; 
      border-radius: 24px; 
      overflow: hidden; 
      background: black;
      margin-bottom: 40px;
      box-shadow: 0 40px 100px rgba(0,0,0,0.4);
    }
    .player-wrapper iframe { position: absolute; top:0; left:0; width:100%; height:100%; }

    .sermon-info { margin-bottom: 60px; }
    .meta-row { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
    .series-pill { background: rgba(23, 106, 96, 0.1); color: #176a60; padding: 4px 14px; border-radius: 50px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
    .date-label { color: #6b7280; font-size: 13px; font-weight: 500; }
    
    .sermon-title { font-family: 'Manrope', sans-serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; margin-bottom: 30px; line-height: 1.1; letter-spacing: -0.02em; color: #1a1a1a; }

    .speaker-row { display: flex; align-items: center; gap: 15px; padding-bottom: 30px; border-bottom: 1px solid var(--glass-border); margin-bottom: 30px; }
    .speaker-avatar { width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: #f3f4f6; }
    .speaker-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .speaker-name { display: block; font-weight: 700; font-size: 16px; color: #1a1a1a; }
    .speaker-role { display: block; font-size: 13px; color: #6b7280; }

    .sermon-description { color: #4b5563; line-height: 1.8; font-size: 17px; margin-bottom: 40px; }

    .action-grid { display: flex; gap: 15px; }
    .action-btn { 
      padding: 14px 28px; border-radius: 50px; display: inline-flex; align-items: center; gap: 12px;
      font-weight: 700; font-size: 14px; cursor: pointer; transition: 0.3s; text-decoration: none;
      border: 1px solid var(--glass-border); color: #1a1a1a; background: #ffffff;
    }
    .action-btn:hover { background: #f9fafb; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
    .action-btn.share { background: #176a60; color: white; border: none; }

    /* Related Section */
    .related-section { border-top: 1px solid var(--glass-border); padding-top: 60px; }
    .section-heading { font-size: 1.4rem; font-weight: 800; margin-bottom: 25px; color: #1a1a1a; }
    .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .related-card { display: flex; align-items: center; gap: 15px; padding: 12px; border-radius: 16px; text-decoration: none; background: #ffffff; border: 1px solid var(--glass-border); }
    .rel-img { width: 80px; aspect-ratio: 16/10; border-radius: 8px; overflow: hidden; }
    .rel-img img { width: 100%; height: 100%; object-fit: cover; }
    .rel-info h4 { font-size: 14px; color: #1a1a1a; margin: 0 0 4px 0; }
    .rel-info span { font-size: 12px; color: #6b7280; }

    /* Study Hub */
    .study-hub { 
      height: calc(100vh - 180px); 
      position: sticky; top: 140px; 
      border-radius: 24px; 
      display: flex; flex-direction: column; 
      background: #ffffff;
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    }
    .hub-tabs { display: flex; border-bottom: 1px solid var(--glass-border); }
    .hub-tab { flex: 1; padding: 20px; text-align: center; font-size: 11px; font-weight: 800; letter-spacing: 2px; cursor: pointer; color: #1a1a1a; opacity: 0.4; }
    .hub-tab.active { opacity: 1; box-shadow: inset 0 -2px 0 #176a60; color: #176a60; }

    .hub-content { flex: 1; padding: 30px; overflow-y: auto; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .notes-header h3 { color: #1a1a1a; font-size: 18px; font-weight: 800; margin-bottom: 5px; }
    .notes-header p { color: #6b7280; font-size: 13px; }

    #personal-notes { 
      width: 100%; min-height: 400px; background: #f9fafb; border: 1px solid #e5e7eb; 
      border-radius: 12px; color: #1a1a1a; font-size: 15px; line-height: 1.6; outline: none; resize: none;
      margin-top: 20px; padding: 20px; font-family: inherit;
    }
    .notes-footer { margin-top: 20px; }
    .export-btn { 
      width: 100%; padding: 12px; background: #f3f4f6; border: 1px solid #e5e7eb; 
      border-radius: 10px; color: #1a1a1a; font-weight: 700; cursor: pointer; transition: 0.3s;
    }
    .export-btn:hover { background: #e5e7eb; }

    .bible-search { 
      width: 100%; padding: 12px 20px; border-radius: 10px; border: 1px solid #e5e7eb;
      background: #f9fafb; color: #1a1a1a; margin-top: 15px; outline: none;
    }

    /* BG Blobs */
    .watch-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; background: #fdfdfd; }
    .bg-blob { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.05; }
    .blob-1 { width: 60vw; height: 60vw; top: -10%; left: -10%; background: #176a60; }
    .blob-2 { width: 40vw; height: 40vw; bottom: -5%; right: -5%; background: #2d948a; }

    .glass-fx { background: var(--glass); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border: 1px solid var(--glass-border); }

    @media (max-width: 1200px) {
      .sermon-layout { grid-template-columns: 1fr; padding: 20px; }
      .study-hub { height: 600px; position: static; margin-top: 40px; }
      .sermon-title { font-size: 2.2rem; }
    }
  </style>

  <%- include('../partials/footer') %>

  <script>
    // ─── YouTube Embed Fix (Error 150/153) ───
    const player = document.getElementById('yt-player-frame');
    if (player) {
      // 1. Ensure origin param is set (required by YouTube JS API)
      try {
        const currentSrc = new URL(player.src);
        if (!currentSrc.searchParams.get('origin')) {
          currentSrc.searchParams.set('origin', window.location.origin);
          player.src = currentSrc.toString();
        }
      } catch(e) { /* ignore */ }

      // 2. Extract video ID and build direct link for the fallback button
      const embedMatch = player.src.match(/\/embed\/([^?&#]+)/);
      const directLink = document.getElementById('yt-direct-link');
      if (embedMatch && directLink) {
        directLink.href = `https://www.youtube.com/watch?v=${embedMatch[1]}`;
      }

      // 3. Detect embed failure
      let embedOk = false;
      window.addEventListener('message', function ytCheck(e) {
        if (e.origin && e.origin.includes('youtube.com')) {
          try {
            const d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
            if (d && d.event === 'onError' && (d.info === 150 || d.info === 153)) {
              showEmbedError();
              return;
            }
          } catch(_) {}
          embedOk = true;
        }
      });
    }

    function showEmbedError() {
      const overlay = document.getElementById('embed-error-overlay');
      if (overlay) overlay.style.display = 'flex';
    }

    const sermonId = '<%= sermon.id %>';
    const storageKey = `notes_${sermonId}`;
    
    // Notes Persistence
    const notesArea = document.getElementById('personal-notes');
    if (notesArea) {
      notesArea.value = localStorage.getItem(storageKey) || '';
      notesArea.addEventListener('input', (e) => {
        localStorage.setItem(storageKey, e.target.value);
      });
    }

    // Tabs
    document.querySelectorAll('.hub-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.hub-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(`tab-${tab.dataset.target}`).classList.add('active');
      });
    });

    function downloadNotes() {
      const text = notesArea.value;
      const blob = new Blob([text], { type: 'text/plain' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Sermon_Notes_${sermonId}.txt`;
      a.click();
    }

    function copyStreamLink() {
      navigator.clipboard.writeText(window.location.href);
      showToast('Link copied to clipboard!', 'success');
    }
  </script>
</body>
</html>
