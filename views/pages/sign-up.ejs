<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

                  <!-- NAVBAR -->
                  <%- include('../partials/navbar') %>

                  <!-- ======================================================== -->
                  <!-- PAGE SPECIFIC CSS (Cinematic Glassmorphism)              -->
                  <!-- ======================================================== -->
                  <style>
                    /* 4. Hide the footer on the Sign-In page for a true App-like feel (Optional) */
.dmFooterContainer {
  display: none !important; 
}
                    /* STRIP DUDA'S WHITE BACKGROUNDS & PADDING */
                    body.dmRoot, #dm, .dm_wrapper, .dmOuter, .dmInner, #site_content, .dmBody, #allWrapper, #dm_content, #dmFlexHeaderContainer, #flex-header {
                      background-color: transparent !important;
                      background-image: none !important;
                    }
                    #dmFlexHeaderContainer {
                      position: absolute !important;
                      top: 0; left: 0; width: 100%; z-index: 1000 !important;
                    }
                    #dmFirstContainer, #allWrapper, #dm_content {
                      margin: 0 !important; padding: 0 !important;
                    }

                    /* BACKGROUND & LAYOUT */
                    .auth-section {
                      position: relative;
                      width: 100%;
                      min-height: 100vh;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      padding: 160px 4% 60px; /* Accounts for absolute navbar */
                      background-color: var(--color_1);
                      font-family: 'Articulat_CF_Normal', sans-serif;
                      color: #1a1a1a;
                      overflow: hidden;
                    }

                   /* .auth-section::before {
                      content: "";
                      position: absolute;
                      top: 0; left: 0; width: 100%; height: 100%;
                      background: radial-gradient(circle at center, transparent 0%, rgba(5,5,5,0.4) 100%);
                      pointer-events: none;
                    }*/

                    .auth-container {
                      display: flex;
                      flex-direction: row;
                      width: 100%;
                      max-width: 1100px;
                      background: #ffffff;
                      border: 1.5px solid rgba(26, 26, 26, 0.1);
                      border-radius: 20px;
                      overflow: hidden;
                      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.05);
                    }

                    /* BRAND SIDE */
                    .auth-brand-side {
                      flex: 1;
                      padding: 60px 50px;
                      display: flex;
                      flex-direction: column;
                      justify-content: space-between;
                      background: #fafafa;
                      border-right: 1.5px solid rgba(26, 26, 26, 0.05);
                    }
                    .auth-logo-box {
                      background: rgba(255, 255, 255, 0.9);
                      padding: 15px 25px;
                      border-radius: 12px;
                      display: inline-block;
                      width: fit-content;
                      margin-bottom: 40px;
                    }
                    .auth-logo-box img {
                      height: 50px; width: auto; object-fit: contain;
                    }
                    .auth-quote p {
                      font-family: 'AppleGaramond-Light', serif;
                      font-size: 28px; line-height: 1.4; color: #1a1a1a; margin-bottom: 15px;
                    }
                    .auth-quote span {
                      font-size: 14px; text-transform: uppercase; letter-spacing: 2px; color: rgba(26, 26, 26, 0.45);
                    }

                    /* FORM SIDE */
                    .auth-form-side {
                      flex: 1;
                      padding: 50px 50px;
                      display: flex;
                      flex-direction: column;
                      justify-content: center;
                    }
                    .auth-form-header h1 {
                      font-family: 'Articulat CF Demi Bold', sans-serif;
                      font-size: 36px; margin: 0 0 10px 0; color: #1a1a1a;
                    }
                    .auth-form-header p {
                      font-size: 15px; color: rgba(26, 26, 26, 0.5); margin: 0 0 30px 0;
                    }

                    /* INPUTS */
                    .input-row {
                      display: flex; gap: 20px;
                    }
                    .input-group {
                      position: relative; margin-bottom: 25px; width: 100%;
                    }
                    .input-group input {
                      width: 100%; padding: 15px 0; font-size: 16px; color: #1a1a1a;
                      background: transparent; border: none; border-bottom: 1.5px solid rgba(26, 26, 26, 0.1);
                      outline: none; transition: border-color 0.3s ease; font-family: inherit;
                    }
                    .input-group label {
                      position: absolute; top: 15px; left: 0; font-size: 16px;
                      color: rgba(26, 26, 26, 0.45); pointer-events: none; transition: 0.3s ease all;
                    }
                    .input-group input:focus ~ label,
                    .input-group input:not(:placeholder-shown) ~ label {
                      top: -10px; font-size: 12px; color: #1a1a1a;
                    }
                    .input-group input:focus {
                      border-bottom: 1.5px solid #1a1a1a;
                    }

                    /* PASSWORD STRENGTH UI */
                    .password-strength {
                      display: flex; gap: 5px; margin-top: -15px; margin-bottom: 20px;
                    }
                    .strength-bar {
                      height: 4px; flex: 1; background: rgba(26, 26, 26, 0.05); border-radius: 2px; transition: 0.3s;
                    }
                    .strength-text {
                      font-size: 12px; color: rgba(26, 26, 26, 0.45); margin-top: 5px; text-align: right; width: 100%;
                    }

                    /* BUTTONS */
                    .auth-submit-btn {
                      width: 100%;
                      padding: 16px;
                      border-radius: 12px;
                      background: rgba(113, 178, 128, 1);
                      border: 1.5px solid rgba(113, 178, 128, 0.3);
                      color: #ffffff;
                      font-family: 'Articulat CF Demi Bold', sans-serif;
                      font-size: 16px;
                      cursor: pointer;
                      transition: all 0.3s ease;
                      margin-bottom: 20px;
                      font-weight: 700;
                    }
                    .auth-submit-btn:hover {
                      background: #1a1a1a;
                      border-color: #1a1a1a;
                      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
                    }
                    .auth-footer-link {
                      text-align: center; font-size: 14px; color: rgba(26, 26, 26, 0.6);
                    }
                    .auth-footer-link a {
                      color: var(--aa-green); text-decoration: none; font-family: 'Articulat CF Demi Bold', sans-serif; font-weight: 700;
                    }
                    .error-alert {
                      display: none; background: rgba(255, 59, 48, 0.1); border: 1px solid rgba(255, 59, 48, 0.3);
                      color: #ff453a; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; text-align: center;
                      word-wrap: break-word; overflow-wrap: break-word; white-space: pre-wrap;
                    }

                    /* MOBILE */
                    @media (max-width: 768px) {
                      .auth-container { flex-direction: column; }
                      .auth-brand-side { display: none; }
                      .auth-form-side { padding: 40px 30px; }
                      .input-row { flex-direction: column; gap: 0; }
                    }
                  </style>

                  <!-- ======================================================== -->
                  <!-- SIGN UP HTML -->
                  <!-- ======================================================== -->
                  <section class="auth-section">
                    <div class="auth-container">
                      
                      <!-- Left Split: Branding -->
                      <div class="auth-brand-side">
                        <div class="auth-logo-box">
                          <a href="/"><img src="https://storage.googleapis.com/chat-engine-prod/d4094a6e-dc0f-48d8-99ee-7132a01344da/3013d5df-4d69-42b7-a3a5-51dc5d862d83.jpg" alt="Ambassadors Assembly"></a>
                        </div>
                        <div class="auth-quote">
                          <p>"A community where you are known, loved, and empowered to fulfill your God-given purpose."</p>
                          <span>— Welcome to the Family</span>
                        </div>
                      </div>

                      <!-- Right Split: Form -->
                      <div class="auth-form-side">
                        <div class="auth-form-header">
                          <h1>Create an Account.</h1>
                          <p>Join Ambassadors Assembly to connect, serve, and grow.</p>
                        </div>

                        <div class="error-alert" id="auth-error"></div>

                        <form id="sign-up-form">
                            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                            <!-- CSRF Token for JS handlers -->
                            <input type="hidden" name="_csrf_legacy" id="csrfToken" value="<%= locals.csrfToken %>">

                          <div class="input-row">
                            <div class="input-group">
                              <input type="text" id="firstName" name="firstName" placeholder=" " required>
                              <label for="firstName">First Name</label>
                            </div>
                            <div class="input-group">
                              <input type="text" id="lastName" name="lastName" placeholder=" " required>
                              <label for="lastName">Last Name</label>
                            </div>
                          </div>

                          <div class="input-group">
                            <input type="email" id="email" name="email" placeholder=" " required>
                            <label for="email">Email Address</label>
                          </div>
                          
                          <div class="input-group">
                            <input type="password" id="password" name="password" placeholder=" " required>
                            <label for="password">Password</label>
                          </div>

                          <!-- High IQ: Password Strength Indicator -->
                          <div class="password-strength" id="pwd-strength">
                            <div class="strength-bar" id="bar-1"></div>
                            <div class="strength-bar" id="bar-2"></div>
                            <div class="strength-bar" id="bar-3"></div>
                          </div>
                          <div class="strength-text" id="pwd-text">Password too weak</div>

                          <div class="input-group" style="margin-top: 10px;">
                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder=" " required>
                            <label for="confirmPassword">Confirm Password</label>
                          </div>

                          <button type="submit" class="auth-submit-btn" id="submit-btn">
                            Create Account
                          </button>

                          <div class="auth-footer-link">
                            Already have an account? <a href="/sign-in">Sign In Here</a>
                          </div>
                        </form>
                      </div>
                    </div>
                  </section>
                   <%- include('../partials/footer') %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

 

  

  <!-- AUTHENTICATION JAVASCRIPT -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("sign-up-form");
      const errorBox = document.getElementById("auth-error");
      const submitBtn = document.getElementById("submit-btn");
      
      // Password Strength Logic
      const pwdInput = document.getElementById("password");
      const confirmInput = document.getElementById("confirmPassword");
      const bar1 = document.getElementById("bar-1");
      const bar2 = document.getElementById("bar-2");
      const bar3 = document.getElementById("bar-3");
      const pwdText = document.getElementById("pwd-text");

      pwdInput.addEventListener('input', () => {
        const val = pwdInput.value;
        let strength = 0;
        if (val.length >= 8) strength += 1;
        if (/[A-Z]/.test(val) && /[0-9]/.test(val)) strength += 1;
        if (/[^A-Za-z0-9]/.test(val)) strength += 1; // Special char

        // Reset
        bar1.style.background = 'rgba(26, 26, 26, 0.05)';
        bar2.style.background = 'rgba(26, 26, 26, 0.05)';
        bar3.style.background = 'rgba(26, 26, 26, 0.05)';
        pwdText.style.color = 'rgba(26, 26, 26, 0.45)';

        if (strength === 1) {
          bar1.style.background = '#ff453a'; // Red
          pwdText.textContent = "Weak (Need uppercase & number)";
        } else if (strength === 2) {
          bar1.style.background = '#ffd60a'; // Yellow
          bar2.style.background = '#ffd60a';
          pwdText.textContent = "Good (Add special character)";
        } else if (strength === 3) {
          bar1.style.background = '#32d74b'; // Green
          bar2.style.background = '#32d74b';
          bar3.style.background = '#32d74b';
          pwdText.textContent = "Strong password!";
          pwdText.style.color = '#32d74b';
        } else {
          pwdText.textContent = "Minimum 8 characters";
        }
      });

      // Submit Form
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        if (pwdInput.value !== confirmInput.value) {
          errorBox.textContent = "Passwords do not match.";
          errorBox.style.display = "block";
          return;
        }

        errorBox.style.display = "none";
        submitBtn.textContent = "Creating Account...";
        submitBtn.style.opacity = "0.7";
        submitBtn.disabled = true;

        const formData = {
          firstName: document.getElementById("firstName").value,
          lastName: document.getElementById("lastName").value,
          email: document.getElementById("email").value,
          password: pwdInput.value,
          _csrf: document.getElementById("csrfToken").value // CSRF Protection
        };

        try {
          const response = await fetch('/api/signup', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 
              'Content-Type': 'application/json',
              'x-csrf-token': document.getElementById("csrfToken").value
            },
            body: JSON.stringify(formData)
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || (data.debug ? JSON.stringify(data.debug) : data.error) || "Failed to sign up.");
          }

          // Redirect to the "Check Your Email" page
          window.location.href = "/check-email";

        } catch (err) {
          errorBox.textContent = err.message;
          errorBox.style.display = "block";
          submitBtn.textContent = "Create Account";
          submitBtn.style.opacity = "1";
          submitBtn.disabled = false;
        }
      });
    });
  </script>
</body>
</html>
