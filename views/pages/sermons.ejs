<%- include('../partials/head') %>

<link rel="stylesheet" href="/css/sermons-page.css">

<body id="dmRoot" data-page-alias="sermons" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite sermons-page hasStickyHeader"
  style="background: #080808; margin: 0; padding: 0;">
  <%- include('../partials/preloader') %>

  <!-- Ambient Animated Dark Background -->
  <div class="ambient-bg">
    <div class="ambient-blob ambient-blob--1"></div>
    <div class="ambient-blob ambient-blob--2"></div>
    <div class="ambient-blob ambient-blob--3"></div>
  </div>

  <!-- Duda wrappers needed for sticky header + social icon CSS -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper">
      <div class="dmOuter">
        <div class="dmInner">
          <div id="dm-outer-wrapper" class="runtime-module-container dm-bfs dm-layout-home hasStickyHeader inMiniHeaderMode dmDHeader" data-soch="true">
            <div id="site_content">

  <%- include('../partials/navbar') %>

  <!-- MAIN WRAPPER -->
  <main class="sermons-main-content">
    
    <!-- FEATURED SERMON (LATEST) -->
    <% if (sermons && sermons.length > 0) { 
      const featured = sermons[0];
    %>
    <section class="sermons-hero" id="sermons-hero">
      <div class="sermons-hero__bg" style="background-image: url('<%= featured.thumbnail_url %>');"></div>
      <div class="sermons-hero__overlay"></div>
      
      <div class="sermons-hero__inner">
        <!-- Featured Thumbnail Card -->
        <div class="sermons-hero__card">
          <img src="<%= featured.thumbnail_url %>" alt="<%= featured.title %>">
          <div class="hero-card__play-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>
        </div>
        
        <div class="sermons-hero__content">
          <span class="supertitle">Latest Message</span>
          <h1 class="sermons-hero__title"><%= featured.title %></h1>
          <% if (featured.description) { %>
            <p class="sermons-hero__desc"><%= featured.description.length > 180 ? featured.description.substring(0, 180) + '...' : featured.description %></p>
          <% } %>
          <p class="sermons-hero__meta">
            <span class="meta-date"><%= new Date(featured.sermon_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric'}) %></span>
            <% if (featured.sermon_speakers) { %>
             <span class="meta-dot">•</span>
             <span class="meta-speaker"><%= featured.sermon_speakers.name %></span>
            <% } %>
          </p>
          
          <a href="/sermons/<%= featured.slug %>" class="hero-watch-btn">
            <span class="hero-watch-btn__icon">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            </span>
            Watch Now
          </a>
        </div>
      </div>
    </section>
    <% } %>

    <!-- UPCOMING / CURRENT SERIES -->
    <% if (series && series.length > 0) { %>
    <section class="current-series page-section" id="current-series">
      <div class="page-section__inner">
        <h2 class="page-section__title">Current Series</h2>
        <div class="series-row">
          <% series.forEach(s => { %>
            <div class="series-card">
              <% if (s.cover_image_url) { %>
                <div class="series-card__img">
                  <img src="<%= s.cover_image_url %>" alt="<%= s.title %>" loading="lazy">
                </div>
              <% } %>
              <div class="series-card__body">
                <h3 class="series-card__title"><%= s.title %></h3>
                <% if (s.description) { %>
                  <p class="series-card__desc"><%= s.description %></p>
                <% } %>
                <span class="series-card__date">
                  <%= new Date(s.start_date).toLocaleDateString('en-US', {month: 'long', year: 'numeric'}) %>
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <!-- BOLD CATEGORIZATION / FILTERS -->
    <section class="sermon-filters page-section" id="sermon-filters">
      <div class="page-section__inner">
        <div class="filters-scroll">
          <button class="filter-pill active" data-filter="all">All Sermons</button>
          <button class="filter-pill" data-filter="faith">Faith</button>
          <button class="filter-pill" data-filter="purpose">Purpose</button>
          <button class="filter-pill" data-filter="relationships">Relationships</button>
          <button class="filter-pill" data-filter="guest">Guest Speakers</button>
        </div>
      </div>
    </section>

    <!-- SERMONS LIBRARY GRID -->
    <section class="sermons-library page-section" id="sermons-library">
      <div class="page-section__inner">
        <div class="sermons-grid">
          <% if (sermons && sermons.length > 1) { %>
            <% sermons.slice(1).forEach(sermon => { %>
              <article class="sermon-card-lib" data-tags="<%= sermon.tags ? sermon.tags.join(',') : '' %>">
                <a href="/sermons/<%= sermon.slug %>" class="sermon-card-lib__thumb">
                  <img src="<%= sermon.thumbnail_url %>" alt="<%= sermon.title %>" loading="lazy">
                  <div class="sermon-card-lib__play">
                    <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="9 6 19 12 9 18 9 6"></polygon></svg>
                  </div>
                </a>
                <div class="sermon-card-lib__body">
                  <h3 class="sermon-card-lib__title"><%= sermon.title %></h3>
                  <% if (sermon.description) { %>
                    <p class="sermon-card-lib__desc"><%= sermon.description.length > 100 ? sermon.description.substring(0, 100) + '...' : sermon.description %></p>
                  <% } %>
                  <div class="sermon-card-lib__meta">
                    <span><%= new Date(sermon.sermon_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric'}) %></span>
                    <% if (sermon.sermon_speakers) { %>
                      <span class="meta-dot">•</span>
                      <span><%= sermon.sermon_speakers.name %></span>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>

            </div><!-- /#site_content -->
          </div><!-- /#dm-outer-wrapper -->
        </div><!-- /.dmInner -->
      </div><!-- /.dmOuter -->
    </div><!-- /.dm_wrapper -->
  </div><!-- /#dm -->

  <!-- Load GreenSock and specific JS for this page -->
  <script src="/js/sermons-page.js"></script>
</body>
</html>
