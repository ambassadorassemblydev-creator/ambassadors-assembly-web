<%- include('../../partials/head') %>

<body id="dmRoot" class="dmRoot flex-site no-scroll-transition" style="background: #050505; color: white; margin: 0; overflow: hidden;">
    <%- include('../../partials/preloader') %>

    <main class="error-page 403-page">
        <div class="error-container">
            <!-- Animated Mascot: The Golden Gates -->
            <div class="mascot-wrapper">
                <div class="gates-container">
                    <div class="gate left" id="gateLeft"></div>
                    <div class="gate right" id="gateRight"></div>
                    <div class="divine-glow"></div>
                </div>
            </div>

            <div class="error-content gsap-up">
                <h1 class="error-code">403</h1>
                <h2 class="error-title">Divine Restriction</h2>
                <p class="error-text">Halt, Ambassador. These chambers require a higher level of clearance. Your entry has been denied by the celestial guard. Please return to the public halls.</p>
                <div class="error-actions">
                    <a href="/" class="primary-btn">Return Home</a>
                    <a href="/sign-in" class="secondary-btn">Request Access</a>
                </div>
            </div>
        </div>
    </main>

    <style>
        .error-page {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            background: radial-gradient(circle at center, #1a1a0d 0%, #050505 100%);
        }

        .error-container {
            max-width: 600px;
            width: 100%;
        }

        /* Mascot Styles: The Golden Gates */
        .mascot-wrapper {
            margin-bottom: 60px;
            display: flex;
            justify-content: center;
        }

        .gates-container {
            width: 200px;
            height: 120px;
            position: relative;
            display: flex;
            justify-content: center;
            perspective: 1000px;
        }

        .gate {
            width: 80px;
            height: 120px;
            background: linear-gradient(to right, #2a2a1a, #4a4a2a);
            border: 2px solid rgba(113, 178, 128, 0.3);
            position: absolute;
            top: 0;
            z-index: 2;
        }

        .gate.left {
            left: 20px;
            border-radius: 60px 0 0 0;
            transform-origin: left;
        }

        .gate.right {
            right: 20px;
            border-radius: 0 60px 0 0;
            transform-origin: right;
        }

        .divine-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, rgba(113, 178, 128, 0.4) 0%, transparent 70%);
            filter: blur(10px);
            z-index: 1;
        }

        /* Typography */
        .error-code {
            font-size: clamp(6rem, 15vw, 10rem);
            font-weight: 900;
            margin: 0;
            line-height: 0.8;
            letter-spacing: -0.05em;
            color: #d4af37; /* Metallic Gold */
            opacity: 0.8;
        }

        .error-title {
            font-size: 2rem;
            font-weight: 700;
            margin: 20px 0 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .error-text {
            font-size: 1.1rem;
            line-height: 1.6;
            color: rgba(255,255,255,0.6);
            margin-bottom: 40px;
        }

        /* Buttons */
        .error-actions {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .primary-btn {
            background: white;
            color: black;
            padding: 15px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 800;
            transition: transform 0.3s ease;
        }

        .secondary-btn {
            background: transparent;
            color: white;
            border: 1px solid rgba(255,255,255,0.2);
            padding: 15px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 800;
            transition: all 0.3s ease;
        }

        .primary-btn:hover { transform: scale(1.05); }
        .secondary-btn:hover { background: rgba(255,255,255,0.05); border-color: white; }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Gate Shivers (Rejected Attempt vibes)
            const shiver = () => {
                gsap.to(['#gateLeft', '#gateRight'], {
                    x: () => Math.random() * 2 - 1,
                    duration: 0.05,
                    onComplete: shiver
                });
            };
            shiver();

            // Glow Pulse
            gsap.to('.divine-glow', {
                scale: 1.2,
                opacity: 0.8,
                duration: 3,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut"
            });

            // Content Reveal
            gsap.from('.error-content > *', {
                opacity: 0,
                y: 30,
                duration: 1,
                stagger: 0.1,
                ease: "power3.out"
            });
        });
    </script>
</body>
</html>
