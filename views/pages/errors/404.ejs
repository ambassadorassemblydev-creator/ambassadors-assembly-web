<%- include('../../partials/head') %>

<body id="dmRoot" class="dmRoot flex-site no-scroll-transition" style="background: #131313; color: white; margin: 0; overflow: hidden;">
    <%- include('../../partials/preloader') %>

    <main class="error-page 404-page">
        <div class="error-container">
            <!-- Animated Mascot: The Lost Lamb -->
            <div class="mascot-wrapper">
                <div class="lamb-container" id="lamb">
                    <div class="lamb-body">
                        <div class="lamb-head">
                            <div class="lamb-ear left"></div>
                            <div class="lamb-ear right"></div>
                            <div class="lamb-eye left"></div>
                            <div class="lamb-eye right"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="error-content gsap-up">
                <h1 class="error-code">404</h1>
                <h2 class="error-title">Page Not Found</h2>
                <p class="error-text">Even the most seasoned Ambassadors take a wrong turn sometimes. The Shepherd is searching for this page, but it seems to have wandered off.</p>
                <div class="error-actions">
                    <a href="/" class="primary-btn">Return to Base</a>
                    <button onclick="window.history.back()" class="secondary-btn">Go Back</button>
                </div>
            </div>
        </div>
    </main>

    <style>
        .error-page {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            background: var(--color_1, #ffffff);
            color: #1a1a1a;
        }

        .error-container {
            max-width: 600px;
            width: 100%;
        }

        /* Mascot Styles: The Lost Lamb (Simplified CSS Art) */
        .mascot-wrapper {
            margin-bottom: 40px;
            display: flex;
            justify-content: center;
        }

        .lamb-container {
            width: 120px;
            height: 120px;
            position: relative;
        }

        .lamb-body {
            width: 100px;
            height: 80px;
            background: #ffffff;
            border: 2px solid rgba(26,26,26,0.1);
            border-radius: 50px;
            position: absolute;
            bottom: 0;
            left: 10px;
            box-shadow: 0 10px 30px rgba(23, 106, 96,0.1);
        }

        .lamb-head {
            width: 60px;
            height: 60px;
            background: #ffffff;
            border: 2px solid rgba(26,26,26,0.1);
            border-radius: 50%;
            position: absolute;
            top: -30px;
            right: -10px;
        }

        .lamb-ear {
            width: 15px;
            height: 25px;
            background: #ffffff;
            border: 2px solid rgba(26,26,26,0.1);
            border-radius: 50%;
            position: absolute;
            top: 5px;
        }
        .lamb-ear.left { left: 5px; transform: rotate(-30deg); }
        .lamb-ear.right { right: 5px; transform: rotate(30deg); }

        .lamb-eye {
            width: 6px;
            height: 6px;
            background: #1a1a1a;
            border-radius: 50%;
            position: absolute;
            top: 25px;
        }
        .lamb-eye.left { left: 15px; }
        .lamb-eye.right { right: 15px; }

        /* Typography */
        .error-code {
            font-size: clamp(6rem, 15vw, 10rem);
            font-weight: 900;
            margin: 0;
            line-height: 0.8;
            letter-spacing: -0.05em;
            color: var(--color_2, #176a60);
            opacity: 0.9;
        }

        .error-title {
            font-size: 2rem;
            font-weight: 700;
            margin: 20px 0 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #1a1a1a;
        }

        .error-text {
            font-size: 1.1rem;
            line-height: 1.6;
            color: rgba(26,26,26,0.6);
            margin-bottom: 40px;
        }

        /* Buttons */
        .error-actions {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .primary-btn {
            background: linear-gradient(135deg, var(--color_2, #176a60) 0%, #115048 100%);
            color: white;
            padding: 15px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 800;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 10px 25px rgba(23, 106, 96, 0.3);
            border: none;
        }

        .secondary-btn {
            background: transparent;
            color: #1a1a1a;
            border: 1.5px solid rgba(26,26,26,0.2);
            padding: 15px 35px;
            border-radius: 50px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .primary-btn:hover { transform: scale(1.05) translateY(-3px); box-shadow: 0 15px 35px rgba(23, 106, 96, 0.4); }
        .secondary-btn:hover { background: rgba(23, 106, 96, 0.05); border-color: var(--color_2, #176a60); color: var(--color_2, #176a60); }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Lamb Idle Animation
            gsap.to('#lamb', {
                y: -10,
                duration: 2,
                repeat: -1,
                yoyo: true,
                ease: "power1.inOut"
            });

            gsap.to('.lamb-head', {
                rotation: 5,
                duration: 3,
                repeat: -1,
                yoyo: true,
                ease: "power1.inOut"
            });

            // Content Reveal
            gsap.from('.error-content > *', {
                opacity: 0,
                y: 30,
                duration: 1,
                stagger: 0.1,
                ease: "power3.out"
            });
        });
    </script>
</body>
</html>
