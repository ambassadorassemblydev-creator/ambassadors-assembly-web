<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site no-scroll-transition" style="padding: 0px; margin: 0px; background: #050505; color: white;">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div id="site_content">

        <main class="onboarding-page">
          <!-- AMBIENT BG -->
          <div class="give-bg">
            <div class="bg-overlay"></div>
            <img src="https://images.unsplash.com/photo-1510531704581-5b2870972060?q=80&w=2000&auto=format&fit=crop" alt="Onboarding Background" class="bg-img">
          </div>
          
          <div class="onboard-container gsap-up">
            <div class="onboard-card glass-fx">
              
              <!-- PROGRESS TRACKER -->
              <div class="progress-tracker">
                <div class="step-indicator <%= step >= 1 ? 'active' : '' %>">
                  <span class="step-num">1</span>
                  <span class="step-label">Personal</span>
                </div>
                <div class="step-line <%= step >= 2 ? 'active' : '' %>"></div>
                <div class="step-indicator <%= step >= 2 ? 'active' : '' %>">
                  <span class="step-num">2</span>
                  <span class="step-label">Spiritual</span>
                </div>
              </div>

              <div class="onboard-header">
                <h2 id="onboardTitle">Welcome to the Family</h2>
                <p id="onboardSub">Let’s start with some basic details to get your profile ready.</p>
                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="ob-error">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <%= error %>
                  </div>
                <% } %>
              </div>

              <form action="/onboarding" method="POST" class="ob-form" id="onboardingForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <!-- STEP 1: PERSONAL DETAILS -->
                <div id="stepSection1" class="form-section">
                  <div class="form-row">
                    <div class="form-group">
                      <label>Gender <span>*</span></label>
                      <div class="custom-select-wrapper">
                        <input type="hidden" name="gender" value="<%= user && user.gender ? user.gender : '' %>">
                        <div class="custom-select-trigger"><%= user && user.gender ? user.gender : 'Select Gender' %></div>
                        <div class="custom-options">
                          <div class="option" data-value="Male">Male</div>
                          <div class="option" data-value="Female">Female</div>
                        </div>
                      </div>
                    </div>
                    <div class="form-group">
                      <label>Date of Birth <span>*</span></label>
                      <input type="date" name="dob" value="<%= user && user.date_of_birth ? user.date_of_birth : '' %>">
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Phone Number / WhatsApp <span>*</span></label>
                      <input type="tel" name="phone" placeholder="+234 ..." value="<%= user && user.phone ? user.phone : '' %>">
                    </div>
                    <div class="form-group">
                      <label>Marital Status <span>*</span></label>
                      <div class="custom-select-wrapper">
                        <input type="hidden" name="marital_status" value="<%= user && user.marital_status ? user.marital_status : '' %>" onchange="toggleAnniversary()">
                        <div class="custom-select-trigger"><%= user && user.marital_status ? user.marital_status : 'Select Status' %></div>
                        <div class="custom-options">
                          <div class="option" data-value="Single">Single</div>
                          <div class="option" data-value="Married">Married</div>
                          <div class="option" data-value="Divorced">Divorced</div>
                          <div class="option" data-value="Widowed">Widowed</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div id="anniversaryGroup" class="form-group" style="display: <%= user && user.marital_status === 'Married' ? 'block' : 'none' %>;">
                    <label>Wedding Anniversary</label>
                    <input type="date" name="wedding_anniversary" value="<%= user && user.wedding_anniversary ? user.wedding_anniversary : '' %>">
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Home Address <span>*</span></label>
                      <input type="text" name="addressLine1" placeholder="123 Example St" value="<%= user && user.address_line_1 ? user.address_line_1 : '' %>">
                    </div>
                    <div class="form-group">
                      <label>City / Region <span>*</span></label>
                      <input type="text" name="city" placeholder="Lagos, Nigeria" value="<%= user && user.city ? user.city : '' %>">
                    </div>
                  </div>

                  <div class="form-actions">
                    <button type="button" class="submit-btn highlight" onclick="goToStep(2)">Continue to Step 2 
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                  </div>
                </div>
                
                <div id="stepSection2" class="form-section" style="display: none;">
                  <!-- Area of Interest / Department -->
                  <div class="form-group">
                    <label>Area of Interest / Department <span>*</span></label>
                    <div class="custom-select-wrapper" id="deptSelectWrapper">
                      <input type="hidden" name="department_interest" id="deptInput" value="<%= (user && user.department_interest) ? user.department_interest : '' %>">
                      <div class="custom-select-trigger"><%= (user && user.department_interest) ? user.department_interest : 'Select Department' %></div>
                      <div class="custom-options">
                        <% departments.forEach(dept => { %>
                          <div class="option" data-value="<%= dept.name %>" data-id="<%= dept.id %>">
                            <strong><%= dept.name %></strong>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  </div>

                  <!-- Dynamic Role Selection -->
                  <div id="roleSelectionWrapper" class="form-group" style="display: none;">
                    <label>Position / Role of interest <span>*</span></label>
                    <div class="custom-select-wrapper" id="posSelectWrapper">
                      <input type="hidden" name="position_interest" id="posInput" value="<%= (user && user.position_interest) ? user.position_interest : '' %>">
                      <div class="custom-select-trigger"><%= (user && user.position_interest) ? user.position_interest : 'Select Position' %></div>
                      <div class="custom-options" id="roleOptions">
                        <% positions.forEach(pos => { %>
                          <div class="option role-option" data-value="<%= pos.title %>" data-dept-id="<%= pos.department_id %>">
                            <%= pos.title %>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  </div>

                  <!-- Ministry Interest -->
                  <div class="form-group">
                    <label>Join a Ministry (Interest Groups)</label>
                    <div class="ministry-pills">
                      <% ministries.forEach(min => { %>
                        <div class="min-pill <%= user && user.ministry_members && user.ministry_members.some(m => m.ministries.name === min.name) ? 'selected' : '' %>" 
                             onclick="toggleMin(this, '<%= min.name %>')">
                          <input type="checkbox" name="ministry_interests" value="<%= min.name %>" style="display:none" <%= user && user.ministry_members && user.ministry_members.some(m => m.ministries.name === min.name) ? 'checked' : '' %>>
                          <span class="pill-title"><%= min.name %></span>
                          <svg class="check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Occupation / Professional Background</label>
                    <input type="text" name="occupation" placeholder="e.g. Software Engineer, Doctor, Student" value="<%= user && user.occupation ? user.occupation : '' %>">
                  </div>

                  <div class="form-actions dual">
                    <button type="button" onclick="goToStep(1)" class="back-btn glass-btn">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                      Back
                    </button>
                    <button type="submit" class="submit-btn highlight">Complete My Profile 
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </button>
                  </div>
                </div>

              </form>
            </div>
          </div>

        </main>

      </div>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <style>
    :root {
      --accent: #22c55e;
      --glass: rgba(255, 255, 255, 0.04);
      --glass-border: rgba(255, 255, 255, 0.08);
      --input-bg: rgba(255, 255, 255, 0.05);
    }

    /* Flatpickr Customization */
    .flatpickr-calendar { background: #1a1a1a !important; border: 1px solid var(--glass-border) !important; box-shadow: 0 20px 50px rgba(0,0,0,0.5) !important; border-radius: 16px !important; }
    .flatpickr-day.selected { background: var(--accent) !important; border-color: var(--accent) !important; }

    .onboarding-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 100px 20px; position: relative; }

    /* Ambient BG */
    .give-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
    .bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.1; filter: contrast(1.1); }
    .bg-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: radial-gradient(circle at center, rgba(14,14,14,0.4) 0%, rgba(5,5,5,1) 80%); }

    /* Container */
    .onboard-container { width: 100%; max-width: 800px; margin: 0 auto; }
    
    .glass-fx { background: var(--glass); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); border: 1px solid var(--glass-border); border-radius: 40px; padding: 60px; box-shadow: 0 40px 100px rgba(0,0,0,0.5); }

    /* Progress Tracker */
    .progress-tracker { display: flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 60px; }
    .step-indicator { display: flex; flex-direction: column; align-items: center; gap: 10px; opacity: 0.3; transition: 0.4s; }
    .step-indicator.active { opacity: 1; }
    .step-num { width: 36px; height: 36px; border-radius: 50%; border: 2px solid white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; }
    .step-indicator.active .step-num { background: white; color: black; }
    .step-label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; }
    .step-line { width: 100px; height: 2px; background: rgba(255,255,255,0.1); border-radius: 2px; }
    .step-line.active { background: white; }

    /* Header */
    .onboard-header { text-align: center; margin-bottom: 50px; }
    .onboard-header h2 { font-family: 'Outfit', sans-serif; font-size: 2.8rem; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 12px; line-height: 1.1; }
    .onboard-header p { font-size: 1.1rem; color: rgba(255,255,255,0.5); line-height: 1.6; max-width: 500px; margin: 0 auto; }

    .ob-error { margin-top: 30px; padding: 18px 25px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 16px; color: #ef4444; font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; gap: 12px; }

    /* Form */
    .form-section { animation: fadeIn 0.6s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px; }
    .form-group { margin-bottom: 30px; }
    .form-group label { display: block; font-size: 0.9rem; font-weight: 700; color: rgba(255,255,255,0.8); margin-bottom: 10px; }
    .form-group label span { color: #ef4444; }

    .form-group input {
      width: 100%; background: var(--input-bg); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px;
      padding: 18px 22px; color: white; font-size: 1rem; font-family: inherit;
      outline: none; transition: 0.3s;
    }
    .form-group input:focus { border-color: var(--accent); background: rgba(34, 197, 94, 0.05); box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.15); }

    /* Custom Select */
    .custom-select-wrapper { position: relative; width: 100%; }
    .custom-select-trigger {
      width: 100%; background: var(--input-bg); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px;
      padding: 18px 22px; color: white; cursor: pointer; transition: 0.3s;
      display: flex; justify-content: space-between; align-items: center;
      min-height: 60px;
    }
    .custom-select-trigger:after { content: ""; border: solid rgba(255,255,255,0.4); border-width: 0 2px 2px 0; display: inline-block; padding: 3px; transform: rotate(45deg); transition: 0.3s; margin-left: 10px; }
    .custom-select-wrapper.open .custom-select-trigger:after { transform: rotate(-135deg); }
    .custom-options {
      position: absolute; top: 120%; left: 0; right: 0; background: #1a1a1a; border: 1px solid var(--glass-border);
      border-radius: 16px; z-index: 100; opacity: 0; visibility: hidden; transform: translateY(-10px); transition: 0.3s;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5); overflow-y: auto; max-height: 250px;
    }
    .custom-select-wrapper.open .custom-options { opacity: 1; visibility: visible; transform: translateY(0); }
    .custom-options .option { padding: 15px 20px; cursor: pointer; transition: 0.2s; font-size: 14px; font-weight: 600; }
    .custom-options .option:hover { background: var(--accent); color: white; }
    .custom-options .option strong { display: block; }

    /* Ministry Pills */
    .ministry-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
    .min-pill {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px;
      padding: 10px 20px; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 8px;
    }
    .min-pill:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); }
    .min-pill.selected { background: var(--accent); border-color: var(--accent); color: white; }
    .min-pill .check-icon { opacity: 0; transform: scale(0.5); transition: 0.3s; }
    .min-pill.selected .check-icon { opacity: 1; transform: scale(1); }
    .pill-title { font-size: 13px; font-weight: 700; }

    /* Checkbox Custom */
    .checkbox-label { display: flex; align-items: flex-start; gap: 18px; cursor: pointer; user-select: none; }
    .checkbox-label input { position: absolute; opacity: 0; width: 0; height: 0; }
    .custom-check { flex-shrink: 0; height: 26px; width: 26px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: 0.3s; margin-top: 2px; }
    .checkbox-label:hover input ~ .custom-check { background: rgba(255,255,255,0.2); }
    .checkbox-label input:checked ~ .custom-check { background: var(--accent); border-color: var(--accent); }
    .custom-check:after { content: ""; display: none; width: 6px; height: 12px; border: solid white; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); margin-bottom: 3px; }
    .checkbox-label input:checked ~ .custom-check:after { display: block; }

    .label-info strong { display: block; font-size: 1.05rem; margin-bottom: 4px; }
    .label-info p { font-size: 0.9rem; color: rgba(255,255,255,0.4); margin: 0; }

    .card-group { background: rgba(255,255,255,0.02); padding: 25px; border-radius: 20px; border: 1px solid var(--glass-border); }

    /* Actions */
    .form-actions { margin-top: 20px; }
    .form-actions.dual { display: flex; gap: 20px; align-items: center; }
    
    .submit-btn {
      width: 100%; padding: 20px; background: rgba(255,255,255,0.05); color: white; border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.1); font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.3s;
      display: flex; align-items: center; justify-content: center; gap: 12px;
    }
    .submit-btn.highlight { background: white; color: black; border: none; box-shadow: 0 10px 40px rgba(255,255,255,0.15); }
    .submit-btn:hover { transform: translateY(-3px); box-shadow: 0 20px 50px rgba(0,0,0,0.3); }
    .submit-btn.highlight:hover { background: #f0f0f0; box-shadow: 0 20px 50px rgba(255,255,255,0.25); }
    
    .back-btn { 
      background: transparent; border: 1px solid var(--glass-border); padding: 18px 30px; 
      border-radius: 100px; color: rgba(255,255,255,0.6); font-weight: 700; cursor: pointer; 
      transition: 0.3s; display: flex; align-items: center; gap: 8px;
    }
    .back-btn:hover { background: rgba(255,255,255,0.05); color: white; border-color: rgba(255,255,255,0.3); }

    /* Custom Select */
    .custom-select-wrapper { position: relative; width: 100%; }
    .custom-select-trigger {
      width: 100%; background: var(--input-bg); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px;
      padding: 18px 22px; color: white; cursor: pointer; transition: 0.3s;
      display: flex; justify-content: space-between; align-items: center;
    }
    .custom-select-trigger:after { content: ""; border: solid rgba(255,255,255,0.4); border-width: 0 2px 2px 0; display: inline-block; padding: 3px; transform: rotate(45deg); transition: 0.3s; }
    .custom-select-wrapper.open .custom-select-trigger:after { transform: rotate(-135deg); }
    .custom-options {
      position: absolute; top: 120%; left: 0; right: 0; background: #1a1a1a; border: 1px solid var(--glass-border);
      border-radius: 12px; z-index: 100; opacity: 0; visibility: hidden; transform: translateY(-10px); transition: 0.3s;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5); overflow: hidden;
    }
    .custom-select-wrapper.open .custom-options { opacity: 1; visibility: visible; transform: translateY(0); }
    .custom-options .option { padding: 15px 20px; cursor: pointer; transition: 0.2s; font-size: 14px; font-weight: 600; }
    .custom-options .option:hover { background: var(--accent); color: white; }

    /* Custom Tile Grid */
    .custom-tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 15px; }
    .dept-tile {
      background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 18px;
      padding: 20px; cursor: pointer; transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      position: relative; display: flex; gap: 15px; border-left: 4px solid transparent;
    }
    .dept-tile:hover { background: rgba(255,255,255,0.06); transform: translateX(5px); }
    .dept-tile.selected { background: rgba(34, 197, 94, 0.1); border-color: rgba(34, 197, 94, 0.3); border-left-color: var(--accent); }
    
    .tile-icon { width: 40px; height: 40px; border-radius: 10px; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent); flex-shrink: 0; }
    .tile-info strong { display: block; font-size: 15px; margin-bottom: 4px; }
    .tile-info p { font-size: 11px; opacity: 0.4; margin: 0; line-height: 1.4; }
    
    .selection-indicator { position: absolute; top: 15px; right: 15px; opacity: 0; transform: scale(0.5); transition: 0.3s; color: var(--accent); }
    .dept-tile.selected .selection-indicator { opacity: 1; transform: scale(1); }

    .field-hint { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 8px; }

    /* Card Group Items */
    .card-group { background: rgba(255,255,255,0.02); padding: 25px; border-radius: 20px; border: 1px solid var(--glass-border); }
    .already-in-dept { display: flex; align-items: center; gap: 15px; padding: 15px 20px; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 16px; color: #4ade80; font-size: 14px; margin-bottom: 25px; }
    .role-badge { background: #166534; color: white; padding: 2px 8px; border-radius: 100px; font-size: 10px; font-weight: 800; text-transform: uppercase; margin-left: 8px; letter-spacing: 0.5px; }

    /* Role Selector */
    .role-selector-wrap { margin-top: 30px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.05); animation: slideDown 0.4s ease-out; }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    .sub-label { font-size: 0.85rem; font-weight: 800; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; display: block; }
    .role-pills { display: flex; flex-wrap: wrap; gap: 10px; }
    .role-pill { 
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; 
      padding: 8px 18px; color: rgba(255,255,255,0.6); font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.3s;
    }
    .role-pill:hover { background: rgba(255,255,255,0.08); color: white; }
    .role-pill.active { background: var(--accent); color: white; border-color: var(--accent); box-shadow: 0 5px 15px rgba(34, 197, 94, 0.3); }

    /* Ministry Grid */
    .ministry-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; margin-top: 15px; }
    .min-card { 
      background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: 16px; 
      padding: 15px; cursor: pointer; transition: 0.3s;
    }
    .min-card:hover { background: rgba(255,255,255,0.05); }
    .min-card.selected { border-color: #22c55e; background: rgba(34, 197, 94, 0.05); }
    .min-card strong { display: block; font-size: 14px; margin-bottom: 5px; }
    .min-card p { font-size: 10px; opacity: 0.4; line-height: 1.4; margin: 0; }

    /* Checkbox Custom */
    .checkbox-label { display: flex; align-items: flex-start; gap: 18px; cursor: pointer; user-select: none; }
    .checkbox-label input { position: absolute; opacity: 0; width: 0; height: 0; }
    .custom-check { flex-shrink: 0; height: 26px; width: 26px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: 0.3s; margin-top: 2px; }
    .checkbox-label:hover input ~ .custom-check { background: rgba(255,255,255,0.2); }
    .checkbox-label input:checked ~ .custom-check { background: var(--accent); border-color: var(--accent); }
    .custom-check:after { content: ""; display: none; width: 6px; height: 12px; border: solid white; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); margin-bottom: 3px; }
    .checkbox-label input:checked ~ .custom-check:after { display: block; }

    .label-info strong { display: block; font-size: 1.05rem; margin-bottom: 4px; }
    .label-info p { font-size: 0.9rem; color: rgba(255,255,255,0.4); margin: 0; }

    /* Actions */
    .form-actions { margin-top: 20px; }
    .form-actions.dual { display: flex; gap: 20px; align-items: center; }
    
    .submit-btn {
      width: 100%; padding: 22px; background: rgba(255,255,255,0.05); color: white; border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.1); font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: 0.3s;
      display: flex; align-items: center; justify-content: center; gap: 12px;
    }
    .submit-btn.highlight { background: white; color: black; border: none; box-shadow: 0 10px 40px rgba(255,255,255,0.15); }
    .submit-btn:hover { transform: translateY(-3px); box-shadow: 0 20px 50px rgba(0,0,0,0.3); }
    .submit-btn.highlight:hover { background: #f0f0f0; box-shadow: 0 20px 50px rgba(255,255,255,0.25); }
    
    .back-btn { text-decoration: none; color: rgba(255,255,255,0.5); font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 20px; transition: 0.3s; }
    .back-btn:hover { color: white; }

    @media (max-width: 600px) {
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .glass-fx { padding: 40px 20px; border-radius: 0; }
      .onboarding-page { padding: 0; }
      .onboard-header h2 { font-size: 2.2rem; }
      .progress-tracker { gap: 10px; margin-bottom: 40px; }
      .step-line { width: 50px; }
      .form-actions.dual { flex-direction: column-reverse; }
    }
  </style>

  <script>
    // Initialize Flatpickr
    function initDatePicker() {
      const config = {
        dateFormat: "Y-m-d",
        disableMobile: "true", // Use flatpickr UI instead of native on mobile for better UX
        animate: true,
        monthSelectorType: "static"
      };
      
      flatpickr('input[type="date"]', config);
    }

    function toggleAnniversary() {
      const input = document.querySelector('input[name="marital_status"]');
      const status = input ? input.value : '';
      const group = document.getElementById('anniversaryGroup');
      if (!group) return;
      group.style.display = status === 'Married' ? 'block' : 'none';
      
      // Re-init flatpickr if group becomes visible
      if (status === 'Married') {
        const annInput = group.querySelector('input');
        if (annInput && !annInput._flatpickr) flatpickr(annInput, { dateFormat: "Y-m-d" });
      }
    }

    function goToStep(stepNum) {
      const s1 = document.getElementById('stepSection1');
      const s2 = document.getElementById('stepSection2');
      const indicators = document.querySelectorAll('.step-indicator');
      const lines = document.querySelectorAll('.step-line');
      const title = document.getElementById('onboardTitle');
      const sub = document.getElementById('onboardSub');

      if (stepNum === 2) {
        // Validation for Step 1
        const gender = document.querySelector('input[name="gender"]').value;
        const dob = document.querySelector('input[name="dob"]').value;
        const phone = document.querySelector('input[name="phone"]').value;
        const addr = document.querySelector('input[name="addressLine1"]').value;
        const city = document.querySelector('input[name="city"]').value;

        if (!gender || !dob || !phone || !addr || !city) {
          alert('Please fill all required fields marked with * in Step 1.');
          return;
        }

        s1.style.display = 'none';
        s2.style.display = 'block';
        indicators[1].classList.add('active');
        lines[0].classList.add('active');
        title.innerText = 'Your Spiritual Journey';
        sub.innerText = 'Tell us a bit more about your walk with God and how you’d like to serve.';
        
        // GSAP entry if available
        if (typeof gsap !== 'undefined') {
          gsap.fromTo(s2, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power4.out" });
        }
        
        window.scrollTo(0, 0);
      } else {
        s1.style.display = 'block';
        s2.style.display = 'none';
        indicators[1].classList.remove('active');
        lines[0].classList.remove('active');
        title.innerText = 'Welcome to the Family';
        sub.innerText = 'Let’s start with some basic details to get your profile ready.';
        window.scrollTo(0, 0);
      }
    }

    // Role Filtering Logic
    function handleDeptSelection(deptName, deptId) {
       const roleWrapper = document.getElementById('roleSelectionWrapper');
       const roleOptions = document.querySelectorAll('.role-option');
       const posInput = document.getElementById('posInput');
       const posTrigger = document.querySelector('#posSelectWrapper .custom-select-trigger');
       
       // Reset position if department changes
       posInput.value = "";
       posTrigger.innerText = "Select Position";
       
       let hasRoles = false;
       roleOptions.forEach(opt => {
         if (opt.dataset.deptId === deptId) {
           opt.style.display = 'block';
           hasRoles = true;
         } else {
           opt.style.display = 'none';
         }
       });

       if (hasRoles) {
         roleWrapper.style.display = 'block';
         if (typeof gsap !== 'undefined') {
           gsap.fromTo(roleWrapper, { opacity: 0, height: 0 }, { opacity: 1, height: 'auto', duration: 0.5 });
         }
       } else {
         roleWrapper.style.display = 'none';
       }
    }

    function toggleMin(pill, minName) {
      pill.classList.toggle('selected');
      const checkbox = pill.querySelector('input[type="checkbox"]');
      checkbox.checked = !checkbox.checked;
    }

    // Unified Custom Select Logic
    document.addEventListener('click', (e) => {
      const isTrigger = e.target.closest('.custom-select-trigger');
      const isOption = e.target.closest('.option');
      
      // Close all if clicking outside
      if (!isTrigger && !isOption) {
        document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
        return;
      }

      if (isTrigger) {
        const wrapper = isTrigger.parentElement;
        document.querySelectorAll('.custom-select-wrapper').forEach(w => {
          if (w !== wrapper) w.classList.remove('open');
        });
        wrapper.classList.toggle('open');
      }

      if (isOption) {
        const wrapper = isOption.closest('.custom-select-wrapper');
        const trigger = wrapper.querySelector('.custom-select-trigger');
        const input = wrapper.querySelector('input');
        const val = isOption.dataset.value;
        const id = isOption.dataset.id;
        
        trigger.innerText = val;
        input.value = val;
        wrapper.classList.remove('open');
        
        // Custom hooks
        if (input.name === 'marital_status') toggleAnniversary();
        if (input.name === 'department_interest') handleDeptSelection(val, id);
      }
    });

    function toggleBaptismDate() {
      const isBaptized = document.getElementById('isBaptized').checked;
      const group = document.getElementById('baptismDateGroup');
      if (!group) return;
      group.style.display = isBaptized ? 'block' : 'none';
      
      if (isBaptized) {
        const bapInput = group.querySelector('input');
        if (bapInput && !bapInput._flatpickr) flatpickr(bapInput, { dateFormat: "Y-m-d" });
      }
    }

    window.addEventListener('load', () => {
      initDatePicker();
      toggleAnniversary();
      toggleBaptismDate();
      
      if (typeof gsap !== 'undefined') {
        gsap.from('.gsap-up', { y: 30, opacity: 0, duration: 1.2, ease: 'expo.out' });
      }
    });
  </script>
</body>
</html>
