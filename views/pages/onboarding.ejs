      .step-indicator { gap: 6px; }
      .step-label { font-size: 8px; letter-spacing: 0.5px; }
      .step-num { width: 28px; height: 28px; font-size: 11px; }
      .form-actions.dual { flex-direction: column-reverse; }
    }
  </style> 
  
  <script>
    let cropper;
    const avatarDataInput = document.getElementById('avatarDataInput');
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreviewBox = document.getElementById('avatarPreviewBox');
    const avatarImage = document.getElementById('avatarImage');
    const btnNext1 = document.getElementById('btnNext1');
    const cropControl = document.getElementById('cropControl');

    // Avatar Logic
    avatarInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          avatarPreviewBox.querySelector('.placeholder-icon').style.display = 'none';
          avatarImage.src = event.target.result;
          avatarImage.style.display = 'block';
          
          if (cropper) cropper.destroy();
          cropper = new Cropper(avatarImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
          });
          cropControl.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });

    function saveCrop() {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
      avatarDataInput.value = canvas.toDataURL('image/jpeg', 0.8);
      
      // Visual feedback
      avatarImage.src = avatarDataInput.value;
      cropper.destroy();
      cropper = null;
      cropControl.style.display = 'none';
      btnNext1.disabled = false;
      showToast('Avatar locked in!', 'success');
    }

    function selectPath(path) {
      document.getElementById('onboardingPathInput').value = path;
      
      // Update Step Labels based on path
      const journeyLabel = document.querySelector('.step-indicator[data-step="4"]');
      const journeyLine = document.querySelector('.step-line[data-line="4"]');
      
      if (path === 'existing_member' || path === 'church_worker') {
        if (journeyLabel) journeyLabel.style.display = 'none';
        if (journeyLine) journeyLine.style.display = 'none';
      } else {
        if (journeyLabel) journeyLabel.style.display = 'flex';
        if (journeyLine) journeyLine.style.display = 'block';
      }

      // Show/Hide Role Claim for workers in Step 5
      const workerRoleWrapper = document.getElementById('workerRoleClaimWrapper');
      if (workerRoleWrapper) {
        workerRoleWrapper.style.display = (path === 'church_worker') ? 'block' : 'none';
      }

      goToStep(1);
    }

    function goToStep(num) {
      const sections = document.querySelectorAll('.form-section');
      const indicators = document.querySelectorAll('.step-indicator');
      const lines = document.querySelectorAll('.step-line');
      const title = document.getElementById('onboardTitle');
      const sub = document.getElementById('onboardSub');
      const currentStepInput = document.getElementById('currentStepInput');
      const path = document.getElementById('onboardingPathInput').value;

      // Validation
      if (num > parseInt(currentStepInput.value)) {
        if (!validateCurrentStep(parseInt(currentStepInput.value))) return;
      }

      // Branching logic: Skip Step 4 for Members and Workers
      if (num === 4 && (path === 'existing_member' || path === 'church_worker')) {
        goToStep(5);
        return;
      }

      // Handle Back button branching
      if (num === 4 && (path === 'existing_member' || path === 'church_worker')) {
        goToStep(3);
        return;
      }

      sections.forEach((s, idx) => s.style.display = (idx === num) ? 'block' : 'none');
      
      // Progress UI
      indicators.forEach((ind, idx) => {
        if (idx < num) ind.classList.add('active');
        else ind.classList.remove('active');
      });
      lines.forEach((line, idx) => {
        if (idx < num - 1) line.classList.add('active');
        else line.classList.remove('active');
      });

      // Headers
      const headers = [
        ['Step 0', 'Choose Your Path', 'Tell us how you fit into the assembly family.'],
        ['Step 1', 'Kingdom Presence', 'Let’s start with your profile photo.'],
        ['Step 2', 'Personal Details', 'Basic information to help us know you better.'],
        ['Step 3', 'Life & Profession', 'Your professional background and personal story.'],
        ['Step 4', 'Spiritual Journey', 'Tell us about your walk with Christ.'],
        ['Step 5', 'Ministry & Service', 'Where would you like to serve in the assembly?'],
        ['Step 6', 'Final Connection', 'Set your preferences and join the family.']
      ];
      title.innerText = headers[num][1];
      sub.innerText = headers[num][2];
      currentStepInput.value = num;

      if (typeof gsap !== 'undefined') {
        gsap.fromTo(`#stepSection${num}`, { opacity: 0, x: 20 }, { opacity: 1, x: 0, duration: 0.6 });
      }
      window.scrollTo(0, 0);
    }

    function validateCurrentStep(step) {
      if (step === 0) return true;
      if (step === 1) {
        // Step 1 (Avatar) is now optional.
        return true;
      }
      if (step === 2) {
        const required = ['title', 'gender', 'dob', 'phone', 'addressLine1', 'city'];
        for (let field of required) {
          if (!document.querySelector(`[name="${field}"]`).value) {
            showToast(`Please fill in all identity details.`, 'error');
            return false;
          }
        }
      }
      // Security Check: Ensure CSRF token is still present before major submission
      if (step === 5) {
        const csrf = document.querySelector('input[name="_csrf"]');
        if (!csrf || !csrf.value) {
          showToast('Security token missing. Please refresh the page.', 'error');
          return false;
        }

        const dept = document.getElementById('deptInput').value;
        const pos = document.getElementById('outreachPosInput').value;
        
        if (dept && dept !== 'None' && !pos) {
          showToast('Please select a position within your chosen outreach team.', 'error');
          return false;
        }

        const path = document.getElementById('onboardingPathInput').value;
        if (path === 'church_worker') {
          const roleClaim = document.getElementById('roleClaimInput').value;
          if (!roleClaim) {
            showToast('Please select your current serving role.', 'error');
            return false;
          }
        }
      }
      return true;
    }

    function selectDept(tile, name, id) {
      const isCurrentlySelected = tile.classList.contains('selected');
      
      // Deselect all other tiles
      document.querySelectorAll('.dept-tile').forEach(t => t.classList.remove('selected'));
      document.getElementById('deptInput').value = '';
      
      // Toggle if not already selected
      if (!isCurrentlySelected) {
        tile.classList.add('selected');
        document.getElementById('deptInput').value = name;
      }
      
      const newName = document.getElementById('deptInput').value;
      
      // Clear position selection if switching or unselecting
      document.getElementById('outreachPosInput').value = '';
      document.querySelectorAll('#outreachRoleOptions .role-pill').forEach(p => p.classList.remove('active'));

      const roleWrapper = document.getElementById('outreachRoleSelectionWrapper');
      const roles = document.querySelectorAll('#outreachRoleOptions .role-pill');
      let count = 0;
      
      if (newName && newName !== 'None') {
        roles.forEach(r => {
          if (r.dataset.deptId === id) { r.style.display = 'block'; count++; }
          else r.style.display = 'none';
        });
      } else {
        roles.forEach(r => r.style.display = 'none');
      }
      
      roleWrapper.style.display = count > 0 ? 'block' : 'none';
      if (count > 0 && newName !== 'None') {
        roleWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        gsap.from(roleWrapper, { y: 20, opacity: 0, duration: 0.5 });
      }
    }

    function selectOutreachRole(pill, title) {
      document.querySelectorAll('#outreachRoleOptions .role-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      document.getElementById('outreachPosInput').value = title;
    }

    function selectMinRole(pill, title) {
      document.querySelectorAll('#minRoleOptions .role-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      document.getElementById('minRoleInput').value = title;
    }

    function toggleTag(tag, val) {
      tag.classList.toggle('selected');
      tag.querySelector('input').checked = tag.classList.contains('selected');
    }

    function toggleMin(card, name) {
      const container = card.closest('.ministry-groups-container');
      const isCurrentlySelected = card.classList.contains('selected');
      
      // Enforce Single Selection: Deselect all other cards in the container
      container.querySelectorAll('.min-card').forEach(c => {
        c.classList.remove('selected');
        const input = c.querySelector('input');
        if (input) input.checked = false;
      });
      
      const minRoleWrapper = document.getElementById('minRoleSelectionWrapper');

      // If it wasn't selected before, select it now. If it was, it stays unselected (toggling).
      if (!isCurrentlySelected) {
        card.classList.add('selected');
        const input = card.querySelector('input');
        if (input) input.checked = true;
        
        // Show role selection for ministries
        if (name !== 'None') {
          minRoleWrapper.style.display = 'block';
          gsap.from(minRoleWrapper, { y: 20, opacity: 0, duration: 0.5 });
          minRoleWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          minRoleWrapper.style.display = 'none';
        }
      } else {
        minRoleWrapper.style.display = 'none';
      }
    }

    function initFlatpickr() {
      flatpickr('input[type="date"]', {
        dateFormat: "Y-m-d",
        disableMobile: true,
        monthSelectorType: 'static'
      });
    }

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.custom-select-trigger');
      if (trigger) {
        const wrapper = trigger.parentElement;
        wrapper.classList.toggle('open');
      }
      const option = e.target.closest('.option');
      if (option) {
        const wrapper = option.closest('.custom-select-wrapper');
        const trigger = wrapper.querySelector('.custom-select-trigger');
        const input = wrapper.querySelector('input');
        trigger.innerText = option.innerText;
        input.value = option.dataset.value;
        wrapper.classList.remove('open');
        if (input.id === 'isBaptized') {
           document.getElementById('baptismDateGroup').style.display = input.value === 'true' ? 'block' : 'none';
        }
        if (input.id === 'maritalStatusInput') {
           document.getElementById('anniversaryGroup').style.display = input.value === 'married' ? 'block' : 'none';
        }
      }
    });

    window.addEventListener('load', () => {
      initFlatpickr();
      if (typeof gsap !== 'undefined') {
        gsap.from('.gsap-up', { y: 30, opacity: 0, duration: 1.2, ease: 'expo.out' });
      }
    });
  </script>
</body>
</html>

