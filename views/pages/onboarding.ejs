<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site no-scroll-transition" style="padding: 0px; margin: 0px; color: #1a1a1a;">
  
  <%- include('../partials/preloader') %>
  <%- include('../partials/toasts') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div id="site_content">

        <main class="onboarding-page">
          
          <div class="onboard-container gsap-up">
            <div class="onboard-card glass-fx">
              
              <!-- PROGRESS TRACKER -->
              <div class="progress-tracker">
                <div class="step-indicator" data-step="1">
                  <span class="step-num">1</span>
                  <span class="step-label">Avatar</span>
                </div>
                <div class="step-line" data-line="1"></div>
                <div class="step-indicator" data-step="2">
                  <span class="step-num">2</span>
                  <span class="step-label">Identity</span>
                </div>
                <div class="step-line" data-line="2"></div>
                <div class="step-indicator" data-step="3">
                  <span class="step-num">3</span>
                  <span class="step-label">Journey</span>
                </div>
                <div class="step-line" data-line="3"></div>
                <div class="step-indicator" data-step="4">
                  <span class="step-num">4</span>
                  <span class="step-label">Gifts</span>
                </div>
                <div class="step-line" data-line="4"></div>
                <div class="step-indicator" data-step="5">
                  <span class="step-num">5</span>
                  <span class="step-label">Service</span>
                </div>
              </div>

              <div class="onboard-header">
                <h2 id="onboardTitle">Welcome Home</h2>
                <p id="onboardSub">Let’s get your digital identity ready for the kingdom.</p>
                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="ob-error">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <%= error %>
                  </div>
                <% } %>
              </div>

              <form action="/onboarding" method="POST" class="ob-form" id="onboardingForm">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                <input type="hidden" name="avatar_data" id="avatarDataInput">
                <input type="hidden" name="current_step" id="currentStepInput" value="1">
                
                <!-- STEP 1: AVATAR UPLOAD (COMPULSORY) -->
                <div id="stepSection1" class="form-section">
                  <div class="avatar-upload-container">
                    <div class="avatar-preview-box glass-fx" id="avatarPreviewBox">
                      <div class="placeholder-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                          <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                      </div>
                      <img id="avatarImage" src="" style="display:none; max-width: 100%;">
                    </div>
                    
                    <div class="upload-controls">
                      <label for="avatarInput" class="upload-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                        Choose Photo
                      </label>
                      <input type="file" id="avatarInput" accept="image/*" style="display:none">
                      <p class="upload-hint">Upload a clear photo of yourself. This is compulsory for identification.</p>
                    </div>

                    <div id="cropControl" style="display:none; margin-top: 20px; width: 100%;">
                       <button type="button" class="submit-btn highlight" onclick="saveCrop()">Confirm Position</button>
                    </div>
                  </div>

                  <div class="form-actions" style="margin-top: 20px; display: flex; flex-direction: column; align-items: center; gap: 15px;">
                    <button type="button" class="submit-btn highlight" id="btnNext1" onclick="goToStep(2)">Continue to Identity
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                    <button type="button" class="back-btn" onclick="goToStep(2)" style="border: none; background: transparent; opacity: 0.5;">Skip photo for now</button>
                  </div>
                </div>

                <!-- STEP 2: IDENTITY -->
                <div id="stepSection2" class="form-section" style="display:none">
                  <div class="form-row">
                    <div class="form-group">
                      <label>Primary Title <span>*</span></label>
                      <div class="custom-select-wrapper">
                        <input type="hidden" name="title" value="<%= (user && user.title) ? user.title : '' %>">
                        <div class="custom-select-trigger"><%= (user && user.title) ? user.title : 'Select Title' %></div>
                        <div class="custom-options">
                          <div class="option" data-value="Mr">Mr</div>
                          <div class="option" data-value="Mrs">Mrs</div>
                          <div class="option" data-value="Ms">Ms</div>
                          <div class="option" data-value="Dr">Dr</div>
                          <div class="option" data-value="Pastor">Pastor</div>
                          <div class="option" data-value="Elder">Elder</div>
                          <div class="option" data-value="Bishop">Bishop</div>
                          <div class="option" data-value="Apostle">Apostle</div>
                          <div class="option" data-value="Prophet">Prophet</div>
                          <div class="option" data-value="Evangelist">Evangelist</div>
                          <div class="option" data-value="Deacon">Deacon</div>
                          <div class="option" data-value="Deaconess">Deaconess</div>
                          <div class="option" data-value="Minister">Minister</div>
                        </div>
                      </div>
                    </div>
                    <div class="form-group">
                      <label>Gender <span>*</span></label>
                      <div class="custom-select-wrapper">
                        <input type="hidden" name="gender" value="<%= user && user.gender ? user.gender : '' %>">
                        <div class="custom-select-trigger"><%= user && user.gender ? user.gender : 'Select Gender' %></div>
                        <div class="custom-options">
                          <div class="option" data-value="male">Male</div>
                          <div class="option" data-value="female">Female</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Date of Birth <span>*</span></label>
                      <input type="date" name="dob" value="<%= user && user.date_of_birth ? user.date_of_birth : '' %>">
                    </div>
                    <div class="form-group">
                      <label>Phone / WhatsApp <span>*</span></label>
                      <input type="tel" name="phone" placeholder="+234 ..." value="<%= user && user.phone ? user.phone : '' %>">
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Marital Status <span>*</span></label>
                      <div class="custom-select-wrapper">
                        <input type="hidden" name="marital_status" id="maritalStatusInput" value="<%= user && user.marital_status ? user.marital_status : '' %>">
                        <div class="custom-select-trigger"><%= user && user.marital_status ? user.marital_status : 'Select Status' %></div>
                        <div class="custom-options">
                          <div class="option" data-value="single">Single</div>
                          <div class="option" data-value="married">Married</div>
                          <div class="option" data-value="divorced">Divorced</div>
                          <div class="option" data-value="widowed">Widowed</div>
                        </div>
                      </div>
                    </div>
                    <div id="anniversaryGroup" class="form-group" style="<%= user && user.marital_status === 'married' ? '' : 'display:none' %>">
                      <label>Wedding Anniversary</label>
                      <input type="date" name="wedding_anniversary" value="<%= user && user.wedding_anniversary ? user.wedding_anniversary : '' %>">
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Home Address <span>*</span></label>
                      <input type="text" name="addressLine1" placeholder="Street Address" value="<%= user && user.address_line_1 ? user.address_line_1 : '' %>">
                    </div>
                    <div class="form-group">
                      <label>City <span>*</span></label>
                      <input type="text" name="city" placeholder="London, etc." value="<%= user && user.city ? user.city : '' %>">
                    </div>
                  </div>

                  <div class="card-group" style="margin-bottom: 30px;">
                    <h4 class="sub-label">Emergency Contact</h4>
                    <div class="form-row" style="margin-bottom: 0;">
                      <div class="form-group" style="margin-bottom: 0;">
                        <label>Contact Name</label>
                        <input type="text" name="emergency_contact_name" placeholder="Full Name" value="<%= user && user.emergency_contact_name ? user.emergency_contact_name : '' %>">
                      </div>
                      <div class="form-group" style="margin-bottom: 0;">
                        <label>Contact Phone</label>
                        <input type="tel" name="emergency_contact_phone" placeholder="Phone Number" value="<%= user && user.emergency_contact_phone ? user.emergency_contact_phone : '' %>">
                      </div>
                    </div>
                  </div>

                  <div class="form-actions dual">
                    <button type="button" onclick="goToStep(1)" class="back-btn glass-btn">Back</button>
                    <button type="button" class="submit-btn highlight" onclick="goToStep(3)">Journey
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                  </div>
                </div>

                <!-- STEP 3: JOURNEY -->
                <div id="stepSection3" class="form-section" style="display:none">
                   <div class="form-row">
                    <div class="form-group">
                      <label>Salvation Date</label>
                      <input type="date" name="salvation_date" value="<%= user && user.salvation_date ? user.salvation_date : '' %>">
                      <p class="field-hint">Approximate is fine.</p>
                    </div>
                    <div class="form-group">
                      <label>Are you Baptized? (Water)</label>
                      <div class="custom-select-wrapper">
                        <input type="hidden" name="is_baptized" id="isBaptized" value="<%= user && user.is_baptized ? 'true' : 'false' %>">
                        <div class="custom-select-trigger"><%= user && user.is_baptized ? 'Yes' : 'No' %></div>
                        <div class="custom-options">
                          <div class="option" data-value="true">Yes</div>
                          <div class="option" data-value="false">No</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div id="baptismDateGroup" class="form-group" style="display: none;">
                    <label>Baptism Date</label>
                    <input type="date" name="baptism_date" value="<%= user && user.baptism_date ? user.baptism_date : '' %>">
                  </div>

                  <div class="form-group">
                    <label>Previous Church (If any)</label>
                    <input type="text" name="previous_church" placeholder="Where were you worshipping before?" value="<%= user && user.previous_church ? user.previous_church : '' %>">
                  </div>

                  <div class="form-group">
                    <label>How did you hear about Ambassadors Assembly?</label>
                    <div class="custom-select-wrapper">
                      <input type="hidden" name="how_did_you_hear" value="<%= user && user.how_did_you_hear ? user.how_did_you_hear : '' %>">
                      <div class="custom-select-trigger"><%= user && user.how_did_you_hear ? user.how_did_you_hear : 'Select Source' %></div>
                      <div class="custom-options">
                        <div class="option" data-value="friend_family">Friend / Family</div>
                        <div class="option" data-value="social_media">Social Media</div>
                        <div class="option" data-value="website">Website</div>
                        <div class="option" data-value="outreach">Outreach</div>
                        <div class="option" data-value="other">Other</div>
                      </div>
                    </div>
                  </div>

                  <div class="form-actions dual">
                    <button type="button" onclick="goToStep(2)" class="back-btn glass-btn">Back</button>
                    <button type="button" class="submit-btn highlight" onclick="goToStep(4)">Gifts & Interests
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                  </div>
                </div>

                <!-- STEP 4: GIFTS & PASSIONS -->
                <div id="stepSection4" class="form-section" style="display:none">
                   <div class="form-group">
                    <label>Spiritual Gifts & Natural Skills</label>
                    <div class="gift-tags-grid" id="giftGrid">
                      <% ['Teaching', 'Worship', 'Hospitality', 'Media/Tech', 'Intercession', 'Administration', 'Evangelism', 'Graphic Design', 'Musical Instruments', 'Counselling', 'First Aid', 'Cooking'].forEach(gift => { %>
                        <div class="gift-tag <%= (user && user.spiritual_gifts && user.spiritual_gifts.includes(gift)) ? 'selected' : '' %>" onclick="toggleTag(this, '<%= gift %>')">
                          <input type="checkbox" name="spiritual_gifts" value="<%= gift %>" style="display:none" <%= (user && user.spiritual_gifts && user.spiritual_gifts.includes(gift)) ? 'checked' : '' %>>
                          <%= gift %>
                        </div>
                      <% }) %>
                    </div>
                    <p class="field-hint">Select all that apply to you.</p>
                  </div>

                  <div class="form-group">
                    <label>Join a Ministry (Fellowship Groups)</label>
                    <div class="ministry-grid">
                      <% const fellowshipGroups = ministries.filter(m => m.category === 'fellowship'); %>
                      <% fellowshipGroups.forEach(min => { 
                        const isSelected = (user && user.ministry_members && Array.isArray(user.ministry_members)) 
                          ? user.ministry_members.some(m => m && m.ministries && m.ministries.name === min.name) 
                          : false;
                      %>
                         <div class="min-card <%= isSelected ? 'selected' : '' %>" 
                              data-name="<%= min.name %>"
                              onclick="toggleMin(this, this.dataset.name)">
                          <input type="checkbox" name="ministry_interests" value="<%= min.name %>" style="display:none" <%= isSelected ? 'checked' : '' %>>
                          <strong><%= min.name %></strong>
                          <p><%= min.description ? min.description.substring(0, 60) + '...' : 'Community fellowship' %></p>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                  <div class="form-actions dual">
                    <button type="button" onclick="goToStep(3)" class="back-btn glass-btn">Back</button>
                    <button type="button" class="submit-btn highlight" onclick="goToStep(5)">Service Placement
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                  </div>
                </div>

                <!-- STEP 5: SERVICE ASSIGNMENT -->
                <div id="stepSection5" class="form-section" style="display:none">
                   <div class="form-group">
                    <label>Where would you like to serve? (Outreach & Community Impact) <span>*</span></label>
                    <div class="dept-selection-grid">
                       <% departments.forEach(dept => { %>
                        <% 
                          function getIcon(name) {
                            const n = name.toLowerCase();
                            if (n.includes('choir') || n.includes('music')) return 'fa-music';
                            if (n.includes('evangelism') || n.includes('outreach') || n.includes('impact')) return 'fa-bullhorn';
                            if (n.includes('prayer') || n.includes('intercession')) return 'fa-praying-hands';
                            if (n.includes('media') || n.includes('technical') || n.includes('it')) return 'fa-video';
                            if (n.includes('junior') || n.includes('children') || n.includes('kids')) return 'fa-child';
                            if (n.includes('usher') || n.includes('protocol')) return 'fa-door-open';
                            if (n.includes('welfare') || n.includes('care')) return 'fa-hands-helping';
                            if (n.includes('finance')) return 'fa-coins';
                            return 'fa-bullhorn';
                          }
                        %>
                        <div class="dept-tile <%= (user && user.department_interest === dept.name) ? 'selected' : '' %>" 
                             data-name="<%= dept.name %>"
                             data-id="<%= dept.id %>"
                             onclick="selectDept(this, this.dataset.name, this.dataset.id)">
                          <div class="tile-icon">
                            <i class="fas <%= getIcon(dept.name) %>"></i>
                          </div>
                          <div class="tile-info">
                            <strong><%= dept.name %></strong>
                            <p><%= dept.description || 'Service unit' %></p>
                          </div>
                          <div class="selection-indicator">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                    <input type="hidden" name="department_interest" id="deptInput" value="<%= (user && user.department_interest) ? user.department_interest : '' %>">
                  </div>

                  <div id="roleSelectionWrapper" class="form-group" style="display: none;">
                    <label>Specific Position of Interest <span>*</span></label>
                    <div class="role-pills" id="roleOptions">
                       <% positions.forEach(pos => { %>
                        <div class="role-pill <%= (user && user.position_interest === pos.title) ? 'active' : '' %>" 
                             data-dept-id="<%= pos.department_id %>"
                             data-title="<%= pos.title %>"
                             onclick="selectRole(this, this.dataset.title)">
                          <%= pos.title %>
                        </div>
                      <% }) %>
                    </div>
                    <input type="hidden" name="position_interest" id="posInput" value="<%= (user && user.position_interest) ? user.position_interest : '' %>">
                  </div>

                  <!-- NEW: Already serving check -->
                  <div class="form-group" style="margin-bottom: 35px; background: rgba(23, 106, 96, 0.03); padding: 25px; border-radius: 20px; border: 1px solid rgba(23, 106, 96, 0.1);">
                    <label class="checkbox-label">
                      <input type="checkbox" name="already_serving" value="true">
                      <div class="custom-check"></div>
                      <div class="label-info">
                        <strong style="color: #4ade80; font-size: 1.1rem; display: block; margin-bottom: 5px;">I am already serving at Ambassadors Assembly</strong>
                        <p style="font-size: 0.9rem; opacity: 0.6; line-height: 1.5; margin: 0;">Check this if you are already a Pastor, Worker, or Choir member. This flags your account for verification rather than a new application.</p>
                      </div>
                    </label>
                  </div>

                  <div class="form-group">
                    <label>Why do you want to serve in this capacity? (Motivation)</label>
                    <textarea name="motivation" placeholder="Share your heart or specific reasons for choosing this outreach team..." class="glass-input"><%= user && user.motivation ? user.motivation : '' %></textarea>
                  </div>

                  <div class="form-group">
                    <label>Occupation / Professional Background</label>
                    <input type="text" name="occupation" placeholder="e.g. Software Engineer, Doctor, Student" value="<%= user && user.occupation ? user.occupation : '' %>">
                  </div>

                  <div class="form-actions" style="margin-top: 30px; display: flex; flex-direction: column; gap: 15px;">
                    <button type="submit" class="submit-btn highlight" id="btnFinal">Complete Onboarding & Join A Team
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </button>
                    
                    <div style="display: flex; gap: 20px; align-items: center; justify-content: center;">
                      <button type="button" onclick="goToStep(4)" class="back-btn" style="padding: 0; border: none; background: transparent;">&larr; Back</button>
                      <button type="submit" class="back-btn" style="border: none; background: transparent; color: var(--accent); opacity: 0.8;">I'll join a team later, just sign me in</button>
                    </div>
                  </div>
                </div>

              </form>
            </div>
          </div>

        </main>

      </div>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

    <style>

  /* STRIP DUDA'S WHITE BACKGROUNDS FIRST */
  body.dmRoot, 
  #dm, 
  .dm_wrapper, 
  .dmOuter, 
  .dmInner, 
  #site_content, 
  .dmBody, 
  #allWrapper, 
  #dm_content,
  #dmFlexHeaderContainer,
  #flex-header,
  .onboarding-page {
    background-color: transparent !important;
    background-image: none !important;
  }

  /* AMBIENT BG */
main.onboarding-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background-image: url('https://res.cloudinary.com/dxwhpacz7/image/upload/q_auto/f_auto/v1775987631/45-dream-dark-blue-gradient.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  display: flex;
  align-items: center;
  justify-content: center;
}


    /* Container */
    .onboard-container { width: 100%; max-width: 800px; margin: 0 auto; color: #1a1a1a; }
    
    .glass-fx { background: #ffffff; border: 1px solid rgba(23, 106, 96, 0.2); border-radius: 40px; padding: 60px; box-shadow: 0 40px 100px rgba(23, 106, 96, 0.08); }

    /* Progress Tracker */
    .progress-tracker { display: flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 60px; }
    .step-indicator { display: flex; flex-direction: column; align-items: center; gap: 10px; opacity: 0.4; transition: 0.4s; color: #1a1a1a; }
    .step-indicator.active { opacity: 1; color: var(--color_2, #176a60); }
    .step-num { width: 36px; height: 36px; border-radius: 50%; border: 2px solid #1a1a1a; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; }
    .step-indicator.active .step-num { background: var(--color_2, #176a60); color: white; border-color: var(--color_2, #176a60); box-shadow: 0 5px 15px rgba(23, 106, 96, 0.3); }
    .step-label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; }
    .step-line { width: 120px; height: 2px; background: rgba(26,26,26,0.1); border-radius: 2px; }
    .step-line.active { background: var(--color_2, #176a60); }

    /* Avatar Step specific */
    .avatar-upload-container { display: flex; flex-direction: column; align-items: center; gap: 30px; margin-bottom: 40px; }
    .avatar-preview-box { width: 280px; height: 280px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative; border: 4px solid var(--color_2, #176a60); background: #fafafa; }
    .placeholder-icon { opacity: 0.15; color: #1a1a1a; }
    .upload-btn { background: linear-gradient(135deg, var(--color_2, #176a60) 0%, #115048 100%); color: white; padding: 15px 35px; border-radius: 100px; font-weight: 800; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 10px; margin-top: 10px; border: none; box-shadow: 0 10px 25px rgba(23, 106, 96, 0.3); }
    .upload-btn:hover { transform: scale(1.05); box-shadow: 0 15px 35px rgba(23, 106, 96, 0.4); }
    .upload-hint { font-size: 0.85rem; color: rgba(26,26,26,0.6); text-align: center; max-width: 300px; margin-top: 15px; }

    /* Gift Tags */
    .gift-tags-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; margin-top: 15px; }
    .gift-tag { 
      background: #fafafa; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 50px; 
      padding: 10px 15px; text-align: center; cursor: pointer; transition: 0.3s; font-size: 13px; font-weight: 700; color: rgba(26,26,26,0.6);
    }
    .gift-tag:hover { background: #ffffff; box-shadow: 0 5px 15px rgba(0,0,0,0.05); color: #1a1a1a; }
    .gift-tag.selected { background: var(--color_2, #176a60); color: white; border-color: var(--color_2, #176a60); box-shadow: 0 5px 15px rgba(23, 106, 96, 0.3); }

    /* Header */
    .onboard-header { text-align: center; margin-bottom: 50px; }
    .onboard-header h2 { font-family: 'Outfit', sans-serif; font-size: 2.8rem; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 12px; line-height: 1.1; color: #1a1a1a; }
    .onboard-header p { font-size: 1.1rem; color: rgba(26,26,26,0.6); line-height: 1.6; max-width: 500px; margin: 0 auto; }

    .ob-error { margin-top: 30px; padding: 18px 25px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 16px; color: #ef4444; font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; gap: 12px; }

    /* Form */
    .form-section { animation: fadeIn 0.6s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px; }
    .form-group { margin-bottom: 30px; }
    .form-group label { display: block; font-size: 0.95rem; font-weight: 700; color: #1a1a1a; margin-bottom: 10px; }
    .form-group label span { color: #ef4444; }
    .field-hint { font-size: 12px; color: rgba(26,26,26,0.5); margin-top: 8px; }

    .form-group input, .glass-input {
      width: 100%; background: #f8f9fa; border: 1px solid rgba(26,26,26,0.15); border-radius: 14px;
      padding: 18px 22px; color: #1a1a1a; font-size: 1rem; font-family: inherit;
      outline: none; transition: 0.3s;
    }
    .glass-input { min-height: 120px; resize: none; overflow-y: auto; }
    .form-group input:focus, .glass-input:focus { border-color: var(--color_2, #176a60); background: #ffffff; box-shadow: 0 0 0 4px rgba(23, 106, 96, 0.1); }

    /* Custom Select */
    .custom-select-wrapper { position: relative; width: 100%; }
    .custom-select-trigger {
      width: 100%; background: #f8f9fa; border: 1px solid rgba(26,26,26,0.15); border-radius: 14px;
      padding: 18px 22px; color: #1a1a1a; cursor: pointer; transition: 0.3s;
      display: flex; justify-content: space-between; align-items: center;
      min-height: 60px;
    }
    .custom-select-trigger:after { content: ""; border: solid rgba(26,26,26,0.5); border-width: 0 2px 2px 0; display: inline-block; padding: 3px; transform: rotate(45deg); transition: 0.3s; margin-left: 10px; }
    .custom-select-wrapper.open .custom-select-trigger { border-color: var(--color_2, #176a60); background: #ffffff; box-shadow: 0 0 0 4px rgba(23, 106, 96, 0.1); }
    .custom-select-wrapper.open .custom-select-trigger:after { transform: rotate(-135deg); border-color: var(--color_2, #176a60); }
    .custom-options {
      position: absolute; top: 110%; left: 0; right: 0; background: #ffffff; border: 1px solid rgba(23, 106, 96, 0.2);
      border-radius: 16px; z-index: 100; opacity: 0; visibility: hidden; transform: translateY(-10px); transition: 0.3s;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1); overflow-y: auto; max-height: 250px;
    }
    .custom-select-wrapper.open .custom-options { opacity: 1; visibility: visible; transform: translateY(0); }
    .custom-options .option { padding: 15px 20px; cursor: pointer; transition: 0.2s; font-size: 14px; font-weight: 600; color: #1a1a1a; }
    .custom-options .option:hover { background: rgba(23, 106, 96, 0.1); color: var(--color_2, #176a60); }

    /* Custom Checkbox */
    .checkbox-label { display: flex; align-items: flex-start; gap: 18px; cursor: pointer; user-select: none; }
    .checkbox-label input { position: absolute; opacity: 0; width: 0; height: 0; }
    .custom-check { flex-shrink: 0; height: 26px; width: 26px; background: #f8f9fa; border: 1.5px solid rgba(26,26,26,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: 0.3s; margin-top: 2px; }
    .checkbox-label:hover input ~ .custom-check { border-color: var(--color_2, #176a60); }
    .checkbox-label input:checked ~ .custom-check { background: var(--color_2, #176a60); border-color: var(--color_2, #176a60); box-shadow: 0 4px 10px rgba(23, 106, 96, 0.3); }
    .custom-check:after { content: ""; display: none; width: 6px; height: 12px; border: solid white; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); margin-bottom: 3px; }
    .checkbox-label input:checked ~ .custom-check:after { display: block; }
    
    .label-info strong { display: block; font-size: 1.05rem; margin-bottom: 4px; color: #1a1a1a; }
    .label-info p { font-size: 0.9rem; color: rgba(26, 26, 26, 0.6); margin: 0; }

    /* Ministry Grid */
    .ministry-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; margin-top: 15px; }
    .min-card { 
      background: #fafafa; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 16px; 
      padding: 15px; cursor: pointer; transition: 0.3s; color: #1a1a1a;
    }
    .min-card:hover { background: #ffffff; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border-color: rgba(23, 106, 96, 0.3); }
    .min-card.selected { border-color: var(--color_2, #176a60); background: rgba(23, 106, 96, 0.05); box-shadow: 0 5px 15px rgba(23, 106, 96, 0.1); }
    .min-card strong { display: block; font-size: 14px; margin-bottom: 5px; color: #1a1a1a; }
    .min-card p { font-size: 11px; color: rgba(26,26,26,0.6); line-height: 1.4; margin: 0; }

    /* Service Visuals / Dept Grid */
    .dept-selection-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px; }
    .dept-tile { 
      background: #fafafa; border: 1.5px solid rgba(26, 26, 26, 0.1); border-radius: 20px; 
      padding: 20px; cursor: pointer; transition: 0.3s; border-left: 4px solid transparent; 
      position: relative; color: #1a1a1a; display: flex; flex-direction: column; 
    }
    .dept-tile:hover { background: #ffffff; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border-color: rgba(23, 106, 96, 0.3); }
    .dept-tile.selected { border-color: var(--color_2, #176a60); border-left-color: var(--color_2, #176a60); background: rgba(23, 106, 96, 0.05); }
    
    .tile-icon { width: 40px; height: 40px; border-radius: 12px; background: rgba(23, 106, 96,0.1); display: flex; align-items: center; justify-content: center; color: var(--color_2, #176a60); margin-bottom: 15px; }
    .tile-info strong { display: block; font-size: 15px; margin-bottom: 4px; color: #1a1a1a; }
    .tile-info p { font-size: 11px; color: rgba(26,26,26,0.6); line-height: 1.4; margin: 0; }
    .selection-indicator { position: absolute; top: 15px; right: 15px; color: var(--color_2, #176a60); opacity: 0; transform: scale(0.5); transition: 0.3s; }
    .dept-tile.selected .selection-indicator { opacity: 1; transform: scale(1); }

    .role-selector-wrap { margin-top: 30px; padding-top: 30px; border-top: 1px solid rgba(26,26,26,0.1); animation: fadeIn 0.4s ease-out; }
    .role-pills { display: flex; flex-wrap: wrap; gap: 10px; }
    .role-pill { 
      background: #fafafa; border: 1.5px solid rgba(26, 26, 26, 0.1); border-radius: 100px; padding: 10px 20px;
      font-size: 13px; font-weight: 700; color: rgba(26, 26, 26, 0.6); cursor: pointer; transition: 0.3s;
    }
    .role-pill:hover { background: #ffffff; color: #1a1a1a; border-color: rgba(23, 106, 96, 0.4); }
    .role-pill.active { background: var(--color_2, #176a60); color: white; border-color: var(--color_2, #176a60); box-shadow: 0 5px 15px rgba(23, 106, 96, 0.3); }

    .card-group { background: #fafafa; padding: 25px; border-radius: 20px; border: 1px solid rgba(26,26,26,0.1); }
    .sub-label { font-size: 0.85rem; font-weight: 800; color: var(--color_2, #176a60); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px; display: block; }
    .already-in-dept { display: flex; align-items: center; gap: 15px; padding: 15px 20px; background: rgba(23, 106, 96, 0.05); border: 1.5px solid rgba(23, 106, 96, 0.2); border-radius: 16px; color: #0e423c; font-size: 14px; margin-bottom: 25px; }
    .role-badge { background: #0e423c; color: white; padding: 2px 8px; border-radius: 100px; font-size: 10px; font-weight: 800; text-transform: uppercase; margin-left: 8px; letter-spacing: 0.5px; }

    /* Actions */
    .form-actions { margin-top: 20px; }
    .form-actions.dual { display: flex; gap: 20px; align-items: center; }
    
    .submit-btn {
      width: 100%; padding: 20px; background: #f8f9fa; color: #1a1a1a; border-radius: 100px;
      border: 1px solid rgba(26,26,26,0.1); font-weight: 800; font-size: 1.05rem; cursor: pointer; transition: 0.3s;
      display: flex; align-items: center; justify-content: center; gap: 12px;
    }
    .submit-btn.highlight { background: linear-gradient(135deg, var(--color_2, #176a60) 0%, #115048 100%); color: white; border: none; box-shadow: 0 10px 25px rgba(23, 106, 96, 0.3); }
    .submit-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0,0,0,0.05); }
    .submit-btn.highlight:hover { box-shadow: 0 15px 35px rgba(23, 106, 96, 0.4); }
    .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
    
    .back-btn { 
      background: transparent; border: 1.5px solid rgba(26, 26, 26, 0.15); padding: 18px 35px; 
      border-radius: 100px; color: rgba(26, 26, 26, 0.7); font-weight: 700; cursor: pointer; 
      transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 0.95rem; white-space: nowrap;
    }
    .back-btn:hover { background: #fafafa; color: #1a1a1a; border-color: rgba(26, 26, 26, 0.4); }

    @media (max-width: 600px) {
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .glass-fx { padding: 40px 20px; border-radius: 0; border: none; box-shadow: none; }
      .onboarding-page { padding: 0; }
      .onboard-header h2 { font-size: 2.2rem; }
      .progress-tracker { gap: 8px; margin-bottom: 40px; overflow-x: auto; padding-bottom: 10px; padding-left: 10px; justify-content: flex-start; }
      .step-line { min-width: 30px; }
      .form-actions.dual { flex-direction: column-reverse; }
    }
  </style> 
  
  <script>
    let cropper;
    const avatarDataInput = document.getElementById('avatarDataInput');
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreviewBox = document.getElementById('avatarPreviewBox');
    const avatarImage = document.getElementById('avatarImage');
    const btnNext1 = document.getElementById('btnNext1');
    const cropControl = document.getElementById('cropControl');

    // Avatar Logic
    avatarInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          avatarPreviewBox.querySelector('.placeholder-icon').style.display = 'none';
          avatarImage.src = event.target.result;
          avatarImage.style.display = 'block';
          
          if (cropper) cropper.destroy();
          cropper = new Cropper(avatarImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
          });
          cropControl.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });

    function saveCrop() {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
      avatarDataInput.value = canvas.toDataURL('image/jpeg', 0.8);
      
      // Visual feedback
      avatarImage.src = avatarDataInput.value;
      cropper.destroy();
      cropper = null;
      cropControl.style.display = 'none';
      btnNext1.disabled = false;
      showToast('Avatar locked in!', 'success');
    }

    function goToStep(num) {
      const sections = document.querySelectorAll('.form-section');
      const indicators = document.querySelectorAll('.step-indicator');
      const lines = document.querySelectorAll('.step-line');
      const title = document.getElementById('onboardTitle');
      const sub = document.getElementById('onboardSub');
      const currentStepInput = document.getElementById('currentStepInput');

      // Validation
      if (num > parseInt(currentStepInput.value)) {
        if (!validateCurrentStep(parseInt(currentStepInput.value))) return;
      }

      sections.forEach((s, idx) => s.style.display = (idx + 1 === num) ? 'block' : 'none');
      
      // Progress UI
      indicators.forEach((ind, idx) => {
        if (idx + 1 <= num) ind.classList.add('active');
        else ind.classList.remove('active');
      });
      lines.forEach((line, idx) => {
        if (idx + 1 < num) line.classList.add('active');
        else line.classList.remove('active');
      });

      // Headers
      const headers = [
        ['Step 1', 'Kingdom Identity', 'Let’s start with your profile photo.'],
        ['Step 2', 'Personal Details', 'Basic information to help us know you better.'],
        ['Step 3', 'Spiritual Journey', 'Tell us about your walk with Christ.'],
        ['Step 4', 'Gifts & Interests', 'What has God placed in your hands?'],
        ['Step 5', 'Service Placement', 'Where would you like to serve in the assembly?']
      ];
      title.innerText = headers[num-1][1];
      sub.innerText = headers[num-1][2];
      currentStepInput.value = num;

      if (typeof gsap !== 'undefined') {
        gsap.fromTo(`#stepSection${num}`, { opacity: 0, x: 20 }, { opacity: 1, x: 0, duration: 0.6 });
      }
      window.scrollTo(0, 0);
    }

    function validateCurrentStep(step) {
      if (step === 1) {
        // Step 1 (Avatar) is now optional.
        return true;
      }
      if (step === 2) {
        const required = ['title', 'gender', 'dob', 'phone', 'addressLine1', 'city'];
        for (let field of required) {
          if (!document.querySelector(`[name="${field}"]`).value) {
            showToast(`Please fill in all identity details.`, 'error');
            return false;
          }
        }
      }
      // Security Check: Ensure CSRF token is still present before major submission
      if (step === 5) {
        const csrf = document.querySelector('input[name="_csrf"]');
        if (!csrf || !csrf.value) {
          showToast('Security token missing. Please refresh the page.', 'error');
          return false;
        }
      }
      return true;
    }

    function selectDept(tile, name, id) {
      document.querySelectorAll('.dept-tile').forEach(t => t.classList.remove('selected'));
      tile.classList.add('selected');
      document.getElementById('deptInput').value = name;
      
      const roleWrapper = document.getElementById('roleSelectionWrapper');
      const roles = document.querySelectorAll('.role-pill');
      let count = 0;
      roles.forEach(r => {
        if (r.dataset.deptId === id) { r.style.display = 'block'; count++; }
        else r.style.display = 'none';
      });
      roleWrapper.style.display = count > 0 ? 'block' : 'none';
    }

    function selectRole(pill, title) {
      document.querySelectorAll('.role-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      document.getElementById('posInput').value = title;
    }

    function toggleTag(tag, val) {
      tag.classList.toggle('selected');
      tag.querySelector('input').checked = tag.classList.contains('selected');
    }

    function toggleMin(card, name) {
      card.classList.toggle('selected');
      card.querySelector('input').checked = card.classList.contains('selected');
    }

    function initFlatpickr() {
      flatpickr('input[type="date"]', {
        dateFormat: "Y-m-d",
        disableMobile: true,
        monthSelectorType: 'static'
      });
    }

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.custom-select-trigger');
      if (trigger) {
        const wrapper = trigger.parentElement;
        wrapper.classList.toggle('open');
      }
      const option = e.target.closest('.option');
      if (option) {
        const wrapper = option.closest('.custom-select-wrapper');
        const trigger = wrapper.querySelector('.custom-select-trigger');
        const input = wrapper.querySelector('input');
        trigger.innerText = option.innerText;
        input.value = option.dataset.value;
        wrapper.classList.remove('open');
        if (input.id === 'isBaptized') {
           document.getElementById('baptismDateGroup').style.display = input.value === 'true' ? 'block' : 'none';
        }
      }
    });

    window.addEventListener('load', () => {
      initFlatpickr();
      if (typeof gsap !== 'undefined') {
        gsap.from('.gsap-up', { y: 30, opacity: 0, duration: 1.2, ease: 'expo.out' });
      }
    });
  </script>
</body>
</html>

