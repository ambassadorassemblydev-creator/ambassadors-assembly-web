<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <main class="event-detail-page">
          
          <!-- DYNAMIC HERO -->
          <section class="event-hero">
            <div class="hero-bg" style="background-image: url('<%= event.cover_image_url %>');"></div>
            <div class="hero-blur"></div>
            
            <div class="hero-content">
              <div class="event-meta gsap-up">
                <span class="type-badge"><%= event.event_type %></span>
                <span class="date-label"><%= new Date(event.start_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
              </div>
              <h1 class="event-title gsap-up"><%= event.title %></h1>
            </div>
          </section>

          <!-- CONTENT SECTION -->
          <section class="event-body">
            <div class="event-container">
              
              <div class="event-main gsap-up">
                <div class="main-card glass-fx">
                  <div class="event-description">
                    <h3 class="panel-title">About the Event</h3>
                    <p><%= event.description || 'Join us for this special gathering at Ambassadors Assembly.' %></p>
                  </div>
                </div>
              </div>

              <aside class="event-sidebar gsap-up">
                <div class="info-card glass-fx">
                  <div class="info-item">
                    <div class="info-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div>
                      <span class="info-label">Date & Time</span>
                      <span class="info-val"><%= new Date(event.start_date).toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) %></span>
                      <span class="info-val"><%= new Date(event.start_date).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %></span>
                    </div>
                  </div>

                  <div class="info-item">
                    <div class="info-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div>
                      <span class="info-label">Location</span>
                      <span class="info-val"><%= event.location_name || 'Ambassadors Assembly HQ' %></span>
                      <span class="info-val small"><%= [event.address, event.city].filter(Boolean).join(', ') || 'Lagos, Nigeria' %></span>
                    </div>
                  </div>

                  <% if (event.registration_required) { %>
                    <% if (user) { %>
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" id="csrfToken">
                      <button id="regButton" class="register-btn" onclick="showRegConfirmation()">
                        Register Now
                      </button>
                    <% } else { %>
                      <a href="/account/login" class="register-btn" style="text-decoration: none;">Sign In to Register</a>
                    <% } %>
                    <p id="attendingBadge" class="open-event-badge" style="display:none; color:#176a60;">You're Attending</p>
                  <% } else { %>
                    <div class="open-event-badge">
                      Free Entry • No Registration Required
                    </div>
                  <% } %>
                </div>

                <div class="share-box glass-fx">
                  <span class="share-label">Invite Others</span>
                  <div class="share-btns">
                    <button class="share-trigger" onclick="copyLink()">Copy Event Link</button>
                  </div>
                </div>
              </aside>

            </div>
          </section>

        </main>

      <!-- </div>
    </div>
  </div> -->

  <!-- REGISTRATION CONFIRMATION MODAL -->
  <div id="regModal" class="modal-overlay">
    <div class="modal-glass">
      <div class="modal-header">
        <h2>Confirm Registration</h2>
        <p>You are about to register for <strong><%= event.title %></strong>.</p>
      </div>
      <div class="modal-body">
        <ul class="reg-bullets">
          <li><strong>Date:</strong> <%= new Date(event.start_date).toLocaleDateString() %></li>
          <li><strong>Time:</strong> <%= new Date(event.start_date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></li>
        </ul>
        <p class="reg-notice">Your profile details will be shared with the event organizers.</p>
      </div>
      <div class="modal-actions">
        <button class="modal-btn secondary" onclick="closeModal('regModal')">Cancel</button>
        <button class="modal-btn primary" id="confirmRegBtn" onclick="submitRegistration('<%= event.id %>')">Confirm & Sign Up</button>
      </div>
    </div>
  </div>

  <!-- SUCCESS MODAL -->
  <div id="successModal" class="modal-overlay">
    <div class="modal-glass success">
      <div class="success-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2>Successfully Registered!</h2>
      <p>We've added this event to your dashboard. See you there!</p>
      <button class="modal-btn primary" onclick="location.href='/my-account?tab=events'">Go to My Dashboard</button>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <style>
    :root {
      --accent: #176a60;
      --glass: rgba(255, 255, 255, 0.7);
      --glass-border: rgba(26, 26, 26, 0.1);
    }

    .event-detail-page { min-height: 100vh; padding-bottom: 150px; }

    /* Hero */
    .event-hero {
      position: relative;
      height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 6%;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background-size: cover;
      background-position: center;
      filter: scale(1.1);
      z-index: 1;
    }

    .hero-blur {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(to top, #0e0e0e 0%, rgba(14, 14, 14, 0.4) 100%);
      z-index: 2;
    }

    .hero-content {
      position: relative;
      z-index: 3;
      text-align: center;
      max-width: 1000px;
    }

    .type-badge {
      display: inline-block;
      padding: 6px 18px;
      background: var(--accent);
      color: white;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 25px;
    }

    .date-label {
      display: block;
      color: rgba(255,255,255,0.6);
      font-weight: 600;
      font-size: 1.1rem;
      margin-bottom: 15px;
    }

    .event-title {
      font-family: 'Manrope', sans-serif;
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.05em;
    }

    /* Body */
    .event-body { margin-top: -100px; position: relative; z-index: 10; padding: 0 6%; }
    .event-container { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 400px; gap: 40px; }

    .glass-fx { background: var(--glass); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); border: 1px solid var(--glass-border); border-radius: 24px; padding: 40px; }

    .panel-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 25px; color: var(--accent); }
    .event-description p { font-size: 1.1rem; line-height: 1.8; color: #1a1a1a; white-space: pre-line; }

    /* Sidebar */
    .event-sidebar { display: flex; flex-direction: column; gap: 20px; }
    .info-item { display: flex; gap: 20px; margin-bottom: 30px; }
    .info-icon { width: 44px; height: 44px; background: rgba(26,26,26,0.05); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--accent); }
    .info-icon svg { width: 22px; }
    .info-label { display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: rgba(26,26,26,0.4); margin-bottom: 6px; }
    .info-val { display: block; font-size: 1.1rem; font-weight: 700; color: #1a1a1a; }
    .info-val.small { font-size: 0.9rem; font-weight: 400; opacity: 0.6; color: #1a1a1a; }

    .register-btn { 
      display: block; width: 100%; padding: 20px; background: var(--accent); color: white; border-radius: 100px; 
      text-align: center; text-decoration: none; font-weight: 800; font-size: 1rem; transition: all 0.3s ease;
      box-shadow: 0 20px 40px rgba(34, 197, 94, 0.2);
    }
    .register-btn:hover { transform: translateY(-4px); box-shadow: 0 25px 50px rgba(34, 197, 94, 0.3); }

    .open-event-badge { text-align: center; padding: 15px; border-radius: 50px; background: rgba(255,255,255,0.05); font-size: 0.85rem; font-weight: 700; color: rgba(255,255,255,0.6); }

    .share-trigger { width: 100%; border: 1px solid var(--glass-border); padding: 15px; border-radius: 12px; background: transparent; color: #1a1a1a; cursor: pointer; transition: 0.3s; }
    .share-trigger:hover { background: rgba(26,26,26,0.05); }
    .share-label { display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin-bottom: 15px; color: rgba(26,26,26,0.4); }

    @media (max-width: 1000px) {
      .event-container { grid-template-columns: 1fr; }
      .event-hero { height: 60vh; }
      .event-title { font-size: 3rem; }
    }

    /* MODAL STYLES */
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.8); backdrop-filter: blur(10px);
      z-index: 9999; display: none; align-items: center; justify-content: center;
      opacity: 0; transition: 0.4s;
    }
    .modal-overlay.active { display: flex; opacity: 1; }
    .modal-glass {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 32px; padding: 50px; width: 100%; max-width: 500px;
      text-align: center; box-shadow: 0 40px 100px rgba(0,0,0,0.5);
      transform: translateY(20px); transition: 0.4s;
    }
    .modal-overlay.active .modal-glass { transform: translateY(0); }
    
    .modal-header h2 { font-size: 2rem; margin-bottom: 10px; font-family: 'Articulat CF Demi Bold'; }
    .modal-header p { opacity: 0.6; margin-bottom: 30px; }
    
    .reg-bullets { list-style: none; padding: 0; margin: 0 0 30px; text-align: left; background: rgba(255,255,255,0.03); padding: 20px; border-radius: 16px; }
    .reg-bullets li { margin-bottom: 8px; font-size: 0.95rem; }
    .reg-notice { font-size: 12px; opacity: 0.4; margin-bottom: 30px; }
    
    .modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .modal-btn { padding: 18px; border-radius: 50px; font-weight: 800; cursor: pointer; border: none; transition: 0.3s; }
    .modal-btn.primary { background: var(--accent); color: white; }
    .modal-btn.secondary { background: rgba(255,255,255,0.05); color: white; }
    .modal-btn:hover { transform: translateY(-3px); opacity: 0.9; }

    .success-icon { width: 80px; height: 80px; background: #22c55e; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px; color: white; box-shadow: 0 20px 40px rgba(34, 197, 94, 0.3); }
  </style>

  <script>
    window.addEventListener('load', () => {
      gsap.from('.gsap-up', {
        y: 40, opacity: 0, duration: 1, stagger: 0.2, ease: 'power3.out'
      });
    });

    function copyLink() {
      navigator.clipboard.writeText(window.location.href);
      showToast('Event link copied!', 'success');
    }

    function showRegConfirmation() {
      document.getElementById('regModal').classList.add('active');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    async function submitRegistration(eventId) {
      const btn = document.getElementById('confirmRegBtn');
      btn.innerText = 'Registering...';
      btn.disabled = true;

      try {
        const response = await fetch('/api/events/register', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'x-csrf-token': document.getElementById('csrfToken').value
          },
          body: JSON.stringify({ eventId })
        });
        
        const result = await response.json();
        
        if (result.status === 'success') {
          closeModal('regModal');
          document.getElementById('successModal').classList.add('active');
          document.getElementById('regButton').style.display = 'none';
          document.getElementById('attendingBadge').style.display = 'block';
        } else {
          showToast(result.message || 'Error occurred during registration.', 'error');
          btn.innerText = 'Confirm & Sign Up';
          btn.disabled = false;
        }
      } catch (err) {
        console.error('Registration failed:', err);
        showToast('Could not complete registration. Please try again.', 'error');
        btn.innerText = 'Confirm & Sign Up';
        btn.disabled = false;
      }
    }
  </script>
</body>
</html>