<%- include('../partials/head') %>
<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: #131313;">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>
<%- include('../partials/preloader') %>
<%- include('../partials/toasts') %>

<main class="prayer-page">
    <!-- Hero / Intro -->
    <section class="prayer-hero">
        <div class="prayer-hero__content">
            <h1 class="hero-title" data-gsap="fade-up">Light of <span class="text-italic">Hope</span></h1>
            <p class="hero-sub" data-gsap="fade-up" data-gsap-delay="0.1">A wall of intercession. Submit your requests and join others in prayer.</p>
            <div class="hero-actions" data-gsap="fade-up" data-gsap-delay="0.2">
                <button class="submit-prayer-btn" onclick="togglePrayerForm()">Submit a Request</button>
            </div>
        </div>
        
        <!-- Floating Particles Decoration -->
        <div class="prayer-particles" id="prayerParticles"></div>
    </section>

    <!-- Prayer Wall Grid -->
    <section class="prayer-wall">
        <div class="prayer-grid" id="prayerGrid">
            <% if (prayers && prayers.length > 0) { %>
                <% prayers.forEach((prayer) => { %>
                    <div class="prayer-card" id="prayer-<%= prayer.id %>" data-gsap="prayer-reveal">
                        <div class="prayer-card__glow"></div>
                        <div class="prayer-card__content">
                            <div class="prayer-card__header">
                                <span class="category"><%= prayer.category %></span>
                                <% if (prayer.is_urgent) { %>
                                    <span class="urgent-badge">Urgent</span>
                                <% } %>
                            </div>
                            <h3 class="prayer-card__title"><%= prayer.title %></h3>
                            <p class="prayer-card__desc"><%= prayer.description %></p>
                            
                            <div class="prayer-card__footer">
                                <div class="requester">
                                    <div class="requester__avatar">
                                        <img src="<%= prayer.is_anonymous ? '/images/default-avatar.png' : (prayer.profiles?.avatar_url || '/images/default-avatar.png') %>" alt="avatar">
                                    </div>
                                    <div class="requester__info">
                                        <span class="name"><%= prayer.is_anonymous ? 'Anonymous' : (prayer.profiles?.first_name || prayer.requester_name) %></span>
                                        <span class="date"><%= new Date(prayer.created_at).toLocaleDateString() %></span>
                                    </div>
                                </div>
                                
                                <button class="intercede-btn" onclick="intercede('<%= prayer.id %>')">
                                    <div class="intercede-btn__icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 21l-8.228-9.274a5.5 5.5 0 010-7.442l.06-.06a5.5 5.5 0 017.567-.132L12 4.965l.592-.513a5.5 5.5 0 017.567.132l.06.06a5.5 5.5 0 010 7.442L12 21z"/></svg>
                                    </div>
                                    <span class="count"><%= prayer.prayer_count %></span>
                                    <span class="label">Intercede</span>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-wall">
                    <p>The wall is quiet. Start a prayer or join one.</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Slide-over Request Form -->
    <div class="prayer-form-overlay" id="prayerForm">
        <div class="prayer-form-panel">
            <button class="close-panel" onclick="togglePrayerForm()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
            <div class="panel-content">
                <h2>Share your <span class="text-italic">burden</span></h2>
                <p>We believe in the power of collective prayer. Your request will be reviewed by our team.</p>
                
                <form action="/prayer-wall/submit" method="POST" class="actual-form">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <div class="hp-field" style="display:none !important; visibility:hidden !important;"><input type="text" name="full_name_hp" tabindex="-1" autocomplete="off"></div>
                    <div class="form-group">
                        <label>Title of Request</label>
                        <input type="text" name="title" placeholder="e.g. Healing for my father" required>
                    </div>
                    <div class="form-group">
                        <label>Details</label>
                        <textarea name="description" placeholder="Share as much as you're comfortable with..." rows="5" required></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Category</label>
                            <select name="category">
                                <option value="healing">Healing</option>
                                <option value="provision">Provision</option>
                                <option value="wisdom">Wisdom</option>
                                <option value="salvation">Salvation</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-checkboxes">
                        <label class="checkbox-label">
                            <input type="checkbox" name="is_anonymous">
                            <span>Post Anonymously</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" name="is_public" checked>
                            <span>Share on Prayer Wall</span>
                        </label>
                    </div>
                    <button type="submit" class="submit-btn">Send to the Wall</button>
                </form>
            </div>
        </div>
    </div>
</main>

<style>
    .prayer-page {
        background: #0e0e0e;
        color: #f5f0e8;
        min-height: 100vh;
    }

    /* Hero */
    .prayer-hero {
        height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at center, #1a1a1a 0%, #0e0e0e 100%);
    }

    .prayer-hero__content {
        z-index: 5;
    }

    .hero-title {
        font-family: 'Manrope', sans-serif;
        font-size: clamp(3rem, 7vw, 5rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 20px;
    }

    .hero-sub {
        opacity: 0.6;
        max-width: 500px;
        margin: 0 auto 40px;
    }

    .submit-prayer-btn {
        background: #f5f0e8;
        color: #0e0e0e;
        border: none;
        padding: 14px 34px;
        border-radius: 50px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

    .submit-prayer-btn:hover {
        transform: scale(1.05);
    }

    /* Grid */
    .prayer-wall {
        max-width: 1400px;
        margin: 0 auto;
        padding: 80px 40px;
    }

    .prayer-grid {
        display: grid;
        grid-template_columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 30px;
    }

    /* Card */
    .prayer-card {
        position: relative;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 40px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .prayer-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.15);
        transform: translateY(-5px);
    }

    .prayer-card__glow {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100px;
        height: 100px;
        background: radial-gradient(circle, rgba(113, 178, 128, 0.3) 0%, transparent 70%);
        transform: translate(-50%, -50%);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .prayer-card:hover .prayer-card__glow {
        opacity: 1;
    }

    .prayer-card__header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .category {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-weight: 800;
        color: rgba(113, 178, 128, 1);
    }

    .urgent-badge {
        background: rgba(233, 69, 96, 0.2);
        color: #e94560;
        padding: 4px 10px;
        border-radius: 5px;
        font-size: 0.65rem;
        font-weight: 800;
    }

    .prayer-card__title {
        font-family: 'Manrope', sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        margin-bottom: 12px;
        line-height: 1.3;
    }

    .prayer-card__desc {
        font-size: 0.95rem;
        opacity: 0.5;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .prayer-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .requester {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .requester__avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        overflow: hidden;
        background: #2a2a2a;
    }

    .requester__avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .requester__info .name {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .requester__info .date {
        font-size: 0.65rem;
        opacity: 0.4;
    }

    /* Intercede Button */
    .intercede-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 8px 16px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        color: #f5f0e8;
    }

    .intercede-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #f5f0e8;
    }

    .intercede-btn__icon svg {
        width: 16px;
        height: 16px;
    }

    .intercede-btn.active {
        background: rgba(113, 178, 128, 0.2);
        border-color: rgba(113, 178, 128, 0.5);
        color: rgba(113, 178, 128, 1);
    }

    /* Form Slide-over */
    .prayer-form-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10000;
        visibility: hidden;
        opacity: 0;
        transition: all 0.4s ease;
    }

    .prayer-form-overlay.is-active {
        visibility: visible;
        opacity: 1;
    }

    .prayer-form-panel {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        max-width: 500px;
        height: 100%;
        background: #1a1a1a;
        padding: 60px 40px;
        transform: translateX(100%);
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .prayer-form-overlay.is-active .prayer-form-panel {
        transform: translateX(0);
    }
</style>

<script>
    function togglePrayerForm() {
        document.getElementById('prayerForm').classList.toggle('is-active');
    }

    async function intercede(id) {
        const btn = document.querySelector(`#prayer-${id} .intercede-btn`);
        const countSpan = btn.querySelector('.count');
        
        try {
            const response = await fetch('/prayer-wall/intercede', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ requestId: id })
            });

            const result = await response.json();
            
            if (result.success) {
                btn.classList.add('active');
                countSpan.innerText = parseInt(countSpan.innerText) + 1;
                
                // LIGHT UP EFFECT
                const glow = document.querySelector(`#prayer-${id} .prayer-card__glow`);
                gsap.to(glow, {
                    scale: 3,
                    opacity: 0.8,
                    duration: 0.5,
                    yoyo: true,
                    repeat: 1
                });

                // Toast or feedback
                showToast('Thank you for praying. Your intercession is recorded!');
            } else {
                showToast(result.error || 'Something went wrong.');
            }
        } catch (error) {
            console.error('Intercession error:', error);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        gsap.from('[data-gsap="prayer-reveal"]', {
            y: 30,
            opacity: 0,
            duration: 0.8,
            stagger: 0.1,
            ease: 'power3.out'
        });
    });
</script>

<%- include('../partials/footer') %>
