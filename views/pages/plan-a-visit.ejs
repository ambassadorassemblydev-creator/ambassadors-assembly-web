<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" data-page-alias="home" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px;" data-flex-site="">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>

        <main class="visit-page">
          <!-- AMBIENT BG -->
          <div class="give-bg">
            <div class="bg-overlay"></div>
            <img src="https://images.unsplash.com/photo-1543886567-91f1a5fcd232?q=80&w=2000&auto=format&fit=crop" alt="Plan Your Visit Background" class="bg-img">
          </div>
          <section class="visit-hero">
            <div class="hero-content">
              <span class="gsap-visit">Welcome Home</span>
              <h1 class="gsap-visit">Plan Your Visit</h1>
              <p class="gsap-visit">We can't wait to meet you. Here is everything you need to know for your first experience at Ambassadors Assembly.</p>
            </div>
          </section>

          <section class="visit-details">
            <div class="details-grid">
              
              <!-- SERVICE TIMES -->
              <div class="detail-panel glass-fx gsap-up">
                <h3>Service Times</h3>
                <div class="time-block">
                  <span class="day">Sunday</span>
                  <div class="slots">
                    <div class="slot"><span>9:00 AM</span> — First Service</div>
                    <div class="slot"><span>11:30 AM</span> — Second Service</div>
                    <div class="slot"><span>5:00 PM</span> — Encounter (Monthly)</div>
                  </div>
                </div>
                <div class="time-block">
                  <span class="day">Wednesday</span>
                  <div class="slots">
                    <div class="slot"><span>6:00 PM</span> — Mid-Week Bible Study</div>
                  </div>
                </div>
              </div>

              <!-- LOCATION -->
              <div class="detail-panel glass-fx gsap-up">
                <h3>How to Find Us</h3>
                <p>123 Ambassadors Drive, Ikeja,<br>Lagos, Nigeria.</p>
                <div class="map-link">
                  <a href="https://maps.google.com" target="_blank" class="map-btn">Get Directions ↗</a>
                </div>
                <div class="parking-info">
                  <p><strong>Parking:</strong> Free parking is available in the main lot. Our welcome team will be there to guide you.</p>
                </div>
              </div>

            </div>
          </section>

          <!-- WHAT TO EXPECT -->
          <section class="expect-section">
            <div class="content-container">
              <div class="expect-grid-layout">
                <div class="expect-text gsap-visit">
                  <span class="small-label">The Experience</span>
                  <h2>What to Expect</h2>
                  <p>We know that visiting a new church can be intimidating. Here’s a glimpse into what your first Sunday at Ambassadors Assembly will look like.</p>
                  
                  <div class="expect-features">
                    <div class="feature-item gsap-up">
                      <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                      </div>
                      <div class="feature-text">
                        <h4>Atmosphere of Love</h4>
                        <p>A welcoming family where you'll be greeted with a smile and a warm embrace.</p>
                      </div>
                    </div>
                    <div class="feature-item gsap-up">
                      <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                      </div>
                      <div class="feature-text">
                        <h4>Punctuality</h4>
                        <p>We honor your time. Our services start on time and are designed to be impactful.</p>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="expect-cards-side">
                  <div class="expect-card-premium glass-fx gsap-up">
                    <div class="card-tag">Style</div>
                    <h4>How should I dress?</h4>
                    <p>Come as you are! You'll see everything from suits to jeans. We care more about you than what you're wearing. Our focus is on the heart, not the outward appearance.</p>
                  </div>
                  <div class="expect-card-premium glass-fx gsap-up">
                    <div class="card-tag">Family</div>
                    <h4>What about my kids?</h4>
                    <p>Ambassadors Kids provides a fun, safe, and engaging environment for children to learn about Jesus at their level. We have age-appropriate classes for infants through pre-teens.</p>
                  </div>
                  <div class="expect-card-premium glass-fx gsap-up">
                    <div class="card-tag">Service</div>
                    <h4>How long is it?</h4>
                    <p>Our services typically last about 90 minutes. They involve powerful, spirit-led worship and a deep, practical Word from God that you can apply to your life immediately.</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

        </main>

     

  <%- include('../partials/footer') %>

  <style>
    .visit-page { padding-bottom: 120px; }
    
    .visit-hero { height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 6%; background: transparent; position: relative; }
    .visit-hero span { display: block; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 5px; color: #3b82f6; margin-bottom: 20px; }
    .visit-hero h1 { font-family: 'Manrope', sans-serif; font-size: clamp(3rem, 7vw, 6rem); font-weight: 900; line-height: 1; letter-spacing: -0.04em; margin-bottom: 25px; }
    .visit-hero p { font-size: 1.15rem; color: rgba(255,255,255,0.6); max-width: 700px; margin: 0 auto; }

    .visit-details { padding: 0 6%; margin-top: -80px; }
    .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 1400px; margin: 0 auto; }
    .detail-panel { padding: 50px; border-radius: 32px; }
    .detail-panel h3 { font-size: 1.8rem; font-weight: 800; margin-bottom: 40px; color: #f5f0e8; }

    .time-block { margin-bottom: 40px; }
    .day { font-size: 0.75rem; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; color: rgba(255,255,255,0.3); display: block; margin-bottom:15px; }
    .slots { display: flex; flex-direction: column; gap: 12px; }
    .slot { font-size: 1.1rem; color: rgba(255,255,255,0.8); }
    .slot span { font-weight: 800; color: white; margin-right: 10px; }

    .map-btn { display: inline-block; padding: 16px 32px; background: white; color: black; border-radius: 100px; text-decoration: none; font-weight: 800; margin-top: 30px; transition: 0.3s; }
    .map-btn:hover { transform: translateY(-3px); box-shadow: 0 20px 40px rgba(255,255,255,0.1); }
    .parking-info { margin-top: 40px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.05); color: rgba(255,255,255,0.5); font-size: 0.95rem; }

    .expect-section { padding: 120px 6%; background: #050505; }
    .content-container { max-width: 1400px; margin: 0 auto; }
    
    .expect-grid-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 100px; align-items: start; }
    .expect-text h2 { font-size: 3.5rem; font-weight: 900; line-height: 1.1; margin-bottom: 30px; letter-spacing: -0.02em; }
    .expect-text p { font-size: 1.1rem; color: rgba(255,255,255,0.5); line-height: 1.7; margin-bottom: 60px; }

    .expect-features { display: flex; flex-direction: column; gap: 40px; }
    .feature-item { display: flex; gap: 25px; }
    .feature-icon { width: 50px; height: 50px; border-radius: 16px; background: rgba(59, 130, 246, 0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .feature-icon svg { width: 24px; height: 24px; }
    .feature-text h4 { font-size: 1.2rem; font-weight: 800; margin-bottom: 8px; }
    .feature-text p { font-size: 0.95rem; color: rgba(255,255,255,0.4); margin-bottom: 0; }

    .expect-cards-side { display: flex; flex-direction: column; gap: 30px; }
    .expect-card-premium { padding: 50px; border-radius: 40px; position: relative; overflow: hidden; }
    .card-tag { position: absolute; top: 30px; right: 40px; font-size: 0.7rem; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; color: rgba(255,255,255,0.2); }
    .expect-card-premium h4 { font-size: 1.5rem; font-weight: 800; margin-bottom: 20px; color: #3b82f6; }
    .expect-card-premium p { font-size: 1rem; color: rgba(255,255,255,0.5); line-height: 1.7; margin-bottom: 0; }

    .glass-fx { background: rgba(255,255,255,0.03); backdrop-filter: blur(40px); border: 1px solid rgba(255,255,255,0.08); }

    /* Ambient BG */
    .give-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
    .bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.3; filter: contrast(1.1) grayscale(0.2); }
    .bg-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to bottom, #0e0e0e 0%, rgba(14,14,14,0.8) 100%); }

    @media (max-width: 1000px) { .details-grid { grid-template-columns: 1fr; } .expect-grid { grid-template-columns: 1fr; } }
  </style>

  <script>
    window.addEventListener('load', () => {
      gsap.from('.gsap-visit', { y: 40, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power3.out' });
      gsap.from('.gsap-up', { 
        scrollTrigger: { trigger: '.visit-details', start: 'top 80%' },
        y: 60, opacity: 0, duration: 1, stagger: 0.15, ease: 'power3.out' 
      });
    });
  </script>
</body>
</html>