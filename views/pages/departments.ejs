<%- include('../partials/head') %>

<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);">
  
  <%- include('../partials/preloader') %>
  
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">

        <%- include('../partials/navbar') %>
        <link rel="stylesheet" href="/css/dashboard-new.css">

        <div class="aa-dash">
          <%- include('../partials/aa-sidebar', { activeTab: 'departments' }) %>

          <main class="aas-main">
            <!-- Mobile top bar -->
            <div class="aas-mob-bar">
              <button class="aas-ham" id="aasHam"><i class="fas fa-bars"></i></button>
              <span class="aas-mob-hello"><%= user.title ? user.title + ' ' : '' %><%= user.first_name %></span>
            </div>

            <!-- PREMIUM HEADER -->
            <div class="aas-ph" style="margin-bottom: 40px;">
              <div class="aas-eyebrow">OUTREACH & COMMUNITY IMPACT</div>
              <h1>Outreach and Community Impact</h1>
              <p>Be the hands and feet of Jesus. Join a team focused on making a real difference in our assembly and community.</p>
            </div>

            <div class="depts-grid">
              <% if (departments && departments.length > 0) { %>
                <% departments.forEach((dept, index) => { %>
                  <div class="dept-card" style="animation-delay: <%= index * 0.1 %>s;">
                    <div class="dept-card-inner">
                      <div class="dept-icon">
                        <i class="fas fa-bullhorn"></i>
                      </div>
                      <h2 class="dept-name"><%= dept.name %></h2>
                      <p class="dept-desc"><%= dept.description || 'Ensuring excellence in church operations and service execution.' %></p>
                      
                      <div class="dept-footer">
                        <a href="/my-account?tab=profile&interest=<%= encodeURIComponent(dept.name) %>" class="interest-btn">
                          Volunteer Now
                          <i class="fas fa-arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="empty-state">
                  <i class="fas fa-building"></i>
                  <p>Departments are being organized. Check back soon!</p>
                </div>
              <% } %>
            </div>

            <style>
              .depts-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
                gap: 24px;
                padding-bottom: 60px;
              }

              .dept-card {
                background: #ffffff;
                border: 1.5px solid rgba(26, 26, 26, 0.1);
                border-radius: 28px;
                padding: 40px;
                position: relative;
                overflow: hidden;
                transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
                animation: dashFadeUp 0.8s ease backwards;
              }

              .dept-card:hover {
                border-color: var(--accent-sage);
                transform: translateY(-10px);
                box-shadow: 0 25px 50px rgba(0,0,0,0.05);
              }

              .dept-icon {
                width: 60px;
                height: 60px;
                background: rgba(113, 178, 128, 0.1);
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 30px;
                color: var(--accent-sage);
                font-size: 24px;
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
              }

              .dept-name {
                font-family: 'Outfit', sans-serif;
                font-size: 26px;
                font-weight: 800;
                color: #1a1a1a;
                margin: 0 0 16px;
                letter-spacing: -0.5px;
              }

              .dept-desc {
                color: rgba(26, 26, 26, 0.5);
                font-size: 15px;
                line-height: 1.7;
                margin-bottom: 35px;
                font-family: 'Inter', sans-serif;
              }

              .dept-footer {
                margin-top: auto;
              }

              .interest-btn {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                padding: 14px 28px;
                background: #fafafa;
                border: 1.5px solid rgba(26, 26, 26, 0.1);
                color: #1a1a1a;
                border-radius: 100px;
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                transition: 0.3s;
              }

              .interest-btn:hover {
                background: var(--accent-sage);
                border-color: var(--accent-sage);
                color: #0c0c0c;
                transform: scale(1.05);
              }

              .interest-btn i {
                font-size: 12px;
                transition: transform 0.3s ease;
              }

              .interest-btn:hover i {
                transform: translateX(5px);
              }

              @keyframes dashFadeUp {
                from { opacity: 0; transform: translateY(30px); }
                to { opacity: 1; transform: translateY(0); }
              }

              @media (max-width: 768px) {
                .depts-grid { grid-template-columns: 1fr; }
                .dept-card { padding: 30px; }
              }
              
              .dmFooterContainer { display: none !important; }
            </style>

          </main>
        </div>

        <%- include('../partials/footer') %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
