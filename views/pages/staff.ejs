<%- include('../partials/head') %>

<!-- MAINTAINING EXACT DUDA NESTING STRUCTURE -->
<body id="dmRoot" class="dmRoot fix-mobile-scrolling flex-site dmResellerSite no-scroll-transition" style="padding: 0px; margin: 0px; background: var(--color_1);">
  
  <%- include('../partials/preloader') %>
  
  <!-- ========= Site Content ========= -->
  <div id="dm" class="dmwr">
    <div class="dm_wrapper -var5 null ">
      <div dmwrapped="true" id="1901957768" class="dm-home-page" themewaschanged="true">
        <div dmtemplateid="FlexHeader" data-responsive-name="FlexLayout" class="runtime-module-container dm-bfs dm-layout-home hasAnimations hasStickyHeader inMiniHeaderMode rows-1200 hamburger-reverse dmPageBody d-page-1716942098 inputs-css-clean dmDHeader" id="dm-outer-wrapper" data-page-class="1716942098" data-soch="true" data-background-parallax-selector=".dmHomeSection1, .dmSectionParallex">
          <div id="dmStyle_outerContainer" class="dmOuter">
            <div id="dmStyle_innerContainer" class="dmInner">
              <div class="dmLayoutWrapper standard-var dmStandardDesktop">
                <div id="site_content">
    <%- include('../partials/navbar') %>

    <main class="staff-page">
      <!-- HERO (CINEMATIC) -->
      <section class="staff-hero">
        <div class="hero-bg">
          <div class="hero-overlay"></div>
          <img src="/images/emerald-hero-bg.png" alt="Staff Background" class="hero-img">
        </div>
        <div class="hero-content">
          <span class="sub-label">The Hands & Feet</span>
          <h1 class="hero-title">Our Glorious<br><span class="text-green">Team</span></h1>
          <p class="hero-sub">The consecrated individuals who labor tirelessly to ensure the vision of Ambassadors Assembly reaches the ends of the earth.</p>
        </div>
      </section>

      <!-- STAFF GRID & FILTER -->
      <section class="staff-directory">
        <div class="directory-container">
          
          <div class="staff-grid" id="staff-grid">
            <% staff.forEach((s, i) => { %>
              <div class="staff-card gsap-reveal" data-dept="<%= s.department %>" onclick="openStaffDetail(`<%= s.first_name %> <%= s.last_name %>`, `<%= s.role %>`, `Leading the <%= s.department %> outreach with excellence and consecration to ensure the kingdom's mandate is fulfilled.`)">
                <div class="staff-card__img">
                    <img src="<%= s.avatar_url || '/images/default-avatar.png' %>" alt="<%= s.first_name %>" loading="lazy">
                </div>
                <div class="staff-card__content">
                    <h3 class="staff-name"><%= s.first_name %> <%= s.last_name %></h3>
                    <span class="staff-role"><%= s.role %></span>
                    <div class="staff-dept-badge"><%= s.department %></div>
                </div>
              </div>
            <% }) %>
          </div>

        </div>
      </section>

      <!-- CENTERED FILTER BUTTON -->
      <div class="filter-section-centered">
          <button id="filterToggle" class="main-filter-trigger gsap-reveal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 3H2l8 9v6l4 3v-9L22 3z"/></svg>
              <span>Filter</span>
          </button>
          
          <div id="filterMenu" class="fancy-filter-menu glass-fx">
              <div class="filter-menu-inner">
                  <button class="filter-btn active" data-filter="all">All Leadership</button>
                  <% departments.forEach(dept => { %>
                      <button class="filter-btn" data-filter="<%= dept.name %>"><%= dept.name %></button>
                  <% }) %>
              </div>
          </div>
      </div>

      <!-- FELLOWSHIP & IMPACT SECTION -->
      <section class="team-extra-section" style="padding: 80px 6%;">
        <div class="directory-container">
          <div style="margin-bottom: 40px; text-align: center;">
            <span class="sub-label">Get Involved</span>
            <h2 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 15px; color: #1a1a1a;">Fellowship & Outreach</h2>
            <p style="color: rgba(26,26,26,0.6); max-width: 600px; margin: 0 auto; font-size: 1.1rem;">Discover active fellowships and join a community where you can serve with purpose.</p>
          </div>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
            <% if (ministries && ministries.length > 0) { %>
              <% ministries.forEach(m => { %>
                <div style="background: #ffffff; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 24px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
                  <h3 style="font-size: 1.5rem; font-weight: 800; color: #1a1a1a; margin-bottom: 10px;"><%= m.name %></h3>
                  <p style="font-size: 0.95rem; color: rgba(26,26,26,0.7); line-height: 1.5; margin-bottom: 20px;"><%= m.description || 'A vibrant community of believers serving together.' %></p>
                  <p style="font-size: 0.8rem; font-weight: 700; color: var(--aa-green); text-transform: uppercase; letter-spacing: 1px;"><%= m.meeting_time ? `Meets: ${m.meeting_time}` : 'Contact for meeting times' %></p>
                </div>
              <% }) %>
            <% } else { %>
              <p>Check back soon for our active ministries list.</p>
            <% } %>
          </div>
        </div>
      </section>

      <!-- CHURCH PROJECTS / OUTREACH SECTION -->
      <section class="team-extra-section" style="padding: 80px 6%; background: rgba(113, 178, 128, 0.05); border-top: 1.5px solid rgba(26,26,26,0.1); border-bottom: 1.5px solid rgba(26,26,26,0.1);">
        <div class="directory-container">
          <div style="margin-bottom: 40px; text-align: center;">
            <span class="sub-label">Impact Stories</span>
            <h2 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 15px; color: #1a1a1a;">Church Projects & Outreach</h2>
            <p style="color: rgba(26,26,26,0.6); max-width: 600px; margin: 0 auto; font-size: 1.1rem;">See the vision behind our ongoing initiatives and testimonies of lives transformed.</p>
          </div>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
            <% if (projects && projects.length > 0) { %>
              <% projects.forEach(p => { %>
                <div style="background: #ffffff; border: 1.5px solid rgba(26,26,26,0.1); border-radius: 24px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
                  <div style="aspect-ratio: 16/9; overflow: hidden; background: #f0f0f0;">
                    <img src="<%= p.image_url || 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?q=80&w=2070' %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                  </div>
                  <div style="padding: 30px;">
                    <h3 style="font-size: 1.5rem; font-weight: 800; color: #1a1a1a; margin-bottom: 10px;"><%= p.name %></h3>
                    <p style="font-size: 0.95rem; color: rgba(26,26,26,0.7); line-height: 1.5;"><%= p.description || 'Impacting our community through dedicated outreach and foundational projects.' %></p>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p>No ongoing projects right now. Check back soon.</p>
            <% } %>
          </div>
        </div>
      </section>

      <!-- SERVICES & PROGRAMS SECTION -->
      <section class="team-extra-section" style="padding: 80px 6%;">
        <div class="directory-container" style="text-align: center;">
          <span class="sub-label">Join Us</span>
          <h2 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 50px; color: #1a1a1a;">Services & Programs</h2>
          
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 30px;">
            <div style="background: #1a1a1a; color: white; border-radius: 24px; padding: 40px; width: 100%; max-width: 400px; text-align: left;">
              <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 15px; color: var(--aa-green);">Sunday Services</h3>
              <ul style="list-style: none; padding: 0; margin: 0; font-size: 1.1rem; line-height: 2;">
                <li style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; margin-bottom: 10px;"><strong>First Service:</strong> 8:00 AM</li>
                <li><strong>Second Service:</strong> 10:00 AM</li>
              </ul>
            </div>
            <div style="background: #1a1a1a; color: white; border-radius: 24px; padding: 40px; width: 100%; max-width: 400px; text-align: left;">
              <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 15px; color: var(--aa-green);">Midweek Services</h3>
              <ul style="list-style: none; padding: 0; margin: 0; font-size: 1.1rem; line-height: 2;">
                <li style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; margin-bottom: 10px;"><strong>Wednesday Bible Study:</strong> 6:00 PM</li>
                <li><strong>Monthly Encounter:</strong> Sundays at 5:00 PM</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- DETAIL POPUP (CINEMATIC) -->
      <div class="staff-popup" id="staff-popup">
        <div class="popup-overlay" onclick="closeStaffDetail()"></div>
        <div class="popup-content glass-fx">
          <button class="close-popup" onclick="closeStaffDetail()">&times;</button>
          <div class="popup-inner">
            <div class="popup-header">
              <span id="pop-role" class="sub-label">Role</span>
              <h2 id="pop-name">Staff Name</h2>
            </div>
            <div class="popup-quote">
              <p id="pop-quote">"Compelling vision statement goes here."</p>
            </div>
          </div>
        </div>
      </div>

    </main>

    <%- include('../partials/footer') %>
  

  <style>
    :root { 
        --aa-green: #176a60; 
        --aa-bg: var(--color_1);
    }
    .text-green { color: var(--aa-green); }

    .staff-page {
        background: var(--aa-bg);
        color: #1a1a1a;
        min-height: 100vh;
    }
    
    .staff-hero { position: relative; height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; }
    .hero-bg { position: absolute; top:0; left:0; width:100%; height:100%; z-index: 1; }
    .hero-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; transform: scale(1.1); }
    .hero-overlay { 
      position: absolute; top:0; left:0; width:100%; height:100%; 
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, rgba(255,255,255,0.8) 60%, var(--aa-bg) 100%); 
      z-index: 2; 
    }

    .hero-content { position: relative; z-index: 3; padding: 0 6%; }
    .sub-label { display: block; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 5px; color: var(--aa-green); margin-bottom: 20px; }
    .hero-title {
        font-size: clamp(3.5rem, 10vw, 7rem);
        font-weight: 950;
        line-height: 0.85;
        letter-spacing: -0.05em;
        margin-bottom: 30px;
        color: #1a1a1a;
    }
    .hero-sub {
        font-size: 1.25rem;
        color: rgba(26, 26, 26, 0.5);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .staff-directory { padding: 40px 6% 150px; position: relative; z-index: 5; }
    .directory-container { max-width: 1400px; margin: 0 auto; }
    
    .staff-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; }
    
    .staff-card {
        background: #ffffff;
        border: 1.5px solid rgba(26, 26, 26, 0.1);
        border-radius: 40px;
        overflow: hidden;
        transition: 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
        cursor: pointer;
        position: relative;
    }
    .staff-card:hover {
        transform: translateY(-15px) scale(1.02);
        border-color: var(--aa-green);
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.08);
    }
    
    .staff-card__img { aspect-ratio: 1; overflow: hidden; }
    .staff-card__img img {
        width: 100%; height: 100%; object-fit: cover;
        opacity: 0.9;
        transition: 1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .staff-card:hover .staff-card__img img { opacity: 1; transform: scale(1.1); }

    .staff-card__content { padding: 35px; text-align: center; }
    .staff-name { font-size: 1.5rem; font-weight: 850; margin-bottom: 5px; color: #1a1a1a; }
    .staff-role { font-size: 0.85rem; color: var(--aa-green); font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }

    /* Centered Filter */
    .filter-section-centered {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 60px;
      position: relative;
    }
    
    .main-filter-trigger {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 40px;
      background: var(--aa-green);
      color: white;
      border: none;
      border-radius: 100px;
      font-weight: 800;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 20px 40px rgba(23, 106, 96, 0.2);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      z-index: 100;
    }
    .main-filter-trigger:hover {
      transform: translateY(-5px);
      box-shadow: 0 25px 50px rgba(23, 106, 96, 0.3);
    }
    .main-filter-trigger.active {
      background: #1a1a1a;
    }

    .fancy-filter-menu {
      position: absolute;
      top: calc(100% + 20px);
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 1.5px solid rgba(23, 106, 96, 0.1);
      border-radius: 30px;
      padding: 15px;
      display: none;
      opacity: 0;
      transform: translateY(10px);
      z-index: 99;
      box-shadow: 0 30px 60px rgba(0,0,0,0.1);
      width: max-content;
      max-width: 90vw;
    }
    .filter-menu-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      max-width: 600px;
    }

    .filter-btn { 
      padding: 10px 22px; border-radius: 100px; background: rgba(26,26,26,0.03); border: 1px solid transparent; 
      color: #1a1a1a; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: 0.3s;
    }
    .filter-btn:hover { background: rgba(23, 106, 96, 0.05); color: var(--aa-green); }
    .filter-btn.active { background: var(--aa-green); color: white; border-color: var(--aa-green); }

    /* Popup */
    .staff-popup { 
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
      z-index: 2000; visibility: hidden; opacity: 0;
      display: flex; align-items: center; justify-content: center; padding: 6%;
    }
    .close-popup { position: absolute; top: 30px; right: 30px; background: transparent; border: none; font-size: 2rem; color: white; cursor: pointer; line-height: 1; }
    .popup-header h2 { font-size: 4rem; line-height: 0.95; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 40px; }
    .popup-quote p { font-size: 1.5rem; line-height: 1.6; font-style: italic; color: rgba(255,255,255,0.7); }
    
    .glass-fx { background: #1a1a1a; border: 1px solid rgba(255,255,255,0.08); }

    @media (max-width: 800px) {
      .staff-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
      .popup-content { padding: 40px 20px; }
      .popup-header h2 { font-size: 2.5rem; }
      .popup-quote p { font-size: 1.1rem; }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script>
    // Filter Logic
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.staff-card');
    const defaultFilter = "<%= defaultFilter %>"; // 'Pastoral'

    window.addEventListener('load', () => {
      // Set default filter if it exists
      if (defaultFilter) {
        applyFilter(defaultFilter);
        const defaultBtn = Array.from(filterBtns).find(b => b.dataset.filter === defaultFilter);
        if (defaultBtn) {
          filterBtns.forEach(b => b.classList.remove('active'));
          defaultBtn.classList.add('active');
        }
      }

      // Cinematic Entrance (Defensive)
      if (document.querySelector('.hero-content h1')) {
          gsap.from('.hero-content h1', { y: 50, opacity: 0, duration: 1.2, ease: 'power4.out' });
      }
      if (document.querySelectorAll('.staff-card').length > 0) {
          gsap.from('.staff-card', { y: 60, opacity: 0, duration: 0.8, stagger: 0.1, ease: "power2.out", delay: 0.2 });
      }
      if (document.querySelector('.bottom-filter-bar')) {
          gsap.from('.bottom-filter-bar', { y: 100, opacity: 0, duration: 1, ease: "back.out(1.7)", delay: 0.5 });
      }
    });

    // Filter Toggle Logic
    const filterTrigger = document.getElementById('filterToggle');
    const filterMenu = document.getElementById('filterMenu');
    
    filterTrigger.addEventListener('click', () => {
        const isOpen = filterTrigger.classList.contains('active');
        if (isOpen) {
            closeFilter();
        } else {
            openFilter();
        }
    });

    function openFilter() {
        filterTrigger.classList.add('active');
        filterMenu.style.display = 'block';
        gsap.to(filterMenu, { opacity: 1, y: 0, duration: 0.4, ease: 'back.out(1.7)' });
    }

    function closeFilter() {
        filterTrigger.classList.remove('active');
        gsap.to(filterMenu, { 
            opacity: 0, y: 10, duration: 0.3, 
            onComplete: () => filterMenu.style.display = 'none' 
        });
    }

    // Close on click outside
    document.addEventListener('click', (e) => {
        if (!filterMenu.contains(e.target) && !filterTrigger.contains(e.target)) {
            closeFilter();
        }
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter(btn.dataset.filter);
        closeFilter();
      });
    });

    function applyFilter(filter) {
      gsap.to('.staff-card', { 
        duration: 0.3, 
        scale: 0.9, 
        opacity: 0, 
        onComplete: () => {
          cards.forEach(card => {
            if (filter === 'all' || card.dataset.dept.includes(filter)) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
          gsap.to('.staff-card', { duration: 0.5, scale: 1, opacity: 1, stagger: 0.05, ease: 'power2.out' });
        }
      });
    }

    // Popup Logic
    const popup = document.getElementById('staff-popup');
    const popName = document.getElementById('pop-name');
    const popRole = document.getElementById('pop-role');
    const popQuote = document.getElementById('pop-quote');

    function openStaffDetail(name, role, quote) {
      popName.innerText = name;
      popRole.innerText = role;
      popQuote.innerText = `"${quote}"`;

      gsap.set(popup, { visibility: 'visible' });
      gsap.to(popup, { opacity: 1, duration: 0.5 });
      gsap.from('.popup-content', { y: 100, scale: 0.95, duration: 0.6, ease: 'elastic.out(1, 0.8)' });
    }

    function closeStaffDetail() {
      gsap.to(popup, { 
        opacity: 0, 
        duration: 0.4, 
        onComplete: () => gsap.set(popup, { visibility: 'hidden' }) 
      });
    }
  </script>
</body>
</html>
