<!-- Global Toast Container -->
<div id="toast-container" class="toast-container"></div>

<style>
  .toast-container {
    position: fixed;
    top: 30px;
    right: 30px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 15px;
    pointer-events: none;
  }

  .toast {
    min-width: 320px;
    max-width: 450px;
    padding: 20px 25px;
    border-radius: 16px;
    background: rgba(20, 20, 20, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    gap: 15px;
    pointer-events: auto;
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(120%);
    opacity: 0;
  }

  .toast.show {
    transform: translateX(0);
    opacity: 1;
  }

  .toast-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .toast-content {
    flex: 1;
  }

  .toast-title {
    font-size: 0.95rem;
    font-weight: 800;
    margin-bottom: 2px;
    display: block;
    font-family: 'Manrope', sans-serif;
  }

  .toast-msg {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
  }

  /* Success State */
  .toast-success {
    border-left: 4px solid #10b981;
  }
  .toast-success .toast-icon { color: #10b981; }

  /* Error State */
  .toast-error {
    border-left: 4px solid #ef4444;
  }
  .toast-error .toast-icon { color: #ef4444; }

  /* Info State */
  .toast-info {
    border-left: 4px solid #3b82f6;
  }
  .toast-info .toast-icon { color: #3b82f6; }

  @media (max-width: 600px) {
    .toast-container {
      top: auto;
      bottom: 30px;
      right: 20px;
      left: 20px;
    }
    .toast {
      min-width: 0;
      width: 100%;
    }
  }
</style>

<script>
  /**
   * High IQ Global Toast System
   * Usage: showToast('Message', 'success' | 'error' | 'info')
   */
  function showToast(message, type = 'info', title = null) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    
    if (!title) {
      if (type === 'success') title = 'Success';
      else if (type === 'error') title = 'Error';
      else title = 'Notification';
    }

    const icons = {
      success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toast-icon"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>',
      error: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toast-icon"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>',
      info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toast-icon"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>'
    };

    toast.innerHTML = `
      ${icons[type] || icons.info}
      <div class="toast-content">
        <strong class="toast-title">${title}</strong>
        <p class="toast-msg">${message}</p>
      </div>
    `;

    container.appendChild(toast);

    // Trigger animation
    requestAnimationFrame(() => {
      toast.classList.add('show');
    });

    // Auto-remove after 5s
    const timer = setTimeout(() => {
      removeToast(toast);
    }, 5000);

    // Manual remove on click
    toast.onclick = () => {
      clearTimeout(timer);
      removeToast(toast);
    };
  }

  function removeToast(toast) {
    toast.classList.remove('show');
    toast.style.transform = 'translateY(-20px)';
    toast.style.opacity = '0';
    setTimeout(() => {
      if (toast.parentNode) {
        toast.parentNode.removeChild(toast);
      }
    }, 500);
  }

  // Auto-detect messages from URL
  window.addEventListener('load', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.has('success')) {
      showToast(params.get('success'), 'success');
      // Clean URL without refresh
      const newUrl = window.location.pathname + window.location.hash;
      window.history.replaceState({}, document.title, newUrl);
    }
    if (params.has('error')) {
      showToast(params.get('error'), 'error');
      const newUrl = window.location.pathname + window.location.hash;
      window.history.replaceState({}, document.title, newUrl);
    }
  });
</script>
