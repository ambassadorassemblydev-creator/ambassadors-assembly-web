<style><

.no-scroll-transition { overflow: hidden !important; position: relative; height: 100vh !important; }
.page-transition { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 100000000; pointer-events: all; }
.page-transition__bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #0d2a1f; clip-path: circle(150% at 50% 50%); will-change: clip-path; }
.page-transition__text-mask { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1; overflow: visible; white-space: nowrap; width: 90vw; max-width: 1100px; text-align: center; height: 120px; }
.page-transition__text { position: absolute; left: 0; width: 100%; text-align: center; white-space: nowrap; line-height: 1.2; margin: 0; }
.page-transition__text--brand { font-family: 'Manrope', sans-serif; font-size: clamp(1.4rem, 6vw, 3.5rem); font-weight: 800; color: #f5f0e8; letter-spacing: 0.08em; }
.page-transition__text--tagline { font-family: 'Manrope', sans-serif; font-size: clamp(1.1rem, 4.5vw, 2.5rem); font-weight: 300; color: #f5f0e8; letter-spacing: 0.12em; visibility: hidden; }

@media (max-width: 480px) {
  .page-transition__text-mask { width: 95vw; white-space: normal; }
  .page-transition__text { white-space: normal; }
  .page-transition__text--brand { font-size: clamp(1rem, 6vw, 1.6rem); letter-spacing: 0.03em; }
  .page-transition__text--tagline { font-size: clamp(0.85rem, 4.5vw, 1.2rem); letter-spacing: 0.06em; }
}

@media (max-width: 360px) {
  .page-transition__text--brand { font-size: 0.95rem; letter-spacing: 0.02em; }
  .page-transition__text--tagline { font-size: 0.8rem; letter-spacing: 0.04em; }
}
</style>

<!-- ========= Page Transition Overlay ========= -->
<div class="page-transition" id="page-transition">
  <div class="page-transition__bg"></div>
  <div class="page-transition__text-mask">
    <div class="page-transition__text page-transition__text--brand">
      THE AMBASSADORS ASSEMBLY
    </div>
    <div class="page-transition__text page-transition__text--tagline">
      <%= locals.preloaderText || 'YOU BELONG HERE' %>
    </div>
  </div>
</div>
<script src="/js/preloader.js"></script>
