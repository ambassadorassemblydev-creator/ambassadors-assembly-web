<!-- ========= CUSTOM MODAL SYSTEM ========= -->
<div id="aa-modal-root" class="aa-modal-root">
  <div class="aa-modal-overlay" id="aa-modal-overlay"></div>
  <div class="aa-modal-container glass-fx" id="aa-modal-container">
    <div class="aa-modal-header">
      <div class="aa-modal-brand">
         <div class="aa-brand-dot"></div>
         <span id="aa-modal-header-text">Notification</span>
      </div>
      <button class="aa-modal-close" id="aa-modal-close">&times;</button>
    </div>
    <div class="aa-modal-body">
      <p id="aa-modal-message">Your message goes here.</p>
    </div>
    <div class="aa-modal-footer">
      <button class="aa-btn aa-btn--secondary" id="aa-modal-cancel">Cancel</button>
      <button class="aa-btn aa-btn--primary" id="aa-modal-confirm">Confirm</button>
    </div>
  </div>
</div>

<style>
.aa-modal-root {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  z-index: 9999; display: flex; align-items: center; justify-content: center;
  visibility: hidden; opacity: 0; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.aa-modal-root.active { visibility: visible; opacity: 1; }

.aa-modal-overlay {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.85); backdrop-filter: blur(10px);
}

.aa-modal-container {
  position: relative; z-index: 2; width: 90%; max-width: 500px;
  padding: 40px; border-radius: 32px; transform: scale(0.9);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.aa-modal-root.active .aa-modal-container { transform: scale(1); }

.aa-modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
.aa-modal-brand { display: flex; align-items: center; gap: 10px; }
.aa-brand-dot { width: 12px; height: 12px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 15px rgba(34, 197, 94, 0.5); }
#aa-modal-header-text { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: rgba(255,255,255,0.4); }
.aa-modal-close { background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; opacity: 0.5; transition: 0.3s; }
.aa-modal-close:hover { opacity: 1; transform: rotate(90deg); }

#aa-modal-message { font-size: 1.15rem; line-height: 1.6; color: white; font-weight: 500; }

.aa-modal-footer { display: flex; gap: 10px; margin-top: 40px; justify-content: flex-end; }

.aa-btn { padding: 14px 28px; border-radius: 100px; font-weight: 800; font-size: 0.85rem; border: none; cursor: pointer; transition: 0.3s; }
.aa-btn--primary { background: #22c55e; color: white; box-shadow: 0 10px 20px rgba(34, 197, 94, 0.2); }
.aa-btn--primary:hover { background: #16a34a; transform: translateY(-2px); box-shadow: 0 15px 30px rgba(34, 197, 94, 0.4); }
.aa-btn--secondary { background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.1); }
.aa-btn--secondary:hover { background: rgba(255,255,255,0.1); }

.glass-fx { background: rgba(255,255,255,0.03); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); border: 1px solid rgba(255,255,255,0.08); }
</style>
