<!-- ========= STICKY BOTTOM BAR (AA CUSTOM) ========= -->
<% if (locals.stickyConfig && stickyConfig.is_active && typeof currentPath !== 'undefined' && !currentPath.startsWith('/my-account')) { %>
<div class="aa-sticky-bar" id="aa-sticky-bar" style="background: <%= stickyConfig.bg_color || 'rgba(14, 14, 14, 0.85)' %>; color: <%= stickyConfig.text_color || '#f5f0e8' %>">
  <div class="aa-sticky-bar__inner">
    <!-- Left: Static Times -->
    <div class="aa-sticky-bar__times">
      <span class="aa-sticky-bar__label"><%= stickyConfig.label %></span>
      <% if (stickyConfig.times && Array.isArray(stickyConfig.times)) { %>
        <% stickyConfig.times.forEach(time => { %>
          <span class="aa-sticky-bar__time"><%= time %></span>
        <% }) %>
      <% } %>
    </div>

    <!-- Center/Right: Scrolling Content (Always Active if text exists) -->
    <div class="aa-sticky-bar__dynamic is-scrolling" 
         style="--scroll-speed: <%= stickyConfig.speed || 15 %>s">
      <div class="aa-sticky-bar__scroll-track">
        <span class="aa-sticky-bar__info"><%= stickyConfig.info_text %></span>
        <span class="aa-sticky-bar__info"><%= stickyConfig.info_text %></span>
      </div>
    </div>

    <!-- Right: CTA -->
    <div class="aa-sticky-bar__watch">
      <a href="<%= stickyConfig.cta_link %>" style="color: <%= stickyConfig.text_color || '#f5f0e8' %>">
        <%= stickyConfig.cta_text %> 
        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .aa-sticky-bar {
    position: fixed !important;
    bottom: 30px !important; /* Raised for better visual clearance */
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    min-width: 500px;
    max-width: 90%;
    border-radius: 100px !important;
    z-index: 15000 !important;
    height: 52px !important;
    display: flex !important;
    align-items: center !important;
    background: rgba(14, 14, 14, 0.95) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    padding: 0 5px;
    opacity: 1;
    pointer-events: all;
  }

  /* Robust hiding class using high specificity to ensure JS control */
  .aa-sticky-bar.is-hidden {
    opacity: 0 !important;
    transform: translateX(-50%) translateY(100px) !important;
    pointer-events: none !important;
  }

  .aa-sticky-bar__inner {
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 25px;
    height: 100%;
    gap: 30px;
  }

  .aa-sticky-bar__times {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .aa-sticky-bar__label { opacity: 0.5; font-weight: 800; }

  .aa-sticky-bar__dynamic {
    flex: 1;
    overflow: hidden;
    position: relative;
    padding: 0 20px;
    display: flex;
    align-items: center;
    border-left: 1px solid rgba(255,255,255,0.1);
    border-right: 1px solid rgba(255,255,255,0.1);
  }

  .aa-sticky-bar__scroll-track {
    display: flex;
    white-space: nowrap;
    gap: 100px;
    width: max-content; /* CRITICAL: Calculate full content width */
  }

  .aa-sticky-bar__dynamic.is-scrolling .aa-sticky-bar__scroll-track {
    animation: aaStickyMarquee var(--scroll-speed, 15s) linear infinite;
  }

  @keyframes aaStickyMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Halfway if we have duplicates */
  }

  .aa-sticky-bar__info { 
    font-size: 0.8rem; 
    font-weight: 500;
    flex-shrink: 0; /* CRITICAL: Prevent shrinking so width matches content for marquee */
  }

  .aa-sticky-bar__watch a {
    display: flex; align-items: center; gap: 8px;
    text-decoration: none; font-weight: 800; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    background: rgba(255, 255, 255, 0.08);
    padding: 8px 16px; border-radius: 100px;
    transition: all 0.3s ease;
  }

  .aa-sticky-bar__watch a:hover { background: rgba(255, 255, 255, 0.2); transform: scale(1.05); }

  .aa-sticky-bar__watch svg { width: 12px; height: 12px; }

  /* Mobile Overrides */
  @media (max-width: 767px) {
    .aa-sticky-bar {
      min-width: 90% !important;
      bottom: 20px !important;
      height: 44px !important;
    }
    .aa-sticky-bar__times { display: none; }
    .aa-sticky-bar__dynamic { border: none; padding: 0 10px; }
    .aa-sticky-bar__info { font-size: 0.7rem; }
    .aa-sticky-bar__watch a { font-size: 0.65rem; padding: 6px 12px; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const stickyBar = document.getElementById('aa-sticky-bar');
    // Targeted selector for the custom Duda footer container
    const footer = document.querySelector('#flex-footer') || document.querySelector('.dmFooterContainer');
    
    if (stickyBar && footer) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    stickyBar.classList.add('is-hidden');
                } else {
                    stickyBar.classList.remove('is-hidden');
                }
            });
        }, { 
            threshold: 0.05, // Trigger as soon as 5% of footer enters
            rootMargin: '0px 0px -20px 0px' 
        });
        
        observer.observe(footer);
    }
});
</script>

<% } %>
<!-- ========= END STICKY BOTTOM BAR ========= -->