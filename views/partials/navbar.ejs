<!-- ========= STICKY BOTTOM BAR ========= -->
<% if (locals.stickyConfig && stickyConfig.is_active) { %>
<div class="sticky-bar" id="sticky-bar" style="background: <%= stickyConfig.bg_color || 'rgba(14, 14, 14, 0.85)' %>; color: <%= stickyConfig.text_color || '#f5f0e8' %>">
  <div class="sticky-bar__inner">
    <!-- Left: Static Times -->
    <div class="sticky-bar__times">
      <span class="sticky-bar__label"><%= stickyConfig.label %></span>
      <% if (stickyConfig.times && Array.isArray(stickyConfig.times)) { %>
        <% stickyConfig.times.forEach(time => { %>
          <span class="sticky-bar__time"><%= time %></span>
        <% }) %>
      <% } %>
    </div>

    <!-- Center/Right: Scrolling Content or Static -->
    <div class="sticky-bar__dynamic <%= stickyConfig.is_scrolling ? 'is-scrolling' : '' %>" 
         style="--scroll-speed: <%= stickyConfig.speed || 15 %>s">
      <div class="sticky-bar__scroll-track">
        <span class="sticky-bar__info"><%= stickyConfig.info_text %></span>
        <% if (stickyConfig.is_scrolling) { %>
          <!-- Duplicate for seamless scroll -->
          <span class="sticky-bar__info"><%= stickyConfig.info_text %></span>
          <span class="sticky-bar__info"><%= stickyConfig.info_text %></span>
        <% } %>
      </div>
    </div>

    <!-- Right: CTA -->
    <div class="sticky-bar__watch">
      <a href="<%= stickyConfig.cta_link %>" style="color: <%= stickyConfig.text_color || '#f5f0e8' %>">
        <%= stickyConfig.cta_text %> 
        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 9999;
    height: 48px;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    transition: transform 0.3s ease;
  }

  .sticky-bar__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    height: 100%;
  }

  .sticky-bar__times {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sticky-bar__label {
    opacity: 0.6;
  }

  .sticky-bar__dynamic {
    flex: 1;
    overflow: hidden;
    position: relative;
    padding: 0 40px;
    display: flex;
    align-items: center;
  }

  .sticky-bar__scroll-track {
    display: flex;
    white-space: nowrap;
    gap: 40px;
  }

  .sticky-bar__dynamic.is-scrolling .sticky-bar__scroll-track {
    animation: stickyMarquee var(--scroll-speed, 15s) linear infinite;
  }

  @keyframes stickyMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  .sticky-bar__info {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .sticky-bar__watch a {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.1);
    padding: 6px 12px;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .sticky-bar__watch a:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .sticky-bar__watch svg {
    width: 14px;
    height: 14px;
  }

  /* Mobile Overrides */
  @media (max-width: 767px) {
    .sticky-bar {
      height: 40px;
      padding-bottom: env(safe-area-inset-bottom);
    }
    
    .sticky-bar__times {
      display: none; /* Hide times on mobile to save space */
    }

    .sticky-bar__dynamic {
      padding: 0 15px;
    }

    .sticky-bar__info {
      font-size: 0.75rem;
    }

    .sticky-bar__watch a span {
      display: none; /* Hide text if too long, but user said only watch now shows */
    }
    
    .sticky-bar__watch a {
      font-size: 0.7rem;
      padding: 4px 8px;
    }
  }
</style>

<% } %>
<!-- ========= END STICKY BOTTOM BAR ========= -->