<!-- ========= ACCOUNT PANEL (QUICK ACTIONS) ========= -->
<div class="account-container" id="account-container">
  <!-- The Floating Bubble -->
  <button class="account-fab" id="account-fab" aria-label="Account Actions">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
  </button>

  <!-- The Expandable Panel -->
  <div class="account-panel" id="account-panel">
    <div class="account-panel__header">
      <div class="account-panel__user">
        <div class="user-avatar">
          <% if (user) { %>
            <img src="<%= user.avatar_url || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + (user.first_name || user.id || 'Ambassador') %>" alt="Avatar">
          <% } else { %>
            <i class="fas fa-user-circle"></i>
          <% } %>
        </div>
        <div class="user-info">
          <% if (user) { %>
            <span class="user-greeting">Welcome,</span>
            <span class="user-name"><%= user.first_name || 'Ambassador' %></span>
          <% } else { %>
            <span class="user-greeting">Peace be with you,</span>
            <span class="user-name">Ambassador</span>
          <% } %>
        </div>
      </div>
      <button class="account-panel__close" id="account-panel-close">&times;</button>
    </div>

    <div class="account-panel__body">
      <% if (user) { %>
        <p class="panel-subtitle">Your Spiritual Journey</p>
        <div class="quick-actions-grid">
          <a href="/my-account" class="quick-action">
            <i class="fas fa-th-large"></i>
            <span>Dashboard</span>
          </a>
          <a href="/ministries" class="quick-action">
            <i class="fas fa-users"></i>
            <span>Ministries</span>
          </a>
          <a href="/give" class="quick-action">
            <i class="fas fa-heart"></i>
            <span>Giving</span>
          </a>
          <a href="/prayer-wall" class="quick-action">
            <i class="fas fa-hands-praying"></i>
            <span>Prayers</span>
          </a>
        </div>
        <div class="panel-divider"></div>
        <a href="/account/logout" class="logout-link">
          <i class="fas fa-sign-out-alt"></i> Sign Out
        </a>
      <% } else { %>
        <div class="guest-msg">
          <p>Join the family to track your spiritual journey, join ministries, and grow with us.</p>
          <a href="/account/login" class="btn-signin">Sign In Now</a>
          <p class="register-text">New here? <a href="/onboarding">Register</a></p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
.account-container {
    position: fixed;
    bottom: 100px;
    left: 30px;
    z-index: 10000;
}

.account-fab {
    width: 65px;
    height: 65px;
    background: #115048;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.account-fab:hover {
    transform: scale(1.1) rotate(5deg);
    background: #176a60;
}

.account-fab svg { width: 28px; height: 28px; }

.account-panel {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 320px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(113, 178, 128, 0.2);
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.95);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: bottom left;
    overflow: hidden;
}

.account-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}

.account-panel__header {
    padding: 25px;
    background: linear-gradient(135deg, #115048 0%, #176a60 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.account-panel__user { display: flex; align-items: center; gap: 15px; }

.user-avatar { width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; }
.user-avatar img { width: 100%; height: 100%; object-fit: cover; }
.user-avatar i { font-size: 30px; }

.user-info { display: flex; flex-direction: column; }
.user-greeting { font-size: 0.75rem; opacity: 0.8; }
.user-name { font-size: 1rem; font-weight: 700; }

.account-panel__close { background: none; border: none; color: white; font-size: 24px; cursor: pointer; opacity: 0.7; transition: 0.3s; }
.account-panel__close:hover { opacity: 1; }

.account-panel__body { padding: 25px; }
.panel-subtitle { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; font-weight: 700; margin-bottom: 15px; }

.quick-actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
.quick-action {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 15px; background: #f8fafc; border-radius: 16px;
    text-decoration: none; color: #1e293b; transition: all 0.3s;
    border: 1px solid #f1f5f9;
}
.quick-action:hover { background: #176a60; color: white; transform: translateY(-3px); }
.quick-action i { font-size: 18px; }
.quick-action span { font-size: 0.75rem; font-weight: 600; }

.panel-divider { height: 1px; background: #f1f5f9; margin: 15px 0; }
.logout-link { display: flex; align-items: center; gap: 10px; color: #ef4444; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.3s; }
.logout-link:hover { transform: translateX(5px); }

.guest-msg { text-align: center; }
.guest-msg p { font-size: 0.85rem; color: #64748b; line-height: 1.5; margin-bottom: 20px; }
.btn-signin {
    display: block; width: 100%; padding: 15px; background: #115048;
    color: white; text-decoration: none; border-radius: 14px;
    font-weight: 700; transition: all 0.3s; margin-bottom: 15px;
}
.btn-signin:hover { background: #176a60; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(17, 80, 72, 0.2); }
.register-text { font-size: 0.8rem; color: #94a3b8; }
.register-text a { color: #176a60; font-weight: 700; text-decoration: none; }

@media (max-width: 767px) {
    .account-container { left: 20px; bottom: 80px; }
    .account-fab { width: 55px; height: 55px; }
    .account-panel { width: 280px; bottom: 70px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const fab = document.getElementById('account-fab');
    const panel = document.getElementById('account-panel');
    const close = document.getElementById('account-panel-close');
    
    if (fab && panel) {
        fab.addEventListener('click', () => {
            panel.classList.toggle('active');
        });
        
        if (close) {
            close.addEventListener('click', () => {
                panel.classList.remove('active');
            });
        }
        
        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!panel.contains(e.target) && !fab.contains(e.target)) {
                panel.classList.remove('active');
            }
        });
    }
});
</script>
