    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // High IQ: Auto-popup is now handled by the dashboard trigger logic
      });

      async function markSocialShown() {
        try {
          const csrfEl = document.querySelector('input[name="_csrf"]');
          const csrfToken = csrfEl ? csrfEl.value : '';
          
          await fetch('/api/profile/mark-share-shown', { 
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify({ shown: true })
          });
        } catch (e) { console.warn('Popup sync ignored'); }
      }

      async function dismissSocialPopup() {
        const popup = document.getElementById('socialSharePopup');
        if (popup) {
          popup.classList.remove('show');
          // Add a small delay to ensure animation completes before sync
          setTimeout(() => { popup.style.display = 'none'; }, 600);
        }
        await markSocialShown();
      }

      function triggerDownload(dataUrl) {
        const link = document.createElement('a');
        link.download = `ambassador-card-${Date.now()}.png`;
        link.href = dataUrl;
        link.style.display = 'none';
        document.body.appendChild(link);
        setTimeout(() => {
          link.click();
          document.body.removeChild(link);
          dismissSocialPopup();
        }, 100);
      }

      window.shareToWhatsApp = function(e) {
        if(e) e.preventDefault();
        const text = encodeURIComponent("I've officially been commissioned as an Ambassador at The Ambassadors Assembly! Join the movement: " + window.location.origin);
        window.open(`https://wa.me/?text=${text}`, '_blank');
      };
      
      window.shareToFacebook = function(e) {
        if(e) e.preventDefault();
        const url = encodeURIComponent(window.location.origin);
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank');
      };
      
      window.shareToInstagram = function(e) {
        if(e) e.preventDefault();
        // High IQ: Instagram doesn't support URL sharing, so we guide them to download
        downloadShareCard();
        alert("Your celebration card is downloading! You can now upload it to your Instagram Story or Feed. ✨");
      };

      async function downloadShareCard() {
        const card = document.getElementById('shareCardImage');
        const btn = document.querySelector('.download-btn');
        if (!card || !btn) return;

        try {
          const originalHTML = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
          btn.disabled = true;

          const canvas = await html2canvas(card, {
            scale: 2,
            useCORS: true,
            allowTaint: false,
            backgroundColor: null,
            logging: false,
            ignoreElements: (el) => {
              // High IQ: Explicitly ignore heavy/tainted elements to prevent 17s lag
              return el.tagName === 'VIDEO' || el.tagName === 'IFRAME' || el.classList.contains('hero-video');
            }
          });

          const dataUrl = canvas.toDataURL("image/png", 1.0);
          triggerDownload(dataUrl);
          
          // Note: Native navigator.share is disabled here because html2canvas 
          // delay breaks the 'User Gesture' requirement in modern browsers.
        } catch (err) {
          console.error('[CaptureError]', err);
          btn.innerHTML = originalHTML;
          btn.disabled = false;
        }
      }
    </script>

