    window.customWidgetsFunctions["d5c0c8fad21f4820bc13d4fe48e88a9e~2"] = function (element, data, api) {
      window.dmAPI.runOnReady('widget-d5c0c8', () => {
        // Load GSAP core + common plugins, then initialize animations
        function loadScript(src) {
          return new Promise((resolve, reject) => {
            if (document.querySelector(`script[src="${src}"]`)) {
              resolve();
              return;
            }
            const script = document.createElement('script');
            script.src = src;
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
          });
        }
        const GSAP_CDN = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5';
        loadScript(`${GSAP_CDN}/gsap.min.js`)
          .then(() => Promise.all([
            loadScript(`${GSAP_CDN}/ScrollTrigger.min.js`),
            loadScript(`${GSAP_CDN}/ScrollToPlugin.min.js`),
            loadScript(`${GSAP_CDN}/TextPlugin.min.js`),
            loadScript(`${GSAP_CDN}/Draggable.min.js`),
          ]))
          .then(() => {
            // Register plugins
            gsap.registerPlugin(ScrollTrigger, ScrollToPlugin, TextPlugin, Draggable);
            // ─────────────────────────────────────────
            // Your GSAP animation code starts here
            // ─────────────────────────────────────────
            const eventCards = document.querySelectorAll(".event-card");
            eventCards.forEach((card) => {
              const startPos = card.dataset.start
              const x = card.dataset.x;
              const y = card.dataset.y;
              const rotate = card.dataset.rotate;
              const eventsComplete = () => {
                gsap.set(card, {
                  y: y,
                  x: x,
                  rotate: rotate,
                })
              }
              const eventsTl = gsap.timeline({ scrollTrigger: '.event-cards', onComplete: eventsComplete });
              gsap.set(card, {
                y: 100,
                x: startPos,
                rotate: -12,
              })
              eventsTl.to(card, {
                rotate: 0,
                y: 0,
                ease: "sine",
                duration: .75,
              })
              eventsTl.to(card, {
                opacity: 1,
                duration: .5,
              })
              eventsTl.to(card, {
                x: x,
                y: y,
                rotate: rotate,
                ease: "sine",
              }, ">=-.5")
              if (window.innerWidth > 767) {
                card.addEventListener("mouseenter", () => {
                  gsap.to(card, {
                    y: parseFloat(y) - 25,
                    rotate: 0,
                    duration: 0.3,
                    ease: "sine",
                  });
                });
                card.addEventListener("mouseleave", () => {
                  gsap.to(card, {
                    y: y,
                    rotate: rotate,
                    duration: 0.3,
                    ease: "sine",
                  });
                });
              };
            })
            // ─────────────────────────────────────────
            // Your GSAP animation code ends here
            // ─────────────────────────────────────────
          })
          .catch((err) => {
            console.error('Failed to load GSAP scripts:', err);
          });
      });
    };
