      .hashtags { font-size: 8px; font-weight: 700; color: #10b981; opacity: 0.6; letter-spacing: 0.5px; }

      .popup-actions { padding: 25px 25px; text-align: center; }
      .popup-actions h3 { font-size: 1.1rem; color: #176a60; margin-bottom: 8px; font-weight: 800; }
      .popup-actions p { font-size: 0.85rem; color: #6b7280; line-height: 1.4; margin-bottom: 20px; }

      .download-btn {
        width: 100%; padding: 18px; background: #176a60; color: white;
        border: none; border-radius: 18px; font-weight: 800; font-size: 1rem;
        cursor: pointer; transition: 0.3s; box-shadow: 0 10px 20px rgba(23, 106, 96, 0.3);
        margin-bottom: 20px; display: flex; align-items: center; justify-content: center; gap: 10px;
      }
      .download-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(23, 106, 96, 0.4); }

      .dismiss-link {
        background: none; border: none; font-size: 0.85rem; font-weight: 700;
        color: #9ca3af; cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px;
      }
