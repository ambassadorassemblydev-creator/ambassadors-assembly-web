  <script>
    window.customWidgetsFunctions["bb326d33b58a475aaf4861dade7c981f~24"] = function (element, data, api) {
      window.dmAPI.runOnReady('heroSwiperWidget', () => {
        // ─── Load external libraries ───────────────────────────────────────────────
        function loadScript(src, onload) {
          if (document.querySelector('script[src="' + src + '"]')) {
            if (onload) onload();
            return;
          }
          var s = document.createElement('script');
          s.src = src;
          s.onload = onload || null;
          document.head.appendChild(s);
        }
        function loadStyle(href) {
          if (document.querySelector('link[href="' + href + '"]')) return;
          var l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = href;
          document.head.appendChild(l);
        }
        // ─── Ambassadors Assembly API: load latest sermon into Slide 2 ────────────────────
        function fetchLatestSermon() {
          fetch('https://api.cornerstoneathens.cc/youtube/latest?playlistId=PLoC0xI5CrP4mKkZ2Dy_B1rkI4runKUiOa')
            .then(function (res) {
              if (!res.ok) throw new Error('Network response was not ok ' + res.status);
              return res.json();
            })
            .then(function (responseData) {
              var videoId = responseData.videoId;
              var title = responseData.title;
              var thumb = responseData.imageUrl;
              var cleanTitle = (title || '').split('|')[0].trim();
              var titleEl = element.querySelector('[data-slide2-title]');
              var watchEl = element.querySelector('[data-slide2-watch]');
              var slide2 = element.querySelector('[data-slide2]');
              if (titleEl) titleEl.textContent = cleanTitle;
              if (watchEl) watchEl.href = 'https://www.youtube.com/watch?v=' + videoId;
              if (slide2) {
                slide2.style.backgroundImage = 'url(' + thumb + ')';
                slide2.style.backgroundSize = 'cover';
                slide2.style.backgroundRepeat = 'no-repeat';
                slide2.style.backgroundPosition = 'center center';
              }
            })
            .catch(function (err) {
              console.error('Error fetching latest sermon:', err);
              var titleEl = element.querySelector('[data-slide2-title]');
              if (titleEl) titleEl.textContent = 'Unable to load sermon';
            });
        }
        fetchLatestSermon();
        // ─── Hide swiper early if reorder will happen, to prevent slide-1 flash ──
        (function () {
          var wrap = element.querySelector('.hero-swiper-wrap');
          if (wrap && wrap.getAttribute('data-start-with-slide3') === 'true') {
            wrap.style.visibility = 'hidden';
          }
        })();
        // ─── Reorder slides if "Start with Slide 3 First" is toggled ─────────────
        function reorderSlides() {
          var wrap = element.querySelector('.hero-swiper-wrap');
          if (!wrap) return;
          if (wrap.getAttribute('data-start-with-slide3') !== 'true') return;
          var wrapper = element.querySelector('.swiper-wrapper');
          if (!wrapper) return;
          var slide1 = wrapper.querySelector('.slide-1');
          var slide2 = wrapper.querySelector('.slide-2');
          var slide3 = wrapper.querySelector('.slide-3');
          if (!slide1 || !slide2 || !slide3) return;
          // New order: slide3, slide1, slide2
          wrapper.insertBefore(slide3, wrapper.firstChild);
          slide3.after(slide1);
          slide1.after(slide2);
        }
        // ─── GSAP animation helpers ───────────────────────────────────────────────
        function resetSlideElements(slide) {
          if (!slide || typeof gsap === 'undefined') return;
          var els = slide.querySelectorAll('.gsap-slide-title, .gsap-slide-text, .gsap-slide-btns');
          gsap.set(els, { opacity: 0, y: 30 });
        }
        function animateActiveSlide(slide) {
          if (!slide || typeof gsap === 'undefined') return;
          var title = slide.querySelector('.gsap-slide-title');
          var texts = slide.querySelectorAll('.gsap-slide-text');
          var btns = slide.querySelector('.gsap-slide-btns');
          var tl = gsap.timeline();
          if (title) tl.fromTo(title, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, 0);
          if (texts.length) tl.fromTo(texts, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.1 }, 0.2);
          if (btns) tl.fromTo(btns, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 0.5);
        }
        // ─── Init Swiper ──────────────────────────────────────────────────────────
        function initSwiper() {
          var swiperEl = element.querySelector('.heroSwiper');
          if (!swiperEl) return;
          var numSlides = swiperEl.querySelectorAll('.swiper-slide').length;
          var swiper = new Swiper(swiperEl, {
            loop: false,
            autoplay: {
              delay: 7000,
              disableOnInteraction: false,
              pauseOnMouseEnter: true
            },
            speed: 800,
            pagination: {
              el: element.querySelector('.hero-pag'),
              clickable: true
            },
            navigation: {
              nextEl: element.querySelector('.hero-next'),
              prevEl: element.querySelector('.hero-prev')
            },
            on: {
              init: function () {
                animateActiveSlide(this.slides[this.activeIndex]);
              },
              slideChangeTransitionStart: function () {
                resetSlideElements(this.slides[this.activeIndex]);
              },
              slideChangeTransitionEnd: function () {
                animateActiveSlide(this.slides[this.activeIndex]);
              }
            }
          });
        }
        // ─── Load Swiper CSS → Swiper JS → GSAP → init ────────────────────────────
        loadStyle('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');
        loadScript('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js', function () {
          loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js', function () {
            reorderSlides();
            var wrap = element.querySelector('.hero-swiper-wrap');
            if (wrap) wrap.style.visibility = '';
            initSwiper();
          });
        });
      });
    };
  </script>
