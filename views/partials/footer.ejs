    .typing-dots span { width: 6px; height: 6px; background: #134e5e; border-radius: 50%; opacity: 0.4; animation: ai-typing 1.4s infinite both; }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes ai-typing { 
      0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; } 
