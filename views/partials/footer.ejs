      color: white;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 30px rgba(14, 58, 48, 0.4);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
    }
    .ai-chat-bubble svg { width: 28px; height: 28px; transition: transform 0.3s ease; }
    .ai-chat-bubble:hover { transform: scale(1.1) translateY(-5px); }
    .ai-chat-bubble:hover svg { transform: rotate(15deg); }
    .bubble-ping {
      position: absolute;
      top: 0;
      right: 0;
      width: 15px;
      height: 15px;
      background: #4ade80;
      border-radius: 50%;
      border: 3px solid #fff;
      animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes ping {
      75%, 100% { transform: scale(2); opacity: 0; }
    }
    .ai-chat-window {
      position: absolute;
      bottom: 80px;
      right: 0;
      width: 380px;
      height: 550px;
      background: rgba(255, 255, 255, 0.98);
