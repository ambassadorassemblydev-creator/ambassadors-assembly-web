        .cookie-content { flex-direction: column; text-align: left; align-items: flex-start; gap: 10px; }
        .cookie-actions { width: 100%; margin-top: 10px; display: flex; justify-content: flex-end; }
        .btn-accept { width: auto; min-width: 100px; }
