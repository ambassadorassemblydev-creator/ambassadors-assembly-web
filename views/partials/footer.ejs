    .status-online::before { content: ''; width: 8px; height: 8px; background: #4ade80; border-radius: 50%; }
    .header-actions { display: flex; align-items: center; gap: 15px; }
    .close-chat { background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer; opacity: 0.7; transition: opacity 0.2s; padding: 0; line-height: 1; }
    .close-chat:hover { opacity: 1; }

    .ai-chat-body {
      flex: 1;
      padding: 25px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 15px;
      background: #fdfdfb;
