        }
      ],
      "sameAs": [
        "<%= locals.churchSettings?.social_youtube || 'https://www.youtube.com/@theambassadorsassembly' %>",
        "<%= locals.churchSettings?.social_instagram || 'https://www.instagram.com/theambassadorsassembly' %>",
        "<%= locals.churchSettings?.social_facebook || 'https://www.facebook.com/theambassadorsassembly' %>"
      ]
    }
  ]
}
