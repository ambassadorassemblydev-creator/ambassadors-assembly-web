      "@id": "https://www.theambassadorsassembly.org/#website",
      "url": "https://www.theambassadorsassembly.org/",
      "name": "<%= locals.churchSettings?.church_name || 'The Ambassadors Assembly' %>",
      "publisher": { "@id": "https://www.theambassadorsassembly.org/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.theambassadorsassembly.org/#webpage",
      "url": "https://www.theambassadorsassembly.org/",
      "name": "<%= pageTitle %> | The Ambassadors Assembly",
      "description": "<%= locals.churchSettings?.site_description %>",
      "isPartOf": { "@id": "https://www.theambassadorsassembly.org/#website" },
      "about": { "@id": "https://www.theambassadorsassembly.org/#organization" },
      "primaryImageOfPage": { "@id": "https://www.theambassadorsassembly.org/#primaryimage" }
    },
    {
      "@type": "ImageObject",
      "@id": "https://www.theambassadorsassembly.org/#primaryimage",
      "url": "<%= optimizedOgImage %>",
      "contentUrl": "<%= optimizedOgImage %>"
    },
    {
