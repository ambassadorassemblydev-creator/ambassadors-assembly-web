<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" class="">

<head>
  <meta charset="utf-8">
  
  <!-- LCP Image Preload -->
  <% if (locals.lcpImage) { %>
  <link rel="preload" as="image" href="<%= lcpImage %>" fetchpriority="high">
  <% } %>
  
  <!-- Preconnect to CDNs for faster asset delivery -->
  <link rel="preconnect" href="https://res.cloudinary.com">
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  
  <!-- Font Preloading (High IQ: Mitigates FOIT and improves LCP) -->
  <link rel="preload" href="/fonts/Articulatcf-regular.otf" as="font" type="font/otf" crossorigin>
  <link rel="preload" href="/fonts/Articulat-CF-Demi-Bold.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin>
  
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-446GXF82G8"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-446GXF82G8');
  </script>
  <!-- ========= Meta Tags ========= -->
  <meta id="view" name="viewport" content="initial-scale=1, minimum-scale=1, maximum-scale=5, viewport-fit=cover">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="The Ambassadors Assembly">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="keywords" content="The Ambassadors Assembly, Church in Lagos, Christian Community, Jesus, Lagos Church, Faith, Ministry, Sermons, Reach Raise Rule">
  <meta name="author" content="The Ambassadors Assembly">
  <meta name="geo.region" content="NG-LA" />
  <meta name="geo.placename" content="Lagos" />
  <meta name="geo.position" content="6.6341;3.3702" />
  <meta name="ICBM" content="6.6341, 3.3702" />

  <script>
    function handleImageLoadError(img) {
      img.onerror = null; // Prevent infinite loop
      img.src = 'https://res.cloudinary.com/dxwhpacz7/image/upload/v1775200226/IMG-20260304-WA0059_telyum.jpg';
      img.classList.add('image-fallback');
    }
  </script>

  <!-- Sentry Tracking -->
  <% if (locals.SENTRY_BROWSER_DSN) { %>
  <script src="https://js.sentry-cdn.com/f0c3f0c3f0c3f0c3f0c3f0c3f0c3f0c3.min.js" crossorigin="anonymous"></script>
  <script>
    if (window.Sentry) {
      Sentry.init({
        dsn: "<%= SENTRY_BROWSER_DSN %>",
        integrations: [Sentry.browserTracingIntegration()],
        tracesSampleRate: 1.0,
      });
    }
  </script>
  <% } %>

  <!-- Favicons (Cloudinary) -->
  <link rel="apple-touch-icon"
    href="https://res.cloudinary.com/dxwhpacz7/image/upload/v1775200226/IMG-20260304-WA0059_telyum.jpg">
  <link rel="icon" type="image/x-icon"
    href="https://res.cloudinary.com/dxwhpacz7/image/upload/v1775200226/IMG-20260304-WA0059_telyum.jpg">

  <!-- Canonical -->
  <link rel="canonical" href="https://www.theambassadorsassembly.org/">

  <!-- Deferred promise utility (used by runtime) -->
  <script data-role="deferred-init" type="text/javascript">
    function Def() {
      this.promise = new Promise((function (a, b) {
        this.resolve = a; this.reject = b;
      }).bind(this));
    }
    const defs = {};
    window.getDeferred = function (a) { return null == defs[a] && (defs[a] = new Def), defs[a]; };
    window.waitForDeferred = function (b, a, c) {
      let d = window?.getDeferred?.(b);
      d ? d.promise.then(a)
        : c && ["complete", "interactive"].includes(document.readyState) ? setTimeout(a, 1)
        : c ? document.addEventListener("DOMContentLoaded", a)
        : console.error('Deferred does not exist');
    };
  </script>

  <!-- ========= Stylesheets ========= -->
  <link rel="stylesheet" href="/css/vendor/d-css-runtime-flex.min.css" type="text/css">
  <link rel="stylesheet" href="/css/vendor/widget-styles.css" id="widgetCSS" type="text/css" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="/css/vendor/home-page.min.css" id="homeCssLink" type="text/css" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="/css/vendor/site-global.min.css" id="siteGlobalCss" type="text/css" media="print" onload="this.media='all'">
  <style>
    @font-face {
      font-family: "AppleGaramond-Light";
      src: url("/fonts/AppleGaramond-Light.ttf");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    
    /* Optimized Articulat font definitions with swap display */
    @font-face {
      font-family: 'Articulat CF Demi Bold';
      src: url('/fonts/Articulat-CF-Demi-Bold.ttf') format('truetype');
      font-weight: 600;
      font-display: swap;
    }
    @font-face {
      font-family: 'Articulat CF';
      src: url('/fonts/Articulatcf-regular.otf') format('opentype');
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'Articulat_CF_Normal';
      src: url('/fonts/Articulat_CF_Normal.otf') format('opentype');
      font-weight: 400;
      font-display: swap;
    }
    img[width][height] { height: auto; }
    body[data-page-alias="home"] #dm [data-show-on-page-only="home"] { display: block !important; }
  </style>
  
  <link rel="stylesheet" href="/css/style.min.css?v=1.1">
  <link rel="stylesheet" href="/css/index-page.min.css?v=1.1">

  <!-- ========= Page Title & SEO ========= -->
  <title><%= pageTitle || locals.churchSettings?.site_title || 'The Ambassadors Assembly' %></title>
  <meta name="description" content="<%= locals.churchSettings?.site_description || 'The Ambassadors Assembly — A Spirit-filled church in Lagos, Nigeria.' %>">

  <!-- Meta Optimization -->
  <% 
    const optimizedOgImage = (locals.churchSettings?.og_image || 'https://res.cloudinary.com/dxwhpacz7/image/upload/v1775200226/IMG-20260304-WA0059_telyum.jpg').replace('/upload/', '/upload/f_auto,q_auto/');
  %>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.theambassadorsassembly.org<%= currentPath || '' %>">
  <meta property="og:title" content="<%= pageTitle || locals.churchSettings?.site_title || 'The Ambassadors Assembly' %>">
  <meta property="og:description" content="<%= locals.churchSettings?.site_description || 'The Ambassadors Assembly — A Spirit-filled church in Lagos, Nigeria.' %>">
  <meta property="og:image" content="<%= optimizedOgImage %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@theambassadorsassembly">
  <meta name="twitter:creator" content="@theambassadorsassembly">
  <meta name="twitter:title" content="<%= pageTitle || locals.churchSettings?.site_title || 'The Ambassadors Assembly' %>">
  <meta name="twitter:description" content="<%= locals.churchSettings?.site_description || 'The Ambassadors Assembly — A Spirit-filled church in Lagos, Nigeria.' %>">
  <meta name="twitter:image" content="<%= optimizedOgImage %>">

  <!-- ========= Structured Data (JSON-LD) ========= -->
