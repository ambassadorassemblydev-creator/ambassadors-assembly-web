      "name": "<%= locals.churchSettings?.church_name || 'The Ambassadors Assembly' %>",
      "url": "https://www.theambassadorsassembly.org/",
      "logo": "<%= locals.churchSettings?.logo_url || optimizedOgImage %>",
      "image": "<%= optimizedOgImage %>",
      "telephone": "<%= locals.churchSettings?.church_phone || '+234 803 333 3333' %>",
      "email": "<%= locals.churchSettings?.church_email %>",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "<%= locals.churchSettings?.church_address || '7 Fashe Street, Omole Phase 2' %>",
        "addressLocality": "Lagos",
        "addressRegion": "Lagos",
        "addressCountry": "NG"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 6.6341,
        "longitude": 3.3702
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
