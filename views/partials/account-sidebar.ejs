<button id="mobile-sidebar-toggle" class="mobile-sidebar-toggle">
  <i class="fas fa-bars"></i>
  <span>Menu</span>
</button>

<aside class="dash-sidebar" id="dash-sidebar">
  <button id="sidebar-toggle" class="sidebar-toggle" aria-label="Toggle Sidebar">
    <i class="fas fa-chevron-left"></i>
  </button>

  <div class="sidebar-profile">
    <div class="avatar-container">
      <% if (user.avatar_url) { %>
        <img src="<%= user.avatar_url %>" alt="<%= user.first_name %>" class="avatar-img">
      <% } else { %>
        <div class="avatar-initials"><%= user.first_name ? user.first_name[0] : 'U' %><%= user.last_name ? user.last_name[0] : '' %></div>
      <% } %>
      <% if (user.church_workers && user.church_workers.length > 0) { %>
        <div class="worker-badge-mini" title="Church Worker"><i class="fas fa-certificate"></i></div>
      <% } %>
    </div>
    
    <div class="profile-info">
      <h3><%= user.title ? user.title + ' ' : '' %><%= user.first_name %> <%= user.last_name %></h3>
      <% if (user.church_workers && user.church_workers.length > 0) { %>
        <div class="role-stack">
          <% user.church_workers.forEach(worker => { %>
            <span class="role-tag">
              <%= (worker.church_positions && worker.church_positions.title) || 'Worker' %> 
              <%= (worker.church_departments && worker.church_departments.name) ? ' • ' + worker.church_departments.name : '' %>
            </span>
          <% }) %>
        </div>
      <% } else { %>
        <p class="member-id"><%= user.member_id || 'Member' %></p>
      <% } %>
    </div>
  </div>

  <ul class="nav-links">
    <li class="nav-item">
      <a href="/my-account" 
         onclick="if(window.switchTab) { switchTab('overview'); return false; }"
         class="nav-link <%= activePage === 'dashboard' && activeTab === 'overview' ? 'active' : '' %>">
        <i class="fas fa-th-large"></i>
        <span>Overview</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/my-account/profile" class="nav-link <%= activePage === 'profile' ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i>
        <span>Profile</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/my-account?tab=events" 
         onclick="if(window.switchTab) { switchTab('events'); return false; }"
         class="nav-link <%= activePage === 'dashboard' && activeTab === 'events' ? 'active' : '' %>">
        <i class="fas fa-calendar-alt"></i>
        <span>Events</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/my-account?tab=giving" 
         onclick="if(window.switchTab) { switchTab('giving'); return false; }"
         class="nav-link <%= activePage === 'dashboard' && activeTab === 'giving' ? 'active' : '' %>">
        <i class="fas fa-hand-holding-heart"></i>
        <span>Partnership</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/my-account?tab=prayers" 
         onclick="if(window.switchTab) { switchTab('prayers'); return false; }"
         class="nav-link <%= activePage === 'dashboard' && activeTab === 'prayers' ? 'active' : '' %>">
        <i class="fas fa-pray"></i>
        <span>Prayers</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/my-account?tab=notes" 
         onclick="if(window.switchTab) { switchTab('notes'); return false; }"
         class="nav-link <%= activePage === 'dashboard' && activeTab === 'notes' ? 'active' : '' %>">
        <i class="fas fa-sticky-note"></i>
        <span>My Notes</span>
      </a>
    </li>
    <li class="nav-item separator"></li>
    <li class="nav-item">
      <a href="/departments" class="nav-link <%= activePage === 'departments' ? 'active' : '' %>">
        <i class="fas fa-users"></i>
        <span>Departments</span>
      </a>
    </li>
  </ul>

  <div class="sidebar-footer">
    <a href="/auth/logout" class="logout-btn">
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    </a>
  </div>

  <script>
    (function() {
      const sidebar = document.getElementById('dash-sidebar');
      const toggle = document.getElementById('sidebar-toggle');
      const mobileToggle = document.getElementById('mobile-sidebar-toggle');
      
      // Load saved state immediately to prevent flicker
      const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed && window.innerWidth > 1024) {
        sidebar.classList.add('collapsed');
      }

      toggle.addEventListener('click', () => {
        const collapsed = sidebar.classList.toggle('collapsed');
        localStorage.setItem('sidebarCollapsed', collapsed);
      });

      if (mobileToggle) {
        mobileToggle.addEventListener('click', () => {
          sidebar.classList.toggle('active');
        });
      }

      // Auto-close on link click (mobile)
      document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth <= 1024) {
            sidebar.classList.remove('active');
          }
        });
      });
    })();
  </script>
</aside>
